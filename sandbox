    local NEW_CHANGED_FILES=$(git diff --name-only "$PR_BASE"...HEAD 2>/dev/null || echo "")
    local CHANGES_SINCE=$(git diff --stat "$OLD_COMMIT"...HEAD 2>/dev/null || echo "")

