# ============================================================================
# NON-INTERACTIVE SESSION CREATION (for web UI)
# ============================================================================

create_pr_session_noninteractive() {
    local PR_URL="$1"
    local JIRA_TICKET="$2"

    # Parse PR URL
    if [[ "$PR_URL" =~ github\.com/([^/]+)/([^/]+)/pull/([0-9]+) ]]; then
        local OWNER="${BASH_REMATCH[1]}"
        local REPO="${BASH_REMATCH[2]}"
        local PR_NUMBER="${BASH_REMATCH[3]}"
    else
        echo "ERROR: Invalid PR URL" >&2
        exit 1
    fi

    local REPO_URL="https://github.com/$OWNER/$REPO.git"
    local SESSION_NAME="pr-${REPO}-${PR_NUMBER}-$(date +%Y%m%d-%H%M%S)"
    local SESSION_DIR="$SESSIONS_DIR/$SESSION_NAME"

    mkdir -p "$SESSION_DIR"
    cd "$SESSION_DIR"

    # Clone and checkout PR
    git clone --depth=50 "$REPO_URL" repo 2>/dev/null
    cd repo
    git fetch origin "pull/$PR_NUMBER/head:pr-$PR_NUMBER" 2>/dev/null
    git checkout "pr-$PR_NUMBER" 2>/dev/null

    # Get PR metadata
    local PR_JSON=$(gh pr view "$PR_NUMBER" --repo "$OWNER/$REPO" --json title,headRefName,baseRefName,author,additions,deletions,changedFiles,url 2>/dev/null)

    local PR_TITLE=$(echo "$PR_JSON" | jq -r '.title // "PR #'"$PR_NUMBER"'"')
    local PR_HEAD=$(echo "$PR_JSON" | jq -r '.headRefName // "unknown"')
    local PR_BASE=$(echo "$PR_JSON" | jq -r '.baseRefName // "main"')
    local PR_AUTHOR=$(echo "$PR_JSON" | jq -r '.author.login // "unknown"')

    # Auto-detect Jira from branch name if not provided
    if [ -z "$JIRA_TICKET" ] && [ -n "$PR_HEAD" ]; then
        # Extract Jira ticket pattern from branch (e.g., HB-404-fix-login -> HB-404)
        local detected=$(echo "$PR_HEAD" | grep -oE '^[A-Za-z]+-[0-9]+' | head -1 | tr '[:lower:]' '[:upper:]')
        if [ -z "$detected" ]; then
            detected=$(echo "$PR_HEAD" | grep -oE '[A-Za-z]+-[0-9]+' | head -1 | tr '[:lower:]' '[:upper:]')
        fi
        [ -n "$detected" ] && JIRA_TICKET="$detected"
    fi

    # Create session.json
    local extra_json=$(cat <<EOF
{
    "pr": {
        "number": "$PR_NUMBER",
        "title": "$PR_TITLE",
        "url": "https://github.com/$OWNER/$REPO/pull/$PR_NUMBER",
        "head": "$PR_HEAD",
        "base": "$PR_BASE",
        "author": "$PR_AUTHOR"
    }
}
EOF
)
    [ -n "$JIRA_TICKET" ] && extra_json=$(echo "$extra_json" | jq ". + {jira: {ticket: \"$JIRA_TICKET\"}}" 2>/dev/null || echo "$extra_json")

    create_session_json "$SESSION_DIR" "review" "https://github.com/$OWNER/$REPO" "$extra_json"

    # Fallback: if session.json is empty/invalid, create minimal one
    if ! jq -e type "$SESSION_DIR/session.json" >/dev/null 2>&1; then
        cat > "$SESSION_DIR/session.json" <<FALLBACK
{
  "id": "$SESSION_NAME",
  "mode": "review",
  "project": "https://github.com/$OWNER/$REPO",
  "created": "$(date -Iseconds)",
  "status": "active",
  "pr": {"number": "$PR_NUMBER", "title": "$PR_TITLE", "url": "https://github.com/$OWNER/$REPO/pull/$PR_NUMBER", "head": "$PR_HEAD", "base": "$PR_BASE", "author": "$PR_AUTHOR"},
  "history": []
}
FALLBACK
    fi

    # Always create session-info.txt as dashboard fallback
    cat > "$SESSION_DIR/session-info.txt" <<INFO_EOF
================================================================================
SESSION INFO
================================================================================
Type:       PR Review
Created:    $(date '+%Y-%m-%d %H:%M:%S')
Session:    $SESSION_NAME

PR #$PR_NUMBER: $PR_TITLE
URL:        https://github.com/$OWNER/$REPO/pull/$PR_NUMBER
Author:     $PR_AUTHOR
Branch:     $PR_HEAD → $PR_BASE

Repository: $OWNER/$REPO
$([ -n "$JIRA_TICKET" ] && echo "Jira:       $JIRA_TICKET")
================================================================================
INFO_EOF

    # Create CLAUDE.md for review mode
    generate_claude_md "$SESSION_DIR" "review" "PR #$PR_NUMBER: $PR_TITLE by @$PR_AUTHOR"

    # Fetch PR discussion and comments for context
    fetch_pr_comments "$SESSION_DIR" "$OWNER" "$REPO" "$PR_NUMBER"

    # Output session name for the API
    echo "$SESSION_NAME"
}

create_investigation_session_noninteractive() {
    local REPO_URL="$1"
    local FOCUS="$2"
    local JIRA_TICKET="$3"

    # Parse repo URL
    local REPO_NAME=$(basename "$REPO_URL" .git)
    local SESSION_NAME="inv-${REPO_NAME}-$(date +%Y%m%d-%H%M%S)"
    local SESSION_DIR="$SESSIONS_DIR/$SESSION_NAME"

    mkdir -p "$SESSION_DIR"
    cd "$SESSION_DIR"

    # Clone repo
    git clone --depth=50 "$REPO_URL" repo 2>/dev/null

    # Create session.json
    local extra_json=$(cat <<EOF
{
    "focus": "$FOCUS"
}
EOF
)
    [ -n "$JIRA_TICKET" ] && extra_json=$(echo "$extra_json" | jq ". + {jira: {ticket: \"$JIRA_TICKET\"}}")

    create_session_json "$SESSION_DIR" "investigation" "$REPO_URL" "$extra_json"

    # Create CLAUDE.md for investigation mode
    generate_claude_md "$SESSION_DIR" "investigation" "$FOCUS"

    echo "$SESSION_NAME"
}

create_development_session_noninteractive() {
    local REPO_URL="$1"
    local JIRA_TICKET="$2"

    # Parse repo URL
    local REPO_NAME=$(basename "$REPO_URL" .git)
    local BRANCH_NAME="feature/${JIRA_TICKET}"
    local SESSION_NAME="dev-${REPO_NAME}-${JIRA_TICKET}-$(date +%Y%m%d-%H%M%S)"
    local SESSION_DIR="$SESSIONS_DIR/$SESSION_NAME"

    mkdir -p "$SESSION_DIR"
    cd "$SESSION_DIR"

    # Clone repo and create branch
    git clone --depth=50 "$REPO_URL" repo 2>/dev/null
    cd repo
    git checkout -b "$BRANCH_NAME" 2>/dev/null

    # Create session.json
    local extra_json=$(cat <<EOF
{
    "jira": {
        "ticket": "$JIRA_TICKET"
    },
    "branch": "$BRANCH_NAME"
}
EOF
)

    create_session_json "$SESSION_DIR" "development" "$REPO_URL" "$extra_json"

    # Create CLAUDE.md for development mode
    generate_claude_md "$SESSION_DIR" "development" "Jira: $JIRA_TICKET"

    echo "$SESSION_NAME"
}

# Handle --create-session argument (called from web UI)
if [ "$1" = "--create-session" ]; then
    case "$SANDBOX_MODE" in
        review)
            create_pr_session_noninteractive "$SANDBOX_URL" "$SANDBOX_JIRA"
            ;;
        investigation)
            create_investigation_session_noninteractive "$SANDBOX_URL" "$SANDBOX_FOCUS" "$SANDBOX_JIRA"
            ;;
        development)
            create_development_session_noninteractive "$SANDBOX_URL" "$SANDBOX_JIRA"
            ;;
        *)
            echo "ERROR: Unknown mode $SANDBOX_MODE" >&2
            exit 1
            ;;
    esac
    exit 0
fi

main_menu
