# Start a background file watcher that updates the preview
start_file_watcher() {
    local SESSION_DIR="$1"
    local HTML_FILE="$2"
    # Files are in session root (symlinked to repo)
    local REVIEW_FILE="$SESSION_DIR/REVIEW.md"

