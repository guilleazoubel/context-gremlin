                type === 'review' ? 'Live Code Review' : 'Live Investigation';
        }

        function updateTabState() {
            document.querySelectorAll('.tab').forEach(tab => {
                const type = tab.dataset.file;
                tab.classList.toggle('has-content', hasContent[type]);
                tab.classList.toggle('no-content', !hasContent[type]);
            });
