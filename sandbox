settings_menu() {
    while true; do
        header
        gum style --foreground 212 --bold "Settings"
        echo ""

        # Show current settings
        gum style --foreground 240 "Current configuration:"
        echo "  Model: $(gum style --foreground 82 "$MODEL")"
        echo "  Dashboard auto-start: $(gum style --foreground 82 "$DASHBOARD_AUTO_START")"
        [ -n "$DEFAULT_PROJECT" ] && echo "  Default project: $(gum style --foreground 82 "$DEFAULT_PROJECT")"
        echo ""

        local choice=$(printf '%s\n' \
            "🤖 Switch Claude model ($MODEL)" \
            "🌐 Toggle dashboard auto-start ($DASHBOARD_AUTO_START)" \
            "📁 Set default project" \
            "🔄 Migrate sessions to v2 format" \
            "🗑️  Clear configuration" \
            "📄 View config file" \
            "← Back" | fzf \
            --height=~40% \
            --layout=reverse \
            --border=rounded \
            --no-info \
            --prompt="" \
            --header="Configure sandbox settings" \
            --header-first)

        case "$choice" in
            *"Switch Claude model"*)
                local new_model=$(printf '%s\n' \
                    "sonnet (Recommended - fast & capable)" \
                    "opus (Most capable - slower)" \
                    "haiku (Fastest - simpler tasks)" | fzf \
                    --height=~25% \
                    --layout=reverse \
                    --border=rounded \
                    --no-info \
                    --prompt="" \
                    --header="Select Claude model" \
                    --header-first)

                case "$new_model" in
                    *"sonnet"*) MODEL="sonnet" ;;
                    *"opus"*) MODEL="opus" ;;
                    *"haiku"*) MODEL="haiku" ;;
                esac

                if [ -n "$new_model" ]; then
                    save_config
                    success "Model set to: $MODEL"
                    sleep 1
                fi
                ;;
            *"Toggle dashboard"*)
                if [ "$DASHBOARD_AUTO_START" = "true" ]; then
                    DASHBOARD_AUTO_START="false"
                else
                    DASHBOARD_AUTO_START="true"
                fi
                save_config
                success "Dashboard auto-start: $DASHBOARD_AUTO_START"
                sleep 1
                ;;
            *"Set default project"*)
                local project_path=$(gum input \
                    --placeholder "e.g., https://github.com/org/repo" \
                    --value "$DEFAULT_PROJECT" \
                    --header "Default project URL or path:")

                if [ -n "$project_path" ]; then
                    DEFAULT_PROJECT="$project_path"
                    save_config
                    success "Default project set"
                    sleep 1
                fi
                ;;
            *"Migrate sessions"*)
                echo ""
                dim "Scanning for v1 sessions..."
                local migrated=0
                local failed=0

                for session in $(get_sessions); do
                    if [ ! -f "$session/session.json" ] && [ -f "$session/session-info.txt" ]; then
                        local name=$(basename "$session")
                        dim "  Migrating $name..."
                        if migrate_session_to_v2 "$session"; then
                            ((migrated++))
                        else
                            ((failed++))
                        fi
                    fi
                done

                echo ""
                if [ $migrated -gt 0 ]; then
                    success "Migrated $migrated session(s) to v2 format"
                fi
                if [ $failed -gt 0 ]; then
                    error "Failed to migrate $failed session(s)"
                fi
                if [ $migrated -eq 0 ] && [ $failed -eq 0 ]; then
                    dim "No v1 sessions found to migrate"
                fi
                sleep 2
                ;;
            *"Clear configuration"*)
                if gum confirm "Clear all configuration?"; then
                    MODEL="$DEFAULT_MODEL"
                    DASHBOARD_AUTO_START="$DEFAULT_DASHBOARD_AUTO_START"
                    DEFAULT_PROJECT=""
                    rm -f "$CONFIG_FILE"
                    success "Configuration cleared"
                    sleep 1
                fi
                ;;
            *"View config"*)
                if [ -f "$CONFIG_FILE" ]; then
                    gum pager < "$CONFIG_FILE"
                else
                    dim "No config file exists yet"
                    sleep 1
                fi
                ;;
            *"Back"*|"")
                return 0
                ;;
        esac
    done
}

