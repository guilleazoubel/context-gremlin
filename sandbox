        if [ -n "$mode" ]; then
            echo "$mode"
            return
        fi
    fi

    # V1: Check session name prefix
    if [[ "$session_name" == dev-* ]]; then
        echo "development"
        return
    fi

    # V1: Check CLAUDE.md content
    if [ -f "$claude_file" ]; then
        if grep -q "REVIEW.md" "$claude_file" 2>/dev/null; then
            echo "review"
        elif grep -q "FINDINGS.md" "$claude_file" 2>/dev/null; then
            echo "investigation"
        elif grep -q "DEVLOG.md" "$claude_file" 2>/dev/null; then
            echo "development"
        else
            echo "unknown"
        fi
    else
        echo "unknown"
    fi
}

