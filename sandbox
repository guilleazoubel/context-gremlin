        --height=~35% \
        --layout=reverse \
        --border=rounded \
        --no-info \
        --prompt="" \
        --header="Select project" \
        --header-first)

    case "$input_method" in
        *"Use default"*)
            REPO_URL="$DEFAULT_PROJECT"
            ;;
        *"Browse"*)
            REPO_URL=$(select_repo "New Development Session")
            [ -z "$REPO_URL" ] && return 1
            ;;
