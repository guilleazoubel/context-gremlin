        .filter-input { width: 100%; padding: 0.5rem; background: #1a1a1a; border: 1px solid #333; border-radius: 6px; color: #e0e0e0; margin-top: 0.5rem; }
        .filter-input:focus { outline: none; border-color: #00ff88; }
        .session-title { font-weight: 500; font-size: 0.85rem; margin-bottom: 0.25rem; }
        .session-folder { font-size: 0.7rem; color: #555; word-break: break-all; }
        .session-details { background: #0f0f0f; border-bottom: 1px solid #333; padding: 0.75rem 1.5rem; display: none; }
        .session-details.visible { display: block; }
        .session-details-title { font-size: 1rem; font-weight: 600; color: #fff; margin-bottom: 0.5rem; }
        .session-details-links { display: flex; flex-wrap: wrap; gap: 0.75rem; }
        .session-details-links a { font-size: 0.8rem; color: #4dabf7; text-decoration: none; display: flex; align-items: center; gap: 0.3rem; padding: 0.25rem 0.5rem; background: #1a1a1a; border-radius: 4px; border: 1px solid #333; }
        .session-details-links a:hover { border-color: #4dabf7; background: #1a2a3a; }
        .session-details-info { margin-top: 0.5rem; font-size: 0.75rem; color: #666; display: flex; gap: 1rem; flex-wrap: wrap; }
        .session-details-info span { display: flex; align-items: center; gap: 0.3rem; }
        .session-details-header { display: flex; justify-content: space-between; align-items: flex-start; }
        .session-details-actions { display: flex; gap: 0.5rem; }
        .session-details-actions button { font-size: 0.75rem; padding: 0.3rem 0.6rem; border-radius: 4px; cursor: pointer; border: 1px solid #333; display: flex; align-items: center; gap: 0.3rem; }
        .btn-archive { background: #2a2a1a; color: #ffd43b; }
        .btn-archive:hover { background: #3a3a2a; border-color: #ffd43b; }
        .btn-delete { background: #2a1a1a; color: #ff6b6b; }
        .btn-delete:hover { background: #3a2a2a; border-color: #ff6b6b; }
        .btn-archive:disabled, .btn-delete:disabled { opacity: 0.5; cursor: not-allowed; }
        .version-select { background: #222; color: #e0e0e0; border: 1px solid #444; border-radius: 6px; padding: 0.4rem 0.6rem; font-size: 0.85rem; cursor: pointer; margin-left: 0.5rem; }
        .version-select:hover { border-color: #666; }
        .rereview-badge { background: #3a2a1a; color: #ffa500; padding: 0.3rem 0.6rem; border-radius: 4px; font-size: 0.75rem; margin-right: 1rem; }
        .btn-post-pr { background: #1a2a3a; color: #4dabf7; border: 1px solid #4dabf7; padding: 0.25rem 0.5rem; border-radius: 4px; cursor: pointer; font-size: 0.7rem; margin-left: 0.5rem; transition: all 0.2s; }
        .btn-post-pr:hover { background: #2a3a4a; }
        .btn-post-pr:disabled { opacity: 0.5; cursor: not-allowed; }
        .btn-post-pr.posted { background: #1a3a1a; color: #00ff88; border-color: #00ff88; }
        .btn-post-pr.error { background: #3a1a1a; color: #ff6b6b; border-color: #ff6b6b; }
        .finding-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; }
        .finding-actions { display: flex; gap: 0.25rem; align-items: center; }
        .toast { position: fixed; bottom: 2rem; right: 2rem; padding: 1rem 1.5rem; border-radius: 8px; z-index: 1000; animation: slideIn 0.3s ease; }
        .toast.success { background: #1a3a1a; color: #00ff88; border: 1px solid #00ff88; }
        .toast.error { background: #3a1a1a; color: #ff6b6b; border: 1px solid #ff6b6b; }
        .toast.info { background: #1a2a3a; color: #6bc5ff; border: 1px solid #6bc5ff; }
        @keyframes slideIn { from { transform: translateY(100%); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        /* Floating Action Button Menu */
        .fab-menu { position: fixed; bottom: 2rem; right: 2rem; z-index: 100; }
        .fab-trigger {
            width: 56px; height: 56px; border-radius: 50%;
            background: linear-gradient(135deg, #00ff88, #00cc6a);
            border: none; font-size: 1.5rem; cursor: pointer;
            box-shadow: 0 4px 12px rgba(0,255,136,0.3);
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .fab-trigger:hover { transform: scale(1.1); box-shadow: 0 6px 16px rgba(0,255,136,0.4); }
        .fab-trigger.open { transform: rotate(45deg); }
        .fab-actions {
            display: none; flex-direction: column; gap: 0.5rem;
            margin-bottom: 1rem; align-items: flex-end;
        }
        .fab-actions.open { display: flex; animation: fadeInUp 0.2s ease; }
        .fab-action {
            display: flex; align-items: center; gap: 0.5rem;
            background: #1a1a1a; border: 1px solid #333; border-radius: 24px;
            padding: 0.5rem 1rem; color: #fff; cursor: pointer;
            transition: all 0.2s; white-space: nowrap;
        }
        .fab-action:hover { background: #2a2a2a; border-color: #00ff88; }
        .fab-action:disabled { opacity: 0.4; cursor: not-allowed; }
        .fab-icon { font-size: 1rem; }
        .fab-label { font-size: 0.85rem; }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        /* Modal styles */
        .modal { position: fixed; inset: 0; background: rgba(0,0,0,0.8); display: flex; align-items: center; justify-content: center; z-index: 200; }
        .modal-content { background: #1a1a1a; border: 1px solid #333; border-radius: 12px; padding: 1.5rem; max-width: 450px; width: 90%; }
        .modal-content h3 { margin-bottom: 1rem; color: #fff; }
        .modal-content label { display: block; margin: 0.75rem 0 0.25rem; color: #888; font-size: 0.85rem; }
        .modal-content input[type="text"] { width: 100%; padding: 0.5rem; background: #222; border: 1px solid #444; border-radius: 6px; color: #e0e0e0; }
        .modal-content input[type="text"]:focus { outline: none; border-color: #00ff88; }
        .modal-actions { display: flex; gap: 0.5rem; justify-content: flex-end; margin-top: 1.5rem; }
        .modal-actions button { padding: 0.5rem 1rem; border-radius: 6px; cursor: pointer; border: 1px solid #444; background: #222; color: #e0e0e0; }
        .modal-actions button:hover { border-color: #666; }
        .modal-actions button.primary { background: #00ff88; color: #000; border-color: #00ff88; }
        .modal-actions button.primary:hover { background: #00cc6a; }
        .mode-options { display: flex; gap: 0.5rem; margin: 1rem 0; flex-wrap: wrap; }
        .mode-btn { padding: 0.5rem 1rem; border-radius: 6px; cursor: pointer; border: 1px solid #444; background: #222; color: #e0e0e0; transition: all 0.2s; }
        .mode-btn:hover { border-color: #666; }
        .mode-btn.active, .mode-btn.selected { background: #00ff88; color: #000; border-color: #00ff88; }
        .mode-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-header">
            <h1>🧪 Sandbox</h1>
            <input type="text" class="filter-input" placeholder="Filter sessions..." id="filter">
        </div>
        <div class="session-list" id="sessions"></div>
    </div>
    <div class="main">
        <div class="session-details" id="sessionDetails">
            <div class="session-details-header">
                <div class="session-details-title" id="sessionTitle">Session</div>
                <div class="session-details-actions">
                    <button class="btn-focus" id="btnStart" onclick="startClaude()">▶️ Start Claude</button>
                    <button class="btn-focus" id="btnFocus" onclick="focusTerminal()">🎯 Focus Terminal</button>
                    <button class="btn-focus" id="btnRefreshDiscussion" onclick="refreshDiscussion()" style="display:none;">💬 Refresh Discussion</button>
                    <button class="btn-archive" id="btnArchive" onclick="archiveSession()">📦 Archive</button>
                    <button class="btn-delete" id="btnDelete" onclick="deleteSession()">🗑️ Delete</button>
                </div>
            </div>
            <div class="session-details-links" id="sessionLinks"></div>
            <div class="session-details-info" id="sessionInfo"></div>
        </div>
        <div class="main-header">
            <div class="tabs">
                <button class="tab active" data-type="review" onclick="switchTab('review')">📝 Review</button>
                <button class="tab" data-type="findings" onclick="switchTab('findings')">🔬 Findings</button>
                <button class="tab" data-type="devlog" onclick="switchTab('devlog')">📓 Devlog</button>
                <button class="tab" data-type="terminal" onclick="switchTab('terminal')">💻 Terminal</button>
                <select class="version-select" id="versionSelect" onchange="switchVersion(this.value)" style="display:none;">
                    <option value="current">Current</option>
                </select>
            </div>
            <div class="status">
                <span id="rereviewBadge" class="rereview-badge" style="display:none;">🔄 Re-review pending</span>
                <div class="live-dot"></div>
                <span id="status">Auto-refresh active</span>
            </div>
        </div>
        <div class="content" id="content">
            <div class="empty">
                <h2>Select a session</h2>
                <p>Choose a session from the sidebar to view its content</p>
            </div>
        </div>
    </div>
    <!-- Floating Action Menu -->
    <div id="fabMenu" class="fab-menu">
        <div class="fab-actions" id="fabActions">
            <button class="fab-action" onclick="runApplication()" data-requires="repo">
                <span class="fab-icon">▶️</span>
                <span class="fab-label">Run App</span>
            </button>
            <button class="fab-action" onclick="fixAllFindings()" data-requires="review">
                <span class="fab-icon">🔧</span>
                <span class="fab-label">Fix All</span>
            </button>
            <button class="fab-action" onclick="importPRComments()" data-requires="pr">
                <span class="fab-icon">📥</span>
                <span class="fab-label">Import Comments</span>
            </button>
            <button class="fab-action" onclick="showRefreshPRModal()" data-requires="pr">
                <span class="fab-icon">🔄</span>
                <span class="fab-label">Refresh PR</span>
            </button>
            <button class="fab-action" onclick="showSwitchModeModal()">
                <span class="fab-icon">🔀</span>
                <span class="fab-label">Switch Mode</span>
            </button>
            <button class="fab-action" onclick="commitChanges()" data-requires="repo">
                <span class="fab-icon">💾</span>
                <span class="fab-label">Commit</span>
            </button>
            <button class="fab-action" onclick="showNewSessionModal()">
                <span class="fab-icon">➕</span>
                <span class="fab-label">New Session</span>
            </button>
        </div>
        <button class="fab-trigger" onclick="toggleFAB()">
            <span id="fabIcon">⚡</span>
        </button>
    </div>
    <script>
        let sessions = [];
        let currentSession = null;
        let currentTab = 'review';
        let lastContent = '';
        let lastSessionsJson = '';

        async function loadSessions() {
            try {
                const res = await fetch('/api/sessions');
                const newSessions = await res.json();
                const newJson = JSON.stringify(newSessions);
                // Only re-render if data changed
                if (newJson !== lastSessionsJson) {
                    lastSessionsJson = newJson;
                    sessions = newSessions;
                    renderSessions();
                }
            } catch (e) {
                console.error('Failed to load sessions', e);
            }
        }

        function renderSessions() {
            const filter = document.getElementById('filter').value.toLowerCase();
            const filtered = sessions.filter(s => {
                // Search in all string fields
                return Object.values(s).some(v =>
                    typeof v === 'string' && v.toLowerCase().includes(filter)
                );
            });

            document.getElementById('sessions').innerHTML = filtered.map(s => `
                <div class="session-item ${currentSession === s.name ? 'active' : ''}" onclick="selectSession('${s.name}')">
                    <div class="session-title">${escapeHtml(s.display_title || s.name)}</div>
                    <div class="session-folder">${s.name}</div>
                    <div class="session-meta">
                        ${s.has_terminal ? '<span class="badge-terminal">● Active</span>' : ''}
                        ${s.mode || s.session_type ? '<span style="color:#a78bfa;">' + (s.mode || s.session_type) + '</span>' : ''}
                        ${s.has_review ? '<span class="badge-review">Review</span>' : ''}
                        ${s.has_findings ? '<span class="badge-findings">Findings</span>' : ''}
                        ${s.has_devlog ? '<span class="badge-devlog">Devlog</span>' : ''}
                        ${s.archived ? '<span class="badge-archived">Archived</span>' : ''}
                    </div>
                </div>
            `).join('');
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Convert GitHub-style emoji codes to actual emojis
        function convertEmojis(text) {
            const emojiMap = {
                ':white_check_mark:': '✅',
                ':heavy_check_mark:': '✅',
                ':x:': '❌',
                ':warning:': '⚠️',
                ':red_circle:': '🔴',
                ':orange_circle:': '🟠',
                ':yellow_circle:': '🟡',
                ':green_circle:': '🟢',
                ':blue_circle:': '🔵',
                ':bulb:': '💡',
                ':memo:': '📝',
                ':rocket:': '🚀',
                ':bug:': '🐛',
                ':lock:': '🔒',
                ':zap:': '⚡',
                ':recycle:': '♻️',
                ':fire:': '🔥',
                ':star:': '⭐',
                ':thumbsup:': '👍',
                ':thumbsdown:': '👎',
                ':question:': '❓',
                ':exclamation:': '❗',
                ':pushpin:': '📍',
                ':chart_with_upwards_trend:': '📈',
                ':package:': '📦',
                ':gear:': '⚙️',
                ':wrench:': '🔧',
                ':hammer:': '🔨',
                ':eyes:': '👀',
                ':thought_balloon:': '💭',
                ':speech_balloon:': '💬',
                ':mag:': '🔍',
                ':link:': '🔗',
                ':arrow_right:': '→',
                ':arrow_left:': '←',
                ':heavy_minus_sign:': '➖',
                ':heavy_plus_sign:': '➕'
            };
            let result = text;
            for (const [code, emoji] of Object.entries(emojiMap)) {
                result = result.split(code).join(emoji);
            }
            return result;
        }

        async function selectSession(name) {
            currentSession = name;
            const session = sessions.find(s => s.name === name);

            // Set default tab based on session type and available content
            let defaultTab = 'review';
            if (session) {
                // For development sessions, prefer devlog
                if (session.session_type === 'development' && session.has_devlog) {
                    defaultTab = 'devlog';
                } else if (session.has_review) {
                    defaultTab = 'review';
                } else if (session.has_findings) {
                    defaultTab = 'findings';
                } else if (session.has_devlog) {
                    defaultTab = 'devlog';
                }
            }
            currentTab = defaultTab;

            // Update tab UI to match
            document.querySelectorAll('.tab').forEach(function(t) {
                t.classList.remove('active');
            });
            var activeTab = document.querySelector('[data-type="' + currentTab + '"]');
            if (activeTab) activeTab.classList.add('active');

            renderSessions();
            renderSessionDetails();
            await loadContent();
            updateTabs();
        }

        function renderSessionDetails() {
            const session = sessions.find(s => s.name === currentSession);
            const detailsEl = document.getElementById('sessionDetails');

            if (!session) {
                detailsEl.classList.remove('visible');
                return;
            }

            detailsEl.classList.add('visible');
            document.getElementById('sessionTitle').textContent = session.display_title || session.name;

            // Build links
            const links = [];

            // Determine repo URL - could be in url field or constructed from repository field
            let repoUrl = session.url || '';
            if (!repoUrl && session.repository) {
                const repo = session.repository;
                if (repo.includes('github.com')) {
                    repoUrl = repo;
                } else if (repo.includes('/')) {
                    repoUrl = `https://github.com/${repo}`;
                }
            }
            // Clean repo URL - remove /pull/xxx if present (we'll add it separately for PR link)
            const repoBaseUrl = repoUrl.replace(/\\/pull\\/\\d+.*$/, '');

            // PR link
            if (session.pr && session.pr.match(/^\\d+$/) && repoBaseUrl) {
                links.push(`<a href="${repoBaseUrl}/pull/${session.pr}" target="_blank">🔗 PR #${session.pr}</a>`);
            } else if (session.pr && session.pr.includes('http')) {
                links.push(`<a href="${session.pr}" target="_blank">🔗 Pull Request</a>`);
            }

            // Repository link
            if (repoBaseUrl && repoBaseUrl.includes('http')) {
                links.push(`<a href="${repoBaseUrl}" target="_blank">📂 Repository</a>`);
            }

            // Jira link
            if (session.jira) {
                const jiraUrl = `https://aplaceformom.atlassian.net/browse/${session.jira}`;
                links.push(`<a href="${jiraUrl}" target="_blank">🎫 ${session.jira}</a>`);
            }

            // Preview environment link (only for grace-frontend repo)
            if (session.branch && repoBaseUrl.includes('grace-frontend')) {
                // Branch field might be "feature/branch → main", extract just the head branch
                // Remove everything after arrow or " main"/" master" suffix
                var headBranch = session.branch
                    .replace(/\\s*\\u2192\\s*.*/g, '')  // Unicode arrow →
                    .replace(/\\s*->\\s*.*/g, '')       // ASCII arrow ->
                    .replace(/\\s+(main|master)$/i, '') // trailing main/master
                    .trim();
                // Convert branch to URL slug: feature/HB-404-name -> feature-hb-404-name
                var branchSlug = headBranch.replace(/\\//g, '-').toLowerCase();
                var previewUrl = 'https://grace-frontend-dev-git-' + branchSlug + '.preview.findcare.dev.aplaceformom.com/';
                links.push('<a href="' + previewUrl + '" target="_blank">🌐 Preview</a>');
            }

            document.getElementById('sessionLinks').innerHTML = links.join('');

            // Build info
            const infos = [];
            const author = session.author || session.creator;
            if (author) {
                infos.push(`<span>👤 ${escapeHtml(author)}</span>`);
            }
            if (session.branch) {
                infos.push(`<span>🌿 ${escapeHtml(session.branch)}</span>`);
            }
            if (session.type) {
                infos.push(`<span>📋 ${escapeHtml(session.type)}</span>`);
            }
            if (session.created) {
                infos.push(`<span>📅 ${escapeHtml(session.created)}</span>`);
            }

            document.getElementById('sessionInfo').innerHTML = infos.join('');

            // Update action buttons
            const archiveBtn = document.getElementById('btnArchive');
            archiveBtn.disabled = session.archived;
            archiveBtn.innerHTML = session.archived ? '📦 Archived' : '📦 Archive';

            // Show/hide Refresh Discussion button (only for PR sessions)
            const refreshDiscBtn = document.getElementById('btnRefreshDiscussion');
            if (session.pr && !session.archived) {
                refreshDiscBtn.style.display = 'inline-flex';
            } else {
                refreshDiscBtn.style.display = 'none';
            }
        }

        let currentVersion = 'current';

        function updateTabs() {
            const session = sessions.find(s => s.name === currentSession);
            if (session) {
                document.querySelector('[data-type="review"]').classList.toggle('disabled', !session.has_review);
                document.querySelector('[data-type="findings"]').classList.toggle('disabled', !session.has_findings);
                document.querySelector('[data-type="devlog"]').classList.toggle('disabled', !session.has_devlog);
                document.querySelector('[data-type="terminal"]').classList.toggle('disabled', !session.has_terminal);

                // Update version selector
                const versionSelect = document.getElementById('versionSelect');
                const versions = session.review_versions || [];
                if (versions.length > 0) {
                    versionSelect.innerHTML = '<option value="current">Current</option>' +
                        versions.map(v => '<option value="' + v + '">' + v.toUpperCase() + ' (archived)</option>').join('');
                    versionSelect.style.display = 'inline-block';
                    versionSelect.value = currentVersion;
                } else {
                    versionSelect.style.display = 'none';
                }

                // Show re-review badge if pending
                const rereviewBadge = document.getElementById('rereviewBadge');
                rereviewBadge.style.display = session.has_rereview ? 'inline-block' : 'none';

                // Update focus button visibility
                const focusBtn = document.getElementById('btnFocus');
                focusBtn.style.display = session.has_terminal ? 'inline-flex' : 'none';
            }
        }

        function switchTab(type) {
            currentTab = type;
            currentVersion = 'current';
            document.getElementById('versionSelect').value = 'current';
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            document.querySelector(`[data-type="${type}"]`).classList.add('active');
            loadContent();
        }

        function switchVersion(version) {
            currentVersion = version;
            loadContent();
        }

        async function loadContent() {
            if (!currentSession) return;
            try {
                // Terminal tab has special handling
                if (currentTab === 'terminal') {
                    const res = await fetch('/api/terminal?session=' + encodeURIComponent(currentSession) + '&lines=200');
                    const text = await res.text();
                    if (text !== lastContent) {
                        lastContent = text;
                        if (text.trim()) {
                            document.getElementById('content').innerHTML =
                                '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">' +
                                '<h2 style="margin:0;border:none;padding:0;">Terminal Output</h2>' +
                                '<button onclick="focusTerminal()" style="background:#1a2a1a;color:#00ff88;border:1px solid #333;padding:0.5rem 1rem;border-radius:6px;cursor:pointer;">🎯 Focus Terminal</button>' +
                                '</div>' +
                                '<div class="terminal-output">' + escapeHtml(text) + '</div>';
                        } else {
                            document.getElementById('content').innerHTML = '<div class="empty"><h2>No terminal output</h2><p>Start a Claude session with logging to see output here</p></div>';
                        }
                    }
                    document.getElementById('status').textContent = 'Updated ' + new Date().toLocaleTimeString();
                    return;
                }

                var url = '/api/content?session=' + encodeURIComponent(currentSession) + '&type=' + currentTab;
                if (currentVersion !== 'current') {
                    url += '&version=' + encodeURIComponent(currentVersion);
                }
                const res = await fetch(url);
                const text = await res.text();
                if (text !== lastContent) {
                    lastContent = text;
                    if (text.trim()) {
                        var header = '';
                        if (currentVersion !== 'current') {
                            header = '<div style="background:#3a2a1a;color:#ffa500;padding:0.5rem 1rem;border-radius:6px;margin-bottom:1rem;">📦 Viewing archived version: ' + currentVersion.toUpperCase() + '</div>';
                        }
                        const convertedText = convertEmojis(text);
                        document.getElementById('content').innerHTML = header + marked.parse(convertedText);
                        // Add PR comment buttons to findings (only for review tab and PR sessions)
                        if (currentTab === 'review') {
                            addPRCommentButtons(convertedText);
                        }
                    } else {
                        document.getElementById('content').innerHTML = '<div class="empty"><h2>No content yet</h2><p>Waiting for ' + currentTab + ' to be written...</p></div>';
                    }
                    document.getElementById('status').textContent = 'Updated ' + new Date().toLocaleTimeString();
                }
            } catch (e) {
                console.error('Failed to load content', e);
            }
        }

        document.getElementById('filter').addEventListener('input', renderSessions);

        async function archiveSession() {
            if (!currentSession) return;
            const session = sessions.find(s => s.name === currentSession);
            if (!session || session.archived) return;

            if (!confirm(`Archive session "${session.display_title || currentSession}"?\\n\\nThis will delete the cloned repo but keep the review/findings files.`)) return;

            document.getElementById('btnArchive').disabled = true;
            try {
                const res = await fetch('/api/archive', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ session: currentSession })
                });
                if (res.ok) {
                    await loadSessions();
