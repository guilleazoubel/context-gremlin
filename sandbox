    cat > "$watcher_script" << 'WATCHER'
#!/bin/bash
SESSION_DIR="$1"
HTML_FILE="$2"
REVIEW_FILE="$SESSION_DIR/REVIEW.md"
LAST_MOD=""

while true; do
    if [ -f "$REVIEW_FILE" ]; then
        CURRENT_MOD=$(stat -f %m "$REVIEW_FILE" 2>/dev/null || stat -c %Y "$REVIEW_FILE" 2>/dev/null)
        if [ "$CURRENT_MOD" != "$LAST_MOD" ]; then
            LAST_MOD="$CURRENT_MOD"
            # Update the HTML with new content
            CONTENT=$(cat "$REVIEW_FILE" | sed 's/\\/\\\\/g' | sed 's/`/\\`/g' | sed "s/'/\\'/g" | sed 's/\$/\\$/g')
            # Write to a temp file that the browser can poll
            echo "$CONTENT" > "/tmp/review_content_$$.txt"
        fi
    fi
    sleep 1
done
WATCHER
    chmod +x "$watcher_script"

    # Run watcher in background
    bash "$watcher_script" "$SESSION_DIR" "$HTML_FILE" &
    echo $!
}

