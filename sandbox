cleanup_sessions() {
    header
    gum style --foreground 196 --bold "Cleanup Sessions"
    echo ""

    local sessions=$(get_sessions)

    if [ -z "$sessions" ]; then
        dim "No sessions to clean up"
        sleep 2
        return 0
    fi

    # Display all sessions
    display_sessions

    # Build options for multi-select
    local session_array=()
    local options=()
    while IFS= read -r session; do
        [ -z "$session" ] && continue
        session_array+=("$session")
        local name=$(basename "$session")
        local info_file="$session/session-info.txt"

        if [ -f "$info_file" ]; then
            if [[ "$name" == pr-* ]]; then
                local title=$(grep "^PR #" "$info_file" 2>/dev/null | head -1)
                options+=("$title")
            else
                local title=$(sed -n '/Investigation Focus:/,/====/p' "$info_file" 2>/dev/null | grep -v "Investigation Focus:" | grep -v "===" | grep -v "^-" | head -1 | xargs)
                options+=("${title:0:50}")
            fi
        else
            options+=("$name")
        fi
    done <<< "$sessions"

    echo ""
    dim "Press TAB to select, Enter to confirm, ESC to cancel"
    echo ""
    local selected=$(printf '%s\n' "${options[@]}" | fzf \
        --multi \
        --height=~50% \
        --layout=reverse \
        --border=rounded \
        --no-info \
        --prompt="" \
        --header="Select sessions to delete (TAB to select)" \
        --header-first)

    if [ -z "$selected" ]; then
        return 0
    fi

    # Find and delete matching sessions
    local to_delete=()
    while IFS= read -r sel; do
        [ -z "$sel" ] && continue
        for i in "${!options[@]}"; do
            if [ "${options[$i]}" = "$sel" ]; then
                to_delete+=("${session_array[$i]}")
                break
            fi
        done
    done <<< "$selected"

    if [ ${#to_delete[@]} -eq 0 ]; then
        return 0
    fi

    echo ""
    gum style --foreground 196 "Will delete ${#to_delete[@]} session(s)"
    echo ""

    if gum confirm --default=false "Delete these sessions?"; then
        for session in "${to_delete[@]}"; do
            rm -rf "$session"
            success "Deleted: $(basename "$session")"
        done
        sleep 1
    fi
}

# ============================================================================
# LIST / RESUME
# ============================================================================

list_sessions_menu() {
    header

    local sessions=$(get_sessions)

    if [ -z "$sessions" ]; then
        dim "No sessions found"
        sleep 2
        return 0
    fi

    local session=$(select_session_simple)

    if [ -n "$session" ] && [ -d "$session" ]; then
        # Check if archived
        local archived=$(is_archived "$session" && echo "yes" || echo "no")

        # Find review/findings files (prefer session root, fallback to repo for old sessions)
        local review_file=""
        local findings_file=""
        [ -f "$session/REVIEW.md" ] && [ -s "$session/REVIEW.md" ] && review_file="$session/REVIEW.md"
        [ -f "$session/FINDINGS.md" ] && [ -s "$session/FINDINGS.md" ] && findings_file="$session/FINDINGS.md"

        # Get PR URL for PR-specific options
        local PR_URL=""
        if [ -f "$session/session-info.txt" ]; then
            PR_URL=$(grep "^URL:" "$session/session-info.txt" 2>/dev/null | head -1 | cut -d: -f2- | xargs)
        fi

        local options=()

        if [ "$archived" = "yes" ]; then
            options+=("🔄 Restart session (re-clone repo)")
        else
            options+=("▶ Resume session")
            options+=("💻 Open in editor")
            options+=("📊 View diff")
        fi

        if [ -n "$PR_URL" ]; then
            options+=("🌐 Open PR in browser")
            [ "$archived" != "yes" ] && options+=("🔄 Refresh PR (fetch updates)")
        fi

        if [ -n "$review_file" ]; then
            options+=("📖 View review (nice)")
        fi

        options+=("ℹ View session info")
        options+=("🗑 Delete session")
        options+=("← Back")

        local header_text="Active Session"
        [ "$archived" = "yes" ] && header_text="📦 Archived Session"
        local choice=$(printf '%s\n' "${options[@]}" | fzf \
            --height=~50% \
            --layout=reverse \
            --border=rounded \
            --no-info \
            --prompt="" \
            --header="$header_text" \
            --header-first)

        case "$choice" in
            *"Restart"*)
                if restart_session "$session"; then
                    pre_session_menu "$session"
                fi
                ;;
            *"Resume"*)
                tput reset 2>/dev/null || clear
                pre_session_menu "$session"
                ;;
            *"editor"*)
                open_in_editor "$session/repo"
                ;;
            *"View diff"*)
                view_diff "$session"
                ;;
            *"Open PR in browser"*)
                if [ -n "$PR_URL" ]; then
                    open "${PR_URL}/files" 2>/dev/null || xdg-open "${PR_URL}/files" 2>/dev/null || true
                fi
                ;;
            *"Refresh PR"*)
                refresh_pr_session "$session"
                ;;
            *"View review"*)
                if [ -n "$review_file" ]; then
                    view_markdown_nice "$review_file"
                fi
                ;;
            *"session info"*)
                if [ -f "$session/session-info.txt" ]; then
                    gum pager < "$session/session-info.txt"
                fi
                ;;
            *"Delete"*)
                if gum confirm --default=false "Delete this session?"; then
                    rm -rf "$session"
                    success "Session deleted"
                    sleep 1
                fi
                ;;
        esac
    fi
}

