        }
        if (hasPR && hasRepo) {
            html += '<span class="ab-divider"></span>';
            html += '<button class="btn-action" onclick="importPRComments()">📥 Import PR Comments</button>';
            html += '<button class="btn-action" onclick="showRefreshPRModal()">🔄 Refresh PR</button>';
        }
