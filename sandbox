# Generate branch name from Jira ticket
# e.g., "HB-500" with summary "Implement new feature" -> "feature/HB-500-implement-new-feature"
generate_branch_from_jira() {
    local ticket_id="$1"
    local summary="$2"
    local ticket_type="${3:-Story}"

    # Determine branch prefix based on ticket type
    local prefix="feature"
    case "$ticket_type" in
        "Bug"|"bug") prefix="bugfix" ;;
        "Hotfix"|"hotfix") prefix="hotfix" ;;
        "Task"|"task") prefix="task" ;;
        "Spike"|"spike") prefix="spike" ;;
        *) prefix="feature" ;;
    esac

    # Create slug from summary
    local slug=$(echo "$summary" | \
        tr '[:upper:]' '[:lower:]' | \
        sed 's/[^a-z0-9 ]//g' | \
        tr ' ' '-' | \
        sed 's/--*/-/g' | \
        sed 's/^-//' | \
        sed 's/-$//' | \
        cut -c1-40)

    # Construct branch name
    echo "${prefix}/${ticket_id}-${slug}"
}

