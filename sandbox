launch_live_dashboard() {
    if is_dashboard_running; then
        local action=$(printf '%s\n' \
            "🌐 Open in browser" \
            "🔄 Restart server (reload code changes)" \
            "🛑 Stop server" \
            "← Back" | fzf \
            --height=~30% \
            --layout=reverse \
            --border=rounded \
            --no-info \
            --prompt="" \
            --header="Dashboard is running at http://127.0.0.1:$DASHBOARD_PORT" \
            --header-first)

        case "$action" in
            *"Open"*)
                open "http://127.0.0.1:$DASHBOARD_PORT" 2>/dev/null || \
                xdg-open "http://127.0.0.1:$DASHBOARD_PORT" 2>/dev/null || \
                gum style --foreground 87 "Open http://127.0.0.1:$DASHBOARD_PORT in your browser"
                sleep 1
                ;;
            *"Restart"*)
                dim "Stopping dashboard..."
                cleanup_dashboard_server
                sleep 0.5
                dim "Starting dashboard..."
                if start_dashboard_server; then
                    success "Dashboard restarted"
                    sleep 0.5
                    open "http://127.0.0.1:$DASHBOARD_PORT" 2>/dev/null
                else
                    error "Failed to restart dashboard"
                fi
                sleep 1
                ;;
            *"Stop"*)
                cleanup_dashboard_server
                success "Dashboard stopped"
                sleep 1
                ;;
        esac
    else
        gum spin --spinner dot --title "Starting dashboard..." -- sleep 0.5
        if start_dashboard_server; then
            success "Dashboard running at http://127.0.0.1:$DASHBOARD_PORT"
            open "http://127.0.0.1:$DASHBOARD_PORT" 2>/dev/null || \
            xdg-open "http://127.0.0.1:$DASHBOARD_PORT" 2>/dev/null || \
            gum style --foreground 87 "Open http://127.0.0.1:$DASHBOARD_PORT in your browser"

            gum style \
                --border rounded \
                --border-foreground 214 \
                --padding "1 2" \
                "Dashboard is running in the background." \
                "Select 'Live Dashboard' again to manage or stop it."
            sleep 2
        else
            error "Failed to start dashboard. Check $SESSIONS_DIR/.dashboard.log for details."
            sleep 2
        fi
    fi
}

