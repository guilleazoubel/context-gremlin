# Display current selection context
show_context() {
    local title="$1"
    shift

    header
    gum style --foreground 212 --bold "$title"
    echo ""

    # Show previous selections if any
    if [ $# -gt 0 ]; then
        local context=""
        while [ $# -gt 0 ]; do
            [ -n "$context" ] && context="$context  →  "
            context="$context$1"
            shift
        done
        gum style --foreground 240 --italic "$context"
        echo ""
    fi
}

select_repo() {
    local DEFAULT_ORG="aplaceformom"
    local title="${1:-Select Repository}"

    # All display output to stderr so it doesn't pollute return value
    show_context "$title" >&2
    dim "Fetching repositories from $DEFAULT_ORG..." >&2

    # Fetch repos from default org
    local repos=$(gh repo list "$DEFAULT_ORG" --limit 100 --json name,description --jq '.[] | "\(.name) ~ \(.description // "No description")"' 2>/dev/null)

    if [ -z "$repos" ]; then
        error "Could not fetch repositories" >&2
        sleep 2
        return 1
    fi

    local repo_count=$(echo "$repos" | wc -l | xargs)

    # Use fzf for fuzzy selection (fzf outputs to stderr by default)
    local selected=$(echo -e "← Back (cancel)\n$repos" | fzf \
        --height=~50% \
        --layout=reverse \
        --border=rounded \
        --prompt="Search: " \
        --header="Select repository ($repo_count available) • ESC to cancel" \
        --header-first \
        --ansi)

    # Handle cancel/back
    if [ -z "$selected" ] || [[ "$selected" == "← Back"* ]]; then
        return 1
    fi

    # Extract just the repo name (before the " ~ ")
    local repo_name=$(echo "$selected" | cut -d'~' -f1 | xargs)
    echo "https://github.com/$DEFAULT_ORG/$repo_name"
    return 0
}

select_pr() {
    local REPO="$1"
    local REPO_DISPLAY="$2"

    # All display output to stderr so it doesn't pollute return value
    show_context "New PR Review" "📁 $REPO_DISPLAY" >&2
    dim "Fetching open PRs..." >&2

    # Fetch open PRs
    local prs=$(gh pr list --repo "$REPO" --state open --limit 50 --json number,title,author --jq '.[] | "#\(.number) \(.title) (@\(.author.login))"' 2>/dev/null)

    if [ -z "$prs" ]; then
        dim "No open PRs found in $REPO" >&2
        sleep 2
        return 1
    fi

    local pr_count=$(echo "$prs" | wc -l | xargs)

    # Use fzf for fuzzy selection (fzf outputs to stderr by default)
    local selected=$(echo -e "← Back (cancel)\n$prs" | fzf \
        --height=~50% \
        --layout=reverse \
        --border=rounded \
        --prompt="Search: " \
        --header="Select PR ($pr_count open) • ESC to cancel" \
        --header-first \
        --ansi)

    # Handle cancel/back
    if [ -z "$selected" ] || [[ "$selected" == "← Back"* ]]; then
        return 1
    fi

    # Extract PR number
    echo "$selected" | sed 's/^#\([0-9]*\).*/\1/'
    return 0
}

create_pr_session() {
    show_context "New PR Review"

    local OWNER=""
    local REPO=""
    local PR_NUMBER=""
    local REPO_URL=""

    # Choose input method
    local input_method=$(gum choose \
        "🔍 Browse open PRs" \
        "🔗 Enter PR URL directly" \
        "← Back")

    case "$input_method" in
        *"Browse"*)
            # First select repo
            REPO_URL=$(select_repo "New PR Review")
            if [ -z "$REPO_URL" ]; then
                return 1
            fi

            # Extract owner/repo
            if [[ "$REPO_URL" =~ github.com/([^/]+)/([^/]+) ]]; then
                OWNER="${BASH_REMATCH[1]}"
                REPO="${BASH_REMATCH[2]}"
                REPO="${REPO%.git}"
            fi

            # Then select PR - pass repo name for context display
            PR_NUMBER=$(select_pr "$OWNER/$REPO" "$REPO")
            if [ -z "$PR_NUMBER" ]; then
                return 1
            fi

            REPO_URL="https://github.com/$OWNER/$REPO.git"
            ;;
        *"Enter PR URL"*)
            printf "PR URL or number: "
            read -r pr_input
            [ -z "$pr_input" ] && return 1

            # Parse PR input
            if [[ "$pr_input" =~ ^https://github.com/([^/]+)/([^/]+)/pull/([0-9]+) ]]; then
                OWNER="${BASH_REMATCH[1]}"
                REPO="${BASH_REMATCH[2]}"
                PR_NUMBER="${BASH_REMATCH[3]}"
                REPO_URL="https://github.com/$OWNER/$REPO.git"
            elif [[ "$pr_input" =~ ^[0-9]+$ ]]; then
                PR_NUMBER="$pr_input"
                printf "Repository (owner/repo): "
                read -r repo_input

                if [[ "$repo_input" =~ github.com/([^/]+)/([^/]+) ]]; then
                    OWNER="${BASH_REMATCH[1]}"
                    REPO="${BASH_REMATCH[2]}"
                    REPO="${REPO%.git}"
                elif [[ "$repo_input" =~ ^([^/]+)/([^/]+)$ ]]; then
                    OWNER="${BASH_REMATCH[1]}"
                    REPO="${BASH_REMATCH[2]}"
                else
                    error "Could not parse repository"
                    sleep 2
                    return 1
                fi
                REPO_URL="https://github.com/$OWNER/$REPO.git"
            else
                error "Invalid PR input"
                sleep 2
                return 1
            fi
            ;;
        *)
            return 1
            ;;
    esac

    echo ""

    # Debug: show what we're fetching
    dim "Fetching PR #$PR_NUMBER from $OWNER/$REPO..."

    # Validate we have required info
    if [ -z "$PR_NUMBER" ] || [ -z "$OWNER" ] || [ -z "$REPO" ]; then
        error "Missing info - PR: '$PR_NUMBER', Owner: '$OWNER', Repo: '$REPO'"
        sleep 2
        return 1
    fi

    # Fetch PR info with spinner
    local PR_INFO
    local pr_error_file=$(mktemp)
    PR_INFO=$(gum spin --spinner dot --title "Fetching PR #$PR_NUMBER..." -- \
        gh pr view "$PR_NUMBER" --repo "$OWNER/$REPO" --json title,body,headRefName,baseRefName,author,additions,deletions,changedFiles,url 2>"$pr_error_file")

    if [ $? -ne 0 ] || [ -z "$PR_INFO" ]; then
        local err_msg=$(cat "$pr_error_file")
        rm -f "$pr_error_file"
        error "Could not fetch PR info: $err_msg"
        sleep 3
        return 1
    fi
    rm -f "$pr_error_file"

    local PR_TITLE=$(echo "$PR_INFO" | jq -r '.title')
    local PR_BODY=$(echo "$PR_INFO" | jq -r '.body // "No description provided"')
    local PR_HEAD=$(echo "$PR_INFO" | jq -r '.headRefName')
    local PR_BASE=$(echo "$PR_INFO" | jq -r '.baseRefName')
    local PR_AUTHOR=$(echo "$PR_INFO" | jq -r '.author.login')
    local PR_ADDITIONS=$(echo "$PR_INFO" | jq -r '.additions')
    local PR_DELETIONS=$(echo "$PR_INFO" | jq -r '.deletions')
    local PR_FILES=$(echo "$PR_INFO" | jq -r '.changedFiles')
    local PR_URL=$(echo "$PR_INFO" | jq -r '.url')

    # Show PR info
    gum style \
        --border rounded \
        --border-foreground 240 \
        --padding "1 2" \
        --margin "1 0" \
        "PR #$PR_NUMBER: $PR_TITLE" \
        "" \
        "$(dim "Author: $PR_AUTHOR")" \
        "$(dim "Branch: $PR_HEAD → $PR_BASE")" \
        "$(dim "Changes: +$PR_ADDITIONS -$PR_DELETIONS in $PR_FILES files")"

    if ! gum confirm "Create session for this PR?"; then
        return 1
    fi

    local SESSION_NAME="pr-${REPO}-${PR_NUMBER}-$(date +%Y%m%d-%H%M%S)"
    local SESSION_DIR="$SESSIONS_DIR/$SESSION_NAME"

    mkdir -p "$SESSION_DIR"
    cd "$SESSION_DIR"

    # Clone with spinner
    if ! gum spin --spinner dot --title "Cloning repository..." -- \
        git clone --depth=50 "$REPO_URL" repo 2>&1; then
        error "Failed to clone repository"
        rm -rf "$SESSION_DIR"
        sleep 2
        return 1
    fi

    if [ ! -d "repo" ]; then
        error "Clone failed - repo directory not created"
        rm -rf "$SESSION_DIR"
        sleep 2
        return 1
    fi

    cd repo
    if ! gum spin --spinner dot --title "Checking out PR branch..." -- \
        bash -c "git fetch origin 'pull/$PR_NUMBER/head:pr-$PR_NUMBER' 2>&1 && git checkout 'pr-$PR_NUMBER' 2>&1"; then
        error "Failed to checkout PR branch"
        rm -rf "$SESSION_DIR"
        sleep 2
        return 1
    fi

    local DIFF_STAT=$(git diff --stat "$PR_BASE"..."pr-$PR_NUMBER" 2>/dev/null || echo "")
    local CHANGED_FILES=$(git diff --name-only "$PR_BASE"..."pr-$PR_NUMBER" 2>/dev/null || echo "")
    local COMMIT_MESSAGES=$(git log --oneline "$PR_BASE"..."pr-$PR_NUMBER" 2>/dev/null || echo "")

    cd "$SESSION_DIR"

    # Create session-info.txt
    cat > session-info.txt << EOF
================================================================================
SESSION INFO
================================================================================
Type:       PR Review
Created:    $(date '+%Y-%m-%d %H:%M:%S')
Session:    $SESSION_NAME

PR #$PR_NUMBER: $PR_TITLE
URL:        $PR_URL
Author:     $PR_AUTHOR
Branch:     $PR_HEAD → $PR_BASE
Stats:      +$PR_ADDITIONS -$PR_DELETIONS in $PR_FILES files

Repository: $OWNER/$REPO

PR Description:
--------------------------------------------------------------------------------
$PR_BODY

Changed Files:
--------------------------------------------------------------------------------
$CHANGED_FILES
================================================================================
EOF

    # Create CLAUDE.md inside repo/ so Claude auto-reads it
    cat > repo/CLAUDE.md << CLAUDE_EOF
