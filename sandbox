run_acr_review() {
    local SESSION_DIR="$1"
    local PR_BASE="${2:-main}"

    if [ "$HAS_ACR" != "true" ]; then
        error "ACR not installed. Install with: brew install richhaase/tap/acr"
        sleep 2
        return 1
    fi

    cd "$SESSION_DIR/repo" || return 1

    header
    gum style --foreground 214 --bold "ACR - Agentic Code Reviewer"
    echo ""

    # ACR configuration
    local reviewers=5
    local agents="claude"
    local timeout="10m"
    local verbose=""

    # Let user configure
    local config_choice=$(gum choose \
        "🚀 Quick review (5 reviewers, claude)" \
        "⚙️  Custom configuration" \
        "← Back")

    case "$config_choice" in
        *"Quick"*)
            # Use defaults
            ;;
        *"Custom"*)
            echo ""
            reviewers=$(gum input --placeholder "Number of reviewers (1-10)" --value "5")
            [[ ! "$reviewers" =~ ^[0-9]+$ ]] && reviewers=5
            [ "$reviewers" -gt 10 ] && reviewers=10
            [ "$reviewers" -lt 1 ] && reviewers=1

            agents=$(gum choose --header "Select agent(s):" \
                "claude" \
                "codex" \
                "gemini" \
                "claude,codex" \
                "claude,gemini" \
                "codex,gemini" \
                "claude,codex,gemini")

            if gum confirm "Enable verbose output?"; then
                verbose="-v"
            fi
            ;;
        *)
            return 1
            ;;
    esac

    echo ""
    gum style --foreground 240 "Running ACR with $reviewers reviewers using $agents..."
    echo ""

    # Run ACR (--local to not post to GitHub, capture output)
    local acr_output="$SESSION_DIR/ACR_REVIEW.md"

    # Create a wrapper to capture output nicely
    {
        echo "# ACR Review Results"
        echo ""
        echo "- **Reviewers**: $reviewers"
        echo "- **Agents**: $agents"
        echo "- **Base**: $PR_BASE"
        echo "- **Date**: $(date '+%Y-%m-%d %H:%M:%S')"
        echo ""
        echo "---"
        echo ""
    } > "$acr_output"

    # Run ACR and capture output
    if acr -r "$reviewers" -a "$agents" -b "$PR_BASE" -t "$timeout" --local $verbose 2>&1 | tee -a "$acr_output"; then
        success "ACR review complete"
    else
        error "ACR review failed or found issues (exit code indicates findings)"
    fi

    echo ""
    echo "---" >> "$acr_output"
    echo "" >> "$acr_output"
    echo "*Generated by ACR (Agentic Code Reviewer)*" >> "$acr_output"

    success "Results saved to ACR_REVIEW.md"
    sleep 1

    # Offer next steps in a loop until user chooses to go back
    while true; do
        local next=$(gum choose \
            "📖 View ACR results" \
            "🤖 Feed results to Claude for deeper analysis" \
            "⚡ Feed results to Codex for deeper analysis" \
            "✅ Done, return to session menu")

        case "$next" in
            *"View ACR"*)
                if command -v glow >/dev/null 2>&1; then
                    glow -p "$acr_output"
                else
                    gum pager < "$acr_output"
                fi
                ;;
            *"Claude"*)
                feed_acr_to_claude "$SESSION_DIR" "$acr_output"
                return 0
                ;;
            *"Codex"*)
                if command -v codex >/dev/null 2>&1; then
                    # Copy ACR results to REVIEW.md as context (in session root)
                    cat > "$SESSION_DIR/REVIEW.md" << ACRCTX
# Code Review

## ACR Pre-Analysis

\`\`\`
$(cat "$acr_output")
\`\`\`

---

## Detailed Analysis

ACRCTX
                    run_codex_review "$SESSION_DIR" "$PR_BASE" "false"
                else
                    error "Codex not installed"
                    sleep 1
                fi
                return 0
                ;;
            *"Done"*|*)
                return 0
                ;;
        esac
    done
}

