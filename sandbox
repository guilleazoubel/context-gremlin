        function switchTab(type) {
            currentFile = type;
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            document.querySelector('.tab[data-file="' + type + '"]').classList.add('active');
            renderContent(lastContent[type], type);
        }

        document.querySelectorAll('.tab').forEach(tab => {
            tab.addEventListener('click', () => switchTab(tab.dataset.file));
        });

        async function fetchAll() {
            await Promise.all([fetchFile('review'), fetchFile('findings')]);
            // Auto-switch to findings tab if review is empty but findings has content
            if (!hasContent.review && hasContent.findings && currentFile === 'review') {
