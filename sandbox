get_sessions() {
    # Support both v1 (pr-*, inv-*, dev-*) and v2 (session-*) naming
    find "$SESSIONS_DIR" -maxdepth 1 -type d \( \
        -name "pr-*" -o -name "inv-*" -o -name "dev-*" -o -name "session-*" \
    \) 2>/dev/null | sort -r
}

format_session_display() {
    local session="$1"
    local name=$(basename "$session")
    local session_json="$session/session.json"
    local info_file="$session/session-info.txt"

    # Check for output files
    local has_output=""
    [ -f "$session/REVIEW.md" ] || [ -f "$session/repo/REVIEW.md" ] && has_output=" 📝"
    [ -f "$session/FINDINGS.md" ] || [ -f "$session/repo/FINDINGS.md" ] && has_output=" 📝"
    [ -f "$session/DEVLOG.md" ] || [ -f "$session/repo/DEVLOG.md" ] && has_output=" 📝"

    # V2 format: session.json
    if [ -f "$session_json" ]; then
        local mode=$(jq -r '.mode // "unknown"' "$session_json")
        local created=$(jq -r '.created // ""' "$session_json" | cut -dT -f1)
        local status=$(jq -r '.status // "active"' "$session_json")
        local archived=""
        [ "$status" = "archived" ] && archived=" 📦"

        case "$mode" in
            review)
                local pr_num=$(jq -r '.pr.number // ""' "$session_json")
                local pr_title=$(jq -r '.pr.title // ""' "$session_json")
                pr_title="${pr_title:0:40}"
                echo "📝 PR #$pr_num: $pr_title$archived$has_output"
                ;;
            development)
                local jira=$(jq -r '.jira.ticket // ""' "$session_json")
                local summary=$(jq -r '.jira.summary // ""' "$session_json")
                summary="${summary:0:40}"
                echo "🛠️  $jira: $summary$archived$has_output"
                ;;
            investigation)
                local focus=$(jq -r '.focus // ""' "$session_json")
                focus="${focus:0:50}"
                echo "🔍 $focus$archived$has_output"
                ;;
            *)
                echo "❓ $name$archived$has_output"
                ;;
        esac
        echo "   $name • $created"

    # V1 format: session-info.txt
    elif [ -f "$info_file" ]; then
        local created=$(grep "^Created:" "$info_file" 2>/dev/null | cut -d: -f2- | xargs)
        local archived=""
        grep -q "^ARCHIVED:" "$info_file" 2>/dev/null && archived=" 📦"

        if [[ "$name" == pr-* ]]; then
            local title=$(grep "^PR #" "$info_file" 2>/dev/null | head -1)
            echo "📝 $title$archived$has_output"
            echo "   $name • $created"
        elif [[ "$name" == dev-* ]]; then
            local jira=$(grep "^Jira:" "$info_file" 2>/dev/null | head -1 | cut -d: -f2 | xargs)
            local summary=$(grep "^Summary:" "$info_file" 2>/dev/null | head -1 | cut -d: -f2- | xargs)
            summary="${summary:0:40}"
            echo "🛠️  $jira: $summary$archived$has_output"
            echo "   $name • $created"
        else
            local title=$(sed -n '/Investigation Focus:/,/====/p' "$info_file" 2>/dev/null | grep -v "Investigation Focus:" | grep -v "===" | grep -v "^-" | head -1 | xargs)
            title="${title:0:50}"
            echo "🔍 $title$archived$has_output"
            echo "   $name • $created"
        fi
    else
        echo "❓ $name"
    fi
    echo ""
}

display_sessions() {
    local sessions=$(get_sessions)

    if [ -z "$sessions" ]; then
        dim "No active sessions"
        return 1
    fi

    while IFS= read -r session; do
        [ -z "$session" ] && continue
        format_session_display "$session"
    done <<< "$sessions"

    return 0
}

select_session_simple() {
    local sessions=$(get_sessions)

    if [ -z "$sessions" ]; then
        return 1
    fi

    # Build array with full formatted display
    local options=("← Back")
    local session_paths=("")

    while IFS= read -r session; do
        [ -z "$session" ] && continue
        session_paths+=("$session")

        local name=$(basename "$session")
        local session_json="$session/session.json"
        local info_file="$session/session-info.txt"
        local display=""

        # Check for output files
        local has_output=""
        [ -f "$session/REVIEW.md" ] || [ -f "$session/repo/REVIEW.md" ] && has_output=" 📝"
        [ -f "$session/FINDINGS.md" ] || [ -f "$session/repo/FINDINGS.md" ] && has_output=" 📝"
        [ -f "$session/DEVLOG.md" ] || [ -f "$session/repo/DEVLOG.md" ] && has_output=" 📝"

        # V2 format: session.json
        if [ -f "$session_json" ]; then
            local mode=$(jq -r '.mode // "unknown"' "$session_json")
            local created=$(jq -r '.created // ""' "$session_json" | cut -dT -f1)
            local status=$(jq -r '.status // "active"' "$session_json")
            local archived=""
            [ "$status" = "archived" ] && archived="📦 "

            case "$mode" in
                review)
                    local pr_num=$(jq -r '.pr.number // ""' "$session_json")
                    local pr_title=$(jq -r '.pr.title // ""' "$session_json")
                    pr_title="${pr_title:0:30}"
                    display="${archived}📝 PR #$pr_num: $pr_title$has_output • $created"
                    ;;
                development)
                    local jira=$(jq -r '.jira.ticket // ""' "$session_json")
                    local summary=$(jq -r '.jira.summary // ""' "$session_json")
                    summary="${summary:0:30}"
                    display="${archived}🛠️  $jira: $summary$has_output • $created"
                    ;;
                investigation)
                    local focus=$(jq -r '.focus // ""' "$session_json")
                    focus="${focus:0:40}"
                    display="${archived}🔍 $focus$has_output • $created"
                    ;;
                *)
                    display="${archived}❓ $name$has_output • $created"
                    ;;
            esac

        # V1 format: session-info.txt
        elif [ -f "$info_file" ]; then
            local archived=""
            grep -q "^ARCHIVED:" "$info_file" 2>/dev/null && archived="📦 "

            local created=$(grep "^Created:" "$info_file" 2>/dev/null | cut -d: -f2- | xargs | cut -d' ' -f1-2)

            if [[ "$name" == pr-* ]]; then
                local title=$(grep "^PR #" "$info_file" 2>/dev/null | head -1)
                display="${archived}📝 ${title}${has_output} • ${created}"
            elif [[ "$name" == dev-* ]]; then
                local jira=$(grep "^Jira:" "$info_file" 2>/dev/null | head -1 | cut -d: -f2 | xargs)
                local summary=$(grep "^Summary:" "$info_file" 2>/dev/null | head -1 | cut -d: -f2- | xargs)
                summary="${summary:0:30}"
                display="${archived}🛠️  ${jira}: ${summary}${has_output} • ${created}"
            else
                local title=$(sed -n '/Investigation Focus:/,/====/p' "$info_file" 2>/dev/null | grep -v "Investigation Focus:" | grep -v "===" | grep -v "^-" | head -1 | xargs)
                title="${title:0:40}"
                display="${archived}🔍 ${title}${has_output} • ${created}"
            fi
        else
            display="❓ $name"
        fi

        options+=("$display")
    done <<< "$sessions"

    # Show selection using fzf
    local selected=$(printf '%s\n' "${options[@]}" | fzf \
        --height=~50% \
        --layout=reverse \
        --border=rounded \
        --prompt="Search: " \
        --header="Select a session • ESC to go back" \
        --header-first)

    # Handle back/cancel
    if [ -z "$selected" ] || [[ "$selected" == "← Back"* ]]; then
        return 1
    fi

    # Find matching session by index
    for i in "${!options[@]}"; do
        if [ "${options[$i]}" = "$selected" ]; then
            echo "${session_paths[$i]}"
            return 0
        fi
    done

    return 1
}

