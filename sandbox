refresh_pr_session() {
    local SESSION_DIR="$1"
    local INFO_FILE="$SESSION_DIR/session-info.txt"

    if ! grep -q "^Type:.*PR" "$INFO_FILE" 2>/dev/null; then
        error "This is not a PR session"
        sleep 2
        return 1
    fi

    local PR_NUMBER=$(grep "^PR #" "$INFO_FILE" 2>/dev/null | head -1 | sed 's/PR #\([0-9]*\).*/\1/')
    local REPO=$(grep "^Repository:" "$INFO_FILE" 2>/dev/null | head -1 | cut -d: -f2 | xargs)
    local PR_BASE=$(grep "^Branch:" "$INFO_FILE" 2>/dev/null | head -1 | sed 's/.*→ //' | xargs)

    if [ -z "$PR_NUMBER" ] || [ -z "$REPO" ]; then
        error "Could not find PR info in session"
        sleep 2
        return 1
    fi

    cd "$SESSION_DIR/repo" || return 1

    # Get current commit before refresh
    local OLD_COMMIT=$(git rev-parse HEAD 2>/dev/null)

    echo ""
    gum spin --spinner dot --title "Fetching latest PR changes..." -- \
        bash -c "git fetch origin 'pull/$PR_NUMBER/head:pr-$PR_NUMBER-new' 2>&1"

    local NEW_COMMIT=$(git rev-parse "pr-$PR_NUMBER-new" 2>/dev/null)

    if [ "$OLD_COMMIT" = "$NEW_COMMIT" ]; then
        success "PR is already up to date (no new commits)"
        sleep 2
        return 0
    fi

    # Show what changed
    local NEW_COMMITS=$(git log --oneline "$OLD_COMMIT".."$NEW_COMMIT" 2>/dev/null)
    local COMMIT_COUNT=$(echo "$NEW_COMMITS" | grep -c . || echo "0")

    echo ""
    gum style --foreground 82 --bold "Found $COMMIT_COUNT new commit(s):"
    echo ""
    echo "$NEW_COMMITS" | head -10
    [ "$COMMIT_COUNT" -gt 10 ] && dim "... and $((COMMIT_COUNT - 10)) more"
    echo ""

    if ! gum confirm "Update to latest and prepare re-review?"; then
        return 0
    fi

    # Checkout new version
    git checkout "pr-$PR_NUMBER-new" 2>/dev/null
    git branch -D "pr-$PR_NUMBER" 2>/dev/null
    git branch -m "pr-$PR_NUMBER" 2>/dev/null

    # Get new diff stats
    local NEW_DIFF_STAT=$(git diff --stat "$PR_BASE"..."pr-$PR_NUMBER" 2>/dev/null || echo "")
    local NEW_CHANGED_FILES=$(git diff --name-only "$PR_BASE"..."pr-$PR_NUMBER" 2>/dev/null || echo "")
    local CHANGES_SINCE=$(git diff --stat "$OLD_COMMIT"..."pr-$PR_NUMBER" 2>/dev/null || echo "")

    # Update session info with refresh timestamp
    echo "" >> "$INFO_FILE"
    echo "REFRESHED: $(date '+%Y-%m-%d %H:%M:%S')" >> "$INFO_FILE"
    echo "Previous commit: $OLD_COMMIT" >> "$INFO_FILE"
    echo "New commit: $NEW_COMMIT" >> "$INFO_FILE"
    echo "New commits: $COMMIT_COUNT" >> "$INFO_FILE"

    # Archive old REVIEW.md if it exists
    local version=1
    while [ -f "$SESSION_DIR/repo/REVIEW-v${version}.md" ] || [ -f "$SESSION_DIR/REVIEW-v${version}.md" ]; do
        ((version++))
    done

    if [ -f "$SESSION_DIR/repo/REVIEW.md" ]; then
        cp "$SESSION_DIR/repo/REVIEW.md" "$SESSION_DIR/repo/REVIEW-v${version}.md"
        success "Archived previous review as REVIEW-v${version}.md"
    fi

    local next_version=$((version + 1))

    # Create RE-REVIEW.md with streamlined instructions
    cat > "$SESSION_DIR/repo/RE-REVIEW.md" << REREVIEW_EOF
# Re-Review: v${next_version}

## What Changed

| Info | Value |
|------|-------|
| **Previous** | v${version} (commit \`${OLD_COMMIT:0:8}\`) |
| **Current** | v${next_version} (commit \`${NEW_COMMIT:0:8}\`) |
| **New Commits** | ${COMMIT_COUNT} |

### New Commits
\`\`\`
$NEW_COMMITS
\`\`\`

### Files Changed Since Last Review
\`\`\`
$CHANGES_SINCE
\`\`\`

---

## Re-Review Instructions

**Update REVIEW.md in-place. Do NOT append sections.**

### 1. Check Each Open Finding
For each finding in "Open Findings":
- **Fixed?** → Move to "Resolved Findings", note the fix
- **Still present?** → Keep in place
- **Partially fixed?** → Update the description

### 2. Update the Tracker Table
\`\`\`markdown
| ID | Finding | Severity | Status | Since |
|----|---------|----------|--------|-------|
| 1 | Null check missing | 🔴 Critical | ✅ Fixed | v1→v${next_version} |
| 2 | SQL injection | 🟠 High | ⚠️ Open | v1 |
| 3 | New issue found | 🟡 Medium | ⚠️ Open | v${next_version} |
\`\`\`

### 3. Check for New Issues
Review the new commits for any NEW problems introduced.
Add new findings with "Since: v${next_version}"

### 4. Update Review History
Add row to the history table:
\`\`\`markdown
| v${next_version} | $(date '+%Y-%m-%d') | ${NEW_COMMIT:0:8} | [X fixed, Y new, Z still open] |
\`\`\`

### 5. Update Verdict
Re-evaluate based on current state of findings.

---

**BEGIN: Read REVIEW.md, check findings against new code, update in-place.**
REREVIEW_EOF

    success "PR refreshed! RE-REVIEW.md created with instructions"
    sleep 1

    # Update CLAUDE.md to reference RE-REVIEW.md
    if [ -f "$SESSION_DIR/repo/CLAUDE.md" ]; then
        # Remove any previous re-review notice
        sed -i '' '/^# ⚠️ RE-REVIEW MODE/,/^---$/d' "$SESSION_DIR/repo/CLAUDE.md" 2>/dev/null || true

        # Prepend new re-review notice
        local temp_file=$(mktemp)
        cat > "$temp_file" << NOTICE_EOF
# ⚠️ RE-REVIEW MODE (v${next_version})

**PR updated: ${COMMIT_COUNT} new commit(s) since last review.**

1. Read \`RE-REVIEW.md\` for what changed
2. Update \`REVIEW.md\` in-place (don't append)
3. Move fixed items to "Resolved Findings"
4. Add any new issues found

---

NOTICE_EOF
        cat "$SESSION_DIR/repo/CLAUDE.md" >> "$temp_file"
        mv "$temp_file" "$SESSION_DIR/repo/CLAUDE.md"
    fi

    return 0
}

restart_session() {
    local SESSION_DIR="$1"
    local INFO_FILE="$SESSION_DIR/session-info.txt"

    # Extract repo URL and branch info
    local REPO_URL=$(grep "^URL:" "$INFO_FILE" 2>/dev/null | head -1 | cut -d' ' -f2-)

    if [ -z "$REPO_URL" ]; then
        error "Could not find repository URL in session info"
        sleep 2
        return 1
    fi

    # Check if it's a PR session
    if grep -q "^Type:.*PR" "$INFO_FILE" 2>/dev/null; then
        local PR_NUMBER=$(grep "^PR #" "$INFO_FILE" 2>/dev/null | head -1 | sed 's/PR #\([0-9]*\).*/\1/')
        local PR_BASE=$(grep "^Branch:" "$INFO_FILE" 2>/dev/null | head -1 | sed 's/.*→ //' | xargs)

        gum spin --spinner dot --title "Re-cloning repository..." -- \
            git clone --depth=50 "https://github.com/${REPO_URL}.git" "$SESSION_DIR/repo" 2>&1 || \
            git clone --depth=50 "$REPO_URL" "$SESSION_DIR/repo" 2>&1

        if [ ! -d "$SESSION_DIR/repo" ]; then
            error "Failed to clone repository"
            sleep 2
            return 1
        fi

        cd "$SESSION_DIR/repo"
        gum spin --spinner dot --title "Checking out PR branch..." -- \
            bash -c "git fetch origin 'pull/$PR_NUMBER/head:pr-$PR_NUMBER' 2>&1 && git checkout 'pr-$PR_NUMBER' 2>&1"
    else
        # Investigation session
        local BRANCH=$(grep "^Branch:" "$INFO_FILE" 2>/dev/null | head -1 | cut -d: -f2 | xargs | sed 's/ (default)//')

        gum spin --spinner dot --title "Re-cloning repository..." -- \
            git clone --depth=100 "$REPO_URL" "$SESSION_DIR/repo" 2>&1

        if [ ! -d "$SESSION_DIR/repo" ]; then
            error "Failed to clone repository"
            sleep 2
            return 1
        fi

        if [ -n "$BRANCH" ]; then
            cd "$SESSION_DIR/repo"
            git checkout "$BRANCH" 2>/dev/null || true
        fi
    fi

    # Restore CLAUDE.md to repo if it exists in session root
    [ -f "$SESSION_DIR/CLAUDE.md" ] && cp "$SESSION_DIR/CLAUDE.md" "$SESSION_DIR/repo/"

    # Remove archived marker
    sed -i '' '/^ARCHIVED:/d' "$SESSION_DIR/session-info.txt" 2>/dev/null || true

    success "Session restored!"
    sleep 1
    return 0
}

