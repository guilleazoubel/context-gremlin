create_investigation_session() {
    show_context "New Investigation"

    local REPO_URL=""
    local REPO_DISPLAY=""

    # Choose input method
    local input_method=$(gum choose \
        "🔍 Browse repositories" \
        "🔗 Enter repo URL directly" \
        "← Back")

    case "$input_method" in
        *"Browse"*)
            REPO_URL=$(select_repo "New Investigation")
            [ -z "$REPO_URL" ] && return 1
            ;;
        *"Enter repo"*)
            local DEFAULT_REPO="https://github.com/aplaceformom/grace-frontend"
            printf "Repository URL [$DEFAULT_REPO]: "
            read -r REPO_URL
            [ -z "$REPO_URL" ] && REPO_URL="$DEFAULT_REPO"
            ;;
        *)
            return 1
            ;;
    esac

    # Extract repo display name
    if [[ "$REPO_URL" =~ github.com/([^/]+)/([^/]+) ]]; then
        REPO_DISPLAY="${BASH_REMATCH[2]}"
        REPO_DISPLAY="${REPO_DISPLAY%.git}"
    else
        REPO_DISPLAY="$REPO_URL"
    fi

    show_context "New Investigation" "📁 $REPO_DISPLAY"
    dim "Fetching branches..."

    # Fetch remote branches - try with and without .git suffix
    local branches=""
    branches=$(git ls-remote --heads "$REPO_URL" 2>/dev/null | sed 's/.*refs\/heads\///' | sort)
    if [ -z "$branches" ]; then
        branches=$(git ls-remote --heads "${REPO_URL}.git" 2>/dev/null | sed 's/.*refs\/heads\///' | sort)
    fi

    local BRANCH=""
    if [ -n "$branches" ]; then
        local branch_count=$(echo "$branches" | wc -l | xargs)

        # Use fzf for fuzzy selection
        BRANCH=$(echo -e "← Back (cancel)\nmain (default)\n$branches" | fzf \
            --height=~50% \
            --layout=reverse \
            --border=rounded \
            --prompt="Search: " \
            --header="Select branch ($branch_count available) • ESC to cancel" \
            --header-first \
            --ansi)

        # Handle cancel/back
        if [ -z "$BRANCH" ] || [[ "$BRANCH" == "← Back"* ]]; then
            return 1
        fi

        # Handle "main (default)" selection
        [[ "$BRANCH" == "main (default)" ]] && BRANCH=""
    else
        dim "Could not fetch branches from remote."
        echo ""

        local fallback_choice=$(gum choose \
            "📌 Use main/master (default)" \
            "✏️  Enter branch name manually" \
            "← Back (cancel)")

        case "$fallback_choice" in
            *"main/master"*)
                BRANCH=""
                ;;
            *"Enter branch"*)
                printf "Branch name: "
                read -r BRANCH
                ;;
            *)
                return 1
                ;;
        esac
    fi

    # Show context with branch selection
    local branch_display="${BRANCH:-main}"
    show_context "New Investigation" "📁 $REPO_DISPLAY" "🌿 $branch_display"

    # Optional: Link Jira ticket FIRST (provides context, may make instructions optional)
    # Pass branch name for auto-detection of Jira ticket (e.g., HB-404-fix-login -> HB-404)
    local JIRA_TICKET_ID=""
    local JIRA_CONTEXT=""
    local JIRA_TICKET_TYPE=""
    local JIRA_SUMMARY=""
    prompt_jira_ticket "investigation" "$BRANCH"

    # Get Jira summary if ticket was linked
    if [ -n "$JIRA_TICKET_JSON" ]; then
        JIRA_SUMMARY=$(echo "$JIRA_TICKET_JSON" | jq -r '.fields.summary // empty' 2>/dev/null)
    fi

    # Investigation instructions - optional if Jira ticket linked
    local INVESTIGATION=""
    if [ -n "$JIRA_TICKET_ID" ]; then
        dim "Additional notes (optional - Jira context will be used):"
        dim "(empty line to skip, 'q' alone to cancel)"
    else
        dim "Describe your investigation focus (empty line to finish, 'q' alone to cancel):"
    fi
    echo ""
    while IFS= read -r line; do
        [ -z "$line" ] && break
        [[ "$line" == "q" ]] && return 1
        INVESTIGATION="${INVESTIGATION}${line}"$'\n'
    done

    # Need either Jira ticket OR investigation focus
    if [ -z "$INVESTIGATION" ] && [ -z "$JIRA_TICKET_ID" ]; then
        dim "No investigation focus or Jira ticket provided"
        sleep 1
        return 1
    fi

    # Build the investigation focus text
    local INVESTIGATION_DISPLAY=""
    if [ -n "$JIRA_SUMMARY" ]; then
        INVESTIGATION_DISPLAY="$JIRA_TICKET_ID: $JIRA_SUMMARY"
        [ -n "$INVESTIGATION" ] && INVESTIGATION_DISPLAY="$INVESTIGATION_DISPLAY"$'\n\nAdditional Notes:\n'"$INVESTIGATION"
    elif [ -n "$INVESTIGATION" ]; then
        INVESTIGATION_DISPLAY="$INVESTIGATION"
    fi

    local OWNER REPO
    if [[ "$REPO_URL" =~ ([^/]+)/([^/]+)(\.git)?$ ]]; then
        OWNER="${BASH_REMATCH[1]}"
        REPO="${BASH_REMATCH[2]}"
        REPO="${REPO%.git}"
    else
        OWNER="unknown"
        REPO="repo"
    fi

    local SESSION_NAME="inv-${REPO}-$(date +%Y%m%d-%H%M%S)"
    local SESSION_DIR="$SESSIONS_DIR/$SESSION_NAME"

    mkdir -p "$SESSION_DIR"
    cd "$SESSION_DIR"

    # Clone with branch if specified (avoids fetch issues with shallow clone)
    local clone_cmd="git clone --depth=100"
    [ -n "$BRANCH" ] && clone_cmd="$clone_cmd --branch '$BRANCH'"
    clone_cmd="$clone_cmd '$REPO_URL' repo"

    if ! gum spin --spinner dot --title "Cloning repository..." -- \
