SESSIONS_DIR="$HOME/Agent-temp"
mkdir -p "$SESSIONS_DIR"

# ============================================================================
# CONFIGURATION SYSTEM
# ============================================================================

CONFIG_DIR="$HOME/.sandbox"
CONFIG_FILE="$CONFIG_DIR/config"

# Default configuration values
DEFAULT_MODEL="sonnet"
DEFAULT_DASHBOARD_AUTO_START="true"
DEFAULT_PROJECT=""

# Current configuration (loaded at startup)
MODEL="${DEFAULT_MODEL}"
DASHBOARD_AUTO_START="${DEFAULT_DASHBOARD_AUTO_START}"
DEFAULT_PROJECT="${DEFAULT_PROJECT}"

# Load configuration from file
load_config() {
    mkdir -p "$CONFIG_DIR"

    if [ -f "$CONFIG_FILE" ]; then
        # Source the config file to load variables
        while IFS='=' read -r key value; do
            # Skip comments and empty lines
            [[ "$key" =~ ^[[:space:]]*# ]] && continue
            [[ -z "$key" ]] && continue

            # Remove leading/trailing whitespace and quotes
            key=$(echo "$key" | xargs)
            value=$(echo "$value" | sed 's/^["'\'']\|["'\'']$//g' | xargs)

            case "$key" in
                MODEL) MODEL="$value" ;;
                DASHBOARD_AUTO_START) DASHBOARD_AUTO_START="$value" ;;
                DEFAULT_PROJECT) DEFAULT_PROJECT="$value" ;;
            esac
        done < "$CONFIG_FILE"
    fi
}

# Save configuration to file
save_config() {
    mkdir -p "$CONFIG_DIR"

    cat > "$CONFIG_FILE" << EOF
# Sandbox Configuration
# Generated: $(date '+%Y-%m-%d %H:%M:%S')

# Claude model to use (sonnet/opus/haiku)
MODEL="$MODEL"

# Auto-start dashboard when sandbox launches (true/false)
DASHBOARD_AUTO_START="$DASHBOARD_AUTO_START"

# Default project path (last used or set manually)
DEFAULT_PROJECT="$DEFAULT_PROJECT"
EOF
    chmod 600 "$CONFIG_FILE"
}

# Load config at startup
load_config

# Create dashboard config.json with empty defaults if it doesn't exist
if [ ! -f "$CONFIG_DIR/config.json" ]; then
    mkdir -p "$CONFIG_DIR"
    cat > "$CONFIG_DIR/config.json" << 'CFGEOF'
{
  "jira_base_url": "",
  "vercel_preview_url_template": ""
}
CFGEOF
fi

# Auto-populate jira_base_url from jira.conf if not already set
if [ -f "$HOME/.config/sandbox/jira.conf" ]; then
    _jira_domain=""
    eval "$(grep '^JIRA_DOMAIN=' "$HOME/.config/sandbox/jira.conf")" 2>/dev/null && _jira_domain="$JIRA_DOMAIN"
    if [ -n "$_jira_domain" ]; then
        _current_jira_url=$(jq -r '.jira_base_url // ""' "$CONFIG_DIR/config.json" 2>/dev/null)
        if [ -z "$_current_jira_url" ]; then
            local_tmp=$(jq --arg url "https://$_jira_domain/browse/" '.jira_base_url = $url' "$CONFIG_DIR/config.json" 2>/dev/null)
            [ -n "$local_tmp" ] && echo "$local_tmp" > "$CONFIG_DIR/config.json"
        fi
    fi
    unset _jira_domain _current_jira_url
fi

# ============================================================================
# V2 SESSION MODEL
# ============================================================================
# Unified session management with session.json metadata
# All sessions use session-* naming with mode tracked in metadata

# Generate unique session ID
generate_session_id() {
    local prefix="session"
    local timestamp=$(date '+%Y%m%d-%H%M%S')
    local random=$(head -c 4 /dev/urandom | xxd -p)
    echo "${prefix}-${timestamp}-${random}"
}

# Create session.json with all metadata
# Usage: create_session_json SESSION_DIR mode project [extra_json_fields]
create_session_json() {
    local session_dir="$1"
    local mode="$2"
    local project="$3"
    local extra_fields="${4:-{}}"

    local session_id=$(basename "$session_dir")
    local created=$(date -Iseconds)

    # Merge extra fields into base JSON
    local json=$(jq -n \
        --arg id "$session_id" \
        --arg mode "$mode" \
        --arg project "$project" \
        --arg created "$created" \
        --arg status "active" \
        --argjson extra "$extra_fields" \
        '{
            id: $id,
            mode: $mode,
            project: $project,
            created: $created,
            status: $status,
            terminal: {
                pid: null,
                tmux_session: null,
                log_file: null
            },
            history: []
        } + $extra')

    echo "$json" > "$session_dir/session.json"
}

# Read a field from session.json
# Usage: read_session_field SESSION_DIR field_path
read_session_field() {
    local session_dir="$1"
    local field="$2"
    local session_file="$session_dir/session.json"

    if [ -f "$session_file" ]; then
        jq -r ".$field // empty" "$session_file" 2>/dev/null
    fi
}

# Update a field in session.json
# Usage: update_session_field SESSION_DIR field_path value
update_session_field() {
    local session_dir="$1"
    local field="$2"
    local value="$3"
    local session_file="$session_dir/session.json"

    if [ -f "$session_file" ]; then
        local tmp=$(mktemp)
        # Check if value is JSON or plain string
        if echo "$value" | jq -e . >/dev/null 2>&1; then
            jq ".$field = $value" "$session_file" > "$tmp" && mv "$tmp" "$session_file"
        else
            jq --arg v "$value" ".$field = \$v" "$session_file" > "$tmp" && mv "$tmp" "$session_file"
        fi
    fi
}

# Add history entry to session
# Usage: add_session_history SESSION_DIR action [details_json]
add_session_history() {
    local session_dir="$1"
    local action="$2"
    local details="${3:-{}}"
    local session_file="$session_dir/session.json"

    if [ -f "$session_file" ]; then
        local tmp=$(mktemp)
        local timestamp=$(date -Iseconds)
        jq --arg ts "$timestamp" --arg act "$action" --argjson det "$details" \
            '.history += [{ timestamp: $ts, action: $act } + $det]' \
            "$session_file" > "$tmp" && mv "$tmp" "$session_file"
    fi
}

# Check if session uses v2 format (has session.json)
is_v2_session() {
    local session_dir="$1"
    [ -f "$session_dir/session.json" ]
}

# Migrate old session to v2 format
# Reads session-info.txt and creates session.json
migrate_session_to_v2() {
    local session_dir="$1"
    local session_name=$(basename "$session_dir")
    local info_file="$session_dir/session-info.txt"

    # Skip if already v2
    [ -f "$session_dir/session.json" ] && return 0

    # Skip if no info file
    [ ! -f "$info_file" ] && return 1

    # Determine mode from folder name
    local mode="investigation"
    if [[ "$session_name" == pr-* ]]; then
        mode="review"
    elif [[ "$session_name" == dev-* ]]; then
        mode="development"
    fi

    # Parse info file for metadata
    local project=""
    local pr_number=""
    local pr_title=""
    local jira_ticket=""
    local branch=""
    local created=""
    local focus=""

    while IFS=: read -r key value; do
        key=$(echo "$key" | xargs | tr '[:upper:]' '[:lower:]' | tr ' ' '_')
        value=$(echo "$value" | xargs)
        case "$key" in
            repository) project="$value" ;;
            pr*)
                if [[ "$value" =~ ([0-9]+) ]]; then
                    pr_number="${BASH_REMATCH[1]}"
                fi
                ;;
            branch) branch="$value" ;;
            jira) jira_ticket="$value" ;;
            created) created="$value" ;;
            summary) pr_title="$value" ;;
        esac
    done < "$info_file"

    # Build extra fields based on mode
    local extra="{}"
    case "$mode" in
        review)
            extra=$(jq -n --arg pr "$pr_number" --arg title "$pr_title" --arg branch "$branch" \
                '{pr: {number: $pr, title: $title, branch: $branch}}')
            ;;
        development)
            extra=$(jq -n --arg jira "$jira_ticket" --arg branch "$branch" \
                '{jira: {ticket: $jira}, branch: $branch}')
            ;;
        investigation)
            # Extract focus from the file
            focus=$(sed -n '/Investigation Focus:/,/====/p' "$info_file" 2>/dev/null | \
                grep -v "Investigation Focus:" | grep -v "===" | grep -v "^-" | head -1 | xargs)
            extra=$(jq -n --arg focus "$focus" '{focus: $focus}')
            ;;
    esac

    # Create session.json
    create_session_json "$session_dir" "$mode" "$project" "$extra"

    # Update created timestamp if available
    if [ -n "$created" ]; then
        update_session_field "$session_dir" "created" "$created"
    fi

    # Mark as migrated in history
    add_session_history "$session_dir" "migrated" '{"from": "v1"}'

    return 0
}

# Get sessions (supports both v1 and v2 formats)
get_sessions_v2() {
    # Find all session directories (old naming: pr-*, inv-*, dev-*; new naming: session-*)
    find "$SESSIONS_DIR" -maxdepth 1 -type d \( \
        -name "pr-*" -o -name "inv-*" -o -name "dev-*" -o -name "session-*" \
    \) 2>/dev/null | sort -r
}

# Get session mode (works with both formats)
get_session_mode() {
    local session_dir="$1"

    # Try v2 first
    if is_v2_session "$session_dir"; then
        read_session_field "$session_dir" "mode"
        return
    fi

    # Fall back to v1 folder naming
    local name=$(basename "$session_dir")
    if [[ "$name" == pr-* ]]; then
        echo "review"
    elif [[ "$name" == dev-* ]]; then
        echo "development"
    else
        echo "investigation"
    fi
}

