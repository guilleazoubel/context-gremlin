    else
        REPO_DISPLAY="$REPO_URL"
    fi

    show_context "New Investigation" "📁 $REPO_DISPLAY"
    dim "Fetching branches..."

    # Fetch remote branches - try with and without .git suffix
    local branches=""
    branches=$(git ls-remote --heads "$REPO_URL" 2>/dev/null | sed 's/.*refs\/heads\///' | sort)
    if [ -z "$branches" ]; then
        branches=$(git ls-remote --heads "${REPO_URL}.git" 2>/dev/null | sed 's/.*refs\/heads\///' | sort)
    fi

    local BRANCH=""
    if [ -n "$branches" ]; then
        local branch_count=$(echo "$branches" | wc -l | xargs)

        # Use fzf for fuzzy selection
        BRANCH=$(echo -e "← Back (cancel)\nmain (default)\n$branches" | fzf \
            --height=~50% \
            --layout=reverse \
            --border=rounded \
            --prompt="Search: " \
            --header="Select branch ($branch_count available) • ESC to cancel" \
            --header-first \
            --ansi)

        # Handle cancel/back
        if [ -z "$BRANCH" ] || [[ "$BRANCH" == "← Back"* ]]; then
            return 1
        fi

        # Handle "main (default)" selection
        [[ "$BRANCH" == "main (default)" ]] && BRANCH=""
    else
        dim "Could not fetch branches from remote."
        echo ""

        local fallback_choice=$(gum choose \
            "📌 Use main/master (default)" \
            "✏️  Enter branch name manually" \
            "← Back (cancel)")

        case "$fallback_choice" in
