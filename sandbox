header() {
    clear
    gum style \
        --border double \
        --border-foreground 212 \
        --padding "0 2" \
        --margin "1 0" \
        --align center \
        --width 60 \
        "🧪 SANDBOX" \
        "Isolated environments for code work"
}

success() {
    gum style --foreground 82 "✓ $1"
}

error() {
    gum style --foreground 196 "✗ $1"
}

info() {
    gum style --foreground 75 "→ $1"
}

dim() {
    gum style --foreground 240 "$1"
