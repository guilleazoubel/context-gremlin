        const contentFile = "${content_file}";
        const reviewFile = "${REVIEW_FILE}";
        let lastContent = '';
        let checkCount = 0;

        async function loadContent() {
            checkCount++;
            try {
                // Try XMLHttpRequest for local file
                const xhr = new XMLHttpRequest();
                xhr.open('GET', 'file://' + reviewFile + '?t=' + Date.now(), false);
                try {
                    xhr.send();
                    if (xhr.status === 200 || xhr.status === 0) {
                        updateContent(xhr.responseText);
                        return;
                    }
                } catch(e) {}
            } catch(e) {}

            // Fallback: reload page to get fresh content from file system
            // This works because browsers cache the initial load
            document.getElementById('lastUpdate').textContent =
                new Date().toLocaleTimeString() + ' (check #' + checkCount + ')';
        }

        function updateContent(content) {
            if (content && content.trim() && content !== lastContent) {
                lastContent = content;
                const html = marked.parse(content);
                document.getElementById('content').innerHTML = DOMPurify.sanitize(html);
                document.getElementById('lastUpdate').textContent =
                    'Updated: ' + new Date().toLocaleTimeString();
            }
        }

        // Initial load from embedded content if available
        const initialContent = \`PLACEHOLDER_CONTENT\`;
        if (initialContent && initialContent !== 'PLACEHOLDER_CONTENT') {
            updateContent(initialContent);
        }

        // Poll for updates
        setInterval(loadContent, 2000);
    </script>
</body>
</html>
LIVEPREVIEW

    echo "$html_file"
}

