        // Parse findings and add PR comment buttons
        function addPRCommentButtons(rawMarkdown) {
            const session = sessions.find(s => s.name === currentSession);
            // Only add buttons for PR sessions that aren't archived
            if (!session || !session.pr || session.archived) return;

            // Find all h4 elements that look like findings
            const content = document.getElementById('content');
            const h4s = content.querySelectorAll('h4');

            // Parse the raw markdown to extract finding details
            // Looking for patterns like:
            // #### Finding #1: Title
            // 📍 **Location:** `path/to/file.ts:XX-YY`
            // **Problem:** description

            // Enhanced regex to capture full finding details
            const findingRegex = /####\\s*Finding\\s*#?(\\d+)[:\\s]*([^\\n]+)\\n([\\s\\S]*?)(?=####|$)/gi;
            const findings = [];
            let match;

            while ((match = findingRegex.exec(rawMarkdown)) !== null) {
                const findingBody = match[3];

                // Extract location
                const locMatch = findingBody.match(/📍\\s*\\*\\*Location:\\*\\*\\s*`([^`]+)`/);
                if (!locMatch) continue;

                const location = locMatch[1];
                const fileLineMatch = location.match(/^([^:]+):(\\d+)(?:-(\\d+))?/);
                if (!fileLineMatch) continue;

                // Extract problem - look for **Problem:** or just Problem:
                const problemMatch = findingBody.match(/\\*\\*Problem:?\\*\\*\\s*([^*]+?)(?=\\*\\*|$)/s) ||
                                    findingBody.match(/Problem:\\s*([^\\n]+)/i);
                const problem = problemMatch ? problemMatch[1].trim().replace(/\\n+/g, ' ') : '';

                // Extract impact - look for **Impact:** or Why it matters:
                const impactMatch = findingBody.match(/\\*\\*Impact:?\\*\\*\\s*([^*]+?)(?=\\*\\*|$)/s) ||
                                   findingBody.match(/\\*\\*Why[^:]*:\\*\\*\\s*([^*]+?)(?=\\*\\*|$)/s) ||
                                   findingBody.match(/Impact:\\s*([^\\n]+)/i);
                const impact = impactMatch ? impactMatch[1].trim().replace(/\\n+/g, ' ') : '';

                // Extract suggested fix text
                const suggestedMatch = findingBody.match(/\\*\\*Suggest[^:]*:?\\*\\*\\s*([^`*]+?)(?=```|\\*\\*|$)/s) ||
                                      findingBody.match(/\\*\\*(?:Fix|Recommendation):?\\*\\*\\s*([^`*]+?)(?=```|\\*\\*|$)/s);
                const suggested = suggestedMatch ? suggestedMatch[1].trim().replace(/\\n+/g, ' ') : '';

                // Extract code suggestion if present (code block after Suggested Fix)
                const codeMatch = findingBody.match(/\\*\\*Suggest[^*]*\\*\\*[\\s\\S]*?```(?:suggestion|[a-z]*)\\n([\\s\\S]*?)```/);
                const suggestedCode = codeMatch ? codeMatch[1].trim() : '';

                findings.push({
                    number: match[1],
                    title: match[2].trim(),
                    file: fileLineMatch[1],
                    line: parseInt(fileLineMatch[2]),
                    endLine: fileLineMatch[3] ? parseInt(fileLineMatch[3]) : null,
                    problem: problem,
                    impact: impact,
                    suggested: suggested,
                    suggestedCode: suggestedCode
                });
            }

            // Also try simpler pattern for findings with just Location
            const simpleRegex = /####\\s*(?:Finding\\s*#?\\d+[:\\s]*)?([^\\n]+)\\n[\\s\\S]*?(?:📍|\\*\\*Location:\\*\\*)\\s*`?([^`\\n]+\\.[a-z]+:\\d+[^`\\n]*)`?/gi;
            while ((match = simpleRegex.exec(rawMarkdown)) !== null) {
                const location = match[2].trim();
                const locMatch = location.match(/^([^:]+):(\\d+)(?:-(\\d+))?/);
                if (locMatch && !findings.some(f => f.file === locMatch[1] && f.line === parseInt(locMatch[2]))) {
                    findings.push({
                        title: match[1].trim(),
                        file: locMatch[1],
                        line: parseInt(locMatch[2]),
                        endLine: locMatch[3] ? parseInt(locMatch[3]) : null,
                        problem: match[1].trim()
                    });
                }
            }

            // Inject buttons into the DOM
            h4s.forEach((h4, index) => {
                const text = h4.textContent || '';
                // Try to match this h4 with a finding
                const finding = findings.find(f =>
                    text.includes(f.title?.substring(0, 30)) ||
                    (f.number && text.includes('#' + f.number))
                );

                if (finding) {
                    // Create button container
                    const btnContainer = document.createElement('span');
                    btnContainer.className = 'finding-actions';
                    btnContainer.style.marginLeft = '0.5rem';

                    // Create post to PR button
                    const btn = document.createElement('button');
                    btn.className = 'btn-post-pr';
                    btn.innerHTML = '💬 Post to PR';
                    btn.dataset.file = finding.file;
                    btn.dataset.line = finding.line;
                    btn.dataset.finding = JSON.stringify(finding);
                    btn.onclick = function() { postToPR(this); };

                    // Create copy button as fallback
                    const copyBtn = document.createElement('button');
                    copyBtn.className = 'btn-post-pr';
                    copyBtn.innerHTML = '📋 Open';
                    copyBtn.title = 'Copy comment & open PR at ' + finding.file + ':' + finding.line;
                    copyBtn.onclick = async function() {
                        copyBtn.innerHTML = '⏳';
                        await copyAndOpenPR(finding);
                        copyBtn.innerHTML = '📋 Open';
                    };

                    // Add Fix button (only if session isn't archived)
                    const fixBtn = document.createElement('button');
                    fixBtn.className = 'btn-post-pr';
                    fixBtn.innerHTML = '🔧 Fix';
                    fixBtn.title = 'Fix this finding with Claude';
                    fixBtn.onclick = async function() {
                        fixBtn.disabled = true;
                        fixBtn.innerHTML = '⏳';
                        try {
                            const res = await fetch('/api/fix-finding', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    session: currentSession,
                                    finding: finding,
                                    fix_all: false
                                })
                            });
                            if (res.ok) {
                                showToast('Claude launched to fix finding #' + finding.number);
                                fixBtn.innerHTML = '✅';
                            } else {
                                throw new Error(await res.text());
                            }
                        } catch (e) {
                            showToast('Failed: ' + e.message, 'error');
                            fixBtn.innerHTML = '🔧 Fix';
                            fixBtn.disabled = false;
                        }
                    };

                    btnContainer.appendChild(btn);
                    btnContainer.appendChild(copyBtn);
                    btnContainer.appendChild(fixBtn);
                    h4.appendChild(btnContainer);
                }
            });
        }

        // Format a rich comment from finding data
        function formatFindingComment(finding) {
            let comment = '**' + finding.title + '**\\n\\n';

            if (finding.problem) {
                comment += '**Problem:** ' + finding.problem + '\\n\\n';
            }

            if (finding.impact) {
                comment += '**Impact:** ' + finding.impact + '\\n\\n';
            }

            if (finding.suggested) {
                comment += '**Suggested Fix:** ' + finding.suggested;
                if (finding.suggestedCode) {
                    comment += '\\n```suggestion\\n' + finding.suggestedCode + '\\n```';
                }
                comment += '\\n';
            } else if (finding.suggestedCode) {
                comment += '**Suggested Fix:**\\n```suggestion\\n' + finding.suggestedCode + '\\n```\\n';
            }

            return comment.trim();
        }

        // Post comment to PR via API
        async function postToPR(btn) {
            const file = btn.dataset.file;
