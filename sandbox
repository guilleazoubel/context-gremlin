# Create static HTML preview (no server needed, manual refresh)
create_static_preview() {
    local SESSION_DIR="$1"
    local OUTPUT_FILE="$2"

    local REVIEW_FILE="$SESSION_DIR/REVIEW.md"
    local FINDINGS_FILE="$SESSION_DIR/FINDINGS.md"

    # Read content
    local review_content=""
    local findings_content=""
    [ -f "$REVIEW_FILE" ] && review_content=$(cat "$REVIEW_FILE" | sed 's/\\/\\\\/g' | sed 's/`/\\`/g' | sed "s/'/\\\\'/g")
    [ -f "$FINDINGS_FILE" ] && findings_content=$(cat "$FINDINGS_FILE" | sed 's/\\/\\\\/g' | sed 's/`/\\`/g' | sed "s/'/\\\\'/g")

    cat > "$OUTPUT_FILE" << STATICHTML
<!DOCTYPE html>
<html lang="en">
<head>
