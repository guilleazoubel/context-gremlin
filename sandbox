# Display current selection context
show_context() {
    local title="$1"
    shift

    header
    gum style --foreground 212 --bold "$title"
    echo ""

    # Show previous selections if any
    if [ $# -gt 0 ]; then
        local context=""
        while [ $# -gt 0 ]; do
            [ -n "$context" ] && context="$context  →  "
            context="$context$1"
            shift
        done
        gum style --foreground 240 --italic "$context"
        echo ""
    fi
}

select_repo() {
    local DEFAULT_ORG="aplaceformom"
    local title="${1:-Select Repository}"

    # All display output to stderr so it doesn't pollute return value
    show_context "$title" >&2
    dim "Fetching repositories from $DEFAULT_ORG..." >&2

    # Fetch repos from default org
    local repos=$(gh repo list "$DEFAULT_ORG" --limit 100 --json name,description --jq '.[] | "\(.name) ~ \(.description // "No description")"' 2>/dev/null)

    if [ -z "$repos" ]; then
        error "Could not fetch repositories" >&2
        sleep 2
        return 1
    fi

    local repo_count=$(echo "$repos" | wc -l | xargs)

    # Use fzf for fuzzy selection (fzf outputs to stderr by default)
    local selected=$(echo -e "← Back (cancel)\n$repos" | fzf \
        --height=~50% \
        --layout=reverse \
        --border=rounded \
        --prompt="Search: " \
        --header="Select repository ($repo_count available) • ESC to cancel" \
        --header-first \
        --ansi)

    # Handle cancel/back
    if [ -z "$selected" ] || [[ "$selected" == "← Back"* ]]; then
        return 1
    fi

    # Extract just the repo name (before the " ~ ")
    local repo_name=$(echo "$selected" | cut -d'~' -f1 | xargs)
    echo "https://github.com/$DEFAULT_ORG/$repo_name"
    return 0
}

select_pr() {
    local REPO="$1"
    local REPO_DISPLAY="$2"

    # All display output to stderr so it doesn't pollute return value
    show_context "New PR Review" "📁 $REPO_DISPLAY" >&2
    dim "Fetching open PRs..." >&2

    # Fetch open PRs
    local prs=$(gh pr list --repo "$REPO" --state open --limit 50 --json number,title,author --jq '.[] | "#\(.number) \(.title) (@\(.author.login))"' 2>/dev/null)

    if [ -z "$prs" ]; then
        dim "No open PRs found in $REPO" >&2
        sleep 2
        return 1
    fi

    local pr_count=$(echo "$prs" | wc -l | xargs)

    # Use fzf for fuzzy selection (fzf outputs to stderr by default)
    local selected=$(echo -e "← Back (cancel)\n$prs" | fzf \
        --height=~50% \
        --layout=reverse \
        --border=rounded \
        --prompt="Search: " \
        --header="Select PR ($pr_count open) • ESC to cancel" \
        --header-first \
        --ansi)

    # Handle cancel/back
    if [ -z "$selected" ] || [[ "$selected" == "← Back"* ]]; then
        return 1
    fi

    # Extract PR number
    echo "$selected" | sed 's/^#\([0-9]*\).*/\1/'
    return 0
}

# Fetch PR comments and reviews for context
fetch_pr_comments() {
    local SESSION_DIR="$1"
    local OWNER="$2"
    local REPO="$3"
    local PR_NUMBER="$4"
    local OUTPUT_FILE="$SESSION_DIR/PR_DISCUSSION.md"

    dim "Fetching PR comments and reviews..."

    # Start the markdown file
    cat > "$OUTPUT_FILE" << 'HEADER'
# PR Discussion & Review History

> This file contains existing comments, reviews, and discussions from the PR.
> Use this context to avoid duplicating feedback and to understand decisions already made.

HEADER

    # Fetch review comments (comments on specific lines of code)
    local review_comments=$(gh api "repos/$OWNER/$REPO/pulls/$PR_NUMBER/comments" --paginate 2>/dev/null || echo "[]")
    local review_count=$(echo "$review_comments" | jq 'length')

    if [ "$review_count" != "0" ] && [ "$review_count" != "null" ]; then
        echo "## Code Review Comments ($review_count)" >> "$OUTPUT_FILE"
        echo "" >> "$OUTPUT_FILE"

        echo "$review_comments" | jq -r '.[] | "### 📍 `\(.path):\(.line // .original_line // "?")`\n**@\(.user.login)** on \(.created_at | split("T")[0]):\n\n\(.body)\n\n---\n"' >> "$OUTPUT_FILE" 2>/dev/null
    fi

    # Fetch PR reviews (approve/request changes/comment)
    local reviews=$(gh api "repos/$OWNER/$REPO/pulls/$PR_NUMBER/reviews" --paginate 2>/dev/null || echo "[]")
    local reviews_count=$(echo "$reviews" | jq 'length')

    if [ "$reviews_count" != "0" ] && [ "$reviews_count" != "null" ]; then
        echo "## PR Reviews ($reviews_count)" >> "$OUTPUT_FILE"
        echo "" >> "$OUTPUT_FILE"

        echo "$reviews" | jq -r '.[] | select(.body != "" and .body != null) | "### \(if .state == "APPROVED" then "✅" elif .state == "CHANGES_REQUESTED" then "⚠️" else "💬" end) \(.state) by @\(.user.login)\n\(.created_at | split("T")[0])\n\n\(.body)\n\n---\n"' >> "$OUTPUT_FILE" 2>/dev/null
    fi

    # Fetch general PR comments (conversation)
    local issue_comments=$(gh api "repos/$OWNER/$REPO/issues/$PR_NUMBER/comments" --paginate 2>/dev/null || echo "[]")
    local issue_count=$(echo "$issue_comments" | jq 'length')

    if [ "$issue_count" != "0" ] && [ "$issue_count" != "null" ]; then
        echo "## General Discussion ($issue_count)" >> "$OUTPUT_FILE"
        echo "" >> "$OUTPUT_FILE"

        echo "$issue_comments" | jq -r '.[] | "### 💬 @\(.user.login) on \(.created_at | split("T")[0])\n\n\(.body)\n\n---\n"' >> "$OUTPUT_FILE" 2>/dev/null
    fi

    # Add summary at the end
    local total=$((review_count + reviews_count + issue_count))
    if [ "$total" -gt 0 ]; then
        echo "" >> "$OUTPUT_FILE"
        echo "---" >> "$OUTPUT_FILE"
        echo "*Total: $review_count code comments, $reviews_count reviews, $issue_count discussion comments*" >> "$OUTPUT_FILE"

        # Also create symlink in repo for Claude to find
        [ -d "$SESSION_DIR/repo" ] && ln -sf "../PR_DISCUSSION.md" "$SESSION_DIR/repo/PR_DISCUSSION.md" 2>/dev/null

        dim "  Found $total existing comments/reviews"
    else
        echo "*No existing comments or reviews on this PR.*" >> "$OUTPUT_FILE"
        dim "  No existing comments found"
    fi
}

create_pr_session() {
    show_context "New PR Review"

    local OWNER=""
    local REPO=""
    local PR_NUMBER=""
    local REPO_URL=""

    # Choose input method
    local input_method=$(gum choose \
        "🔍 Browse open PRs" \
        "🔗 Enter PR URL directly" \
        "← Back")

    case "$input_method" in
        *"Browse"*)
            # First select repo
            REPO_URL=$(select_repo "New PR Review")
            if [ -z "$REPO_URL" ]; then
                return 1
            fi

            # Extract owner/repo
            if [[ "$REPO_URL" =~ github.com/([^/]+)/([^/]+) ]]; then
                OWNER="${BASH_REMATCH[1]}"
                REPO="${BASH_REMATCH[2]}"
                REPO="${REPO%.git}"
            fi

            # Then select PR - pass repo name for context display
            PR_NUMBER=$(select_pr "$OWNER/$REPO" "$REPO")
            if [ -z "$PR_NUMBER" ]; then
                return 1
            fi

            REPO_URL="https://github.com/$OWNER/$REPO.git"
            ;;
        *"Enter PR URL"*)
            printf "PR URL or number: "
            read -r pr_input
            [ -z "$pr_input" ] && return 1

            # Parse PR input
            if [[ "$pr_input" =~ ^https://github.com/([^/]+)/([^/]+)/pull/([0-9]+) ]]; then
                OWNER="${BASH_REMATCH[1]}"
                REPO="${BASH_REMATCH[2]}"
                PR_NUMBER="${BASH_REMATCH[3]}"
                REPO_URL="https://github.com/$OWNER/$REPO.git"
            elif [[ "$pr_input" =~ ^[0-9]+$ ]]; then
                PR_NUMBER="$pr_input"
                printf "Repository (owner/repo): "
                read -r repo_input

                if [[ "$repo_input" =~ github.com/([^/]+)/([^/]+) ]]; then
                    OWNER="${BASH_REMATCH[1]}"
                    REPO="${BASH_REMATCH[2]}"
                    REPO="${REPO%.git}"
                elif [[ "$repo_input" =~ ^([^/]+)/([^/]+)$ ]]; then
                    OWNER="${BASH_REMATCH[1]}"
                    REPO="${BASH_REMATCH[2]}"
                else
                    error "Could not parse repository"
                    sleep 2
                    return 1
                fi
                REPO_URL="https://github.com/$OWNER/$REPO.git"
            else
                error "Invalid PR input"
                sleep 2
                return 1
            fi
            ;;
        *)
            return 1
            ;;
    esac

    echo ""

    # Debug: show what we're fetching
    dim "Fetching PR #$PR_NUMBER from $OWNER/$REPO..."

    # Validate we have required info
    if [ -z "$PR_NUMBER" ] || [ -z "$OWNER" ] || [ -z "$REPO" ]; then
        error "Missing info - PR: '$PR_NUMBER', Owner: '$OWNER', Repo: '$REPO'"
        sleep 2
        return 1
    fi

    # Fetch PR info with spinner
    local PR_INFO
    local pr_error_file=$(mktemp)
    PR_INFO=$(gum spin --spinner dot --title "Fetching PR #$PR_NUMBER..." -- \
        gh pr view "$PR_NUMBER" --repo "$OWNER/$REPO" --json title,body,headRefName,baseRefName,author,additions,deletions,changedFiles,url 2>"$pr_error_file")

    if [ $? -ne 0 ] || [ -z "$PR_INFO" ]; then
        local err_msg=$(cat "$pr_error_file")
        rm -f "$pr_error_file"
        error "Could not fetch PR info: $err_msg"
        sleep 3
        return 1
    fi
    rm -f "$pr_error_file"

    local PR_TITLE=$(echo "$PR_INFO" | jq -r '.title')
    local PR_BODY=$(echo "$PR_INFO" | jq -r '.body // "No description provided"')
    local PR_HEAD=$(echo "$PR_INFO" | jq -r '.headRefName')
    local PR_BASE=$(echo "$PR_INFO" | jq -r '.baseRefName')
    local PR_AUTHOR=$(echo "$PR_INFO" | jq -r '.author.login')
    local PR_ADDITIONS=$(echo "$PR_INFO" | jq -r '.additions')
    local PR_DELETIONS=$(echo "$PR_INFO" | jq -r '.deletions')
    local PR_FILES=$(echo "$PR_INFO" | jq -r '.changedFiles')
    local PR_URL=$(echo "$PR_INFO" | jq -r '.url')

    # Show PR info
