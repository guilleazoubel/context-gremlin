        --border rounded \
        --border-foreground 240 \
        --padding "1 2" \
        --margin "1 0" \
        "PR #$PR_NUMBER: $PR_TITLE" \
        "" \
        "$(dim "Author: $PR_AUTHOR")" \
        "$(dim "Branch: $PR_HEAD → $PR_BASE")" \
        "$(dim "Changes: +$PR_ADDITIONS -$PR_DELETIONS in $PR_FILES files")"

