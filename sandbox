# ============================================================================
# SESSION LISTING
# ============================================================================

get_sessions() {
    find "$SESSIONS_DIR" -maxdepth 1 -type d \( -name "pr-*" -o -name "inv-*" \) 2>/dev/null | sort
}

format_session_display() {
    local session="$1"
    local name=$(basename "$session")
    local info_file="$session/session-info.txt"

    if [ -f "$info_file" ]; then
        local created=$(grep "^Created:" "$info_file" 2>/dev/null | cut -d: -f2- | xargs)
        local archived=""
        grep -q "^ARCHIVED:" "$info_file" 2>/dev/null && archived=" 📦"

        # Check for review file
        local has_review=""
        [ -f "$session/REVIEW.md" ] || [ -f "$session/repo/REVIEW.md" ] && has_review=" 📝"
        [ -f "$session/FINDINGS.md" ] || [ -f "$session/repo/FINDINGS.md" ] && has_review=" 📝"

        if [[ "$name" == pr-* ]]; then
            local title=$(grep "^PR #" "$info_file" 2>/dev/null | head -1)
            echo "🔍 $title$archived$has_review"
            echo "   $name • $created"
        else
            local title=$(sed -n '/Investigation Focus:/,/====/p' "$info_file" 2>/dev/null | grep -v "Investigation Focus:" | grep -v "===" | grep -v "^-" | head -1 | xargs)
            title="${title:0:50}"
            echo "🔬 $title$archived$has_review"
            echo "   $name • $created"
        fi
    else
        echo "❓ $name"
    fi
    echo ""
}

display_sessions() {
    local sessions=$(get_sessions)

    if [ -z "$sessions" ]; then
        dim "No active sessions"
        return 1
    fi

    while IFS= read -r session; do
        [ -z "$session" ] && continue
        format_session_display "$session"
    done <<< "$sessions"

    return 0
}

select_session_simple() {
    local sessions=$(get_sessions)

    if [ -z "$sessions" ]; then
        return 1
    fi

    # Build array with full formatted display
    local options=("← Back")
    local session_paths=("")

    while IFS= read -r session; do
        [ -z "$session" ] && continue
        session_paths+=("$session")

        local name=$(basename "$session")
        local info_file="$session/session-info.txt"
        local display=""

        if [ -f "$info_file" ]; then
            local archived=""
            grep -q "^ARCHIVED:" "$info_file" 2>/dev/null && archived="📦 "

            local has_review=""
            [ -f "$session/REVIEW.md" ] || [ -f "$session/repo/REVIEW.md" ] && has_review=" 📝"
            [ -f "$session/FINDINGS.md" ] || [ -f "$session/repo/FINDINGS.md" ] && has_review=" 📝"

            local created=$(grep "^Created:" "$info_file" 2>/dev/null | cut -d: -f2- | xargs | cut -d' ' -f1-2)

            if [[ "$name" == pr-* ]]; then
                local title=$(grep "^PR #" "$info_file" 2>/dev/null | head -1)
                display="${archived}🔍 ${title}${has_review} • ${created}"
            else
                local title=$(sed -n '/Investigation Focus:/,/====/p' "$info_file" 2>/dev/null | grep -v "Investigation Focus:" | grep -v "===" | grep -v "^-" | head -1 | xargs)
                title="${title:0:40}"
                display="${archived}🔬 ${title}${has_review} • ${created}"
            fi
        else
            display="❓ $name"
        fi

        options+=("$display")
    done <<< "$sessions"

    # Show selection using fzf
    local selected=$(printf '%s\n' "${options[@]}" | fzf \
        --height=~50% \
        --layout=reverse \
        --border=rounded \
        --prompt="Search: " \
        --header="Select a session • ESC to go back" \
        --header-first)

    # Handle back/cancel
    if [ -z "$selected" ] || [[ "$selected" == "← Back"* ]]; then
        return 1
    fi

    # Find matching session by index
    for i in "${!options[@]}"; do
        if [ "${options[$i]}" = "$selected" ]; then
            echo "${session_paths[$i]}"
            return 0
        fi
    done

    return 1
}

