DASHBOARD_PORT=8765
DASHBOARD_PID_FILE="$HOME/.sandbox_dashboard_pid"

start_dashboard_server() {
    # Always clean up first to ensure clean state
    cleanup_dashboard_server

    # Create the dashboard server script (always recreate to pick up code changes)
    local server_script="$SESSIONS_DIR/.dashboard_server.py"
    create_dashboard_server_script "$server_script"

    # Start the server
    cd "$SESSIONS_DIR"
    nohup python3 "$server_script" > "$SESSIONS_DIR/.dashboard.log" 2>&1 &
    local pid=$!
    echo "$pid" > "$DASHBOARD_PID_FILE"

    # Wait and verify it started (check multiple times)
    local attempts=0
    while [ $attempts -lt 10 ]; do
        sleep 0.3
        attempts=$((attempts + 1))

        # Check if process is still running
        if ! kill -0 "$pid" 2>/dev/null; then
            break  # Process died
        fi

        # Check if port is listening
        if lsof -ti:$DASHBOARD_PORT >/dev/null 2>&1; then
            return 0  # Success!
        fi
    done

    # Failed to start - show error
    error "Failed to start dashboard server"
    if [ -f "$SESSIONS_DIR/.dashboard.log" ]; then
        local log_content=$(cat "$SESSIONS_DIR/.dashboard.log" 2>/dev/null)
        if [ -n "$log_content" ]; then
            dim "Server log:"
            echo "$log_content" | tail -10
        fi
    fi
    cleanup_dashboard_server
    return 1
}

stop_dashboard_server() {
    cleanup_dashboard_server
}

cleanup_dashboard_server() {
    # Kill by PID file
    if [ -f "$DASHBOARD_PID_FILE" ]; then
        local pid=$(cat "$DASHBOARD_PID_FILE" 2>/dev/null)
        if [ -n "$pid" ]; then
            kill "$pid" 2>/dev/null
            kill -9 "$pid" 2>/dev/null  # Force kill if still alive
        fi
        rm -f "$DASHBOARD_PID_FILE"
    fi

    # Kill anything on the port (catches orphaned processes)
    local pids=$(lsof -ti:$DASHBOARD_PORT 2>/dev/null)
    if [ -n "$pids" ]; then
        echo "$pids" | xargs kill 2>/dev/null
        sleep 0.3
        # Force kill if still there
        pids=$(lsof -ti:$DASHBOARD_PORT 2>/dev/null)
        if [ -n "$pids" ]; then
            echo "$pids" | xargs kill -9 2>/dev/null
        fi
    fi

    # Wait for port to be free
    local attempts=0
    while lsof -ti:$DASHBOARD_PORT >/dev/null 2>&1 && [ $attempts -lt 10 ]; do
        sleep 0.2
        attempts=$((attempts + 1))
    done
}

is_dashboard_running() {
    # Check both PID and port
    if [ -f "$DASHBOARD_PID_FILE" ]; then
        local pid=$(cat "$DASHBOARD_PID_FILE" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            if lsof -ti:$DASHBOARD_PORT >/dev/null 2>&1; then
                return 0
            fi
        fi
    fi
    # Also check if something else is on the port
    if lsof -ti:$DASHBOARD_PORT >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

create_dashboard_server_script() {
