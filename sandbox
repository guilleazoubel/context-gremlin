    if [ ! -f "$file" ]; then
        dim "File not found: $file"
        sleep 1
        return 1
    fi

    local choice=$(gum choose \
        "📖 View in terminal (formatted)" \
        "🌐 Open in browser (rich view)" \
        "📝 Open in editor" \
        "← Back")

    case "$choice" in
        *"terminal"*)
            # Use glow if available, otherwise gum pager
            if command -v glow >/dev/null 2>&1; then
                glow -p "$file"
            else
                gum pager < "$file"
            fi
            ;;
        *"browser"*)
            generate_review_html "$file"
            ;;
        *"editor"*)
            open_in_editor "$(dirname "$file")"
            ;;
    esac
