JIRA_CONFIG="$HOME/.config/sandbox/jira.conf"

# Load saved Jira credentials
load_jira_config() {
    [ -f "$JIRA_CONFIG" ] && source "$JIRA_CONFIG"
}

# Save Jira credentials
save_jira_config() {
    mkdir -p "$(dirname "$JIRA_CONFIG")"
    cat > "$JIRA_CONFIG" << JIRACONF
JIRA_DOMAIN="$JIRA_DOMAIN"
JIRA_EMAIL="$JIRA_EMAIL"
JIRA_API_TOKEN="$JIRA_API_TOKEN"
JIRACONF
    chmod 600 "$JIRA_CONFIG"

    # Also update dashboard config with Jira base URL for clickable links
    local dashboard_config="$CONFIG_DIR/config.json"
    if [ -f "$dashboard_config" ] && [ -n "$JIRA_DOMAIN" ]; then
        local jira_url="https://$JIRA_DOMAIN/browse/"
        local tmp=$(jq --arg url "$jira_url" '.jira_base_url = $url' "$dashboard_config" 2>/dev/null)
        if [ -n "$tmp" ]; then
            echo "$tmp" > "$dashboard_config"
        fi
    fi
}

# Extract Jira ticket ID and domain from URL or input
parse_jira_input() {
    local input="$1"

    # Handle full URL: https://company.atlassian.net/browse/PROJ-123
    if [[ "$input" =~ ([a-zA-Z0-9-]+\.atlassian\.net)/browse/([A-Z]+-[0-9]+) ]]; then
        JIRA_URL_DOMAIN="${BASH_REMATCH[1]}"
        echo "${BASH_REMATCH[2]}"
    # Handle just ticket ID: PROJ-123
    elif [[ "$input" =~ ^[A-Z]+-[0-9]+$ ]]; then
        echo "$input"
    else
        echo ""
    fi
}

# Setup Jira credentials (one-time)
setup_jira_credentials() {
    echo ""
    gum style --foreground 214 --bold "Jira Setup (one-time)"
    echo ""

    # Use domain from URL if available, otherwise ask
    if [ -n "$JIRA_URL_DOMAIN" ]; then
        JIRA_DOMAIN="$JIRA_URL_DOMAIN"
        dim "Domain: $JIRA_DOMAIN (from URL)"
    else
        printf "Jira domain (e.g., company.atlassian.net): "
        read -r JIRA_DOMAIN
        [ -z "$JIRA_DOMAIN" ] && return 1
    fi

    printf "Jira email: "
    read -r JIRA_EMAIL
    [ -z "$JIRA_EMAIL" ] && return 1

    echo ""
    dim "Get API token: https://$JIRA_DOMAIN/secure/ViewProfile.jspa"
    dim "→ Security → Create API token"
    echo ""
    printf "API token: "
    read -rs JIRA_API_TOKEN
    echo ""
    [ -z "$JIRA_API_TOKEN" ] && return 1

    # Test the credentials
    dim "Testing connection..."
    local test=$(curl -s -u "$JIRA_EMAIL:$JIRA_API_TOKEN" \
        "https://$JIRA_DOMAIN/rest/api/3/myself" 2>/dev/null)

    if echo "$test" | jq -e '.accountId' >/dev/null 2>&1; then
        local name=$(echo "$test" | jq -r '.displayName')
        success "Connected as: $name"

        save_jira_config
        success "Credentials saved to ~/.config/sandbox/jira.conf"
        return 0
    else
        error "Connection failed. Check your credentials."
        return 1
    fi
}

# Fetch Jira ticket details
fetch_jira_ticket() {
    local ticket_id="$1"

    # Load saved credentials
    load_jira_config

    # Use URL domain if provided and no saved domain
    [ -z "$JIRA_DOMAIN" ] && [ -n "$JIRA_URL_DOMAIN" ] && JIRA_DOMAIN="$JIRA_URL_DOMAIN"

    # Setup credentials if needed
    if [ -z "$JIRA_DOMAIN" ] || [ -z "$JIRA_EMAIL" ] || [ -z "$JIRA_API_TOKEN" ]; then
        if ! setup_jira_credentials; then
            return 1
        fi
    fi

    dim "Fetching $ticket_id..."

    # Fetch ticket via API (including attachments)
    local response=$(curl -s -u "$JIRA_EMAIL:$JIRA_API_TOKEN" \
        -H "Content-Type: application/json" \
        "https://$JIRA_DOMAIN/rest/api/3/issue/$ticket_id?fields=summary,description,issuetype,status,priority,labels,assignee,reporter,acceptance_criteria,customfield_10016,attachment,comment" 2>/dev/null)

    # Check for errors
    if echo "$response" | jq -e '.errorMessages' >/dev/null 2>&1; then
        error "$(echo "$response" | jq -r '.errorMessages[0]')"
        return 1
    fi

    if [ -n "$response" ] && echo "$response" | jq -e '.fields' >/dev/null 2>&1; then
        echo "$response"
        return 0
    fi

    return 1
}

# Parse Jira description (handles Atlassian Document Format)
# ADF is a complex nested JSON format used by Jira Cloud
parse_jira_description() {
    local json="$1"

    # Recursive function to extract text from ADF nodes
    # Handles: paragraph, bulletList, orderedList, heading, codeBlock, text, hardBreak, mention, etc.
    local desc=$(echo "$json" | jq -r '
        def extract_text:
            if type == "array" then
                map(extract_text) | join("")
            elif type == "object" then
                if .type == "text" then
                    .text // ""
                elif .type == "hardBreak" then
                    "\n"
                elif .type == "mention" then
                    "@" + (.attrs.text // "user")
                elif .type == "emoji" then
                    .attrs.shortName // ""
                elif .type == "inlineCard" then
                    "[link]"
                elif .type == "paragraph" then
                    ((.content // []) | extract_text) + "\n"
                elif .type == "heading" then
                    "\n" + (if .attrs.level == 1 then "# " elif .attrs.level == 2 then "## " elif .attrs.level == 3 then "### " else "#### " end) + ((.content // []) | extract_text) + "\n"
                elif .type == "bulletList" then
                    "\n" + ((.content // []) | map("• " + ((.content // []) | extract_text)) | join("")) + "\n"
                elif .type == "orderedList" then
                    "\n" + ((.content // []) | to_entries | map("\(.key + 1). " + ((.value.content // []) | extract_text)) | join("")) + "\n"
                elif .type == "listItem" then
                    ((.content // []) | extract_text)
                elif .type == "codeBlock" then
                    "\n```" + (.attrs.language // "") + "\n" + ((.content // []) | extract_text) + "```\n"
                elif .type == "blockquote" then
                    "\n> " + ((.content // []) | extract_text | gsub("\n"; "\n> ")) + "\n"
                elif .type == "rule" then
                    "\n---\n"
                elif .type == "table" then
                    "\n[Table content]\n"
                elif .type == "panel" then
                    "\n> **" + (.attrs.panelType // "Note") + "**: " + ((.content // []) | extract_text) + "\n"
                elif .type == "expand" then
                    "\n**" + (.attrs.title // "Details") + "**\n" + ((.content // []) | extract_text)
                elif .type == "mediaSingle" or .type == "mediaGroup" then
                    "\n[Image/Media]\n"
                else
                    ((.content // []) | extract_text)
                end
            else
                ""
            end;
        .fields.description.content // [] | extract_text
    ' 2>/dev/null)

    # Clean up excessive newlines
    desc=$(echo "$desc" | sed '/^$/N;/^\n$/d' | sed 's/\n\n\n*/\n\n/g')

    # Fallback to plain text if ADF parsing fails or is empty
    if [ -z "$desc" ] || [ "$desc" = "null" ]; then
        desc=$(echo "$json" | jq -r '.fields.description // "No description"' 2>/dev/null)
        # If it's still an object (ADF that jq couldn't parse), show a message
        if echo "$desc" | jq -e '.content' >/dev/null 2>&1; then
            desc="[Complex ADF content - see Jira ticket for full formatting]"
        fi
    fi

    echo "$desc"
}

# Format Jira ticket for display and context
format_jira_context() {
    local ticket_json="$1"
    local ticket_id="$2"

    local summary=$(echo "$ticket_json" | jq -r '.fields.summary // "No summary"')
    local issue_type=$(echo "$ticket_json" | jq -r '.fields.issuetype.name // "Unknown"')
    local status=$(echo "$ticket_json" | jq -r '.fields.status.name // "Unknown"')
    local priority=$(echo "$ticket_json" | jq -r '.fields.priority.name // "Unknown"')
    local assignee=$(echo "$ticket_json" | jq -r '.fields.assignee.displayName // "Unassigned"')
    local reporter=$(echo "$ticket_json" | jq -r '.fields.reporter.displayName // "Unknown"')
    local labels=$(echo "$ticket_json" | jq -r '.fields.labels | join(", ") // ""')
    local description=$(parse_jira_description "$ticket_json")

    # Store ticket type for guidance
    JIRA_TICKET_TYPE="$issue_type"

    cat << JIRA_CTX
## Jira Ticket: $ticket_id

| Field | Value |
|-------|-------|
| **Type** | $issue_type |
| **Status** | $status |
| **Priority** | $priority |
| **Assignee** | $assignee |
| **Reporter** | $reporter |
$([ -n "$labels" ] && echo "| **Labels** | $labels |")

### Summary
$summary

### Description
$description
JIRA_CTX

    # Add attachments (especially images)
    local attachments=$(echo "$ticket_json" | jq -r '
        .fields.attachment // [] |
        map(select(.mimeType | startswith("image/"))) |
        if length > 0 then
            "### Attached Images\n\n" +
            (map("- **\(.filename)**: \(.content)") | join("\n"))
        else
            empty
        end
    ' 2>/dev/null)

    if [ -n "$attachments" ]; then
        echo ""
        echo "$attachments"
    fi

    # Add all attachments list
    local all_attachments=$(echo "$ticket_json" | jq -r '
        .fields.attachment // [] |
        if length > 0 then
            "\n### All Attachments\n\n" +
            (map("- [\(.filename)](\(.content)) (\(.mimeType))") | join("\n"))
        else
            empty
        end
    ' 2>/dev/null)

    if [ -n "$all_attachments" ]; then
        echo "$all_attachments"
    fi

    # Add comments
    local comments=$(echo "$ticket_json" | jq -r '
        .fields.comment.comments // [] |
        if length > 0 then
            "\n### Comments (" + (length | tostring) + ")\n\n" +
            (map(
                "---\n**" + (.author.displayName // "Unknown") + "** - " +
                (.created | split("T")[0]) + "\n\n" +
                (
                    .body.content // [] |
                    map(
                        if .type == "paragraph" then
                            ([.content[]? | .text // empty] | join(""))
                        elif .type == "codeBlock" then
                            "```\n" + ([.content[]? | .text // empty] | join("")) + "\n```"
                        else
                            ""
                        end
                    ) | join("\n")
                )
            ) | join("\n\n"))
        else
            empty
        end
    ' 2>/dev/null)

    if [ -n "$comments" ]; then
        echo "$comments"
    fi
}

# Extract Jira ticket ID from branch name
# e.g., "HB-404-find-user-not-working" -> "HB-404"
# e.g., "feature/PROJ-123-new-login" -> "PROJ-123"
# e.g., "hb-404-lowercase" -> "HB-404" (converts to uppercase)
extract_jira_from_branch() {
    local branch="$1"
    # Trim whitespace
    branch=$(echo "$branch" | xargs)
    [ -z "$branch" ] && return

    # Match patterns like PROJ-123, HB-404, hb-404, etc. (case-insensitive)
    # Pattern: 2+ letters, hyphen, 1+ digits
    # Convert to uppercase for Jira
    if [[ "$branch" =~ ([A-Za-z][A-Za-z]+-[0-9]+) ]]; then
        echo "${BASH_REMATCH[1]}" | tr '[:lower:]' '[:upper:]'
    fi
}

# Prompt user for optional Jira ticket
prompt_jira_ticket() {
    local context_type="$1"  # "pr" or "investigation"
    local branch_name="$2"   # optional: branch name to extract ticket from

    # Try to extract Jira ticket from branch name
    local suggested_ticket=""
    if [ -n "$branch_name" ]; then
        suggested_ticket=$(extract_jira_from_branch "$branch_name")
    fi

    echo ""
    local jira_input=""

    if [ -n "$suggested_ticket" ]; then
        # Found ticket in branch name - offer 3 choices
        local jira_choice=$(printf '%s\n' \
            "✓ Yes, link $suggested_ticket" \
            "✏️  Link different ticket" \
            "⏭  Skip" | fzf \
            --height=~30% \
            --layout=reverse \
            --border=rounded \
            --no-info \
            --prompt="" \
            --header="Link Jira ticket $suggested_ticket (from branch name)?" \
            --header-first)

        case "$jira_choice" in
            *"Yes"*)
                jira_input="$suggested_ticket"
                ;;
            *"different"*)
                echo ""
                dim "Enter Jira ticket URL or ID:"
                printf "Jira: "
                read -r jira_input
                [ -z "$jira_input" ] && return 1
                ;;
            *)
                echo ""
                return 1
                ;;
        esac
    else
        # No ticket found in branch - ask normally
        local jira_choice=$(printf '%s\n' \
            "✓ Yes, link a ticket" \
            "⏭  Skip" | fzf \
            --height=~25% \
            --layout=reverse \
            --border=rounded \
            --no-info \
            --prompt="" \
            --header="Link a Jira ticket for additional context?" \
            --header-first)

        case "$jira_choice" in
            *"Yes"*)
                echo ""
                dim "Enter Jira ticket URL or ID (e.g., PROJ-123 or https://company.atlassian.net/browse/PROJ-123)"
                printf "Jira: "
                read -r jira_input
                [ -z "$jira_input" ] && return 1
                ;;
            *)
                echo ""
                return 1
                ;;
        esac
    fi

    JIRA_URL_DOMAIN=""
    local ticket_id=$(parse_jira_input "$jira_input")

    if [ -z "$ticket_id" ]; then
        error "Could not parse Jira ticket ID"
        sleep 1
        return 1
    fi

    # Fetch ticket details
    local ticket_json=$(fetch_jira_ticket "$ticket_id")

    if [ -n "$ticket_json" ]; then
        JIRA_TICKET_ID="$ticket_id"
        JIRA_TICKET_JSON="$ticket_json"
        JIRA_CONTEXT=$(format_jira_context "$ticket_json" "$ticket_id")

        # Show summary
        echo ""
        local summary=$(echo "$ticket_json" | jq -r '.fields.summary')
        local type=$(echo "$ticket_json" | jq -r '.fields.issuetype.name')
        success "✓ $type: $summary"
        return 0
    fi

    # Fallback: manual input
    echo ""
    dim "Could not fetch from Jira. Enter details manually?"
    echo ""

    local jira_type=$(gum choose --header "Ticket type:" \
        "Story" \
        "Bug" \
        "Task" \
        "Spike" \
        "Epic" \
        "Skip")

    [ "$jira_type" = "Skip" ] && return 1

    echo ""
    dim "Paste the ticket description/acceptance criteria (empty line to finish):"
    local jira_desc=""
    while IFS= read -r line; do
        [ -z "$line" ] && break
        jira_desc="${jira_desc}${line}"$'\n'
    done

    if [ -n "$jira_desc" ]; then
        JIRA_TICKET_ID="$ticket_id"
        JIRA_TICKET_TYPE="$jira_type"
        JIRA_CONTEXT=$(cat << MANUAL_JIRA
## Jira Ticket: $ticket_id

- **Type**: $jira_type

### Description / Acceptance Criteria
$jira_desc
MANUAL_JIRA
)
        return 0
    fi

    return 1
}

# Generate Jira context for CLAUDE.md based on ticket type
generate_jira_guidance() {
    local ticket_type="$1"
    local context_type="$2"  # "pr" or "investigation"

    case "$ticket_type" in
        "Story"|"story")
            if [ "$context_type" = "pr" ]; then
                cat << 'STORY_PR'

### Jira Context Guidance (Story)
This PR implements a **Story**. When reviewing:
1. **Acceptance Criteria**: Verify all acceptance criteria from the ticket are met
2. **User Value**: Ensure the implementation delivers the intended user value
3. **Scope**: Check that the PR doesn't exceed or fall short of the story scope
4. **Edge Cases**: Consider edge cases that may not be explicitly stated
STORY_PR
            else
                cat << 'STORY_INV'

### Jira Context Guidance (Story)
This investigation is for a **Story**. Goals:
1. Understand what user value we're trying to deliver
2. Identify the best technical approach to implement
3. Consider edge cases and potential challenges
4. Propose a solution that meets acceptance criteria
STORY_INV
            fi
            ;;
        "Bug"|"bug")
            if [ "$context_type" = "pr" ]; then
                cat << 'BUG_PR'

### Jira Context Guidance (Bug Fix)
This PR fixes a **Bug**. When reviewing:
1. **Root Cause**: Verify the fix addresses the root cause, not just symptoms
2. **Regression**: Ensure the fix doesn't introduce new issues
3. **Test Coverage**: Check for tests that prevent regression
4. **Scope**: Bug fixes should be minimal and focused
BUG_PR
            else
                cat << 'BUG_INV'

### Jira Context Guidance (Bug)
This investigation is for a **Bug**. Goals:
1. Reproduce and understand the bug behavior
2. Identify the root cause (not just symptoms)
3. Determine the minimal fix required
4. Consider potential side effects of the fix
BUG_INV
            fi
            ;;
        "Task"|"task")
            cat << 'TASK_CTX'

### Jira Context Guidance (Task)
This is a **Task** (technical work). Focus on:
1. Technical correctness and best practices
2. Maintainability and code quality
3. Documentation if applicable
TASK_CTX
            ;;
        "Spike"|"spike")
            cat << 'SPIKE_CTX'

### Jira Context Guidance (Spike)
This is a **Spike** (research/exploration). Goals:
1. Gather information and understanding
2. Evaluate options and trade-offs
3. Document findings and recommendations
4. Provide estimates for implementation
SPIKE_CTX
            ;;
        *)
            echo ""
            ;;
    esac
}

