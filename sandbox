SESSIONS_DIR="$HOME/Agent-temp"
mkdir -p "$SESSIONS_DIR"

# ============================================================================
# CONFIGURATION SYSTEM
# ============================================================================

CONFIG_DIR="$HOME/.sandbox"
CONFIG_FILE="$CONFIG_DIR/config"

# Default configuration values
DEFAULT_MODEL="sonnet"
DEFAULT_DASHBOARD_AUTO_START="true"
DEFAULT_PROJECT=""

# Current configuration (loaded at startup)
MODEL="${DEFAULT_MODEL}"
DASHBOARD_AUTO_START="${DEFAULT_DASHBOARD_AUTO_START}"
DEFAULT_PROJECT="${DEFAULT_PROJECT}"

# Load configuration from file
load_config() {
    mkdir -p "$CONFIG_DIR"

    if [ -f "$CONFIG_FILE" ]; then
        # Source the config file to load variables
        while IFS='=' read -r key value; do
            # Skip comments and empty lines
            [[ "$key" =~ ^[[:space:]]*# ]] && continue
            [[ -z "$key" ]] && continue

            # Remove leading/trailing whitespace and quotes
            key=$(echo "$key" | xargs)
            value=$(echo "$value" | sed 's/^["'\'']\|["'\'']$//g' | xargs)

            case "$key" in
                MODEL) MODEL="$value" ;;
                DASHBOARD_AUTO_START) DASHBOARD_AUTO_START="$value" ;;
                DEFAULT_PROJECT) DEFAULT_PROJECT="$value" ;;
            esac
        done < "$CONFIG_FILE"
    fi
}

# Save configuration to file
save_config() {
    mkdir -p "$CONFIG_DIR"

    cat > "$CONFIG_FILE" << EOF
# Sandbox Configuration
# Generated: $(date '+%Y-%m-%d %H:%M:%S')

# Claude model to use (sonnet/opus/haiku)
MODEL="$MODEL"

# Auto-start dashboard when sandbox launches (true/false)
DASHBOARD_AUTO_START="$DASHBOARD_AUTO_START"

# Default project path (last used or set manually)
DEFAULT_PROJECT="$DEFAULT_PROJECT"
EOF
    chmod 600 "$CONFIG_FILE"
}

# Load config at startup
load_config

# ============================================================================
# DEPENDENCY CHECK
# ============================================================================

check_dependencies() {
    local missing=()

    command -v gum >/dev/null 2>&1 || missing+=("gum")
    command -v fzf >/dev/null 2>&1 || missing+=("fzf")
    command -v gh >/dev/null 2>&1 || missing+=("gh")
    command -v jq >/dev/null 2>&1 || missing+=("jq")
    command -v git >/dev/null 2>&1 || missing+=("git")
    command -v claude >/dev/null 2>&1 || missing+=("claude")

    if [ ${#missing[@]} -gt 0 ]; then
        echo "Missing dependencies: ${missing[*]}"
        echo ""
        echo "Install with:"
        for dep in "${missing[@]}"; do
            case "$dep" in
                gum) echo "  brew install gum" ;;
                fzf) echo "  brew install fzf" ;;
                gh) echo "  brew install gh" ;;
                jq) echo "  brew install jq" ;;
                git) echo "  brew install git" ;;
                claude) echo "  npm install -g @anthropic-ai/claude-code" ;;
            esac
        done
        exit 1
    fi

    # Check for optional dependencies
    HAS_ACR=false
    if command -v acr >/dev/null 2>&1; then
        HAS_ACR=true
    fi
}

check_dependencies

