archive_session() {
    local SESSION_DIR="$1"
    local SESSION_NAME=$(basename "$SESSION_DIR")

    # REVIEW.md and FINDINGS.md are already in session root (repo has symlinks)
    # Just save CLAUDE.md if it exists and isn't a symlink
    if [ -f "$SESSION_DIR/repo/CLAUDE.md" ] && [ ! -L "$SESSION_DIR/repo/CLAUDE.md" ]; then
        cp "$SESSION_DIR/repo/CLAUDE.md" "$SESSION_DIR/"
    fi

    # Delete repo folder (symlinks will be deleted with it, actual files stay in session root)
    rm -rf "$SESSION_DIR/repo"

    # Mark as archived
    echo "ARCHIVED: $(date '+%Y-%m-%d %H:%M:%S')" >> "$SESSION_DIR/session-info.txt"

    success "Session archived (repo deleted, review/findings kept)"
}

is_archived() {
    local SESSION_DIR="$1"
    [ ! -d "$SESSION_DIR/repo" ] && [ -f "$SESSION_DIR/session-info.txt" ]
}

refresh_pr_session() {
    local SESSION_DIR="$1"
    local INFO_FILE="$SESSION_DIR/session-info.txt"

    if ! grep -q "^Type:.*PR" "$INFO_FILE" 2>/dev/null; then
        error "This is not a PR session"
        sleep 2
        return 1
    fi

    local PR_NUMBER=$(grep "^PR #" "$INFO_FILE" 2>/dev/null | head -1 | sed 's/PR #\([0-9]*\).*/\1/')
    local REPO=$(grep "^Repository:" "$INFO_FILE" 2>/dev/null | head -1 | cut -d: -f2 | xargs)
    local PR_BASE=$(grep "^Branch:" "$INFO_FILE" 2>/dev/null | head -1 | sed 's/.*→ //' | xargs)

    if [ -z "$PR_NUMBER" ] || [ -z "$REPO" ]; then
        error "Could not find PR info in session"
        sleep 2
        return 1
    fi

    cd "$SESSION_DIR/repo" || return 1

    # Get current commit before refresh
    local OLD_COMMIT=$(git rev-parse HEAD 2>/dev/null)

    echo ""
    gum spin --spinner dot --title "Fetching latest PR changes..." -- \
        bash -c "git fetch origin 'pull/$PR_NUMBER/head:pr-$PR_NUMBER-new' 2>&1"

    local NEW_COMMIT=$(git rev-parse "pr-$PR_NUMBER-new" 2>/dev/null)

    if [ "$OLD_COMMIT" = "$NEW_COMMIT" ]; then
        success "PR is already up to date (no new commits)"
        sleep 2
        return 0
    fi

    # Show what changed
    local NEW_COMMITS=$(git log --oneline "$OLD_COMMIT".."$NEW_COMMIT" 2>/dev/null)
    local COMMIT_COUNT=$(echo "$NEW_COMMITS" | grep -c . || echo "0")

    echo ""
    gum style --foreground 82 --bold "Found $COMMIT_COUNT new commit(s):"
    echo ""
    echo "$NEW_COMMITS" | head -10
    [ "$COMMIT_COUNT" -gt 10 ] && dim "... and $((COMMIT_COUNT - 10)) more"
    echo ""

    if ! gum confirm "Update to latest and prepare re-review?"; then
        return 0
    fi

    # Checkout new version
    git checkout "pr-$PR_NUMBER-new" 2>/dev/null
    git branch -D "pr-$PR_NUMBER" 2>/dev/null
    git branch -m "pr-$PR_NUMBER" 2>/dev/null

    # Get new diff stats
    local NEW_DIFF_STAT=$(git diff --stat "$PR_BASE"..."pr-$PR_NUMBER" 2>/dev/null || echo "")
    local NEW_CHANGED_FILES=$(git diff --name-only "$PR_BASE"..."pr-$PR_NUMBER" 2>/dev/null || echo "")
    local CHANGES_SINCE=$(git diff --stat "$OLD_COMMIT"..."pr-$PR_NUMBER" 2>/dev/null || echo "")

    # Update session info with refresh timestamp
    echo "" >> "$INFO_FILE"
    echo "REFRESHED: $(date '+%Y-%m-%d %H:%M:%S')" >> "$INFO_FILE"
    echo "Previous commit: $OLD_COMMIT" >> "$INFO_FILE"
    echo "New commit: $NEW_COMMIT" >> "$INFO_FILE"
    echo "New commits: $COMMIT_COUNT" >> "$INFO_FILE"

    # Archive old REVIEW.md if it exists (files are in session root)
    local version=1
    while [ -f "$SESSION_DIR/REVIEW-v${version}.md" ]; do
        ((version++))
    done

    if [ -f "$SESSION_DIR/REVIEW.md" ] && [ -s "$SESSION_DIR/REVIEW.md" ]; then
        cp "$SESSION_DIR/REVIEW.md" "$SESSION_DIR/REVIEW-v${version}.md"
        success "Archived previous review as REVIEW-v${version}.md"
    fi

    local next_version=$((version + 1))

    # Create RE-REVIEW.md with streamlined instructions
    cat > "$SESSION_DIR/repo/RE-REVIEW.md" << REREVIEW_EOF
# Re-Review: v${next_version}

## What Changed

| Info | Value |
|------|-------|
| **Previous** | v${version} (commit \`${OLD_COMMIT:0:8}\`) |
| **Current** | v${next_version} (commit \`${NEW_COMMIT:0:8}\`) |
| **New Commits** | ${COMMIT_COUNT} |

### New Commits
\`\`\`
$NEW_COMMITS
\`\`\`

### Files Changed Since Last Review
\`\`\`
$CHANGES_SINCE
\`\`\`

---

## Re-Review Instructions

**Update REVIEW.md in-place. Do NOT append sections.**

### 1. Check Each Open Finding
For each finding in "Open Findings":
- **Fixed?** → Move to "Resolved Findings", note the fix
- **Still present?** → Keep in place
- **Partially fixed?** → Update the description

### 2. Update the Tracker Table
\`\`\`markdown
| ID | Finding | Severity | Status | Since |
|----|---------|----------|--------|-------|
| 1 | Null check missing | 🔴 Critical | ✅ Fixed | v1→v${next_version} |
| 2 | SQL injection | 🟠 High | ⚠️ Open | v1 |
| 3 | New issue found | 🟡 Medium | ⚠️ Open | v${next_version} |
\`\`\`

### 3. Check for New Issues
Review the new commits for any NEW problems introduced.
Add new findings with "Since: v${next_version}"

### 4. Update Review History (IMPORTANT!)
The Review History table MUST have a new row for this version. Find the table that looks like:
\`\`\`markdown
## Review History

| Version | Date | Commit | Action |
|---------|------|--------|--------|
| v1 | 2026-01-27 | e627b8f | Initial review - Approved |
\`\`\`

ADD a new row (do NOT replace existing rows):
\`\`\`markdown
| v${next_version} | $(date '+%Y-%m-%d') | ${NEW_COMMIT:0:8} | Re-review: X fixed, Y new issues |
\`\`\`

### 5. Update Verdict
Re-evaluate based on current state of ALL findings (fixed + remaining + new).

---

**CRITICAL: The Review History table must show ALL versions (v1, v2, etc). Do NOT remove previous rows.**

**BEGIN: Read REVIEW.md, check findings against new code, update in-place.**
REREVIEW_EOF

    success "PR refreshed! RE-REVIEW.md created with instructions"
    sleep 1

    # Update CLAUDE.md to reference RE-REVIEW.md
    if [ -f "$SESSION_DIR/repo/CLAUDE.md" ]; then
        # Remove any previous re-review notice
        sed -i '' '/^# ⚠️ RE-REVIEW MODE/,/^---$/d' "$SESSION_DIR/repo/CLAUDE.md" 2>/dev/null || true

        # Prepend new re-review notice
        local temp_file=$(mktemp)
        cat > "$temp_file" << NOTICE_EOF
# ⚠️ RE-REVIEW MODE (v${next_version})

**PR updated: ${COMMIT_COUNT} new commit(s) since last review.**

## What to do:
1. Read \`RE-REVIEW.md\` for what changed
2. Update \`REVIEW.md\` **in-place** (don't append sections)
3. Move fixed items to "Resolved Findings" section
4. Add any new issues found in the new commits
5. **IMPORTANT**: Add a new row to the Review History table for v${next_version}

## Review History Must Show:
- v1: Initial review
- v${next_version}: This re-review (add this row!)

---

NOTICE_EOF
        cat "$SESSION_DIR/repo/CLAUDE.md" >> "$temp_file"
        mv "$temp_file" "$SESSION_DIR/repo/CLAUDE.md"
    fi

    # Ask if user wants to start Claude immediately for re-review
    echo ""
    local rereview_action=$(printf '%s\n' \
        "▶ Start Claude re-review now" \
        "🤖 Run ACR first, then Claude" \
        "📋 Return to menu (start later)" | fzf \
        --height=~30% \
        --layout=reverse \
        --border=rounded \
        --no-info \
        --prompt="" \
        --header="Ready to re-review. What would you like to do?" \
        --header-first)

    case "$rereview_action" in
        *"Start Claude"*)
            tput reset 2>/dev/null || clear
            cd "$SESSION_DIR/repo"
            claude "RE-REVIEW MODE: PR has been updated with $COMMIT_COUNT new commit(s). Read RE-REVIEW.md for what changed, then update REVIEW.md in-place."
            return 2  # Signal that Claude was run
            ;;
        *"ACR"*)
            run_acr_quick "$SESSION_DIR" "$PR_BASE"
            tput reset 2>/dev/null || clear
            cd "$SESSION_DIR/repo"
            claude "RE-REVIEW MODE with ACR: PR has been updated. Read RE-REVIEW.md and ACR_REVIEW.md, then update REVIEW.md in-place."
            return 2  # Signal that Claude was run
            ;;
        *)
            return 0
            ;;
    esac
}

restart_session() {
    local SESSION_DIR="$1"
    local INFO_FILE="$SESSION_DIR/session-info.txt"

    # Extract repo URL and branch info
    local REPO_URL=$(grep "^URL:" "$INFO_FILE" 2>/dev/null | head -1 | cut -d' ' -f2-)

    if [ -z "$REPO_URL" ]; then
        error "Could not find repository URL in session info"
        sleep 2
        return 1
    fi

    # Check if it's a PR session
    if grep -q "^Type:.*PR" "$INFO_FILE" 2>/dev/null; then
        local PR_NUMBER=$(grep "^PR #" "$INFO_FILE" 2>/dev/null | head -1 | sed 's/PR #\([0-9]*\).*/\1/')
        local PR_BASE=$(grep "^Branch:" "$INFO_FILE" 2>/dev/null | head -1 | sed 's/.*→ //' | xargs)

        gum spin --spinner dot --title "Re-cloning repository..." -- \
            git clone --depth=50 "https://github.com/${REPO_URL}.git" "$SESSION_DIR/repo" 2>&1 || \
            git clone --depth=50 "$REPO_URL" "$SESSION_DIR/repo" 2>&1

        if [ ! -d "$SESSION_DIR/repo" ]; then
            error "Failed to clone repository"
            sleep 2
            return 1
        fi

        cd "$SESSION_DIR/repo"
        gum spin --spinner dot --title "Checking out PR branch..." -- \
            bash -c "git fetch origin 'pull/$PR_NUMBER/head:pr-$PR_NUMBER' 2>&1 && git checkout 'pr-$PR_NUMBER' 2>&1"
    else
        # Investigation session
        local BRANCH=$(grep "^Branch:" "$INFO_FILE" 2>/dev/null | head -1 | cut -d: -f2 | xargs | sed 's/ (default)//')

        # Clone with branch directly if specified (avoids fetch issues with shallow clone)
        local clone_cmd="git clone --depth=100"
        [ -n "$BRANCH" ] && clone_cmd="$clone_cmd --branch '$BRANCH'"
        clone_cmd="$clone_cmd '$REPO_URL' '$SESSION_DIR/repo'"

        gum spin --spinner dot --title "Re-cloning repository..." -- \
            bash -c "$clone_cmd 2>&1"

        if [ ! -d "$SESSION_DIR/repo" ]; then
            error "Failed to clone repository"
            sleep 2
            return 1
        fi
    fi

    # Restore CLAUDE.md to repo if it exists in session root
    [ -f "$SESSION_DIR/CLAUDE.md" ] && cp "$SESSION_DIR/CLAUDE.md" "$SESSION_DIR/repo/"

    # Setup output files with symlinks (files are in session root, symlinked to repo)
    setup_output_files "$SESSION_DIR"

    # Remove archived marker
    sed -i '' '/^ARCHIVED:/d' "$SESSION_DIR/session-info.txt" 2>/dev/null || true

    success "Session restored!"
    sleep 1
    return 0
}

pre_session_menu() {
    local SESSION_DIR="$1"
    local SESSION_NAME=$(basename "$SESSION_DIR")

    # Get PR URL if it's a PR session
    local PR_URL=""
    if [ -f "$SESSION_DIR/session-info.txt" ]; then
        PR_URL=$(grep "^URL:" "$SESSION_DIR/session-info.txt" 2>/dev/null | head -1 | cut -d: -f2- | xargs)
    fi

    # Detect session type
    local SESSION_TYPE="review"
    if [ -f "$SESSION_DIR/session-info.txt" ]; then
        grep -q "^Type:.*Investigation" "$SESSION_DIR/session-info.txt" && SESSION_TYPE="investigation"
    fi

    while true; do
        header
        gum style \
            --border rounded \
            --border-foreground 82 \
            --padding "1 2" \
            --align center \
            "Session ready: $SESSION_NAME"

        echo ""
        if [ "$SESSION_TYPE" = "investigation" ]; then
            dim "Ready to investigate. Choose how to proceed:"
        else
            dim "Explore the changes before starting the review:"
        fi
        echo ""

        # Check if this is a re-review (has RE-REVIEW.md)
        local is_rereview=""
        [ -f "$SESSION_DIR/repo/RE-REVIEW.md" ] && is_rereview="yes"

        # Get PR base branch for ACR
        local PR_BASE=""
        if [ -f "$SESSION_DIR/session-info.txt" ]; then
            PR_BASE=$(grep "^Branch:" "$SESSION_DIR/session-info.txt" 2>/dev/null | head -1 | sed 's/.*→ //' | xargs)
        fi
        [ -z "$PR_BASE" ] && PR_BASE="main"

        # Check for Codex
        local HAS_CODEX=false
        command -v codex >/dev/null 2>&1 && HAS_CODEX=true

        # Show current mode
        local current_mode=$(get_current_mode "$SESSION_DIR")

        local options=()

        if [ "$SESSION_TYPE" = "investigation" ]; then
            # Investigation session options
            options+=("🔬 Start Claude investigation")
            options+=("📝 Start Claude review (of changes vs $PR_BASE)")
        else
            # PR Review session options
            options+=("▶ Start Claude $([ -n "$is_rereview" ] && echo "re-review" || echo "review")")
            options+=("🔬 Start Claude investigation (explore codebase)")
        fi

        # Add Codex option if available
        if [ "$HAS_CODEX" = "true" ] && [ -n "$PR_URL" ]; then
            options+=("⚡ Start Codex review (+ live preview)")
        fi

        # Add ACR options if available and this is a PR session
        if [ "$HAS_ACR" = "true" ] && [ -n "$PR_URL" ]; then
            options+=("🤖 Run ACR (parallel AI reviewers)")
            options+=("🔀 ACR → Claude (ACR first, then deep dive)")
            if [ "$HAS_CODEX" = "true" ]; then
                options+=("🚀 ACR → Codex (+ live preview)")
            fi
        fi

        options+=(
            "👁 Open live preview"
            "💻 Open in editor (VS Code/Cursor)"
            "📊 View diff"
        )

        if [ -n "$PR_URL" ]; then
            options+=("🌐 Open PR in browser")
            options+=("🔁 Refresh PR (fetch updates)")
        fi

        options+=("📄 View session info")
        options+=("🗑 Cancel and delete session")
        options+=("← Back to main menu")

        local choice=$(printf '%s\n' "${options[@]}" | fzf \
            --height=~50% \
            --layout=reverse \
            --border=rounded \
            --no-info \
            --prompt="" \
            --header="What would you like to do?" \
            --header-first \
            --ansi)

        case "$choice" in
            *"live preview"*)
                # Start the dashboard server (single server for all sessions)
                start_dashboard_server
                sleep 1
                ;;
            *"investigation"*)
                echo ""
                # Switch to investigation mode
                switch_to_investigation_mode "$SESSION_DIR"

                # Check if findings already exist
                local existing_findings=""
                [ -f "$SESSION_DIR/FINDINGS.md" ] && [ -s "$SESSION_DIR/FINDINGS.md" ] && existing_findings="yes"

                if [ -n "$existing_findings" ]; then
                    dim "Existing findings found. Claude will summarize and continue."
                else
                    dim "Starting investigation."
                fi
                dim "Type /exit when done to return here."
                echo ""
                sleep 1

                tput reset 2>/dev/null || clear
                cd "$SESSION_DIR/repo"

                if [ -n "$existing_findings" ]; then
                    claude "Read FINDINGS.md and give me a brief summary of the key discoveries (bullet points, max 5-7 items). Then let me know you're ready to continue the investigation."
                else
                    claude "Begin"
                fi

                post_session_menu "$SESSION_DIR"
                return 0
                ;;
            *"review"*|*"re-review"*)
                echo ""
                # Switch to review mode
                switch_to_review_mode "$SESSION_DIR"

                # Check if review already exists (files are in session root)
                local existing_review=""
                [ -f "$SESSION_DIR/REVIEW.md" ] && [ -s "$SESSION_DIR/REVIEW.md" ] && existing_review="yes"

                if [ -n "$existing_review" ]; then
                    dim "Existing review found. Claude will summarize and continue."
                else
                    dim "Starting review."
                fi
                dim "Type /exit when done to return here."
                echo ""
                sleep 1

                tput reset 2>/dev/null || clear
                cd "$SESSION_DIR/repo"

                if [ -n "$existing_review" ]; then
                    claude "Read REVIEW.md and give me a brief summary of the key findings (bullet points, max 5-7 items). Then let me know you're ready to discuss or continue refining the review."
                else
                    claude "Begin"
                fi

                post_session_menu "$SESSION_DIR"
                return 0
                ;;
            *"Run ACR"*)
                run_acr_review "$SESSION_DIR" "$PR_BASE"
                ;;
            *"ACR → Claude"*)
                # Run ACR first, then go directly to Claude (no confirmation)
                run_acr_quick "$SESSION_DIR" "$PR_BASE"
                tput reset 2>/dev/null || clear
                cd "$SESSION_DIR/repo"
                claude "I've received ACR review results in the CLAUDE.md context. Please analyze them and create a comprehensive REVIEW.md."
                post_session_menu "$SESSION_DIR"
                return 0
                ;;
            *"Start Codex"*)
                run_codex_review "$SESSION_DIR" "$PR_BASE" "false"
                post_session_menu "$SESSION_DIR"
                return 0
                ;;
            *"ACR → Codex"*)
                run_codex_review "$SESSION_DIR" "$PR_BASE" "true"
                post_session_menu "$SESSION_DIR"
                return 0
                ;;
            *"editor"*|*"VS Code"*|*"Cursor"*)
                open_in_editor "$SESSION_DIR/repo"
                ;;
            *"View diff"*)
                view_diff "$SESSION_DIR"
                ;;
            *"Switch mode"*)
                prompt_mode_switch "$SESSION_DIR"
                ;;
            *"Open PR"*)
                if [ -n "$PR_URL" ]; then
                    # Open directly to Files Changed tab
                    open "${PR_URL}/files" 2>/dev/null || xdg-open "${PR_URL}/files" 2>/dev/null || true
                    success "Opened PR files in browser"
                    sleep 1
                fi
                ;;
            *"Refresh PR"*)
                refresh_pr_session "$SESSION_DIR"
                ;;
            *"session info"*)
                if [ -f "$SESSION_DIR/session-info.txt" ]; then
                    gum pager < "$SESSION_DIR/session-info.txt"
                fi
                ;;
            *"Cancel"*|*"delete"*)
                if gum confirm --default=false "Delete this session?"; then
                    rm -rf "$SESSION_DIR"
                    success "Session deleted"
                    sleep 1
                    return 1
                fi
                ;;
            *"Back to main"*)
                return 1
                ;;
            *)
                # ESC pressed or empty selection - go back
                return 1
                ;;
        esac
    done
}

post_session_menu() {
    local SESSION_DIR="$1"
    local SESSION_NAME=$(basename "$SESSION_DIR")

    # Get PR URL if it's a PR session
    local PR_URL=""
    if [ -f "$SESSION_DIR/session-info.txt" ]; then
        PR_URL=$(grep "^URL:" "$SESSION_DIR/session-info.txt" 2>/dev/null | head -1 | cut -d: -f2- | xargs)
    fi

    # Find review/findings files (stored in session root, symlinked to repo)
    local review_file=""
    local findings_file=""
    [ -f "$SESSION_DIR/REVIEW.md" ] && [ -s "$SESSION_DIR/REVIEW.md" ] && review_file="$SESSION_DIR/REVIEW.md"
    [ -f "$SESSION_DIR/FINDINGS.md" ] && [ -s "$SESSION_DIR/FINDINGS.md" ] && findings_file="$SESSION_DIR/FINDINGS.md"

    while true; do
        header
        gum style \
            --border rounded \
            --border-foreground 240 \
            --padding "1 2" \
            --align center \
            "Session: $SESSION_NAME"

        echo ""

        # Show what output files exist
        local has_output=false
        if [ -n "$review_file" ] || [ -n "$findings_file" ]; then
            has_output=true
            local output_info=""
            [ -n "$review_file" ] && output_info="Review"
            [ -n "$findings_file" ] && output_info="${output_info:+$output_info + }Findings"
            gum style --foreground 82 "📝 $output_info available"
            echo ""
        fi

        local options=(
            "↩ Resume Claude"
            "💻 Open in editor"
            "🖥️  Open Terminal in repo"
            "📊 View diff"
        )

        # Add PR-specific options
        if [ -n "$PR_URL" ]; then
            options+=("🌐 Open PR in browser")
            options+=("🔄 Refresh PR (check for updates)")
        fi

        # Add output file options if they exist
        if [ "$has_output" = "true" ]; then
            options+=("📖 View output (nice)")
            options+=("👁 Open live preview (auto-refresh)")
            options+=("📋 Copy to clipboard")
        fi

        options+=(
            "🔄 Switch mode (Review ↔ Investigation)"
            "📄 View session info"
            "───────────────"
            "📁 Keep session"
            "📦 Archive (keep review, delete repo)"
            "🗑 Delete everything"
            "← Back to main menu"
        )

        local choice=$(printf '%s\n' "${options[@]}" | fzf \
            --height=~50% \
            --layout=reverse \
            --border=rounded \
            --no-info \
            --prompt="" \
            --header="What next?" \
            --header-first)

        case "$choice" in
            *"Resume Claude"*)
                tput reset 2>/dev/null || clear
                cd "$SESSION_DIR/repo"

                # Determine current mode and appropriate file
                local mode=$(get_current_mode "$SESSION_DIR")
                local output_file=""
                local prompt=""

                if [ "$mode" = "development" ]; then
                    [ -f "$SESSION_DIR/repo/DEVLOG.md" ] && [ -s "$SESSION_DIR/repo/DEVLOG.md" ] && output_file="DEVLOG.md"
                    prompt="Read DEVLOG.md and give me a brief summary of the progress so far (bullet points). Then let me know you're ready to continue development."
                elif [ "$mode" = "investigation" ]; then
                    [ -f "$SESSION_DIR/repo/FINDINGS.md" ] && [ -s "$SESSION_DIR/repo/FINDINGS.md" ] && output_file="FINDINGS.md"
                    prompt="Read FINDINGS.md and give me a brief summary of the key discoveries (bullet points, max 5-7 items). Then let me know you're ready to continue the investigation or discuss the findings."
                else
                    [ -f "$SESSION_DIR/repo/REVIEW.md" ] && [ -s "$SESSION_DIR/repo/REVIEW.md" ] && output_file="REVIEW.md"
                    prompt="Read REVIEW.md and give me a brief summary of the key findings (bullet points, max 5-7 items). Highlight any critical or high-severity issues. Then let me know you're ready to discuss, refine, or update the review."
                fi

                if [ -n "$output_file" ]; then
                    claude "$prompt"
                else
                    claude -c
                fi
                ;;
            *"editor"*)
                open_in_editor "$SESSION_DIR/repo"
                ;;
            *"Terminal"*)
                open_terminal_in_repo "$SESSION_DIR"
                ;;
            *"View diff"*)
                view_diff "$SESSION_DIR"
                ;;
            *"Open PR in browser"*)
                if [ -n "$PR_URL" ]; then
                    open "${PR_URL}/files" 2>/dev/null || xdg-open "${PR_URL}/files" 2>/dev/null || true
                fi
                ;;
            *"Refresh PR"*)
                if refresh_pr_session "$SESSION_DIR"; then
                    # Re-check files after refresh
                    review_file=""
                    findings_file=""
                    [ -f "$SESSION_DIR/REVIEW.md" ] && [ -s "$SESSION_DIR/REVIEW.md" ] && review_file="$SESSION_DIR/REVIEW.md"
                    [ -f "$SESSION_DIR/FINDINGS.md" ] && [ -s "$SESSION_DIR/FINDINGS.md" ] && findings_file="$SESSION_DIR/FINDINGS.md"
                fi
                ;;
            *"View output"*)
                # Let user choose which file to view
                local view_choice=""
                if [ -n "$review_file" ] && [ -n "$findings_file" ]; then
                    view_choice=$(printf '%s\n' "REVIEW.md" "FINDINGS.md" "Both" | fzf \
                        --height=~20% \
                        --layout=reverse \
                        --border=rounded \
                        --no-info \
                        --prompt="" \
                        --header="Which file?" \
                        --header-first)
                elif [ -n "$review_file" ]; then
                    view_choice="REVIEW.md"
                else
                    view_choice="FINDINGS.md"
                fi

                case "$view_choice" in
                    "REVIEW.md") view_markdown_nice "$SESSION_DIR/REVIEW.md" ;;
                    "FINDINGS.md") view_markdown_nice "$SESSION_DIR/FINDINGS.md" ;;
                    "Both")
                        view_markdown_nice "$SESSION_DIR/REVIEW.md"
                        view_markdown_nice "$SESSION_DIR/FINDINGS.md"
                        ;;
                esac
                ;;
            *"live preview"*)
                # Choose preview mode
                local preview_mode=$(printf '%s\n' \
                    "🔄 Open Dashboard (all sessions)" \
                    "📄 Static HTML (this session only)" \
                    "🛑 Stop dashboard server" \
                    "← Cancel" | fzf \
                    --height=~30% \
                    --layout=reverse \
                    --border=rounded \
                    --no-info \
                    --prompt="" \
                    --header="Preview mode" \
                    --header-first)

                case "$preview_mode" in
                    *"Dashboard"*)
                        start_dashboard_server
                        sleep 1
                        ;;
                    *"Static HTML"*)
                        local static_file="$SESSION_DIR/preview.html"
                        create_static_preview "$SESSION_DIR" "$static_file"
                        open "$static_file" 2>/dev/null
                        success "Opened static preview - refresh browser to see updates"
                        sleep 1
                        ;;
                    *"Stop"*)
                        stop_dashboard_server
                        sleep 1
                        ;;
                esac
                ;;
            *"Copy"*"clipboard"*)
                # Let user choose which file to copy
                local copy_choice=""
                if [ -n "$review_file" ] && [ -n "$findings_file" ]; then
                    copy_choice=$(printf '%s\n' "REVIEW.md" "FINDINGS.md" "Both" | fzf \
                        --height=~20% \
                        --layout=reverse \
                        --border=rounded \
                        --no-info \
                        --prompt="" \
                        --header="Which file?" \
                        --header-first)
                elif [ -n "$review_file" ]; then
                    copy_choice="REVIEW.md"
                elif [ -n "$findings_file" ]; then
                    copy_choice="FINDINGS.md"
                fi

                case "$copy_choice" in
                    "REVIEW.md")
                        cat "$SESSION_DIR/REVIEW.md" | pbcopy 2>/dev/null && success "Review copied to clipboard"
                        ;;
                    "FINDINGS.md")
                        cat "$SESSION_DIR/FINDINGS.md" | pbcopy 2>/dev/null && success "Findings copied to clipboard"
                        ;;
                    "Both")
                        { echo "# REVIEW"; cat "$SESSION_DIR/REVIEW.md"; echo -e "\n\n# FINDINGS"; cat "$SESSION_DIR/FINDINGS.md"; } | pbcopy 2>/dev/null
                        success "Both files copied to clipboard"
                        ;;
                esac
                sleep 1
                ;;
            *"Switch mode"*)
                prompt_mode_switch "$SESSION_DIR"
                ;;
            *"session info"*)
                if [ -f "$SESSION_DIR/session-info.txt" ]; then
                    gum pager < "$SESSION_DIR/session-info.txt"
                fi
                ;;
            *"Keep session"*)
                info "Session kept at: $SESSION_DIR"
                sleep 1
                return 0
                ;;
            *"Archive"*)
                if gum confirm "Archive session? (Keeps review & metadata, deletes repo)"; then
                    archive_session "$SESSION_DIR"
                    sleep 1
                fi
                return 0
                ;;
            *"Delete everything"*)
                if gum confirm --default=false "Delete this session completely?"; then
                    rm -rf "$SESSION_DIR"
                    success "Session deleted"
                    sleep 1
                fi
                return 0
                ;;
            *"───"*)
                # Separator, do nothing
                ;;
            *"Back to main"*)
                return 0
                ;;
            *)
                # ESC pressed or empty selection - go back
                return 0
                ;;
        esac
    done
}

view_diff() {
    local SESSION_DIR="$1"
    local INFO_FILE="$SESSION_DIR/session-info.txt"

    cd "$SESSION_DIR/repo"

    # Get base branch from session info
    local BASE_BRANCH=$(grep "^Branch:" "$INFO_FILE" 2>/dev/null | head -1 | sed 's/.*→ //' | xargs)

    if [ -z "$BASE_BRANCH" ]; then
        BASE_BRANCH="main"
    fi

    local choice=$(gum choose \
        "📊 Summary (stat)" \
        "📝 Full diff in pager" \
        "💻 Open diff in VS Code" \
        "← Back")

    case "$choice" in
        *"Summary"*)
            clear
            echo ""
            gum style --foreground 75 --bold "Diff Summary"
            echo ""
            git diff --stat "$BASE_BRANCH"...HEAD 2>/dev/null || git diff --stat HEAD~5
            echo ""
            read -p "Press Enter to continue..."
            ;;
        *"Full diff"*)
            # Use delta if available, otherwise git diff with color
            if command -v delta >/dev/null 2>&1; then
                git diff "$BASE_BRANCH"...HEAD 2>/dev/null | delta --paging=always
            else
                git diff "$BASE_BRANCH"...HEAD --color=always 2>/dev/null | gum pager
            fi
            ;;
        *"VS Code"*)
            # Open VS Code with git diff
            code --diff "$SESSION_DIR/repo" 2>/dev/null || {
                error "Could not open VS Code"
                sleep 2
            }
            ;;
    esac
}

# ============================================================================
# SEARCH
# ============================================================================

search_sessions() {
    header
    gum style --foreground 214 --bold "Search Sessions"
    echo ""

    printf "Search: "
    read -r query
    [ -z "$query" ] && return 0

    local results=$(grep -ril "$query" "$SESSIONS_DIR"/*/session-info.txt 2>/dev/null || true)

    if [ -z "$results" ]; then
        echo ""
        dim "No sessions found matching '$query'"
        sleep 2
        return 0
    fi

    # Build formatted options
    local sessions=()
    local options=()

    while IFS= read -r info_file; do
        [ -z "$info_file" ] && continue
        local session=$(dirname "$info_file")
        sessions+=("$session")

        local name=$(basename "$session")
        local archived=""
        grep -q "^ARCHIVED:" "$info_file" 2>/dev/null && archived="📦 "

        local has_review=""
        [ -f "$session/REVIEW.md" ] || [ -f "$session/repo/REVIEW.md" ] && has_review=" 📝"
        [ -f "$session/FINDINGS.md" ] || [ -f "$session/repo/FINDINGS.md" ] && has_review=" 📝"

        local created=$(grep "^Created:" "$info_file" 2>/dev/null | cut -d: -f2- | xargs | cut -d' ' -f1-2)

        if [[ "$name" == pr-* ]]; then
            local title=$(grep "^PR #" "$info_file" 2>/dev/null | head -1)
            options+=("${archived}🔍 ${title}${has_review} • ${created}")
        else
            local title=$(sed -n '/Investigation Focus:/,/====/p' "$info_file" 2>/dev/null | grep -v "Investigation Focus:" | grep -v "===" | grep -v "^-" | head -1 | xargs)
            options+=("${archived}🔬 ${title:0:40}${has_review} • ${created}")
        fi
    done <<< "$results"

    echo ""
    # Add back option
    local all_options=("← Back" "${options[@]}")
    local selected=$(printf '%s\n' "${all_options[@]}" | fzf \
        --height=~50% \
        --layout=reverse \
        --border=rounded \
        --no-info \
        --prompt="" \
        --header="Found ${#options[@]} match(es) for '$query'" \
        --header-first)

    if [ -z "$selected" ] || [[ "$selected" == "← Back"* ]]; then
        return 0
    fi

    # Find matching session by index
    for i in "${!options[@]}"; do
        if [ "${options[$i]}" = "$selected" ]; then
            pre_session_menu "${sessions[$i]}"
            return 0
        fi
    done
}

# ============================================================================
# CLEANUP
# ============================================================================

cleanup_sessions() {
    header
    gum style --foreground 196 --bold "Cleanup Sessions"
    echo ""

    local sessions=$(get_sessions)

    if [ -z "$sessions" ]; then
        dim "No sessions to clean up"
        sleep 2
        return 0
    fi

    # Display all sessions
    display_sessions

    # Build options for multi-select
    local session_array=()
    local options=()
    while IFS= read -r session; do
        [ -z "$session" ] && continue
        session_array+=("$session")
        local name=$(basename "$session")
        local info_file="$session/session-info.txt"

        if [ -f "$info_file" ]; then
            if [[ "$name" == pr-* ]]; then
                local title=$(grep "^PR #" "$info_file" 2>/dev/null | head -1)
                options+=("$title")
            else
                local title=$(sed -n '/Investigation Focus:/,/====/p' "$info_file" 2>/dev/null | grep -v "Investigation Focus:" | grep -v "===" | grep -v "^-" | head -1 | xargs)
                options+=("${title:0:50}")
            fi
        else
            options+=("$name")
        fi
    done <<< "$sessions"

    echo ""
    dim "Press TAB to select, Enter to confirm, ESC to cancel"
    echo ""
    local selected=$(printf '%s\n' "${options[@]}" | fzf \
        --multi \
        --height=~50% \
        --layout=reverse \
        --border=rounded \
        --no-info \
        --prompt="" \
        --header="Select sessions to delete (TAB to select)" \
        --header-first)

    if [ -z "$selected" ]; then
        return 0
    fi

    # Find and delete matching sessions
    local to_delete=()
    while IFS= read -r sel; do
        [ -z "$sel" ] && continue
        for i in "${!options[@]}"; do
            if [ "${options[$i]}" = "$sel" ]; then
                to_delete+=("${session_array[$i]}")
                break
            fi
        done
    done <<< "$selected"

    if [ ${#to_delete[@]} -eq 0 ]; then
        return 0
    fi

    echo ""
    gum style --foreground 196 "Will delete ${#to_delete[@]} session(s)"
    echo ""

    if gum confirm --default=false "Delete these sessions?"; then
        for session in "${to_delete[@]}"; do
            rm -rf "$session"
            success "Deleted: $(basename "$session")"
        done
        sleep 1
    fi
}

