main_menu() {
    while true; do
        header

        # Show dashboard status indicator
        local dashboard_status=""
        if is_dashboard_running; then
            dashboard_status="  $(gum style --foreground 82 '● Dashboard running')"
        fi
        [ -n "$dashboard_status" ] && echo "$dashboard_status" && echo ""

        local choice=$(printf '%s\n' \
            "📝 Review      - Review a PR with AI assistance" \
            "🔍 Investigate - Explore codebase for bugs/issues" \
            "🛠️  Develop     - Start new feature from Jira ticket" \
            "─────────────────────────────────────────────────" \
            "⚙️  Settings    - Configure model, dashboard, etc." \
            "📋 Sessions    - View/manage existing sessions" \
            "🌐 Dashboard   - Open live dashboard" \
            "👋 Quit" | fzf \
            --height=~50% \
            --layout=reverse \
            --border=rounded \
            --no-info \
            --prompt="" \
            --header="Choose mode:" \
            --header-first)

        case "$choice" in
            *"Review"*)
                if create_pr_session; then
                    run_claude_session "$CURRENT_SESSION"
                fi
                ;;
            *"Investigate"*)
                if create_investigation_session; then
                    run_claude_session "$CURRENT_SESSION"
                fi
                ;;
            *"Develop"*)
                if create_development_session; then
                    run_claude_session "$CURRENT_SESSION"
                fi
                ;;
            *"Settings"*)
                settings_menu
                ;;
            *"Sessions"*)
                sessions_menu
                ;;
            *"Dashboard"*)
                launch_live_dashboard
                ;;
            *"Quit"*)
                stop_dashboard_server 2>/dev/null
                clear
                exit 0
                ;;
            *"────"*|"")
                # Separator or ESC pressed - do nothing
                ;;
        esac
    done
}

launch_live_dashboard() {
    if is_dashboard_running; then
        local action=$(printf '%s\n' \
            "🌐 Open in browser" \
            "🔄 Restart server (reload code changes)" \
            "🛑 Stop server" \
            "← Back" | fzf \
            --height=~30% \
            --layout=reverse \
            --border=rounded \
            --no-info \
            --prompt="" \
            --header="Dashboard is running at http://127.0.0.1:$DASHBOARD_PORT" \
            --header-first)

        case "$action" in
            *"Open"*)
                open "http://127.0.0.1:$DASHBOARD_PORT" 2>/dev/null || \
                xdg-open "http://127.0.0.1:$DASHBOARD_PORT" 2>/dev/null || \
                gum style --foreground 87 "Open http://127.0.0.1:$DASHBOARD_PORT in your browser"
                sleep 1
                ;;
            *"Restart"*)
                dim "Stopping dashboard..."
                cleanup_dashboard_server
                sleep 0.5
                dim "Starting dashboard..."
                if start_dashboard_server; then
                    success "Dashboard restarted"
                    sleep 0.5
                    open "http://127.0.0.1:$DASHBOARD_PORT" 2>/dev/null
                else
                    error "Failed to restart dashboard"
                fi
                sleep 1
                ;;
            *"Stop"*)
                cleanup_dashboard_server
                success "Dashboard stopped"
                sleep 1
                ;;
        esac
    else
        gum spin --spinner dot --title "Starting dashboard..." -- sleep 0.5
        if start_dashboard_server; then
            success "Dashboard running at http://127.0.0.1:$DASHBOARD_PORT"
            open "http://127.0.0.1:$DASHBOARD_PORT" 2>/dev/null || \
            xdg-open "http://127.0.0.1:$DASHBOARD_PORT" 2>/dev/null || \
            gum style --foreground 87 "Open http://127.0.0.1:$DASHBOARD_PORT in your browser"

            gum style \
                --border rounded \
                --border-foreground 214 \
                --padding "1 2" \
                "Dashboard is running in the background." \
                "Select 'Live Dashboard' again to manage or stop it."
            sleep 2
        else
            error "Failed to start dashboard. Check $SESSIONS_DIR/.dashboard.log for details."
            sleep 2
        fi
    fi
}

