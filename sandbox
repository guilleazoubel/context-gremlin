            --border rounded \
            --border-foreground 240 \
            --padding "1 2" \
            --margin "1 0" \
            "[$JIRA_TYPE] $ticket_id" \
            "" \
            "$JIRA_SUMMARY"

        # Generate branch name
        BRANCH_NAME=$(generate_branch_from_jira "$ticket_id" "$JIRA_SUMMARY" "$JIRA_TYPE")
    else
        error "Could not fetch Jira ticket. Please enter details manually."
        echo ""

        printf "Ticket summary: "
        read -r JIRA_SUMMARY
        [ -z "$JIRA_SUMMARY" ] && JIRA_SUMMARY="New feature"

