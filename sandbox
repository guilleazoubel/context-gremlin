        html = html.replace(/<h2>/g, '</div><div class="section"><h2>');
        html = '<div class="section">' + html + '</div>';
        html = html.replace(/<div class="section"><\/div>/g, '');

        // Style the first section as header
        html = html.replace(/<div class="section">/, '<div class="review-header">');

        // Add verdict styling
        if (html.includes('Approve')) {
            html = html.replace(/(<li[^>]*>.*✅.*Approve[^<]*<\/li>)/i,
                '<li class="verdict-item approve">$1</li>');
        }

        document.getElementById('content').innerHTML = DOMPurify.sanitize(html);

        // Post-process: style finding items
        document.querySelectorAll('ul li, p').forEach(el => {
            const text = el.textContent;
            if (text.includes('📍') || el.querySelector('.finding-location')) {
                const parent = el.closest('.section');
                if (parent) {
                    const headerText = parent.querySelector('h2, h3')?.textContent || '';
                    let cls = 'finding';
                    if (headerText.match(/critical/i)) cls += ' finding-critical';
                    else if (headerText.match(/high/i)) cls += ' finding-high';
                    else if (headerText.match(/medium/i)) cls += ' finding-medium';
                    else if (headerText.match(/suggestion|low/i)) cls += ' finding-suggestion';
                    else if (headerText.match(/positive|good|well/i)) cls += ' finding-positive';
                    el.classList.add(...cls.split(' '));
                }
            }
        });
    </script>
</body>
</html>
HTMLEOF

    open "$html_file" 2>/dev/null || xdg-open "$html_file" 2>/dev/null || true
    success "Opened review in browser"
    sleep 1
}

