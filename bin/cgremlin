header() {
    clear
    gum style \
        --border double \
        --border-foreground 212 \
        --padding "0 2" \
        --margin "1 0" \
        --align center \
        --width 60 \
        "🧪 CONTEXT GREMLIN" \
        "Isolated environments for code work"
}

success() {
    gum style --foreground 82 "✓ $1"
}

error() {
    gum style --foreground 196 "✗ $1"
}

info() {
    gum style --foreground 75 "→ $1"
}

dim() {
    gum style --foreground 240 "$1"
}

# Setup output files in session root with symlinks in repo
# This ensures REVIEW.md and FINDINGS.md survive repo deletion
setup_output_files() {
    local SESSION_DIR="$1"

    # Write shared engineering principles file
    write_principles "$SESSION_DIR"

    # Create output files in session root if they don't exist
    [ ! -f "$SESSION_DIR/REVIEW.md" ] && touch "$SESSION_DIR/REVIEW.md"
    [ ! -f "$SESSION_DIR/FINDINGS.md" ] && touch "$SESSION_DIR/FINDINGS.md"
    [ ! -f "$SESSION_DIR/CLAUDE.md" ] && touch "$SESSION_DIR/CLAUDE.md"

    # Create symlinks in repo directory (remove existing files first)
    if [ -d "$SESSION_DIR/repo" ]; then
        # If there's already content in repo, move it to session root
        [ -f "$SESSION_DIR/repo/REVIEW.md" ] && [ ! -L "$SESSION_DIR/repo/REVIEW.md" ] && \
            mv "$SESSION_DIR/repo/REVIEW.md" "$SESSION_DIR/REVIEW.md"
        [ -f "$SESSION_DIR/repo/FINDINGS.md" ] && [ ! -L "$SESSION_DIR/repo/FINDINGS.md" ] && \
            mv "$SESSION_DIR/repo/FINDINGS.md" "$SESSION_DIR/FINDINGS.md"
        [ -f "$SESSION_DIR/repo/CLAUDE.md" ] && [ ! -L "$SESSION_DIR/repo/CLAUDE.md" ] && \
            mv "$SESSION_DIR/repo/CLAUDE.md" "$SESSION_DIR/CLAUDE.md"

        # Remove any existing files/links and create fresh symlinks
        rm -f "$SESSION_DIR/repo/REVIEW.md" "$SESSION_DIR/repo/FINDINGS.md" "$SESSION_DIR/repo/CLAUDE.md"
        ln -sf "../REVIEW.md" "$SESSION_DIR/repo/REVIEW.md"
        ln -sf "../FINDINGS.md" "$SESSION_DIR/repo/FINDINGS.md"
        ln -sf "../CLAUDE.md" "$SESSION_DIR/repo/CLAUDE.md"

        # Configure Claude permissions: allow research tools + session file writes
        mkdir -p "$SESSION_DIR/repo/.claude"
        local SESSION_NAME=$(basename "$SESSION_DIR")
        local REPO_DIR="$SESSION_DIR/repo"

        # Detect session type from name (dev-* = development, all others = review/investigation)
        local IS_DEV_SESSION=0
        case "$SESSION_NAME" in
            dev-*|session-*) IS_DEV_SESSION=1 ;;
        esac
        # Also check session.json mode for v2 sessions
        if [ "$IS_DEV_SESSION" -eq 0 ] && [ -f "$SESSION_DIR/session.json" ]; then
            local _mode
            _mode=$(python3 -c "import json,sys; d=json.load(open('$SESSION_DIR/session.json')); print(d.get('mode',''))" 2>/dev/null || true)
            [ "$_mode" = "development" ] && IS_DEV_SESSION=1
        fi

        # Build the allow list; dev/fix sessions also get repo-dir write access
        local EXTRA_REPO_PERMS=""
        if [ "$IS_DEV_SESSION" -eq 1 ]; then
            EXTRA_REPO_PERMS=',
      "Write('"$REPO_DIR"'/**)",
      "Edit('"$REPO_DIR"'/**)"'
        fi

        cat > "$SESSION_DIR/repo/.claude/settings.local.json" << CLAUDE_SETTINGS
{
  "permissions": {
    "allow": [
      "Read(*)",
      "Glob",
      "Grep",
      "Skill",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Write($SESSION_DIR/**)",
      "Edit($SESSION_DIR/**)",
      "Bash(cgremlin --approve-pr *)",
      "Bash(cgremlin --comment-pr *)",
      "Bash(cgremlin --request-changes-pr *)"$EXTRA_REPO_PERMS
    ],
    "deny": []
  },
  "hooks": {
    "Stop": [{"hooks": [{"type": "command", "command": "echo waiting > $SESSION_DIR/.cg_agent_state"}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "echo working > $SESSION_DIR/.cg_agent_state"}]}]
  }
}
CLAUDE_SETTINGS
    fi
}

# ============================================================================
# SESSION LISTING
# ============================================================================

get_sessions() {
    # Support both v1 (pr-*, inv-*, dev-*) and v2 (session-*) naming
    find "$SESSIONS_DIR" -maxdepth 1 -type d \( \
        -name "pr-*" -o -name "inv-*" -o -name "dev-*" -o -name "session-*" \
    \) 2>/dev/null | sort -r
}

format_session_display() {
    local session="$1"
    local name=$(basename "$session")
    local session_json="$session/session.json"
    local info_file="$session/session-info.txt"

    # Check for output files
    local has_output=""
    [ -f "$session/REVIEW.md" ] || [ -f "$session/repo/REVIEW.md" ] && has_output=" 📝"
    [ -f "$session/FINDINGS.md" ] || [ -f "$session/repo/FINDINGS.md" ] && has_output=" 📝"
    [ -f "$session/DEVLOG.md" ] || [ -f "$session/repo/DEVLOG.md" ] && has_output=" 📝"

    # V2 format: session.json
    if [ -f "$session_json" ]; then
        local mode=$(jq -r '.mode // "unknown"' "$session_json")
        local created=$(jq -r '.created // ""' "$session_json" | cut -dT -f1)
        local status=$(jq -r '.status // "active"' "$session_json")
        local archived=""
        [ "$status" = "archived" ] && archived=" 📦"

        case "$mode" in
            review)
                local pr_num=$(jq -r '.pr.number // ""' "$session_json")
                local pr_title=$(jq -r '.pr.title // ""' "$session_json")
                pr_title="${pr_title:0:40}"
                echo "📝 PR #$pr_num: $pr_title$archived$has_output"
                ;;
            development)
                local jira=$(jq -r '.jira.ticket // ""' "$session_json")
                local summary=$(jq -r '.jira.summary // ""' "$session_json")
                summary="${summary:0:40}"
                echo "🛠️  $jira: $summary$archived$has_output"
                ;;
            investigation)
                local focus=$(jq -r '.focus // ""' "$session_json")
                focus="${focus:0:50}"
                echo "🔍 $focus$archived$has_output"
                ;;
            *)
                echo "❓ $name$archived$has_output"
                ;;
        esac
        echo "   $name • $created"

    # V1 format: session-info.txt
    elif [ -f "$info_file" ]; then
        local created=$(grep "^Created:" "$info_file" 2>/dev/null | cut -d: -f2- | xargs)
        local archived=""
        grep -q "^ARCHIVED:" "$info_file" 2>/dev/null && archived=" 📦"

        if [[ "$name" == pr-* ]]; then
            local title=$(grep "^PR #" "$info_file" 2>/dev/null | head -1)
            echo "📝 $title$archived$has_output"
            echo "   $name • $created"
        elif [[ "$name" == dev-* ]]; then
            local jira=$(grep "^Jira:" "$info_file" 2>/dev/null | head -1 | cut -d: -f2 | xargs)
            local summary=$(grep "^Summary:" "$info_file" 2>/dev/null | head -1 | cut -d: -f2- | xargs)
            summary="${summary:0:40}"
            echo "🛠️  $jira: $summary$archived$has_output"
            echo "   $name • $created"
        else
            local title=$(sed -n '/Investigation Focus:/,/====/p' "$info_file" 2>/dev/null | grep -v "Investigation Focus:" | grep -v "===" | grep -v "^-" | head -1 | xargs)
            title="${title:0:50}"
            echo "🔍 $title$archived$has_output"
            echo "   $name • $created"
        fi
    else
        echo "❓ $name"
    fi
    echo ""
}

display_sessions() {
    local sessions=$(get_sessions)

    if [ -z "$sessions" ]; then
        dim "No active sessions"
        return 1
    fi

    while IFS= read -r session; do
        [ -z "$session" ] && continue
        format_session_display "$session"
    done <<< "$sessions"

    return 0
}

select_session_simple() {
    local sessions=$(get_sessions)

    if [ -z "$sessions" ]; then
        return 1
    fi

    # Build array with full formatted display
    local options=("← Back")
    local session_paths=("")

    while IFS= read -r session; do
        [ -z "$session" ] && continue
        session_paths+=("$session")

        local name=$(basename "$session")
        local session_json="$session/session.json"
        local info_file="$session/session-info.txt"
        local display=""

        # Check for output files
        local has_output=""
        [ -f "$session/REVIEW.md" ] || [ -f "$session/repo/REVIEW.md" ] && has_output=" 📝"
        [ -f "$session/FINDINGS.md" ] || [ -f "$session/repo/FINDINGS.md" ] && has_output=" 📝"
        [ -f "$session/DEVLOG.md" ] || [ -f "$session/repo/DEVLOG.md" ] && has_output=" 📝"

        # V2 format: session.json
        if [ -f "$session_json" ]; then
            local mode=$(jq -r '.mode // "unknown"' "$session_json")
            local created=$(jq -r '.created // ""' "$session_json" | cut -dT -f1)
            local status=$(jq -r '.status // "active"' "$session_json")
            local archived=""
            [ "$status" = "archived" ] && archived="📦 "

            case "$mode" in
                review)
                    local pr_num=$(jq -r '.pr.number // ""' "$session_json")
                    local pr_title=$(jq -r '.pr.title // ""' "$session_json")
                    pr_title="${pr_title:0:30}"
                    display="${archived}📝 PR #$pr_num: $pr_title$has_output • $created"
                    ;;
                development)
                    local jira=$(jq -r '.jira.ticket // ""' "$session_json")
                    local summary=$(jq -r '.jira.summary // ""' "$session_json")
                    summary="${summary:0:30}"
                    display="${archived}🛠️  $jira: $summary$has_output • $created"
                    ;;
                investigation)
                    local focus=$(jq -r '.focus // ""' "$session_json")
                    focus="${focus:0:40}"
                    display="${archived}🔍 $focus$has_output • $created"
                    ;;
                *)
                    display="${archived}❓ $name$has_output • $created"
                    ;;
            esac

        # V1 format: session-info.txt
        elif [ -f "$info_file" ]; then
            local archived=""
            grep -q "^ARCHIVED:" "$info_file" 2>/dev/null && archived="📦 "

            local created=$(grep "^Created:" "$info_file" 2>/dev/null | cut -d: -f2- | xargs | cut -d' ' -f1-2)

            if [[ "$name" == pr-* ]]; then
                local title=$(grep "^PR #" "$info_file" 2>/dev/null | head -1)
                display="${archived}📝 ${title}${has_output} • ${created}"
            elif [[ "$name" == dev-* ]]; then
                local jira=$(grep "^Jira:" "$info_file" 2>/dev/null | head -1 | cut -d: -f2 | xargs)
                local summary=$(grep "^Summary:" "$info_file" 2>/dev/null | head -1 | cut -d: -f2- | xargs)
                summary="${summary:0:30}"
                display="${archived}🛠️  ${jira}: ${summary}${has_output} • ${created}"
            else
                local title=$(sed -n '/Investigation Focus:/,/====/p' "$info_file" 2>/dev/null | grep -v "Investigation Focus:" | grep -v "===" | grep -v "^-" | head -1 | xargs)
                title="${title:0:40}"
                display="${archived}🔍 ${title}${has_output} • ${created}"
            fi
        else
            display="❓ $name"
        fi

        options+=("$display")
    done <<< "$sessions"

    # Show selection using fzf
    local selected=$(printf '%s\n' "${options[@]}" | fzf \
        --height=~50% \
        --layout=reverse \
        --border=rounded \
        --prompt="Search: " \
        --header="Select a session • ESC to go back" \
        --header-first)

    # Handle back/cancel
    if [ -z "$selected" ] || [[ "$selected" == "← Back"* ]]; then
        return 1
    fi

    # Find matching session by index
    for i in "${!options[@]}"; do
        if [ "${options[$i]}" = "$selected" ]; then
            echo "${session_paths[$i]}"
            return 0
        fi
    done

    return 1
}

# ============================================================================
# PR REVIEW
# ============================================================================

# Display current selection context
show_context() {
    local title="$1"
    shift

    header
    gum style --foreground 212 --bold "$title"
    echo ""

    # Show previous selections if any
    if [ $# -gt 0 ]; then
        local context=""
        while [ $# -gt 0 ]; do
            [ -n "$context" ] && context="$context  →  "
            context="$context$1"
            shift
        done
        gum style --foreground 240 --italic "$context"
        echo ""
    fi
}

select_repo() {
    local DEFAULT_ORG="aplaceformom"
    local title="${1:-Select Repository}"

    # All display output to stderr so it doesn't pollute return value
    show_context "$title" >&2
    dim "Fetching repositories from $DEFAULT_ORG..." >&2

    # Fetch repos from default org
    local repos=$(gh repo list "$DEFAULT_ORG" --limit 100 --json name,description --jq '.[] | "\(.name) ~ \(.description // "No description")"' 2>/dev/null)

    if [ -z "$repos" ]; then
        error "Could not fetch repositories" >&2
        sleep 2
        return 1
    fi

    local repo_count=$(echo "$repos" | wc -l | xargs)

    # Use fzf for fuzzy selection (fzf outputs to stderr by default)
    local selected=$(echo -e "← Back (cancel)\n$repos" | fzf \
        --height=~50% \
        --layout=reverse \
        --border=rounded \
        --prompt="Search: " \
        --header="Select repository ($repo_count available) • ESC to cancel" \
        --header-first \
        --ansi)

    # Handle cancel/back
    if [ -z "$selected" ] || [[ "$selected" == "← Back"* ]]; then
        return 1
    fi

    # Extract just the repo name (before the " ~ ")
    local repo_name=$(echo "$selected" | cut -d'~' -f1 | xargs)
    echo "https://github.com/$DEFAULT_ORG/$repo_name"
    return 0
}

select_pr() {
    local REPO="$1"
    local REPO_DISPLAY="$2"

    # All display output to stderr so it doesn't pollute return value
    show_context "New PR Review" "📁 $REPO_DISPLAY" >&2
    dim "Fetching open PRs..." >&2

    # Fetch open PRs
    local prs=$(gh pr list --repo "$REPO" --state open --limit 50 --json number,title,author --jq '.[] | "#\(.number) \(.title) (@\(.author.login))"' 2>/dev/null)

    if [ -z "$prs" ]; then
        dim "No open PRs found in $REPO" >&2
        sleep 2
        return 1
    fi

    local pr_count=$(echo "$prs" | wc -l | xargs)

    # Use fzf for fuzzy selection (fzf outputs to stderr by default)
    local selected=$(echo -e "← Back (cancel)\n$prs" | fzf \
        --height=~50% \
        --layout=reverse \
        --border=rounded \
        --prompt="Search: " \
        --header="Select PR ($pr_count open) • ESC to cancel" \
        --header-first \
        --ansi)

    # Handle cancel/back
    if [ -z "$selected" ] || [[ "$selected" == "← Back"* ]]; then
        return 1
    fi

    # Extract PR number
    echo "$selected" | sed 's/^#\([0-9]*\).*/\1/'
    return 0
}

# Fetch PR comments and reviews for context
fetch_pr_comments() {
    local SESSION_DIR="$1"
    local OWNER="$2"
    local REPO="$3"
    local PR_NUMBER="$4"
    local OUTPUT_FILE="$SESSION_DIR/PR_DISCUSSION.md"

    dim "Fetching PR comments and reviews..."

    # Start the markdown file
    cat > "$OUTPUT_FILE" << 'HEADER'
# PR Discussion & Review History

> This file contains existing comments, reviews, and discussions from the PR.
> Use this context to avoid duplicating feedback and to understand decisions already made.

HEADER

    # Fetch review comments (comments on specific lines of code)
    local review_comments=$(gh api "repos/$OWNER/$REPO/pulls/$PR_NUMBER/comments" --paginate 2>/dev/null || echo "[]")
    local review_count=$(echo "$review_comments" | jq 'length')

    if [ "$review_count" != "0" ] && [ "$review_count" != "null" ]; then
        echo "## Code Review Comments ($review_count)" >> "$OUTPUT_FILE"
        echo "" >> "$OUTPUT_FILE"

        echo "$review_comments" | jq -r '.[] | "### 📍 `\(.path):\(.line // .original_line // "?")`\n**@\(.user.login)** on \(.created_at | split("T")[0]):\n\n\(.body)\n\n---\n"' >> "$OUTPUT_FILE" 2>/dev/null
    fi

    # Fetch PR reviews (approve/request changes/comment)
    local reviews=$(gh api "repos/$OWNER/$REPO/pulls/$PR_NUMBER/reviews" --paginate 2>/dev/null || echo "[]")
    local reviews_count=$(echo "$reviews" | jq 'length')

    if [ "$reviews_count" != "0" ] && [ "$reviews_count" != "null" ]; then
        echo "## PR Reviews ($reviews_count)" >> "$OUTPUT_FILE"
        echo "" >> "$OUTPUT_FILE"

        echo "$reviews" | jq -r '.[] | select(.body != "" and .body != null) | "### \(if .state == "APPROVED" then "✅" elif .state == "CHANGES_REQUESTED" then "⚠️" else "💬" end) \(.state) by @\(.user.login)\n\(.created_at | split("T")[0])\n\n\(.body)\n\n---\n"' >> "$OUTPUT_FILE" 2>/dev/null
    fi

    # Fetch general PR comments (conversation)
    local issue_comments=$(gh api "repos/$OWNER/$REPO/issues/$PR_NUMBER/comments" --paginate 2>/dev/null || echo "[]")
    local issue_count=$(echo "$issue_comments" | jq 'length')

    if [ "$issue_count" != "0" ] && [ "$issue_count" != "null" ]; then
        echo "## General Discussion ($issue_count)" >> "$OUTPUT_FILE"
        echo "" >> "$OUTPUT_FILE"

        echo "$issue_comments" | jq -r '.[] | "### 💬 @\(.user.login) on \(.created_at | split("T")[0])\n\n\(.body)\n\n---\n"' >> "$OUTPUT_FILE" 2>/dev/null
    fi

    # Add summary at the end
    local total=$((review_count + reviews_count + issue_count))
    if [ "$total" -gt 0 ]; then
        echo "" >> "$OUTPUT_FILE"
        echo "---" >> "$OUTPUT_FILE"
        echo "*Total: $review_count code comments, $reviews_count reviews, $issue_count discussion comments*" >> "$OUTPUT_FILE"

        # Also create symlink in repo for Claude to find
        [ -d "$SESSION_DIR/repo" ] && ln -sf "../PR_DISCUSSION.md" "$SESSION_DIR/repo/PR_DISCUSSION.md" 2>/dev/null

        dim "  Found $total existing comments/reviews"
    else
        echo "*No existing comments or reviews on this PR.*" >> "$OUTPUT_FILE"
        dim "  No existing comments found"
    fi
}

create_pr_session() {
    show_context "New PR Review"

    local OWNER=""
    local REPO=""
    local PR_NUMBER=""
    local REPO_URL=""

    # Choose input method
    local input_method=$(gum choose \
        "🔍 Browse open PRs" \
        "🔗 Enter PR URL directly" \
        "← Back")

    case "$input_method" in
        *"Browse"*)
            # First select repo
            REPO_URL=$(select_repo "New PR Review")
            if [ -z "$REPO_URL" ]; then
                return 1
            fi

            # Extract owner/repo
            if [[ "$REPO_URL" =~ github.com/([^/]+)/([^/]+) ]]; then
                OWNER="${BASH_REMATCH[1]}"
                REPO="${BASH_REMATCH[2]}"
                REPO="${REPO%.git}"
            fi

            # Then select PR - pass repo name for context display
            PR_NUMBER=$(select_pr "$OWNER/$REPO" "$REPO")
            if [ -z "$PR_NUMBER" ]; then
                return 1
            fi

            REPO_URL="https://github.com/$OWNER/$REPO.git"
            ;;
        *"Enter PR URL"*)
            printf "PR URL or number: "
            read -r pr_input
            [ -z "$pr_input" ] && return 1

            # Parse PR input
            if [[ "$pr_input" =~ ^https://github.com/([^/]+)/([^/]+)/pull/([0-9]+) ]]; then
                OWNER="${BASH_REMATCH[1]}"
                REPO="${BASH_REMATCH[2]}"
                PR_NUMBER="${BASH_REMATCH[3]}"
                REPO_URL="https://github.com/$OWNER/$REPO.git"
            elif [[ "$pr_input" =~ ^[0-9]+$ ]]; then
                PR_NUMBER="$pr_input"
                printf "Repository (owner/repo): "
                read -r repo_input

                if [[ "$repo_input" =~ github.com/([^/]+)/([^/]+) ]]; then
                    OWNER="${BASH_REMATCH[1]}"
                    REPO="${BASH_REMATCH[2]}"
                    REPO="${REPO%.git}"
                elif [[ "$repo_input" =~ ^([^/]+)/([^/]+)$ ]]; then
                    OWNER="${BASH_REMATCH[1]}"
                    REPO="${BASH_REMATCH[2]}"
                else
                    error "Could not parse repository"
                    sleep 2
                    return 1
                fi
                REPO_URL="https://github.com/$OWNER/$REPO.git"
            else
                error "Invalid PR input"
                sleep 2
                return 1
            fi
            ;;
        *)
            return 1
            ;;
    esac

    echo ""

    # Debug: show what we're fetching
    dim "Fetching PR #$PR_NUMBER from $OWNER/$REPO..."

    # Validate we have required info
    if [ -z "$PR_NUMBER" ] || [ -z "$OWNER" ] || [ -z "$REPO" ]; then
        error "Missing info - PR: '$PR_NUMBER', Owner: '$OWNER', Repo: '$REPO'"
        sleep 2
        return 1
    fi

    # Fetch PR info with spinner
    local PR_INFO
    local pr_error_file=$(mktemp)
    PR_INFO=$(gum spin --spinner dot --title "Fetching PR #$PR_NUMBER..." -- \
        gh pr view "$PR_NUMBER" --repo "$OWNER/$REPO" --json title,body,headRefName,baseRefName,author,additions,deletions,changedFiles,url 2>"$pr_error_file")

    if [ $? -ne 0 ] || [ -z "$PR_INFO" ]; then
        local err_msg=$(cat "$pr_error_file")
        rm -f "$pr_error_file"
        error "Could not fetch PR info: $err_msg"
        sleep 3
        return 1
    fi
    rm -f "$pr_error_file"

    local PR_TITLE=$(echo "$PR_INFO" | jq -r '.title')
    local PR_BODY=$(echo "$PR_INFO" | jq -r '.body // "No description provided"')
    local PR_HEAD=$(echo "$PR_INFO" | jq -r '.headRefName')
    local PR_BASE=$(echo "$PR_INFO" | jq -r '.baseRefName')
    local PR_AUTHOR=$(echo "$PR_INFO" | jq -r '.author.login')
    local PR_ADDITIONS=$(echo "$PR_INFO" | jq -r '.additions')
    local PR_DELETIONS=$(echo "$PR_INFO" | jq -r '.deletions')
    local PR_FILES=$(echo "$PR_INFO" | jq -r '.changedFiles')
    local PR_URL=$(echo "$PR_INFO" | jq -r '.url')

    # Show PR info
    gum style \
        --border rounded \
        --border-foreground 240 \
        --padding "1 2" \
        --margin "1 0" \
        "PR #$PR_NUMBER: $PR_TITLE" \
        "" \
        "$(dim "Author: $PR_AUTHOR")" \
        "$(dim "Branch: $PR_HEAD → $PR_BASE")" \
        "$(dim "Changes: +$PR_ADDITIONS -$PR_DELETIONS in $PR_FILES files")"

    if ! gum confirm "Create session for this PR?"; then
        return 1
    fi

    # Optional: Link Jira ticket (pass branch name for auto-detection)
    local JIRA_TICKET_ID=""
    local JIRA_CONTEXT=""
    local JIRA_TICKET_TYPE=""
    local JIRA_SUMMARY=""
    prompt_jira_ticket "pr" "$PR_HEAD"

    # Extract Jira summary if ticket was linked
    if [ -n "$JIRA_TICKET_JSON" ]; then
        JIRA_SUMMARY=$(echo "$JIRA_TICKET_JSON" | jq -r '.fields.summary // empty' 2>/dev/null)
    fi

    local SESSION_NAME="pr-${REPO}-${PR_NUMBER}-$(date +%Y%m%d-%H%M%S)"
    local SESSION_DIR="$SESSIONS_DIR/$SESSION_NAME"

    mkdir -p "$SESSION_DIR"
    cd "$SESSION_DIR"

    # Clone with spinner
    if ! gum spin --spinner dot --title "Cloning repository..." -- \
        git clone --depth=50 "$REPO_URL" repo 2>&1; then
        error "Failed to clone repository"
        rm -rf "$SESSION_DIR"
        sleep 2
        return 1
    fi

    if [ ! -d "repo" ]; then
        error "Clone failed - repo directory not created"
        rm -rf "$SESSION_DIR"
        sleep 2
        return 1
    fi

    cd repo
    if ! gum spin --spinner dot --title "Checking out PR branch..." -- \
        bash -c "git fetch origin 'pull/$PR_NUMBER/head:pr-$PR_NUMBER' 2>&1 && git checkout 'pr-$PR_NUMBER' 2>&1"; then
        error "Failed to checkout PR branch"
        rm -rf "$SESSION_DIR"
        sleep 2
        return 1
    fi

    local DIFF_STAT=$(git diff --stat "$PR_BASE"..."pr-$PR_NUMBER" 2>/dev/null || echo "")
    local CHANGED_FILES=$(git diff --name-only "$PR_BASE"..."pr-$PR_NUMBER" 2>/dev/null || echo "")
    local COMMIT_MESSAGES=$(git log --oneline "$PR_BASE"..."pr-$PR_NUMBER" 2>/dev/null || echo "")

    cd "$SESSION_DIR"

    # Create session-info.txt (v1 format - for backward compatibility)
    cat > session-info.txt << EOF
================================================================================
SESSION INFO
================================================================================
Type:       PR Review
Created:    $(date '+%Y-%m-%d %H:%M:%S')
Session:    $SESSION_NAME

PR #$PR_NUMBER: $PR_TITLE
URL:        $PR_URL
Author:     $PR_AUTHOR
Branch:     $PR_HEAD → $PR_BASE
Stats:      +$PR_ADDITIONS -$PR_DELETIONS in $PR_FILES files

Repository: $OWNER/$REPO
$([ -n "$JIRA_TICKET_ID" ] && echo "Jira:       $JIRA_TICKET_ID")

PR Description:
--------------------------------------------------------------------------------
$PR_BODY

Changed Files:
--------------------------------------------------------------------------------
$CHANGED_FILES
================================================================================
EOF

    # Create session.json (v2 format)
    local extra_json=$(jq -n \
        --arg number "$PR_NUMBER" \
        --arg title "$PR_TITLE" \
        --arg url "$PR_URL" \
        --arg author "$PR_AUTHOR" \
        --arg head "$PR_HEAD" \
        --arg base "$PR_BASE" \
        --arg additions "$PR_ADDITIONS" \
        --arg deletions "$PR_DELETIONS" \
        --arg files "$PR_FILES" \
        --arg jira "${JIRA_TICKET_ID:-}" \
        --arg jira_type "${JIRA_TICKET_TYPE:-}" \
        --arg jira_summary "${JIRA_SUMMARY:-}" \
        '{
            pr: {
                number: $number,
                title: $title,
                url: $url,
                author: $author,
                head: $head,
                base: $base,
                additions: ($additions | tonumber),
                deletions: ($deletions | tonumber),
                files: ($files | tonumber)
            },
            jira: (if ($jira | length) > 0 then {ticket: $jira, type: $jira_type, summary: $jira_summary} else null end)
        }')
    create_session_json "$SESSION_DIR" "review" "https://github.com/$OWNER/$REPO" "$extra_json"

    # Create CLAUDE.md inside repo/ so Claude auto-reads it
    cat > CLAUDE.md << CLAUDE_EOF
# PR Review Session - AUTO-START REVIEW

> **IMPORTANT**: Start the review immediately upon reading this file. Do not wait for user input.

## PR Information

- **PR**: #$PR_NUMBER - $PR_TITLE
- **URL**: $PR_URL
- **Author**: $PR_AUTHOR
- **Branch**: \`$PR_HEAD\` → \`$PR_BASE\`
- **Stats**: +$PR_ADDITIONS -$PR_DELETIONS across $PR_FILES files

## PR Description

$PR_BODY

## Commits in this PR

\`\`\`
$COMMIT_MESSAGES
\`\`\`

## Changed Files

\`\`\`
$CHANGED_FILES
\`\`\`

## Diff Summary

\`\`\`
$DIFF_STAT
\`\`\`

$([ -n "$JIRA_CONTEXT" ] && echo "---

$JIRA_CONTEXT
$(generate_jira_guidance "$JIRA_TICKET_TYPE" "pr")")

---

## Review Instructions

You are an expert code reviewer helping evaluate this PR. **Begin immediately.**

## ⛔ SCOPE GATE — Changed Files Only (HARD CONSTRAINT)

**Your review scope is EXACTLY the files listed in "Changed Files" above. This is not a guideline — it is a hard constraint.**

Before writing ANY finding, verify: is the file in the "Changed Files" list? If NO → do not write it. Delete it. No exceptions.

**These will INVALIDATE your review:**
- ❌ Flagging issues in files not in the diff
- ❌ Suggesting improvements to unchanged code
- ❌ Exploring the codebase for pre-existing problems
- ❌ "While looking at X, I noticed Y in another file..."

**Only exception:** If a changed file calls a function in another file AND the interaction creates a bug, mention the other file as context — but the finding Location MUST be in the changed file.

**MANDATORY self-check before submitting REVIEW.md:** Re-read every finding. Delete any whose Location file is not in "Changed Files".

---

## PHASE 1: Classify the PR Type

First, determine what type of PR this is based on the title, description, and changes:

| Type | Description | Key Concern |
|------|-------------|-------------|
| **Feature** | New functionality | Does it work? Is it complete? |
| **Bug Fix** | Fixing broken behavior | Is the fix minimal and targeted? |
| **Refactor** | Restructuring without behavior change | Are there ANY functional changes? |
| **Performance** | Speed/efficiency improvements | Does behavior remain identical? |
| **Chore** | Dependencies, configs, CI | Are there unintended side effects? |
| **Docs** | Documentation only | Is code unchanged? |

---

## PHASE 2: Macro Analysis (The Forest)

**Before looking at code details, evaluate the PR holistically:**

### 2.1 Intent Alignment
- Does the PR do what it claims to do?
- Is the scope appropriate (not too broad, not too narrow)?
- Are there changes that don't belong in this PR?

### 2.2 PR Type Violations (CRITICAL)

🚨 **These are often the most important issues:**

| PR Type | Red Flag |
|---------|----------|
| **Refactor** | ANY functional/behavioral changes (even "improvements") |
| **Bug Fix** | Scope creep - refactoring or features mixed in |
| **Feature** | Unrelated changes, touching code outside feature scope |
| **Performance** | Behavior changes, different outputs, changed APIs |
| **Chore** | Logic changes hidden in dependency updates |

### 2.3 Architectural Fit
- Does this change fit the existing codebase patterns?
- Does it introduce new patterns/approaches inconsistent with the codebase?
- Are there simpler approaches that would achieve the same goal?

### 2.4 Completeness
- Is the feature/fix complete or partially implemented?
- Are there TODOs or commented-out code?
- Missing migrations, configs, env vars?
- Missing documentation for public APIs?

---

## PHASE 3: Micro Analysis (The Trees)

**Now examine the code details. Run these reviews IN PARALLEL using Task tool:**

### 3.1 Correctness
- Logic errors, off-by-one, null/undefined handling
- Race conditions, async/await issues
- Edge cases not handled
- Error handling gaps

### 3.2 Security
- Input validation (user input, API params)
- SQL/NoSQL injection, XSS, command injection
- Auth/authorization bypasses
- Sensitive data exposure (logs, errors, responses)
- Secrets in code

### 3.3 Performance
- N+1 queries, missing indexes
- Unnecessary loops, repeated computations
- Memory leaks, unbounded growth
- Missing pagination, loading too much data

### 3.4 Code Quality
- Readability and clarity
- Naming (variables, functions, files)
- DRY violations, copy-paste code
- Dead code, unused imports
- Consistent style with codebase

### 3.5 Complexity
- Over-engineering, premature abstraction
- Simpler alternatives exist?
- Cognitive load - hard to follow?
- Deep nesting, long functions

### 3.6 Testing
- New code has tests?
- Tests actually test the behavior (not just coverage)?
- Edge cases tested?
- Tests would catch regressions?

### 3.7 Regression Risk
- Changes to shared utilities/components
- API contract changes
- Database schema changes
- Config/environment changes

### 3.8 Best Practices

**React / Next.js (if applicable):**
- **Waterfalls**: Use `Promise.all()` for independent fetches; move `await` into the branch where the value is actually used
- **Bundle size**: Avoid barrel file imports (import from specific modules); use `next/dynamic` for heavy components; defer third-party scripts (analytics, logging) until after hydration
- **Server components**: Use `React.cache()` for per-request dedup; minimize data serialized to client components; use `after()` for non-blocking operations
- **Re-renders**: Use functional `setState` for stable callbacks; don't subscribe to state only used in event handlers; use `startTransition` for non-urgent updates
- **Rendering**: Use ternary (`? :`) not `&&` for conditional rendering; extract static JSX outside components; use `content-visibility: auto` for long lists

**UI / UX / Accessibility:**
- **Semantic HTML**: Use correct elements (`button` not `div` with onClick, `nav`, `main`, `article`); ensure keyboard navigation works (Tab, Enter, Escape)
- **Focus management**: Visible focus indicators; focus moves logically after actions (modal open/close, route change)
- **Touch targets**: Minimum 44x44px for interactive elements on mobile
- **Error/loading states**: All async operations show loading state; errors are shown to users with recovery options
- **Layout stability**: Avoid layout shift (set dimensions on images/videos, use `loading="lazy"`)
- **Forms**: Validation messages visible and associated with fields; submit buttons disabled during submission

### 3.9 Project-Specific Skills (CHECK FIRST)

**Before starting your analysis**, check if the \`/APFM:apfm-review\` skill is available. If it is, run it — it knows the project conventions and will produce the review. If it runs successfully, follow its output and skip the standard process. Only continue with Phases 1-4 if the skill is NOT available.

Additionally, check if \`.agents/skills/\` or \`.claude/skills/\` exists in this repo. If review-relevant skills are found, invoke them on the changed files and incorporate their findings.

---

