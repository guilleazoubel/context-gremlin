# ============================================================================
# INVESTIGATION
# ============================================================================

create_investigation_session() {
    show_context "New Investigation"

    local REPO_URL=""
    local REPO_DISPLAY=""

    # Choose input method
    local input_method=$(gum choose \
        "🔍 Browse repositories" \
        "🔗 Enter repo URL directly" \
        "← Back")

    case "$input_method" in
        *"Browse"*)
            REPO_URL=$(select_repo "New Investigation")
            [ -z "$REPO_URL" ] && return 1
            ;;
        *"Enter repo"*)
            local DEFAULT_REPO="https://github.com/aplaceformom/grace-frontend"
            printf "Repository URL [$DEFAULT_REPO]: "
            read -r REPO_URL
            [ -z "$REPO_URL" ] && REPO_URL="$DEFAULT_REPO"
            ;;
        *)
            return 1
            ;;
    esac

    # Extract repo display name
    if [[ "$REPO_URL" =~ github.com/([^/]+)/([^/]+) ]]; then
        REPO_DISPLAY="${BASH_REMATCH[2]}"
        REPO_DISPLAY="${REPO_DISPLAY%.git}"
    else
        REPO_DISPLAY="$REPO_URL"
    fi

    show_context "New Investigation" "📁 $REPO_DISPLAY"
    dim "Fetching branches..."

    # Fetch remote branches - try with and without .git suffix
    local branches=""
    branches=$(git ls-remote --heads "$REPO_URL" 2>/dev/null | sed 's/.*refs\/heads\///' | sort)
    if [ -z "$branches" ]; then
        branches=$(git ls-remote --heads "${REPO_URL}.git" 2>/dev/null | sed 's/.*refs\/heads\///' | sort)
    fi

    local BRANCH=""
    if [ -n "$branches" ]; then
        local branch_count=$(echo "$branches" | wc -l | xargs)

        # Use fzf for fuzzy selection
        BRANCH=$(echo -e "← Back (cancel)\nmain (default)\n$branches" | fzf \
            --height=~50% \
            --layout=reverse \
            --border=rounded \
            --prompt="Search: " \
            --header="Select branch ($branch_count available) • ESC to cancel" \
            --header-first \
            --ansi)

        # Handle cancel/back
        if [ -z "$BRANCH" ] || [[ "$BRANCH" == "← Back"* ]]; then
            return 1
        fi

        # Handle "main (default)" selection
        [[ "$BRANCH" == "main (default)" ]] && BRANCH=""
    else
        dim "Could not fetch branches from remote."
        echo ""

        local fallback_choice=$(gum choose \
            "📌 Use main/master (default)" \
            "✏️  Enter branch name manually" \
            "← Back (cancel)")

        case "$fallback_choice" in
            *"main/master"*)
                BRANCH=""
                ;;
            *"Enter branch"*)
                printf "Branch name: "
                read -r BRANCH
                ;;
            *)
                return 1
                ;;
        esac
    fi

    # Show context with branch selection
    local branch_display="${BRANCH:-main}"
    show_context "New Investigation" "📁 $REPO_DISPLAY" "🌿 $branch_display"

    # Optional: Link Jira ticket FIRST (provides context, may make instructions optional)
    # Pass branch name for auto-detection of Jira ticket (e.g., HB-404-fix-login -> HB-404)
    local JIRA_TICKET_ID=""
    local JIRA_CONTEXT=""
    local JIRA_TICKET_TYPE=""
    local JIRA_SUMMARY=""
    prompt_jira_ticket "investigation" "$BRANCH"

    # Get Jira summary if ticket was linked
    if [ -n "$JIRA_TICKET_JSON" ]; then
        JIRA_SUMMARY=$(echo "$JIRA_TICKET_JSON" | jq -r '.fields.summary // empty' 2>/dev/null)
    fi

    # Investigation instructions - optional if Jira ticket linked
    local INVESTIGATION=""
    if [ -n "$JIRA_TICKET_ID" ]; then
        dim "Additional notes (optional - Jira context will be used):"
        dim "(empty line to skip, 'q' alone to cancel)"
    else
        dim "Describe your investigation focus (empty line to finish, 'q' alone to cancel):"
    fi
    echo ""
    while IFS= read -r line; do
        [ -z "$line" ] && break
        [[ "$line" == "q" ]] && return 1
        INVESTIGATION="${INVESTIGATION}${line}"$'\n'
    done

    # Need either Jira ticket OR investigation focus
    if [ -z "$INVESTIGATION" ] && [ -z "$JIRA_TICKET_ID" ]; then
        dim "No investigation focus or Jira ticket provided"
        sleep 1
        return 1
    fi

    # Build the investigation focus text
    local INVESTIGATION_DISPLAY=""
    if [ -n "$JIRA_SUMMARY" ]; then
        INVESTIGATION_DISPLAY="$JIRA_TICKET_ID: $JIRA_SUMMARY"
        [ -n "$INVESTIGATION" ] && INVESTIGATION_DISPLAY="$INVESTIGATION_DISPLAY"$'\n\nAdditional Notes:\n'"$INVESTIGATION"
    elif [ -n "$INVESTIGATION" ]; then
        INVESTIGATION_DISPLAY="$INVESTIGATION"
    fi

    local OWNER REPO
    if [[ "$REPO_URL" =~ ([^/]+)/([^/]+)(\.git)?$ ]]; then
        OWNER="${BASH_REMATCH[1]}"
        REPO="${BASH_REMATCH[2]}"
        REPO="${REPO%.git}"
    else
        OWNER="unknown"
        REPO="repo"
    fi

    local SESSION_NAME="inv-${REPO}-$(date +%Y%m%d-%H%M%S)"
    local SESSION_DIR="$SESSIONS_DIR/$SESSION_NAME"

    mkdir -p "$SESSION_DIR"
    cd "$SESSION_DIR"

    # Clone with branch if specified (avoids fetch issues with shallow clone)
    local clone_cmd="git clone --depth=100"
    [ -n "$BRANCH" ] && clone_cmd="$clone_cmd --branch '$BRANCH'"
    clone_cmd="$clone_cmd '$REPO_URL' repo"

    if ! gum spin --spinner dot --title "Cloning repository..." -- \
        bash -c "$clone_cmd 2>&1"; then
        error "Failed to clone repository"
        rm -rf "$SESSION_DIR"
        sleep 2
        return 1
    fi

    if [ ! -d "repo" ]; then
        error "Clone failed - repo directory not created"
        rm -rf "$SESSION_DIR"
        sleep 2
        return 1
    fi

    cd repo

    local BRANCH_INFO
    if [ -n "$BRANCH" ]; then
        BRANCH_INFO="$BRANCH"
    else
        BRANCH=$(git branch --show-current)
        BRANCH_INFO="$BRANCH (default)"
    fi

    cd "$SESSION_DIR"

    # Create session-info.txt (v1 format - for backward compatibility)
    cat > session-info.txt << EOF
================================================================================
SESSION INFO
================================================================================
Type:       Investigation
Created:    $(date '+%Y-%m-%d %H:%M:%S')
Creator:    $(whoami)
Session:    $SESSION_NAME

Repository: $OWNER/$REPO
URL:        $REPO_URL
Branch:     $BRANCH_INFO
$([ -n "$JIRA_TICKET_ID" ] && echo "Jira:       $JIRA_TICKET_ID")

Investigation Focus:
--------------------------------------------------------------------------------
$INVESTIGATION_DISPLAY
================================================================================
EOF

    # Create session.json (v2 format)
    local extra_json=$(jq -n \
        --arg focus "$INVESTIGATION_DISPLAY" \
        --arg branch "$BRANCH_INFO" \
        --arg jira "${JIRA_TICKET_ID:-}" \
        --arg jira_type "${JIRA_TICKET_TYPE:-}" \
        --arg jira_summary "${JIRA_SUMMARY:-}" \
        '{
            focus: $focus,
            branch: $branch,
            jira: (if ($jira | length) > 0 then {ticket: $jira, type: $jira_type, summary: $jira_summary} else null end)
        }')
    create_session_json "$SESSION_DIR" "investigation" "$REPO_URL" "$extra_json"

    # Create CLAUDE.md inside repo/ so Claude auto-reads it
    # Build a rich context section based on Jira ticket
    local PROBLEM_CONTEXT=""
    if [ -n "$JIRA_CONTEXT" ]; then
        PROBLEM_CONTEXT="$JIRA_CONTEXT"
    fi

    cat > CLAUDE.md << CLAUDE_EOF
# Investigation Session - AUTO-START

> **CRITICAL**: Read this entire document carefully. It contains all the context you need to understand what you're investigating and what is expected.

---

## THE PROBLEM

$(if [ -n "$JIRA_TICKET_ID" ]; then
    echo "### $JIRA_TICKET_ID: $JIRA_SUMMARY"
    echo ""
    echo "This investigation is linked to a Jira ticket. **Read the full context below carefully** - it contains:"
    echo "- The reported issue/request"
    echo "- Description with technical details"
    echo "- Any comments from team members with additional context"
    echo "- Attachments that may show the issue"
else
    echo "### Investigation Focus"
fi)

$([ -n "$INVESTIGATION" ] && echo "
**Additional Context from User:**
$INVESTIGATION")

---

$PROBLEM_CONTEXT

$([ -n "$JIRA_TICKET_TYPE" ] && generate_jira_guidance "$JIRA_TICKET_TYPE" "investigation")

---

## YOUR MISSION

Based on the problem described above, you need to:

1. **Understand the Issue**: What exactly is the problem? What behavior is expected vs actual?
2. **Find the Root Cause**: Trace through the code to identify WHY this is happening
3. **Document Everything**: Write your findings to \`FINDINGS.md\` as you go

## Repository Information

- **Repository**: $REPO_URL
- **Branch**: \`$BRANCH_INFO\`

---

## INVESTIGATION APPROACH

### Step 1: Understand the Context (First 5 minutes)
- Re-read the problem description above
- Identify key terms, components, or features mentioned
- Note any error messages, expected behavior, or reproduction steps

### Step 2: Explore the Codebase
- Find files related to the components mentioned in the issue
- Understand the architecture around the affected area
- Map out how data flows through the relevant code paths

### Step 3: Deep Investigation
- Trace the code paths that could cause the reported issue
- Look for edge cases, race conditions, or logic errors
- Check error handling and boundary conditions
- Review recent changes to relevant files (git log/blame)

### Step 4: Document Findings
Write to \`FINDINGS.md\` using this structure:

\`\`\`markdown
# Investigation: $JIRA_TICKET_ID - [Brief Problem Description]

## Problem Statement
[Restate the issue in your own words after investigating]

## Summary
[2-3 sentences: What did you find? What's the root cause?]

## Key Files Involved
- \`path/to/file.ts:123\` - [role in the issue]

## Root Cause Analysis

### What's Happening
[Detailed explanation of the issue]

### Why It's Happening
[The underlying cause]

### Code Evidence
\\\`\\\`\\\`typescript
// Relevant code with file:line reference
\\\`\\\`\\\`

## Recommendations

### Immediate Fix
[What should be done to fix this specific issue]

### Follow-up Improvements
[Any related improvements worth considering]

## Questions / Unknowns
- [Anything that needs clarification]
\`\`\`

---

## EXPECTATIONS

- **Be thorough**: The Jira ticket context above is your primary guide
- **Reference specifics**: Always include file paths and line numbers
- **Update continuously**: Keep FINDINGS.md current as you discover things
- **Connect to the issue**: Every finding should relate back to the reported problem

---

**BEGIN NOW**: Start by summarizing what you understand the problem to be, then explore the codebase to find relevant files.
CLAUDE_EOF

    # Setup output files with symlinks (survives repo deletion)
    setup_output_files "$SESSION_DIR"

    success "Session created"
    CURRENT_SESSION="$SESSION_DIR"
    return 0
