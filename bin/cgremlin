#!/bin/bash

# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║                            CONTEXT GREMLIN                                 ║
# ║         Isolated environments for PR reviews & code investigations         ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

SESSIONS_DIR="${CGREMLIN_SESSIONS_DIR:-}"

# ============================================================================
# CONFIGURATION SYSTEM
# ============================================================================

CONFIG_DIR="$HOME/.cgremlin"
CONFIG_FILE="$CONFIG_DIR/config"

# Default configuration values
DEFAULT_MODEL="sonnet"
DEFAULT_DASHBOARD_AUTO_START="true"
DEFAULT_PROJECT=""
DEFAULT_USE_ZELLIJ="false"

# Current configuration (loaded at startup)
MODEL="${DEFAULT_MODEL}"
DASHBOARD_AUTO_START="${DEFAULT_DASHBOARD_AUTO_START}"
DEFAULT_PROJECT="${DEFAULT_PROJECT}"
USE_ZELLIJ="${DEFAULT_USE_ZELLIJ}"

# Load configuration from file
load_config() {
    mkdir -p "$CONFIG_DIR"

    if [ -f "$CONFIG_FILE" ]; then
        # Source the config file to load variables
        while IFS='=' read -r key value; do
            # Skip comments and empty lines
            [[ "$key" =~ ^[[:space:]]*# ]] && continue
            [[ -z "$key" ]] && continue

            # Remove leading/trailing whitespace and quotes
            key=$(echo "$key" | xargs)
            value=$(echo "$value" | sed 's/^["'\'']\|["'\'']$//g' | xargs)

            case "$key" in
                MODEL) MODEL="$value" ;;
                DASHBOARD_AUTO_START) DASHBOARD_AUTO_START="$value" ;;
                DEFAULT_PROJECT) DEFAULT_PROJECT="$value" ;;
                USE_ZELLIJ) USE_ZELLIJ="$value" ;;
                SESSIONS_DIR) [ -z "$CGREMLIN_SESSIONS_DIR" ] && SESSIONS_DIR="$value" ;;
                WATCH_REPOS) WATCH_REPOS="$value" ;;
                WATCH_AUTHORS) WATCH_AUTHORS="$value" ;;
                GITHUB_ME) GITHUB_ME="$value" ;;
                LOCAL_URL) LOCAL_URL="$value" ;;
                LOCAL_PORT) LOCAL_PORT="$value" ;;
                LOCAL_DEV_CMD) LOCAL_DEV_CMD="$value" ;;
                VERCEL_SCOPE) VERCEL_SCOPE="$value" ;;
                VERCEL_PROJECT) VERCEL_PROJECT="$value" ;;
                LOCAL_NODE_VERSION) LOCAL_NODE_VERSION="$value" ;;
            esac
        done < "$CONFIG_FILE"
    fi

    : "${LOCAL_URL:=https://local.findcare.dev.aplaceformom.com}"
    : "${LOCAL_PORT:=8080}"
    : "${LOCAL_DEV_CMD:=pnpm dev}"
    : "${VERCEL_SCOPE:=grace-0118bc61}"
    : "${VERCEL_PROJECT:=grace-frontend-dev}"
    : "${LOCAL_NODE_VERSION:=24}"
}

# Save configuration to file
save_config() {
    mkdir -p "$CONFIG_DIR"

    cat > "$CONFIG_FILE" << EOF
# cgremlin Configuration
# Generated: $(date '+%Y-%m-%d %H:%M:%S')

# Claude model to use (sonnet/opus/haiku)
MODEL="$MODEL"

# Auto-start dashboard when cgremlin launches (true/false)
DASHBOARD_AUTO_START="$DASHBOARD_AUTO_START"

# Default project path (last used or set manually)
DEFAULT_PROJECT="$DEFAULT_PROJECT"

# Open new Claude sessions in Zellij panes instead of iTerm2 tabs (true/false)
USE_ZELLIJ="$USE_ZELLIJ"

# Repos to watch for new PRs (space-separated, format: owner/repo)
WATCH_REPOS="$WATCH_REPOS"

# GitHub logins whose open PRs are auto-reviewed (space-separated, case-insensitive)
WATCH_AUTHORS="$WATCH_AUTHORS"

# Your own GitHub login — your approved PRs are flagged "merge it"
GITHUB_ME="$GITHUB_ME"

# Local-run: app URL, port, dev command, Vercel scope/project, Node version
LOCAL_URL="$LOCAL_URL"
LOCAL_PORT="$LOCAL_PORT"
LOCAL_DEV_CMD="$LOCAL_DEV_CMD"
VERCEL_SCOPE="$VERCEL_SCOPE"
VERCEL_PROJECT="$VERCEL_PROJECT"
LOCAL_NODE_VERSION="$LOCAL_NODE_VERSION"
EOF
    chmod 600 "$CONFIG_FILE"
}

# Load config at startup
load_config

# Apply sessions directory default (env var > config file > default)
SESSIONS_DIR="${SESSIONS_DIR:-$HOME/.cgremlin/sessions}"
mkdir -p "$SESSIONS_DIR"

# Create dashboard config.json with empty defaults if it doesn't exist
if [ ! -f "$CONFIG_DIR/config.json" ]; then
    mkdir -p "$CONFIG_DIR"
    cat > "$CONFIG_DIR/config.json" << 'CFGEOF'
{
  "jira_base_url": "",
  "vercel_preview_url_template": ""
}
CFGEOF
fi

# Auto-populate jira_base_url from jira.conf if not already set
if [ -f "$HOME/.config/cgremlin/jira.conf" ]; then
    _jira_domain=""
    eval "$(grep '^JIRA_DOMAIN=' "$HOME/.config/cgremlin/jira.conf")" 2>/dev/null && _jira_domain="$JIRA_DOMAIN"
    if [ -n "$_jira_domain" ]; then
        _current_jira_url=$(jq -r '.jira_base_url // ""' "$CONFIG_DIR/config.json" 2>/dev/null)
        if [ -z "$_current_jira_url" ]; then
            local_tmp=$(jq --arg url "https://$_jira_domain/browse/" '.jira_base_url = $url' "$CONFIG_DIR/config.json" 2>/dev/null)
            [ -n "$local_tmp" ] && echo "$local_tmp" > "$CONFIG_DIR/config.json"
        fi
    fi
    unset _jira_domain _current_jira_url
fi

# ============================================================================
# V2 SESSION MODEL
# ============================================================================
# Unified session management with session.json metadata
# All sessions use session-* naming with mode tracked in metadata

# Generate unique session ID
generate_session_id() {
    local prefix="session"
    local timestamp=$(date '+%Y%m%d-%H%M%S')
    local random=$(head -c 4 /dev/urandom | xxd -p)
    echo "${prefix}-${timestamp}-${random}"
}

# Create session.json with all metadata
# Usage: create_session_json SESSION_DIR mode project [extra_json_fields]
create_session_json() {
    local session_dir="$1"
    local mode="$2"
    local project="$3"
    # NB: do NOT write this as ${4:-{}} — bash parses that as default "{" plus a
    # literal "}", appending a stray "}" to a set $4 and corrupting the JSON.
    local extra_fields="$4"; [ -z "$extra_fields" ] && extra_fields="{}"

    local session_id=$(basename "$session_dir")
    local created=$(date -Iseconds)

    # Merge extra fields into base JSON
    local json=$(jq -n \
        --arg id "$session_id" \
        --arg mode "$mode" \
        --arg project "$project" \
        --arg created "$created" \
        --arg status "active" \
        --argjson extra "$extra_fields" \
        '{
            id: $id,
            mode: $mode,
            project: $project,
            created: $created,
            status: $status,
            terminal: {
                pid: null,
                tmux_session: null,
                log_file: null
            },
            history: []
        } + $extra')

    echo "$json" > "$session_dir/session.json"
}

# Read a field from session.json
# Usage: read_session_field SESSION_DIR field_path
read_session_field() {
    local session_dir="$1"
    local field="$2"
    local session_file="$session_dir/session.json"

    if [ -f "$session_file" ]; then
        jq -r ".$field // empty" "$session_file" 2>/dev/null
    fi
}

# Update a field in session.json
# Usage: update_session_field SESSION_DIR field_path value
update_session_field() {
    local session_dir="$1"
    local field="$2"
    local value="$3"
    local session_file="$session_dir/session.json"

    if [ -f "$session_file" ]; then
        local tmp=$(mktemp)
        # Check if value is JSON or plain string
        if echo "$value" | jq -e . >/dev/null 2>&1; then
            jq ".$field = $value" "$session_file" > "$tmp" && mv "$tmp" "$session_file"
        else
            jq --arg v "$value" ".$field = \$v" "$session_file" > "$tmp" && mv "$tmp" "$session_file"
        fi
    fi
}

# Update review_state in session.json
# Usage: update_review_state SESSION_DIR <queued|reviewing|ready|failed|interrupted>
update_review_state()  { update_session_field "$1" "review_state" "$2"; }

# Read review_state from session.json (default: none)
# Usage: read_review_state SESSION_DIR
read_review_state()    { read_session_field "$1" "review_state" 2>/dev/null || echo "none"; }

# Update triage_state in session.json
# Usage: update_triage_state SESSION_DIR <open|done>
update_triage_state()  { update_session_field "$1" "triage_state" "$2"; }

# Read triage_state from session.json (default: open)
# Usage: read_triage_state SESSION_DIR
read_triage_state()    { local v=$(read_session_field "$1" "triage_state" 2>/dev/null); echo "${v:-open}"; }

# Update lifecycle in session.json (human's posted decision)
# Usage: update_lifecycle SESSION_DIR <none|commented|changes-requested|approved>
update_lifecycle() { update_session_field "$1" "lifecycle" "$2"; }
# Read lifecycle from session.json (default: none)
# Usage: read_lifecycle SESSION_DIR
read_lifecycle()   { local v=$(read_session_field "$1" "lifecycle" 2>/dev/null); echo "${v:-none}"; }

# PR head SHA recorded when the human last posted a review
# Usage: update_reviewed_sha SESSION_DIR <sha>
update_reviewed_sha() { update_session_field "$1" "reviewed_sha" "$2"; }
# Usage: read_reviewed_sha SESSION_DIR
read_reviewed_sha()   { read_session_field "$1" "reviewed_sha" 2>/dev/null; }

# Author pushed new commits since reviewed_sha (set by the watch daemon)
# Usage: set_rereview_pending SESSION_DIR
set_rereview_pending()   { update_session_field "$1" "rereview_pending" "true"; }
# Usage: clear_rereview_pending SESSION_DIR
clear_rereview_pending() { update_session_field "$1" "rereview_pending" "false"; }
# Usage: read_rereview_pending SESSION_DIR (default: false)
read_rereview_pending()  { local v=$(read_session_field "$1" "rereview_pending" 2>/dev/null); echo "${v:-false}"; }

# A PR session is "mine" when its author matches GITHUB_ME (case-insensitive).
# Usage: pr_is_mine SESSION_DIR   (exit 0 = mine)
pr_is_mine() {
    [ -n "$GITHUB_ME" ] || return 1
    local a; a=$(read_session_field "$1" "pr.author" 2>/dev/null)
    [ "$(printf '%s' "$a" | tr '[:upper:]' '[:lower:]')" = "$(printf '%s' "$GITHUB_ME" | tr '[:upper:]' '[:lower:]')" ]
}
# mine_stage: tracking (idle) | triaging (worker running) | ready (COMMENTS.md waiting)
update_mine_stage() { update_session_field "$1" "mine_stage" "$2"; }
read_mine_stage()   { local v=$(read_session_field "$1" "mine_stage" 2>/dev/null); echo "${v:-tracking}"; }

# Extract owner/repo from session.json .project (https://github.com/OWNER/REPO)
# Usage: _pr_repo SESSION_DIR
_pr_repo() { read_session_field "$1" "project" | sed -E 's#.*github\.com/([^/]+/[^/.]+).*#\1#'; }

# Post a GitHub PR review on behalf of the discussion agent.
# Usage: _post_review SESSION_NAME gh-event-flag success-lifecycle
_post_review() {   # $1=session_name  $2=gh-event-flag (--approve|--comment|--request-changes)  $3=success-lifecycle
    local d="$SESSIONS_DIR/$1"; local num repo body
    num=$(read_session_field "$d" "pr.number"); repo=$(_pr_repo "$d")
    body="$d/.review_body.md"; [ -f "$body" ] || { echo "ERROR: $body not found (agent must write the review body first)" >&2; return 1; }
    if gh pr review "$num" --repo "$repo" "$2" --body-file "$body"; then
        update_lifecycle "$d" "$3"; echo "posted $2 for $1"
    else
        echo "ERROR: gh pr review failed for $1 (lifecycle unchanged)" >&2; return 1
    fi
}
# Report real approval blockers: failing CI checks + unresolved review threads.
# Prints a human-readable summary to stdout; exit 1 if any blocker, 0 if clean
# (or if it genuinely can't check — never block on our own inability to query).
# Usage: _pr_safety_check SESSION_NAME
_pr_safety_check() {
    local d="$SESSIONS_DIR/$1" num repo owner name failing threads had=0
    num=$(read_session_field "$d" "pr.number"); repo=$(_pr_repo "$d")
    [ -z "$num" ] || [ -z "$repo" ] && return 0
    owner="${repo%%/*}"; name="${repo##*/}"

    # Failing CI checks (ignore SKIPPED / SUCCESS / PENDING / neutral).
    failing=$(timeout 20 gh pr view "$num" --repo "$repo" --json statusCheckRollup \
        --jq '.statusCheckRollup[]? | ((.name // .context) + "\t" + (.conclusion // .state // ""))
              | select(test("\t(FAILURE|ERROR|TIMED_OUT|CANCELLED|ACTION_REQUIRED|STARTUP_FAILURE)$"))
              | split("\t")[0]' 2>/dev/null)
    if [ -n "$failing" ]; then
        had=1
        echo "⚠️  Failing CI checks:"
        while IFS= read -r c; do [ -n "$c" ] && echo "      ✗ $c"; done <<< "$failing"
    fi

    # Unresolved review threads (from anyone), with location + author.
    threads=$(timeout 20 gh api graphql -f query='query($o:String!,$r:String!,$n:Int!){repository(owner:$o,name:$r){pullRequest(number:$n){reviewThreads(first:100){nodes{isResolved comments(first:1){nodes{author{login} path line}}}}}}}' \
        -F o="$owner" -F r="$name" -F n="$num" \
        --jq '.data.repository.pullRequest.reviewThreads.nodes[]? | select(.isResolved==false)
              | "@" + (.comments.nodes[0].author.login // "?") + "  " + (.comments.nodes[0].path // "?") + ":" + ((.comments.nodes[0].line // 0)|tostring)' 2>/dev/null)
    if [ -n "$threads" ]; then
        had=1
        echo "⚠️  Unresolved review comments:"
        while IFS= read -r t; do [ -n "$t" ] && echo "      • $t"; done <<< "$threads"
    fi

    return $had
}

approve_pr() {
    # Posts APPROVE and sets lifecycle=approved (via _post_review). The session
    # is NOT deleted — it moves to the "✅ Approved" group and stays visible
    # until the PR merges (then the watch daemon deletes it). The agent_pid is
    # left in place so open_pr_row cleans the pane when the user navigates away.
    #
    # Safety gate: refuse to approve when CI is failing or review comments are
    # unresolved — surface exactly what's wrong so the reviewer knows the real
    # situation. Pass --force (as $2) to approve anyway.
    local session="$1" force="$2"
    if [ "$force" != "--force" ]; then
        local report; report=$(_pr_safety_check "$session")
        if [ -n "$report" ]; then
            echo "🛑 Holding approval — this PR has open blockers:"
            echo ""
            echo "$report"
            echo ""
            echo "Nothing was posted. If you've weighed these and still want to approve,"
            echo "re-run:  cgremlin --approve-pr $session --force"
            return 2
        fi
    fi
    _post_review "$session" "--approve" "approved" || return 1
    echo "approved $session (moved to Approved group)"
}
comment_pr()         { _post_review "$1" "--comment" "commented"          && _record_reviewed "$1"; }
request_changes_pr() { _post_review "$1" "--request-changes" "changes-requested" && _record_reviewed "$1"; }
# Reply to a review thread with the text in SESSION_DIR/.reply_body.md.
reply_comment() {
    local d="$SESSIONS_DIR/$1" tid="$2"
    local body="$d/.reply_body.md"
    [ -f "$body" ] || { echo "ERROR: $body not found" >&2; return 1; }
    [ -n "$tid" ] || { echo "ERROR: thread id required" >&2; return 1; }
    local text; text=$(cat "$body")
    gh api graphql -f query='mutation($t:ID!,$b:String!){addPullRequestReviewThreadReply(input:{pullRequestReviewThreadId:$t, body:$b}){comment{id}}}' \
        -F t="$tid" -F b="$text" >/dev/null && echo "replied to $tid" || { echo "ERROR: reply failed" >&2; return 1; }
}
# Mark the session's PR ready for review (undraft). Only invoked on explicit user go-ahead.
pr_ready() {
    local d="$SESSIONS_DIR/$1" num repo
    num=$(read_session_field "$d" "pr.number"); repo=$(_pr_repo "$d")
    # The develop agent opens the draft PR with `gh pr create` and may not have
    # recorded pr.number; discover it from the checked-out branch as a fallback.
    if [ -z "$num" ] && [ -d "$d/repo" ]; then
        num=$(cd "$d/repo" && gh pr view --json number -q .number 2>/dev/null)
        [ -n "$num" ] && update_session_field "$d" "pr.number" "$num"
    fi
    [ -z "$num" ] && { echo "ERROR: no PR found for $1 (branch has no PR yet?)" >&2; return 1; }
    [ -z "$repo" ] && { echo "ERROR: missing repo" >&2; return 1; }
    gh pr ready "$num" --repo "$repo" && echo "marked PR #$num ready" || { echo "ERROR: gh pr ready failed" >&2; return 1; }
}
# Resolve a review thread (after replying, e.g. a confirmed false positive).
resolve_comment() {
    local tid="$2"
    [ -n "$tid" ] || { echo "ERROR: thread id required" >&2; return 1; }
    gh api graphql -f query='mutation($t:ID!){resolveReviewThread(input:{threadId:$t}){thread{isResolved}}}' \
        -F t="$tid" >/dev/null && echo "resolved $tid" || { echo "ERROR: resolve failed" >&2; return 1; }
}
# Print LIVE review-thread status for the session's PR (READ-ONLY) so a triage
# agent can reconcile its COMMENTS.md/REVIEW.md against what's actually on the PR
# right now — replies made manually or by another agent, resolved threads, and
# new comments. One TSV row per thread:
#   threadId <tab> resolved(true|false) <tab> @firstAuthor <tab> path:line <tab> @lastAuthor <tab> firstComment(80 chars)
pr_threads() {
    local d="$SESSIONS_DIR/$1" num repo owner name
    num=$(read_session_field "$d" "pr.number"); repo=$(_pr_repo "$d")
    { [ -z "$num" ] || [ -z "$repo" ]; } && { echo "ERROR: missing pr.number/repo" >&2; return 1; }
    owner="${repo%%/*}"; name="${repo##*/}"
    gh api graphql -f query='query($o:String!,$r:String!,$n:Int!){repository(owner:$o,name:$r){pullRequest(number:$n){reviewThreads(first:100){nodes{id isResolved comments(first:30){nodes{author{login} path line body}}}}}}}' \
        -F o="$owner" -F r="$name" -F n="$num" \
        --jq '.data.repository.pullRequest.reviewThreads.nodes[]?
              | (.comments.nodes[0]) as $f
              | [ .id, (.isResolved|tostring), ("@" + ($f.author.login // "?")),
                  (($f.path // "?") + ":" + (($f.line // 0)|tostring)),
                  ("@" + (.comments.nodes[-1].author.login // "?")),
                  (($f.body // "")|gsub("[\n\t]";" ")|.[0:80]) ] | @tsv' 2>/dev/null
}
# Path to the single-owner local-run state file.
_local_run_file() { echo "$SESSIONS_DIR/.local_run"; }
# The session currently running locally (empty if none).
_local_run_owner() { jq -r '.session // empty' "$(_local_run_file)" 2>/dev/null; }

# Verify machine prerequisites for local run. Actionable message + return 1 on
# any failure; never modifies the machine (esp. never runs sudo/setup:local).
# Usage: _local_prereqs
_local_prereqs() {
    grep -q 'local.findcare.dev.aplaceformom.com' /etc/hosts 2>/dev/null \
        || { echo "PREREQ: /etc/hosts is missing the dev domain. Run 'pnpm setup:local' in the repo, with you present (needs sudo)." >&2; return 1; }
    [ -f /Library/LaunchDaemons/com.grace.portforward.plist ] \
        || { echo "PREREQ: the 443→8080 port-forward daemon is missing. Run 'pnpm setup:local' in the repo, with you present (needs sudo)." >&2; return 1; }
    [ -n "$NODE_AUTH_TOKEN" ] \
        || { echo "PREREQ: NODE_AUTH_TOKEN is not set (needed for @aplaceformom/* packages). Export a GitHub PAT with read:packages (the gh oauth token lacks that scope)." >&2; return 1; }
    [ -s "$HOME/.nvm/nvm.sh" ] \
        || { echo "PREREQ: nvm not found at ~/.nvm/nvm.sh (needed for Node $LOCAL_NODE_VERSION)." >&2; return 1; }
    ( export NVM_DIR="$HOME/.nvm"; . "$NVM_DIR/nvm.sh"; nvm which "$LOCAL_NODE_VERSION" >/dev/null 2>&1 ) \
        || echo "NOTE: Node $LOCAL_NODE_VERSION not installed under nvm; run_local will 'nvm install $LOCAL_NODE_VERSION' (this changes nvm's default alias)." >&2
    ( vercel whoami >/dev/null 2>&1 ) \
        || { echo "PREREQ: not logged into Vercel. Run 'vercel login'." >&2; return 1; }
    return 0
}

# Stop the tracked local dev server and clear state.
# Usage: stop_local [SESSION]   (SESSION optional; if given, only stops when it is the current owner)
stop_local() {
    local want="$1" f owner pid
    f=$(_local_run_file); owner=$(_local_run_owner)
    [ -z "$owner" ] && { echo "no session is running locally"; return 0; }
    if [ -n "$want" ] && [ "$want" != "$owner" ]; then
        echo "local run is owned by '$owner', not '$want' — nothing stopped"; return 0
    fi
    pid=$(jq -r '.pid // empty' "$f" 2>/dev/null)
    [ -n "$pid" ] && kill "$pid" 2>/dev/null
    # pnpm dev spawns children (next). Also free the port if anything lingers.
    local lport; lport=$(lsof -t -nP -iTCP:"$LOCAL_PORT" -sTCP:LISTEN 2>/dev/null)
    [ -n "$lport" ] && kill "$lport" 2>/dev/null || true
    rm -f "$f"
    echo "stopped local run for '$owner' (pid ${pid:-?})"
}
# Bring a session's grace-frontend app up on the fixed local URL, single-instance,
# and verify the RIGHT server answers. Idempotent. Prints the URL on success.
# Usage: run_local SESSION [--fresh]
run_local() {
    local sn="$1" fresh="$2"
    local SDIR="$SESSIONS_DIR/$sn" REPO="$SESSIONS_DIR/$sn/repo"
    [ -d "$REPO" ] || { echo "ERROR: repo missing for session '$sn'" >&2; return 1; }
    grep -q '"'"$LOCAL_DEV_CMD"'"\|"dev"' "$REPO/package.json" 2>/dev/null \
        || { echo "ERROR: $REPO is not a runnable checkout (no dev script)" >&2; return 1; }
    mkdir -p "$SDIR/logs"
    local log="$SDIR/logs/dev-server.log"

    # 1) Machine prereqs (actionable STOP if missing).
    _local_prereqs || return 1

    # 2) Load nvm + Node (never the ambient node).
    export NVM_DIR="$HOME/.nvm"; . "$NVM_DIR/nvm.sh" 2>/dev/null
    nvm which "$LOCAL_NODE_VERSION" >/dev/null 2>&1 || nvm install "$LOCAL_NODE_VERSION" >/dev/null 2>&1
    nvm use "$LOCAL_NODE_VERSION" >/dev/null 2>&1 || { echo "ERROR: could not select Node $LOCAL_NODE_VERSION via nvm" >&2; return 1; }

    # 3) Per-checkout setup (env BEFORE install). Fast path if already set up.
    if [ "$fresh" = "--fresh" ] || [ ! -f "$REPO/.env.local" ] || [ ! -d "$REPO/node_modules" ] || ! ls "$REPO"/packages/grace-api/src/generated/* >/dev/null 2>&1; then
        ( cd "$REPO" && vercel link --yes --scope "$VERCEL_SCOPE" --project "$VERCEL_PROJECT" >/dev/null 2>&1 ) \
            || { echo "ERROR: vercel link failed (scope $VERCEL_SCOPE / project $VERCEL_PROJECT)" >&2; return 1; }
        ( cd "$REPO" && vercel env pull .env.local >/dev/null 2>&1 ) \
            || { echo "ERROR: vercel env pull failed" >&2; return 1; }
        local nvars; nvars=$(grep -c '=' "$REPO/.env.local" 2>/dev/null || echo 0)
        [ "$nvars" -gt 0 ] || { echo "ERROR: .env.local came back empty" >&2; return 1; }
        echo "pulled .env.local ($nvars vars); installing…"
        ( cd "$REPO" && pnpm install > "$log.install" 2>&1 ) || { echo "ERROR: pnpm install failed — see $log.install" >&2; return 1; }
        if grep -qi 'Could not generate API types\|Warning: Could not generate' "$log.install" 2>/dev/null; then
            echo "ERROR: dev backend unreachable — API types not generated; the app won't run correctly. See $log.install" >&2; return 1
        fi
    fi

    # 4) Single-instance: free the port.
    local listener owner_cwd
    listener=$(lsof -t -nP -iTCP:"$LOCAL_PORT" -sTCP:LISTEN 2>/dev/null | head -1)
    if [ -n "$listener" ]; then
        owner_cwd=$(lsof -p "$listener" 2>/dev/null | awk '$4=="cwd"{print $NF}' | head -1)
        if [ "$owner_cwd" = "$REPO" ] && curl -sk -o /dev/null -w '%{http_code}' "$LOCAL_URL/" 2>/dev/null | grep -q '^2'; then
            echo "already running for '$sn' at $LOCAL_URL"; return 0
        fi
        echo "port $LOCAL_PORT was held by: ${owner_cwd:-unknown} — stopping it."
        case "$owner_cwd" in "$HOME/Projects/"*) echo "  (that looks like YOUR own dev server — restart it when you're done here.)";; esac
        kill "$listener" 2>/dev/null; sleep 2
    fi

    # 5) Launch in the background.
    ( cd "$REPO" && export NVM_DIR="$HOME/.nvm"; . "$NVM_DIR/nvm.sh" 2>/dev/null; nvm use "$LOCAL_NODE_VERSION" >/dev/null 2>&1; nohup $LOCAL_DEV_CMD > "$log" 2>&1 & echo $! > "$SDIR/.dev_pid" )
    local pid; pid=$(cat "$SDIR/.dev_pid" 2>/dev/null); rm -f "$SDIR/.dev_pid"
    printf '{"session":"%s","pid":%s,"started":"%s"}\n' "$sn" "${pid:-0}" "$(date -Iseconds)" > "$(_local_run_file)"

    # 6) Wait + verify the RIGHT server answers (cwd == this repo AND 200).
    local i code vcwd vpid
    for i in $(seq 1 45); do
        code=$(curl -sk -o /dev/null -w '%{http_code}' "$LOCAL_URL/" 2>/dev/null)
        if [ "$code" = "200" ]; then
            vpid=$(lsof -t -nP -iTCP:"$LOCAL_PORT" -sTCP:LISTEN 2>/dev/null | head -1)
            vcwd=$(lsof -p "$vpid" 2>/dev/null | awk '$4=="cwd"{print $NF}' | head -1)
            [ "$vcwd" = "$REPO" ] && { echo "✅ running for '$sn' at $LOCAL_URL (log: $log)"; return 0; }
        fi
        sleep 2
    done
    echo "ERROR: $LOCAL_URL did not come up as '$sn' within ~90s. Last log lines:" >&2
    tail -20 "$log" >&2
    return 1
}
# Commit staged+unstaged changes in the session repo.
commit_fix() {
    local d="$SESSIONS_DIR/$1"; shift
    local msg="$*"; [ -n "$msg" ] || msg="fix: address review comment"
    ( cd "$d/repo" && git add -A && git commit -m "$msg" ) && echo "committed" || { echo "ERROR: commit failed" >&2; return 1; }
}
# Push the PR branch from the session repo.
push_fix() {
    local d="$SESSIONS_DIR/$1"
    ( cd "$d/repo" && git push ) && echo "pushed" || { echo "ERROR: push failed" >&2; return 1; }
}
# Mark a mine PR's comment triage complete → back to the idle "My pull requests" list.
triage_done() {
    local d="$SESSIONS_DIR/$1"
    [ -d "$d" ] || { echo "ERROR: session $1 not found" >&2; return 1; }
    update_mine_stage "$d" "tracking"
    echo "triage done for $1"
}

# After a successful comment/request-changes, snapshot the PR head so the watch daemon
# can detect NEW commits, and clear any stale rereview flag.
_record_reviewed() {
    local d="$SESSIONS_DIR/$1"; local num repo sha
    num=$(read_session_field "$d" "pr.number"); repo=$(_pr_repo "$d")
    sha=$(timeout 15 gh pr view "$num" --repo "$repo" --json headRefOid -q .headRefOid 2>/dev/null)
    [ -n "$sha" ] && update_reviewed_sha "$d" "$sha"
    clear_rereview_pending "$d"
}

# If a review is marked "reviewing" but its worker PID is gone, mark it interrupted.
# Usage: detect_interrupted SESSION_DIR
detect_interrupted() {
  local d="$1"
  local pid; pid=$(read_session_field "$d" "review_worker_pid")
  if [ "$(read_review_state "$d")" = "reviewing" ] && { [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; }; then
    update_review_state "$d" "interrupted"
  fi
}

# If a PR is merged or closed on GitHub, mark it triage done (best-effort, never blocks).
# Usage: auto_drop_merged SESSION_DIR
auto_drop_merged() {
  local d="$1"
  local num proj repo state
  num=$(read_session_field "$d" "pr.number")
  proj=$(read_session_field "$d" "project")
  [ -z "$num" ] || [ -z "$proj" ] && return 0
  repo=$(printf '%s' "$proj" | sed -E 's#.*github\.com/([^/]+/[^/.]+).*#\1#')
  state=$(gh pr view "$num" --repo "$repo" --json state -q .state 2>/dev/null)
  if [ "$state" = "MERGED" ] || [ "$state" = "CLOSED" ]; then
    update_triage_state "$d" "done"
  fi
}

# Startup sweep: run once at Mission Control launch to fix stale states.
# Usage: mc_startup_sweep
mc_startup_sweep() {
  for d in "$SESSIONS_DIR"/pr-*; do
    [ -d "$d" ] || continue
    [ "$(read_triage_state "$d")" = "done" ] && continue
    detect_interrupted "$d"
    auto_drop_merged "$d"
  done
  # Pre-warm agent tabs for reviewed PRs waiting on you, so a click just
  # switches to an already-running agent (tabs can be targeted by name, unlike
  # floating panes, so pre-warming no longer causes the "opens all" problem).
  ensure_agent_tabs
}

# Write shared engineering principles file to a session directory.
# Usage: write_principles SESSION_DIR
write_principles() {
  cat > "$1/PRINCIPLES.md" <<'PRIN'
# Engineering Principles (shared)
- No hacks or workarounds; prefer correct, maintainable solutions.
- Optimize for readability and long-term maintainability.
- Consider scalability and performance implications.
- Follow existing patterns and conventions in the codebase.
- YAGNI — do not over-engineer; solve the actual problem.
PRIN
}

# Emit one line per open review: "<display>\t<session>\t<group>".
# Section headers are emitted as display-only rows with empty session+group.
review_list_grouped() {
  local mergemine="" ready="" inflight="" rereview="" response="" approved="" mycomments="" mytracking=""
  local d sname num author rs lc rp icon line
  local me_lc; me_lc=$(printf '%s' "${GITHUB_ME:-}" | tr '[:upper:]' '[:lower:]')
  for d in "$SESSIONS_DIR"/pr-*; do
    [ -d "$d/repo" ] || continue                       # repo gone (deleted/merged) → skip
    [ "$(read_triage_state "$d")" = "done" ] && continue
    sname=$(basename "$d")
    num=$(read_session_field "$d" "pr.number")
    author=$(read_session_field "$d" "pr.author")
    rs=$(read_review_state "$d")
    lc=$(read_lifecycle "$d")
    rp=$(read_rereview_pending "$d")

    # --- My own PRs: never code-reviewed; their own lifecycle. ---
    if pr_is_mine "$d"; then
      local ms; ms=$(read_mine_stage "$d")
      if [ "$lc" = "approved" ]; then
        mergemine="${mergemine}$(printf 'PR #%s  @%-14s 🚀 APPROVED — merge it!' "$num" "${author:-?}")\t\tmergemine"$'\n'
      elif [ "$ms" = "ready" ]; then
        # Count only UNHANDLED entries (Status: open), split by verdict, so the
        # label decrements as the user replies/fixes/dismisses — always in sync
        # with COMMENTS.md. valid+open = needs a fix; false-pos+open = just reply.
        local cf="$d/COMMENTS.md" counts nvalid nfp mc_label
        counts=$(awk '
          /^### / { if (v!=""&&st=="open"){ if(v=="valid")nv++; else nf++ } v=""; st="" }
          /^- \*\*Verdict:\*\* ✅/ { v="valid" }
          /^- \*\*Verdict:\*\* 🟡/ { v="fp" }
          /^- \*\*Status:\*\* / { st=$0; sub(/^- \*\*Status:\*\* /,"",st); sub(/[[:space:]]+$/,"",st) }
          END { if (v!=""&&st=="open"){ if(v=="valid")nv++; else nf++ } print (nv+0)" "(nf+0) }
        ' "$cf" 2>/dev/null)
        nvalid=${counts%% *}; nfp=${counts##* }; nvalid=${nvalid:-0}; nfp=${nfp:-0}
        if [ "$nvalid" -gt 0 ]; then
          mc_label="$(printf '🔧 %s to fix' "$nvalid")"; [ "$nfp" -gt 0 ] && mc_label="${mc_label}, ${nfp} to reply"
        elif [ "$nfp" -gt 0 ]; then
          mc_label="$(printf '💬 %s false-pos · just reply' "$nfp")"
        else
          mc_label="✅ all addressed · close it"
        fi
        mycomments="${mycomments}$(printf 'PR #%s  @%-14s %s' "$num" "${author:-?}" "$mc_label")\t${sname}\tmycomments"$'\n'
      elif [ "$ms" = "triaging" ]; then
        inflight="${inflight}$(printf 'PR #%s  @%-14s 👀 triaging reviewer comments' "$num" "${author:-?}")\t\tinflight"$'\n'
      else
        local mt_icon="📋 open · awaiting review"
        [ "$(read_session_field "$d" "is_draft" 2>/dev/null)" = "true" ] && mt_icon="📝 draft · in progress"
        mytracking="${mytracking}$(printf 'PR #%s  @%-14s %s' "$num" "${author:-?}" "$mt_icon")\t\tmyprs"$'\n'
      fi
      continue
    fi

    # Approved → stays until the PR merges. Waiting on the author. Display-only.
    if [ "$lc" = "approved" ]; then
      approved="${approved}$(printf 'PR #%s  @%-14s ✅ approved · author will merge' "$num" "${author:-?}")\t\tapproved"$'\n'
      continue
    fi

    # Agent is actively reviewing (initial OR re-review) → "👀 Reviewing now".
    # Display-only (nothing to open until it's ready).
    if [ "$rs" = "queued" ] || [ "$rs" = "reviewing" ]; then
      local what="review"; [ "$rp" = "true" ] && what="re-review"
      case "$rs" in
        queued)    icon="⏳ queued for $what";;
        reviewing) icon="👀 agent reviewing ($what)";;
      esac
      inflight="${inflight}$(printf 'PR #%s  @%-14s %s' "$num" "${author:-?}" "$icon")\t\tinflight"$'\n'
      continue
    fi

    line="$(printf 'PR #%s  @%-14s %s\t%s' "$num" "${author:-?}" "$icon" "$sname")"
    if [ "$rp" = "true" ]; then
      # Re-review has FINISHED (in-flight ones were caught above as "Agent
      # reviewing"). Needs your attention, but it's a quick check — only the
      # delta since last review, with a resolution summary.
      local summary; summary=$(cat "$d/rereview_summary" 2>/dev/null)
      icon="🔁 re-review · quick"; [ "$rs" = "failed" ] && icon="⚠ re-review failed — retry"
      local reline="$(printf 'PR #%s  @%-14s %s' "$num" "${author:-?}" "$icon")"
      [ -n "$summary" ] && reline="${reline}  ·  ${summary}"
      rereview="${rereview}${reline}\t${sname}\trereview"$'\n'
    elif [ "$lc" = "none" ]; then
      # Fresh review complete (or failed) → a full first-time review to work through.
      case "$rs" in
        ready)       icon="🆕 new · full review";;
        failed)      icon="⚠ review failed — retry";;
        interrupted) icon="⏸ interrupted";;
        *)           icon="${rs:-…}";;
      esac
      ready="${ready}$(printf 'PR #%s  @%-14s %s' "$num" "${author:-?}" "$icon")\t${sname}\tready"$'\n'
    else
      # We posted comments / requested changes → waiting on the author.
      response="${response}$(printf 'PR #%s  @%-14s 💬 waiting on author' "$num" "${author:-?}")\t${sname}\tresponse"$'\n'
    fi
  done
  # Action zone (needs YOU) first, then passive/informational, then my open PRs.
  [ -n "$mergemine" ]  && { printf '── 🚀 Approved — MERGE YOURS ──\t\t\n';        printf '%b' "$mergemine"; }
  [ -n "$mycomments" ] && { printf '── 💬 My PRs — comments to address ──\t\t\n'; printf '%b' "$mycomments"; }
  printf '── 🔔 Needs your attention ──\t\t\n'
  [ -n "$rereview" ] && printf '%b' "$rereview"
  [ -n "$ready" ]    && printf '%b' "$ready"
  [ -n "$inflight" ] && { printf '── 👀 Agent reviewing ──\t\t\n';        printf '%b' "$inflight"; }
  printf '── 💬 Waiting for response ──\t\t\n';         [ -n "$response" ] && printf '%b' "$response"
  [ -n "$approved" ]   && { printf '── ✅ Approved (author will merge) ──\t\t\n'; printf '%b' "$approved"; }
  [ -n "$mytracking" ] && { printf '── 📋 My pull requests ──\t\t\n';            printf '%b' "$mytracking"; }
}

render_status_table() {
  printf '\033[2J\033[H'   # clear
  printf 'MISSION CONTROL — reviews\n\n'
  for d in "$SESSIONS_DIR"/pr-*; do
    [ -d "$d" ] || continue
    [ "$(read_triage_state "$d")" = "done" ] && continue
    local num author rstate astate icon
    num=$(read_session_field "$d" "pr.number"); author=$(read_session_field "$d" "pr.author")
    rstate=$(read_review_state "$d"); astate=$(cat "$d/.cg_agent_state" 2>/dev/null)
    case "$rstate" in
      ready) icon="✅ ready";; reviewing) icon="🤔 reviewing";;
      failed) icon="⚠ failed";; interrupted) icon="⏸ interrupted";;
      queued) icon="… queued";; *) icon="$rstate";;
    esac
    [ "$astate" = "waiting" ] && icon="💬 waiting for your input"
    printf '  PR #%s  @%-12s  %s\n' "$num" "${author:-?}" "$icon"
  done
}

# Create a hidden floating Zellij pane running a claude agent for this PR session.
# Writes the agent PID to SESSION_DIR/agent_pid (exec preserves PID across bash→claude).
# No-op if called outside a Zellij session.
# Usage: create_review_agent_pane SESSION_DIR
# Compute the Zellij tab name for a PR agent: "<status-emoji> #<num> @<author> · <short title>".
# The leading emoji lets the reviewer eyeball the tab bar and cycle to what needs attention.
# Usage: _agent_tab_name SESSION_DIR
_agent_tab_name() {
    local SDIR="$1" num author emoji lc ms rs rp
    num=$(read_session_field "$SDIR" "pr.number")
    author=$(read_session_field "$SDIR" "pr.author")
    lc=$(read_lifecycle "$SDIR"); rs=$(read_review_state "$SDIR"); rp=$(read_rereview_pending "$SDIR")
    if pr_is_mine "$SDIR"; then
        ms=$(read_mine_stage "$SDIR")
        if   [ "$lc" = "approved" ]; then emoji="🚀"
        elif [ "$ms" = "ready" ]; then emoji="🔧"
        elif [ "$ms" = "triaging" ]; then emoji="👀"
        elif [ "$(read_session_field "$SDIR" "is_draft" 2>/dev/null)" = "true" ]; then emoji="📝"
        else emoji="📋"; fi
    else
        if   [ "$lc" = "approved" ]; then emoji="✅"
        elif [ "$lc" = "commented" ] || [ "$lc" = "changes-requested" ]; then emoji="💬"
        elif [ "$rp" = "true" ]; then emoji="🔁"
        elif [ "$rs" = "ready" ]; then emoji="🔔"
        else emoji="👀"; fi
    fi
    # Short, uncluttered tab: status emoji + PR number + author. Full title/details
    # live in the Mission Control status pane.
    printf '%s #%s @%s' "$emoji" "$num" "${author:-?}"
}

# Title for a WORK-tab agent pane: 🔍 <key> (investigate) or 🔨 <key> (develop).
# <key> = session's jira.ticket, else the session dir basename.
# Usage: work_agent_tab_name SESSION_DIR
work_agent_tab_name() {
    local SDIR="$1" mode key emoji
    mode=$(read_session_field "$SDIR" "mode")
    key=$(read_session_field "$SDIR" "jira.ticket"); [ -z "$key" ] && key=$(basename "$SDIR")
    case "$mode" in development) emoji="🔨";; *) emoji="🔍";; esac
    printf '%s %s' "$emoji" "$key"
}

# Launch the session's agent as a tiled pane in the single "🔨 WORK" tab, so all
# active investigate/dev work is visible at once. Agent runs with cwd=SESSION_DIR
# (auto-loads SESSION_DIR/CLAUDE.md — the mode's autonomous instructions). No
# --add-dir (repo/ is a subdir of cwd; adding it would load repo/CLAUDE.md).
# Usage: create_work_agent_pane SESSION_DIR
create_work_agent_pane() {
    local SDIR="$1"
    [ -d "$SDIR/repo" ] || return 1
    # Work regardless of the caller's context (orchestrator is inside MC; the web
    # server is not) — target the mission-control session explicitly below.
    zellij list-sessions 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | grep -qE '^mission-control[[:space:]]' || return 0
    local title; title=$(work_agent_tab_name "$SDIR")

    local wrapper; wrapper=$(mktemp /tmp/cgremlin-work-XXXXXX)
    cat > "$wrapper" <<WRAPPER
#!/bin/bash
echo \$\$ > "$SDIR/agent_pid"
cd "$SDIR" || exit 1
exec claude --model "$MODEL" "Your very first action: read CLAUDE.md in this directory and follow it exactly — it is your autonomous working brief. Begin now; do not wait for my input; do not read any other CLAUDE.md."
WRAPPER
    chmod +x "$wrapper"

    # Ensure the WORK tab exists (create with tab-bar + this pane), else add a
    # tiled pane to it. Detect existence via dump-layout (tab names appear there).
    if zellij --session mission-control action dump-layout 2>/dev/null | grep -qF 'tab name="🔨 WORK"'; then
        zellij --session mission-control action go-to-tab-name "🔨 WORK" 2>/dev/null || true
        zellij --session mission-control action new-pane -c --name "$title" -- bash "$wrapper" 2>/dev/null || true
    else
        local lay; lay=$(mktemp /tmp/cgremlin-worklayout-XXXXXX)
        cat > "$lay" <<KDL
layout {
    pane size=1 borderless=true {
        plugin location="zellij:tab-bar"
    }
    pane close_on_exit=true name="$title" command="bash" {
        args "$wrapper"
    }
}
KDL
        zellij --session mission-control action new-tab --name "🔨 WORK" --layout "$lay" 2>/dev/null || true
        rm -f "$lay"
    fi
}

create_review_agent_pane() {
    local SDIR="$1"
    [ -d "$SDIR/repo" ] || return 1
    [ -n "$ZELLIJ" ] || return 0

    local num author pr_title
    num=$(read_session_field "$SDIR" "pr.number")
    author=$(read_session_field "$SDIR" "pr.author")
    pr_title=$(read_session_field "$SDIR" "pr.title")
    local tab_name; tab_name=$(_agent_tab_name "$SDIR")

    # Posting-command permissions go in the AGENT's cwd settings ($SDIR/.claude),
    # because the interactive agent runs with cwd=$SDIR (see wrapper below).
    local sf="$SDIR/.claude/settings.local.json"; mkdir -p "$SDIR/.claude"
    local add
    if pr_is_mine "$SDIR" && [ "$(read_mine_stage "$SDIR")" = "ready" ]; then
        add='["Bash(cgremlin --reply-comment *)","Bash(cgremlin --resolve-comment *)","Bash(cgremlin --commit-fix *)","Bash(cgremlin --push-fix *)","Bash(cgremlin --triage-done *)","Bash(cgremlin --pr-threads *)","Bash(cgremlin --run-local *)","Bash(cgremlin --stop-local *)"]'
    else
        add='["Bash(cgremlin --approve-pr *)","Bash(cgremlin --comment-pr *)","Bash(cgremlin --request-changes-pr *)","Bash(cgremlin --pr-threads *)","Bash(cgremlin --run-local *)","Bash(cgremlin --stop-local *)"]'
    fi
    if [ -f "$sf" ]; then
        jq --argjson add "$add" '.permissions.allow = ((.permissions.allow // []) + $add | unique)' "$sf" > "$sf.tmp" && mv "$sf.tmp" "$sf"
    else
        printf '{"permissions":{"allow":%s}}\n' "$add" > "$sf"
    fi

    # Write the triage protocol as the agent's cwd CLAUDE.md ($SDIR/CLAUDE.md).
    # The agent runs with cwd=$SDIR (NOT a git repo), so Claude auto-loads THIS
    # file as its project instructions and never descends into repo/CLAUDE.md
    # (the review-generation prompt) — which is what made the agent open "blank".
    local pr_url pr_head
    pr_url=$(read_session_field "$SDIR" "pr.url")
    pr_head=$(read_session_field "$SDIR" "pr.head")
    if pr_is_mine "$SDIR" && [ "$(read_mine_stage "$SDIR")" = "ready" ]; then
      cat > "$SDIR/CLAUDE.md" <<MYCTX
# My PR — reviewer comment triage — PR #${num}: ${pr_title}

Your PR got reviewer comments. \`COMMENTS.md\` in this directory has each comment
already classified ✅ valid or 🟡 false-positive, with reasoning and a proposed
reply/fix. Walk me through them so I can decide each one.

\`COMMENTS.md\` is your working list (each comment pre-classified ✅ valid or
🟡 false-positive, with reasoning + a proposed reply/fix). It is a SNAPSHOT — it
does NOT update when I (or another agent) reply or resolve threads on the PR
directly. **The live PR is the source of truth for what's still open.**

## Reconcile against the live PR — ALWAYS do this first, and again whenever I say I replied
Run \`cgremlin --pr-threads $(basename "$SDIR")\` to see the CURRENT thread state
(one row per thread: threadId, resolved true/false, first author, path:line, last
replier, snippet). Match each COMMENTS.md entry to its thread by id/location and:
- thread \`resolved\` → mark that entry **done** (skip it; don't ask me to reply).
- I (or someone) already replied but it's unresolved → tell me it's replied, ask if I want to resolve it (\`cgremlin --resolve-comment $(basename "$SDIR") <thread-id>\`) — don't re-draft a reply.
- a live thread has NO matching COMMENTS.md entry → it's NEW; surface it and triage it on the fly (valid/false-positive), same as the others.
Re-run \`--pr-threads\` any time I mention I changed something on the PR, and adjust. Never present an item as needing action if it's already resolved/replied live.

## First message — reconcile, then open with the roll-up
Run \`--pr-threads\`, reconcile COMMENTS.md against it, THEN print one line and a
numbered list of what's ACTUALLY still open. Nothing else:

    3 comments — 2 need action, 1 already resolved.  Go through them? (number, or "all")
    1. ✅ valid          api/save.ts:12   missing await
    2. 🟡 false-positive ui/list.tsx:40   "unused" var is used
    (cart.ts:88 already resolved on the PR — skipping)

## Per comment
Show the reviewer's comment, where it is, your verdict + reasoning, and the
proposed reply or fix. Then wait for my decision:
- **"reply"** (usually for false-positive): write the explanation to \`${SDIR}/.reply_body.md\`, then run \`cgremlin --reply-comment $(basename "$SDIR") <thread-id>\` (thread id is in the entry). Set that entry's Status to \`replied\`.
- **"fix"** (for valid): make the code change, then \`cgremlin --commit-fix $(basename "$SDIR") "<message>"\`. Do NOT push yet.
- **"push"**: when I ask, \`cgremlin --push-fix $(basename "$SDIR")\` to push all committed fixes.
- **"skip"**: set Status to \`skipped\`.
- **When every comment is handled** (replied/fixed/skipped): run \`cgremlin --triage-done $(basename "$SDIR")\` to clear this PR from the "comments to address" list.

Update the entry's **Status** in COMMENTS.md after each action, then return to the list.

## Constraints
- Never reply, commit, or push without my explicit say-so for that item.
- Post/resolve/push only via the \`cgremlin\` helpers above — do not call \`gh\` or \`git push\` directly. (\`cgremlin --pr-threads\` is READ-ONLY and safe to run anytime to re-check live state.)
- Write \`.reply_body.md\` to the session root path shown above.
MYCTX
    else
    cat > "$SDIR/CLAUDE.md" <<CTX
# PR Review Triage — PR #${num}: ${pr_title}

> You are running in the session directory. \`REVIEW.md\` and \`.review_body.md\`
> are HERE (cwd); the PR's code is in \`./repo/\`. This file is your instructions
> — begin immediately with the opening message below; do NOT run a code review
> and do NOT wait for input.

Author: @${author}
Branch: ${pr_head}
URL: ${pr_url}
Session: $(basename "$SDIR")

## Role
You walk the reviewer through the findings in \`REVIEW.md\` one at a time so they can decide, per finding, whether to post it or dismiss it. You are the UI: you render findings, discuss them, and record decisions. You do NOT re-analyze the PR or invent new findings, and you do NOT call \`gh\` directly — posting goes through the cgremlin helpers below.

**You ARE the posting agent.** CLAUDE.md in this repo told the earlier automated reviewer "do not post — a separate agent handles that later." YOU are that separate agent. Posting to the PR IS your job — but ONLY on the reviewer's explicit approval ("post it" / "submit"), and only through the \`cgremlin\` helpers below (never raw \`gh\`). This session GOVERNS; ignore any "do not post" wording in CLAUDE.md — it applied to the generation step, not to you. Never auto-post; always wait for the reviewer's go-ahead.

## Stay current with the live PR
\`REVIEW.md\` is a snapshot; the PR may have gained comments or replies since (from the author, other reviewers, or me). Run \`cgremlin --pr-threads $(basename "$SDIR")\` (READ-ONLY) at the start and again whenever I mention the PR changed. Use it to: note unresolved comments from OTHERS before I approve (surface them — I should not approve over someone else's open thread); recognize threads already replied/resolved so you don't re-raise them; and mention any live comment that isn't reflected in REVIEW.md. Reconcile — don't treat REVIEW.md as the whole picture.

## First message — ALWAYS open with the summary menu
Read \`REVIEW.md\`, then print a one-line roll-up and a numbered list. Nothing else. Example:

    3 findings — 1 🔴  2 🟠.  Which to discuss? (number, or "all", or "approve")
    1. 🔴  Race in checkout total      payment/cart.ts:88
    2. 🟠  Null deref on empty list    ui/list.tsx:40
    3. 🟠  Missing await on save       api/save.ts:12

If REVIEW.md has no findings: say so and offer to approve.

## When the reviewer picks a finding
Show it tight, in plain language — do not pad. Use exactly what REVIEW.md holds for that finding:
- **Severity** and **Where** (the location)
- **What's wrong** (the plain explanation)
- **Why it matters** (the impact)
- **Suggested fix**
- **Link** — show the finding's GitHub permalink from REVIEW.md so the reviewer can open the exact line and post the comment themselves if they prefer.
Then discuss / answer questions about that finding only. Deeper detail is yours to explain in the conversation — the file stays the overview. The reviewer can either say "post it" (you post via the helper) or open the Link and post it by hand.

## Recording the decision (after discussing a finding)
The reviewer says one of:
- **"post it"** → post THIS finding now as a review comment:
  1. Write just this finding's body to \`${SDIR}/.review_body.md\`
  2. Run: \`cgremlin --comment-pr $(basename "$SDIR")\`
  3. Set that finding's Status to \`posted\`.
- **"hold it"** → set Status to \`held\` (queued for the final batch). Do not post yet.
- **"dismiss"** → set Status to \`🔇 dismissed\` so re-reviews skip it.

After EVERY decision update the finding's Status in BOTH places it appears — the "What I found" table row AND the detail heading — so they stay in sync. Then return to the menu.

## When the reviewer says "submit" / "done"
1. Confirm the verdict explicitly: Approve / Comment / Request-changes.
2. Write the review body (summary + every \`held\` finding) to \`${SDIR}/.review_body.md\`.
3. Run exactly one of:
   \`cgremlin --approve-pr $(basename "$SDIR")\`  (archives + closes the session)
   \`cgremlin --comment-pr $(basename "$SDIR")\`
   \`cgremlin --request-changes-pr $(basename "$SDIR")\`

## Approval safety gate (IMPORTANT)
\`cgremlin --approve-pr\` will REFUSE and print blockers if CI is failing or
review comments are unresolved. If it does:
1. Show me its output verbatim — the failing checks and open comments.
2. Explain what they mean and whether they should block.
3. Do NOT approve unless I explicitly say to override after seeing them. Only
   then run \`cgremlin --approve-pr $(basename "$SDIR") --force\`.
Never pass \`--force\` on your own initiative.

## Constraints
- Never post without an explicit decision from the reviewer.
- Never run \`gh\` yourself — only the cgremlin helpers above post to GitHub.
- Write \`.review_body.md\` to the session root path shown above, NOT the repo subdirectory.

For live web evals, run \`cgremlin --run-local $(basename "$SDIR")\` and wait for the URL, then drive the browser (chrome-devtools MCP) against https://local.findcare.dev.aplaceformom.com/ . Watch logs/dev-server.log and tell me if it fails. When done, \`cgremlin --stop-local $(basename "$SDIR")\`.
CTX
    fi

    # Wrapper runs the agent with cwd=$SDIR so Claude auto-loads $SDIR/CLAUDE.md
    # (the triage protocol) — never blank. --add-dir gives it the PR code in
    # ./repo/. Runs in a named TAB (below) that stays alive in the background;
    # switching tabs never interrupts it. exec preserves agent_pid = claude pid.
    local wrapper; wrapper=$(mktemp /tmp/cgremlin-agent-XXXXXX)
    cat > "$wrapper" <<WRAPPER
#!/bin/bash
echo \$\$ > "$SDIR/agent_pid"
cd "$SDIR" || exit 1
exec claude --model "$MODEL" "Your very first action: read CLAUDE.md in this directory (the PR triage protocol) and produce the opening summary/menu it specifies — the findings list with an offer to go through them one by one. Do that NOW as your first message; do not wait for my input, do not run a code review, do not read any other CLAUDE.md."
WRAPPER
    chmod +x "$wrapper"

    # Run the agent in its own named Zellij TAB (not a floating pane). The tab
    # stays alive in the background — you switch away and back without killing
    # it (go-to-tab-name). close_on_exit makes the tab vanish when the agent
    # process is killed (e.g. the watch daemon on merge). Tab name carries the
    # PR/author/status so you can eyeball the tab bar and cycle.
    local lay; lay=$(mktemp /tmp/cgremlin-tablayout-XXXXXX)
    cat > "$lay" <<KDL
layout {
    pane size=1 borderless=true {
        plugin location="zellij:tab-bar"
    }
    pane close_on_exit=true command="bash" {
        args "$wrapper"
    }
}
KDL
    zellij action new-tab --name "$tab_name" --layout "$lay" 2>/dev/null || true
    update_session_field "$SDIR" "tab_name" "$tab_name"
    rm -f "$lay"
}

# Pre-warm agent TABS for every PR that's reviewed and waiting on you, so a
# click just switches to an already-running agent (never spawns on click).
# Actionable-via-agent = non-mine (ready & not yet acted on / re-reviewed) OR
# mine with comments to triage. Creates a tab only if one doesn't already exist
# (matched by the stable "#<num> @<author>" identity). Returns focus to the
# MISSION CONTROL tab at the end so pre-warming doesn't leave you on a PR tab.
# Usage: ensure_agent_tabs  (no args; uses SESSIONS_DIR)
ensure_agent_tabs() {
    [ -n "$ZELLIJ" ] || return 0
    local d num author lc rp rs ms layout want stable created=0
    layout=$(zellij action dump-layout 2>/dev/null)
    for d in "$SESSIONS_DIR"/pr-*; do
        [ -d "$d/repo" ] || continue
        [ "$(read_triage_state "$d")" = "done" ] && continue
        lc=$(read_lifecycle "$d"); rp=$(read_rereview_pending "$d"); rs=$(read_review_state "$d")
        want=no
        if pr_is_mine "$d"; then
            [ "$(read_mine_stage "$d")" = "ready" ] && want=yes
        else
            [ "$rs" = "ready" ] && { [ "$lc" = "none" ] || [ "$rp" = "true" ]; } && want=yes
        fi
        [ "$want" = "yes" ] || continue
        num=$(read_session_field "$d" "pr.number"); author=$(read_session_field "$d" "pr.author")
        stable="#${num} @${author}"
        printf '%s' "$layout" | grep 'tab name=' | grep -qF "$stable" && continue  # tab already exists
        create_review_agent_pane "$d" && created=1
    done
    # Pre-warming focuses each new tab; return the user to Mission Control.
    [ "$created" = "1" ] && zellij action go-to-tab-name "MISSION CONTROL" 2>/dev/null || true
}

# Jump to a PR's agent tab (or create it). Each PR agent runs in its own named
# Zellij tab that stays alive in the background — switching between PRs never
# interrupts a running agent. Zellij can jump to a tab by name (go-to-tab-name)
# but NOT to a floating pane by name, which is why we use tabs.
# Usage: open_pr_row <session-name>
open_pr_row() {
    local session_name="$1"
    local SDIR="$SESSIONS_DIR/$session_name"
    [ -d "$SDIR/repo" ] || { echo "ERROR: repo missing for $session_name" >&2; return 1; }
    [ -n "$ZELLIJ" ] || return 0

    # PR agents live in named tabs that stay alive in the background. If a tab
    # for THIS PR already exists, JUMP to it (agent still running, right where
    # you left it — never killed, never re-spawned). Otherwise create it.
    #
    # Match by the STABLE identity "#<num> @<author>" (present in every tab name
    # regardless of the status emoji), then read that tab's exact current name
    # from the layout and jump to it. This never spawns a duplicate even if the
    # stored name is stale.
    local num author stable layout current
    num=$(read_session_field "$SDIR" "pr.number")
    author=$(read_session_field "$SDIR" "pr.author")
    stable="#${num} @${author}"
    layout=$(zellij action dump-layout 2>/dev/null)
    current=$(printf '%s' "$layout" | grep 'tab name=' | grep -F "$stable" | head -1 | sed -E 's/.*tab name="([^"]*)".*/\1/')

    if [ -n "$current" ]; then
        zellij action go-to-tab-name "$current" 2>/dev/null || true
    else
        # No live tab for this PR → create one running the agent (focuses it).
        create_review_agent_pane "$SDIR"
    fi
}

# Interactive picker: select a ready review and show its floating agent pane.
status_pane_loop() {
    mc_startup_sweep
    # Resolve our own absolute path (follow symlinks) so self-calls never depend on PATH.
    local _src="${BASH_SOURCE[0]:-$0}" _d
    while [ -L "$_src" ]; do _d="$(cd -P "$(dirname "$_src")" && pwd)"; _src="$(readlink "$_src")"; [[ "$_src" != /* ]] && _src="$_d/$_src"; done
    local _cg; _cg="$(cd -P "$(dirname "$_src")" && pwd)/$(basename "$_src")"
    while true; do
        local sel sname
        # Seed the list directly (guaranteed to display), then auto-refresh every ~2s via
        # load->reload-sync so reviewing→ready and lifecycle moves appear without a keypress
        # (reload-sync keeps the current list visible during the refresh — no empty flash).
        sel=$("$_cg" --review-list-grouped | fzf --ansi --reverse --delimiter='\t' --with-nth=1 \
            --header='Mission Control — Enter: open a ready review / re-review a waiting one' \
            --bind="load:reload-sync:sleep 2; $_cg --review-list-grouped" \
            --bind='double-click:accept' 2>/dev/null)
        local rc=$?
        [ $rc -ne 0 ] && { sleep 1; continue; }   # Esc/Ctrl-C → loop
        [ -z "$sel" ] && continue
        sname=$(printf '%s' "$sel" | cut -f2)
        [ -z "$sname" ] && continue          # section-header row → no-op
        "$_cg" --open-pr "$sname"
    done
}

# Add history entry to session
# Usage: add_session_history SESSION_DIR action [details_json]
add_session_history() {
    local session_dir="$1"
    local action="$2"
    local details="${3:-{}}"
    local session_file="$session_dir/session.json"

    if [ -f "$session_file" ]; then
        local tmp=$(mktemp)
        local timestamp=$(date -Iseconds)
        jq --arg ts "$timestamp" --arg act "$action" --argjson det "$details" \
            '.history += [{ timestamp: $ts, action: $act } + $det]' \
            "$session_file" > "$tmp" && mv "$tmp" "$session_file"
    fi
}

# Check if session uses v2 format (has session.json)
is_v2_session() {
    local session_dir="$1"
    [ -f "$session_dir/session.json" ]
}

# Migrate old session to v2 format
# Reads session-info.txt and creates session.json
migrate_session_to_v2() {
    local session_dir="$1"
    local session_name=$(basename "$session_dir")
    local info_file="$session_dir/session-info.txt"

    # Skip if already v2
    [ -f "$session_dir/session.json" ] && return 0

    # Skip if no info file
    [ ! -f "$info_file" ] && return 1

    # Determine mode from folder name
    local mode="investigation"
    if [[ "$session_name" == pr-* ]]; then
        mode="review"
    elif [[ "$session_name" == dev-* ]]; then
        mode="development"
    fi

    # Parse info file for metadata
    local project=""
    local pr_number=""
    local pr_title=""
    local jira_ticket=""
    local branch=""
    local created=""
    local focus=""

    while IFS=: read -r key value; do
        key=$(echo "$key" | xargs | tr '[:upper:]' '[:lower:]' | tr ' ' '_')
        value=$(echo "$value" | xargs)
        case "$key" in
            repository) project="$value" ;;
            pr*)
                if [[ "$value" =~ ([0-9]+) ]]; then
                    pr_number="${BASH_REMATCH[1]}"
                fi
                ;;
            branch) branch="$value" ;;
            jira) jira_ticket="$value" ;;
            created) created="$value" ;;
            summary) pr_title="$value" ;;
        esac
    done < "$info_file"

    # Build extra fields based on mode
    local extra="{}"
    case "$mode" in
        review)
            extra=$(jq -n --arg pr "$pr_number" --arg title "$pr_title" --arg branch "$branch" \
                '{pr: {number: $pr, title: $title, branch: $branch}}')
            ;;
        development)
            extra=$(jq -n --arg jira "$jira_ticket" --arg branch "$branch" \
                '{jira: {ticket: $jira}, branch: $branch}')
            ;;
        investigation)
            # Extract focus from the file
            focus=$(sed -n '/Investigation Focus:/,/====/p' "$info_file" 2>/dev/null | \
                grep -v "Investigation Focus:" | grep -v "===" | grep -v "^-" | head -1 | xargs)
            extra=$(jq -n --arg focus "$focus" '{focus: $focus}')
            ;;
    esac

    # Create session.json
    create_session_json "$session_dir" "$mode" "$project" "$extra"

    # Update created timestamp if available
    if [ -n "$created" ]; then
        update_session_field "$session_dir" "created" "$created"
    fi

    # Mark as migrated in history
    add_session_history "$session_dir" "migrated" '{"from": "v1"}'

    return 0
}

# Get sessions (supports both v1 and v2 formats)
get_sessions_v2() {
    # Find all session directories (old naming: pr-*, inv-*, dev-*; new naming: session-*)
    find "$SESSIONS_DIR" -maxdepth 1 -type d \( \
        -name "pr-*" -o -name "inv-*" -o -name "dev-*" -o -name "session-*" \
    \) 2>/dev/null | sort -r
}

# Get session mode (works with both formats)
get_session_mode() {
    local session_dir="$1"

    # Try v2 first
    if is_v2_session "$session_dir"; then
        read_session_field "$session_dir" "mode"
        return
    fi

    # Fall back to v1 folder naming
    local name=$(basename "$session_dir")
    if [[ "$name" == pr-* ]]; then
        echo "review"
    elif [[ "$name" == dev-* ]]; then
        echo "development"
    else
        echo "investigation"
    fi
}

# CLAUDE.md templates for each mode
generate_claude_md() {
    local session_dir="$1"
    local mode="$2"
    local context="$3"  # Mode-specific context (PR info, Jira details, focus area)

    local repo_dir="$session_dir/repo"
    local claude_md="$session_dir/CLAUDE.md"

    case "$mode" in
        review)
            cat > "$claude_md" << 'REVIEW_TEMPLATE'
# PR Review Session — AUTO-START

Start immediately. Do not wait for user input.

## Project Skill (CHECK FIRST)
Check if `/APFM:apfm-review` skill is available. If yes, run it and follow its output — skip everything below. If not available, proceed.

## Role
You are a senior engineer doing a high-signal review. You produce ONLY `REVIEW.md` — a data file of provable findings. You do NOT talk to GitHub, and you do NOT run the review conversation; a separate agent handles that later. Your entire job is: run the tiers below, write `REVIEW.md`, stop.

## Context
{CONTEXT}

## TIER 0 — Intent gate (Jira is the source of truth) — ALWAYS, FIRST
The ticket defines what this PR is supposed to do. Solving the wrong thing correctly is still a failure.
1. Find the Jira ticket key from the branch name / PR title / context above (e.g. `HB-627`, `GRAC-123`).
2. Fetch it: if an Atlassian MCP tool is available (e.g. getJiraIssue), use it to read the ticket's summary, description, and acceptance criteria. If not available, fall back to the PR description as the intent.
3. Judge: **does this PR actually satisfy that intent / those acceptance criteria?**
4. Write an `Intent alignment:` line at the top of REVIEW.md — ✅ satisfies / ⚠️ partial / ❌ diverges (+ one sentence).
5. If ⚠️ or ❌, create a 🔴 finding: Expected = the ticket criterion, Actual = what the PR does. If no ticket is found, write "No ticket found — reviewed against PR description" and continue.

## TIER 1 — Core scan — ALWAYS, FAST
One focused pass over the diff for the finding types below, under the evidence bar.

## TIER 2 — Deep dive — ONLY IF a complexity trigger is met
Escalate to a deeper pass ONLY when at least one is true:
- the diff is large (roughly > 400 changed lines OR > 15 files), OR
- it touches a critical/shared path (auth, payments, DB migrations, shared utils/components, public API), OR
- Tier 1 surfaced an issue whose blast radius needs cross-file tracing.
When escalating, dispatch parallel sub-agents (Task tool) for the deeper lenses you need (e.g. performance, cross-file data-flow, extra tracing). On a normal PR, SKIP Tier 2. Record in REVIEW.md whether Tier 2 ran.

## THE EVIDENCE BAR — your internal test before writing a finding (do NOT print these labels)
This is how you decide whether something is real enough to write down. Think it through privately; the finding you actually write uses the plain format further below.

**For a bug or performance issue, you must be able to answer:**
- When does it happen? (the exact input, state, or sequence)
- What does the code do in that case?
- What should it do instead?
(Performance: point to the exact repeated work / N+1 / unbounded growth — no hunches.)

**For a maintainability issue, you must be able to answer:**
- What two things are mixed together that shouldn't be? (e.g. business logic sitting inside a UI component, or data-fetching baked into display code)
- What does that concretely cost — what can't be tested on its own, changed without touching unrelated code, or reused?
- How would you separate them?

If you can't answer the questions concretely, DROP it. "Might be slow", "could be cleaner", "consider extracting" (with no concrete cost) never qualify — those are opinions, not findings.

## What to look for (only these)
- **Correctness** — logic errors, null/undefined, off-by-one, async/await, unhandled edge cases you can trigger
- **Security** — injection, auth/authz bypass, sensitive-data exposure, secrets, missing input validation on a real path
- **Regression** — a change that breaks existing behavior (shared util/component, API contract, schema, config)
- **Performance** — provable only (see evidence bar)
- **Maintainability / separation of concerns** — UI/data/business-logic mixed together, or coupling that has a concrete consequence (see evidence bar). This is architectural, not cosmetic.

## What to IGNORE (do not write these)
- Cosmetic style: naming, formatting, import order, line length, DRY-as-preference
- "Over-engineering"/complexity as a preference with no concrete consequence
- Missing docs or comments
- Test coverage gaps (unless a specific untested path is the Trigger for a bug above)
- Anything "nice to have"

## Scope gate (hard rule)
⛔ Review ONLY files in this PR's diff. Any finding whose file is NOT in the diff is INVALID — delete it. Before finishing, re-read every finding and confirm its file is a changed file.

## Constraints
- **DO NOT** post to GitHub. Never run `gh pr comment`, `gh pr review`, or any `gh` command that modifies the PR.
- **DO NOT** write "ready-to-post comments", collaboration instructions, or a conversation. REVIEW.md is data, not a script.
- Missing a real Critical/High is worse than writing fewer findings — but a false positive that wastes the reviewer's time is the failure mode we are fixing. When unsure, apply the evidence bar and drop it.

## Severity (exactly four)
- 🔴 **Critical** — correctness/security bug with concrete impact, OR the PR does not satisfy the ticket. Blocks merge.
- 🟠 **High** — real bug, narrower impact. Should fix; reviewer decides.
- 🟡 **Perf** — provable performance issue. Does not block.
- 🔧 **Maintainability** — concrete separation-of-concerns / coupling violation. Does not block.

## How to write — plain language, for a smart colleague who doesn't know this code
- Write like a clear, friendly senior engineer explaining the issue to a teammate. Short sentences. Normal words.
- No jargon or shorthand. If you must use a technical term, say what it means in a few words.
- Each finding is SHORT: a couple of sentences on what's wrong and a couple on why it matters. Deeper detail comes from the chat with the reviewer later — the file is the overview, not the transcript.
- Every finding follows the SAME shape (below). Same shape every time, whether it's a bug or a maintainability issue.
- Every finding includes a **Link:** — a clickable GitHub permalink to the exact line, so the reviewer can open it and post a comment there manually. Build it ONCE up front: run \`git config --get remote.origin.url\` to get owner/repo (strip \`https://github.com/\`, \`git@github.com:\`, and \`.git\`) and \`git rev-parse HEAD\` for the full commit SHA (the PR branch is checked out here). The link is: \`https://github.com/<owner>/<repo>/blob/<full-sha>/<path>#L<startLine>\` (or \`#L<start>-L<end>\` for a range). Use the FULL 40-char SHA (a permalink), not \`HEAD\`.

## Output — write `REVIEW.md` in this directory, EXACTLY this structure

```
# PR Review: #<number> — <title>

**Does it do what the ticket asked?** ✅ Yes / ⚠️ Mostly / ❌ No — <one plain sentence, name the ticket>
**How deep did I look?** Quick pass / Deep pass (<one-line why>)

## Summary
<2-3 plain sentences: what this PR changes, and your overall take. A teammate should understand the gist from this alone.>

## What I found
| # | Severity | Where | Issue | Status |
|---|----------|-------|-------|--------|
| [1](#f1) | 🔴 Critical | `file.ts:88` | one plain-English line | open |
| [2](#f2) | 🔧 Maintainability | `ui/list.tsx:40` | one plain-English line | open |

The `#` links jump to the full detail below. Keep the `Status` column current — it's how the reviewer sees at a glance what's still open.

(If nothing: write "Nothing worth flagging — looks good to me." and set the verdict to Approve.)

## Details

<a id="f1"></a>
### 1. <plain-English title of the problem>
**Severity:** 🔴 Critical   **Where:** `path/to/file.ext:LN-LN`   **Status:** open
**Link:** https://github.com/<owner>/<repo>/blob/<full-sha>/path/to/file.ext#L<start>-L<end>

**What's wrong:** <2-4 plain sentences. Describe when it happens, what the code does, and what it should do instead — in normal language, no jargon.>

**Why it matters:** <1-2 sentences on the real-world impact: who is affected and how.>

**Suggested fix:** <plain description; add a short code snippet only if it makes it clearer.>

<a id="f2"></a>
### 2. <plain-English title>
**Severity:** 🔧 Maintainability   **Where:** `path/to/file.ext:LN-LN`   **Status:** open
**Link:** https://github.com/<owner>/<repo>/blob/<full-sha>/ui/list.tsx#L40

**What's wrong:** <same shape — for a maintainability issue, explain in plain words what's mixed together that shouldn't be.>

**Why it matters:** <the concrete cost: what becomes hard to test, change, or reuse.>

**Suggested fix:** <how to separate the concerns.>

## Verdict
✅ Approve / 🔄 Request Changes / 💬 Comment — <one plain sentence explaining the call>

## Review History
| Version | Date | Commit | Action |
|---------|------|--------|--------|
| v1 | <date> | <sha> | Initial review |
```

Rules for the file:
- Follow this structure EXACTLY, every time. Same headings, same order, same finding shape.
- Every finding has a stable anchor `<a id="fN"></a>` right before its heading, and the table's `#` cell links to it as `[N](#fN)`. Anchor ids never change across re-reviews (finding 1 is always `f1`).
- `Status` appears in TWO places per finding — the table row and the detail heading — and they must always match. Values: `open` (new), `held` (queued to post), `posted` (sent), `resolved` (fixed, confirmed on re-review), `🔇 dismissed` (skip in re-reviews). Set everything to `open`; the triage and re-review agents change it later.
- Keep it tight. The reviewer reads this to get the picture in under a minute, then talks through anything unclear with the agent.

BEGIN NOW: run Tier 0 (intent), Tier 1 (core), Tier 2 only if triggered; apply the evidence bar in your head; write REVIEW.md in plain language; stop.
REVIEW_TEMPLATE
            # Replace context placeholder
            sed -i '' "s|{CONTEXT}|$context|g" "$claude_md" 2>/dev/null || \
            sed -i "s|{CONTEXT}|$context|g" "$claude_md"
            ;;

        development)
            cat > "$claude_md" << 'DEV_TEMPLATE'
# Development Session

## Project Skill (CHECK FIRST)
Check if `/APFM:apfm-review` skill is available. If yes, run it first for project context before developing. Then proceed below.

## Context
{CONTEXT}

## Your Task
You are implementing a new feature/fix. The branch has been created for you.

## Guidelines
- Follow existing code patterns and conventions
- Write clean, maintainable code
- Add tests for new functionality
- Update DEVLOG.md with progress and decisions
- Commit frequently with clear messages

## Output
- Track your progress in `DEVLOG.md`
- Make commits as you complete logical units of work
- Note any questions or blockers in the devlog
DEV_TEMPLATE
            sed -i '' "s|{CONTEXT}|$context|g" "$claude_md" 2>/dev/null || \
            sed -i "s|{CONTEXT}|$context|g" "$claude_md"

            # Also create DEVLOG.md
            local devlog="$repo_dir/DEVLOG.md"
            cat > "$devlog" << DEVLOG
# Development Log

## Session Started: $(date '+%Y-%m-%d %H:%M')

---

### Progress

(Your progress notes will appear here)

---

### Questions / Blockers

(Note any issues encountered)

