# Generate branch name from Jira ticket
# e.g., "HB-500" with summary "Implement new feature" -> "feature/HB-500-implement-new-feature"
generate_branch_from_jira() {
    local ticket_id="$1"
    local summary="$2"
    local ticket_type="${3:-Story}"

    # Determine branch prefix based on ticket type
    local prefix="feature"
    case "$ticket_type" in
        "Bug"|"bug") prefix="bugfix" ;;
        "Hotfix"|"hotfix") prefix="hotfix" ;;
        "Task"|"task") prefix="task" ;;
        "Spike"|"spike") prefix="spike" ;;
        *) prefix="feature" ;;
    esac

    # Create slug from summary
    local slug=$(echo "$summary" | \
        tr '[:upper:]' '[:lower:]' | \
        sed 's/[^a-z0-9 ]//g' | \
        tr ' ' '-' | \
        sed 's/--*/-/g' | \
        sed 's/^-//' | \
        sed 's/-$//' | \
        cut -c1-40)

    # Construct branch name
    echo "${prefix}/${ticket_id}-${slug}"
}

create_development_session() {
    show_context "New Development Session"

    local REPO_URL=""
    local REPO_DISPLAY=""

    # Choose input method - with default project option if set
    local options=()
    [ -n "$DEFAULT_PROJECT" ] && options+=("⭐ Use default: $DEFAULT_PROJECT")
    options+=("🔍 Browse repositories")
    options+=("🔗 Enter repo URL directly")
    options+=("← Back")

    local input_method=$(printf '%s\n' "${options[@]}" | fzf \
        --height=~35% \
        --layout=reverse \
        --border=rounded \
        --no-info \
        --prompt="" \
        --header="Select project" \
        --header-first)

    case "$input_method" in
        *"Use default"*)
            REPO_URL="$DEFAULT_PROJECT"
            ;;
        *"Browse"*)
            REPO_URL=$(select_repo "New Development Session")
            [ -z "$REPO_URL" ] && return 1
            ;;
        *"Enter repo"*)
            printf "Repository URL: "
            read -r REPO_URL
            [ -z "$REPO_URL" ] && return 1
            ;;
        *)
            return 1
            ;;
    esac

    # Save as default project for next time
    if [ "$REPO_URL" != "$DEFAULT_PROJECT" ]; then
        DEFAULT_PROJECT="$REPO_URL"
        save_config
    fi

    # Extract repo display name
    if [[ "$REPO_URL" =~ github.com/([^/]+)/([^/]+) ]]; then
        REPO_DISPLAY="${BASH_REMATCH[2]}"
        REPO_DISPLAY="${REPO_DISPLAY%.git}"
    else
        REPO_DISPLAY="$REPO_URL"
    fi

    show_context "New Development Session" "📁 $REPO_DISPLAY"

    # Get Jira ticket
    echo ""
    dim "Enter Jira ticket ID or URL (e.g., HB-500 or https://company.atlassian.net/browse/HB-500)"
    printf "Jira ticket: "
    read -r jira_input

    if [ -z "$jira_input" ]; then
        error "Jira ticket is required for development mode"
        sleep 1
        return 1
    fi

    JIRA_URL_DOMAIN=""
    local ticket_id=$(parse_jira_input "$jira_input")

    if [ -z "$ticket_id" ]; then
        error "Could not parse Jira ticket ID"
        sleep 1
        return 1
    fi

    # Fetch Jira ticket details
    dim "Fetching Jira ticket details..."
    local ticket_json=$(fetch_jira_ticket "$ticket_id")

    local JIRA_SUMMARY=""
    local JIRA_DESCRIPTION=""
    local JIRA_TYPE="Story"
    local JIRA_CONTEXT=""
    local BRANCH_NAME=""

    if [ -n "$ticket_json" ]; then
        JIRA_SUMMARY=$(echo "$ticket_json" | jq -r '.fields.summary // "No summary"')
        JIRA_TYPE=$(echo "$ticket_json" | jq -r '.fields.issuetype.name // "Story"')
        JIRA_DESCRIPTION=$(parse_jira_description "$ticket_json")
        JIRA_CONTEXT=$(format_jira_context "$ticket_json" "$ticket_id")

        # Show ticket info
        echo ""
        gum style \
            --border rounded \
            --border-foreground 240 \
            --padding "1 2" \
            --margin "1 0" \
            "[$JIRA_TYPE] $ticket_id" \
            "" \
            "$JIRA_SUMMARY"

        # Generate branch name
        BRANCH_NAME=$(generate_branch_from_jira "$ticket_id" "$JIRA_SUMMARY" "$JIRA_TYPE")
    else
        error "Could not fetch Jira ticket. Please enter details manually."
        echo ""

        printf "Ticket summary: "
        read -r JIRA_SUMMARY
        [ -z "$JIRA_SUMMARY" ] && JIRA_SUMMARY="New feature"

        JIRA_TYPE=$(gum choose --header "Ticket type:" \
            "Story" \
            "Bug" \
            "Task" \
            "Spike")

        BRANCH_NAME=$(generate_branch_from_jira "$ticket_id" "$JIRA_SUMMARY" "$JIRA_TYPE")
        JIRA_CONTEXT="## Jira Ticket: $ticket_id\n\n- **Type**: $JIRA_TYPE\n- **Summary**: $JIRA_SUMMARY"
    fi

    # Show and confirm branch name
    echo ""
    gum style --foreground 75 "Branch name: $BRANCH_NAME"
    echo ""

    local branch_choice=$(printf '%s\n' \
        "✓ Use this branch name" \
        "✏️  Edit branch name" \
        "← Cancel" | fzf \
        --height=~25% \
        --layout=reverse \
        --border=rounded \
        --no-info \
        --prompt="" \
        --header="Confirm branch name" \
        --header-first)

    case "$branch_choice" in
        *"Edit"*)
            printf "Branch name: "
            read -r BRANCH_NAME
            [ -z "$BRANCH_NAME" ] && return 1
            ;;
        *"Cancel"*|"")
            return 1
            ;;
    esac

    # Extract owner/repo for session naming
    local OWNER REPO
    if [[ "$REPO_URL" =~ ([^/]+)/([^/]+)(\.git)?$ ]]; then
        OWNER="${BASH_REMATCH[1]}"
        REPO="${BASH_REMATCH[2]}"
        REPO="${REPO%.git}"
    else
        OWNER="unknown"
        REPO="repo"
    fi

    local SESSION_NAME="dev-${REPO}-${ticket_id}-$(date +%Y%m%d-%H%M%S)"
    local SESSION_DIR="$SESSIONS_DIR/$SESSION_NAME"

    mkdir -p "$SESSION_DIR"
    cd "$SESSION_DIR"

    # Clone repository
    if ! gum spin --spinner dot --title "Cloning repository..." -- \
        git clone --depth=100 "$REPO_URL" repo 2>&1; then
        error "Failed to clone repository"
        rm -rf "$SESSION_DIR"
        sleep 2
        return 1
    fi

    if [ ! -d "repo" ]; then
        error "Clone failed - repo directory not created"
        rm -rf "$SESSION_DIR"
        sleep 2
        return 1
    fi

    cd repo

    # Create and checkout new branch
    if ! gum spin --spinner dot --title "Creating branch $BRANCH_NAME..." -- \
        bash -c "git checkout -b '$BRANCH_NAME' 2>&1"; then
        error "Failed to create branch"
        rm -rf "$SESSION_DIR"
        sleep 2
        return 1
    fi

    local ACTUAL_BRANCH=$(git branch --show-current)

    cd "$SESSION_DIR"

    # Create session-info.txt (v1 format - for backward compatibility)
    cat > session-info.txt << EOF
================================================================================
SESSION INFO
================================================================================
Type:       Development
Created:    $(date '+%Y-%m-%d %H:%M:%S')
Creator:    $(whoami)
Session:    $SESSION_NAME

Repository: $OWNER/$REPO
URL:        $REPO_URL
Branch:     $ACTUAL_BRANCH

Jira:       $ticket_id
Jira Type:  $JIRA_TYPE
Summary:    $JIRA_SUMMARY

================================================================================
EOF

    # Create session.json (v2 format)
    local extra_json=$(jq -n \
        --arg ticket "$ticket_id" \
        --arg jira_type "$JIRA_TYPE" \
        --arg summary "$JIRA_SUMMARY" \
        --arg branch "$ACTUAL_BRANCH" \
        '{
            jira: {
                ticket: $ticket,
                type: $jira_type,
                summary: $summary
            },
            branch: $branch
        }')
    create_session_json "$SESSION_DIR" "development" "$REPO_URL" "$extra_json"

    # Create DEVLOG.md for tracking progress
    cat > repo/DEVLOG.md << DEVLOG_EOF
# Development Log: $ticket_id

## Session Info
- **Ticket**: $ticket_id
- **Branch**: \`$ACTUAL_BRANCH\`
- **Started**: $(date '+%Y-%m-%d %H:%M:%S')

---

## Progress

### $(date '+%Y-%m-%d %H:%M') - Session Started

- [ ] Initial setup complete
- [ ] Codebase exploration
- [ ] Implementation planning

---

## Notes

_Add your notes and decisions here as you work._

---

## Commits

_Track your commits here:_

- Initial commit: _pending_
DEVLOG_EOF

    # Create CLAUDE.md with development instructions
    cat > CLAUDE.md << CLAUDE_DEV_EOF
# Development Session: $ticket_id

## Context

**Jira Ticket**: $ticket_id
**Type**: $JIRA_TYPE
**Summary**: $JIRA_SUMMARY

$JIRA_CONTEXT

---

## Your Task

You are helping develop a new feature. The branch \`$ACTUAL_BRANCH\` has been created.

## Guidelines

1. **Understand First**: Read the existing codebase to understand patterns and conventions
2. **Clean Code**: Write clean, maintainable code following existing patterns
3. **Tests**: Add tests for new functionality
4. **Track Progress**: Update DEVLOG.md with progress, decisions, and notes
5. **Commit Often**: Make frequent commits with clear messages

## Files

- **DEVLOG.md** - Track your progress, decisions, and notes here
- **CLAUDE.md** - This file (development context)

## Development Workflow

1. **Explore** - Understand the codebase structure
2. **Plan** - Outline the implementation approach
3. **Implement** - Write the code
4. **Test** - Verify the implementation works
5. **Review** - Check for quality and completeness

---

**BEGIN DEVELOPMENT NOW.**

Start by exploring the codebase to understand:
1. Project structure and architecture
2. Relevant files for this feature
3. Existing patterns to follow

Then update DEVLOG.md with your findings and implementation plan.
CLAUDE_DEV_EOF

    # Setup output files with symlinks
    setup_output_files "$SESSION_DIR"
    touch "$SESSION_DIR/DEVLOG.md"
    ln -sf "../DEVLOG.md" "$SESSION_DIR/repo/DEVLOG.md" 2>/dev/null || true

    success "Development session created"
    info "Branch: $ACTUAL_BRANCH"
    CURRENT_SESSION="$SESSION_DIR"
    return 0
}

# ============================================================================
# MODE SWITCHING (Review <-> Investigation)
# ============================================================================

get_current_mode() {
    local SESSION_DIR="$1"
    local session_json="$SESSION_DIR/session.json"
    local claude_file="$SESSION_DIR/repo/CLAUDE.md"
    local session_name=$(basename "$SESSION_DIR")

    # V2: Check session.json first
    if [ -f "$session_json" ]; then
        local mode=$(jq -r '.mode // empty' "$session_json" 2>/dev/null)
        if [ -n "$mode" ]; then
            echo "$mode"
            return
        fi
    fi

    # V1: Check session name prefix
    if [[ "$session_name" == dev-* ]]; then
        echo "development"
        return
    fi

    # V1: Check CLAUDE.md content
    if [ -f "$claude_file" ]; then
        if grep -q "REVIEW.md" "$claude_file" 2>/dev/null; then
            echo "review"
        elif grep -q "FINDINGS.md" "$claude_file" 2>/dev/null; then
            echo "investigation"
        elif grep -q "DEVLOG.md" "$claude_file" 2>/dev/null; then
            echo "development"
        else
            echo "unknown"
        fi
    else
        echo "unknown"
    fi
}

# Extract Jira context section from CLAUDE.md to preserve across mode switches
extract_jira_context() {
    local claude_file="$1"
    if [ -f "$claude_file" ]; then
        # Extract everything from "## Jira" to end of file (Jira context is always appended last)
        awk '/^## Jira/{found=1} found{print}' "$claude_file"
    fi
}

switch_to_review_mode() {
    local SESSION_DIR="$1"
    local claude_file="$SESSION_DIR/repo/CLAUDE.md"

    # Preserve existing Jira context before overwriting
    local jira_context=$(extract_jira_context "$claude_file")

    cat > "$claude_file" << 'REVIEW_MODE'
# Code Review Mode

> **Focus: Write a comprehensive, insightful code review to REVIEW.md**

## Your Mission

You are a senior engineer performing a thorough code review. Your job is NOT just to find bugs—it's to deeply understand what's being done, why it's being done, and whether it's being done well.

## Review Process

### Phase 1: Understand the Context
1. **What is the request?** - Read the PR description, Jira ticket, or session-info.txt
2. **What problem is being solved?** - Understand the "why" behind these changes
3. **What is the scope?** - How much of the codebase is affected?

### Phase 2: Analyze the Changes
For each significant change, understand and document:
- **What** is being changed
- **Why** this approach was chosen
- **How** it integrates with existing code

### Phase 3: Critical Analysis
Review through these lenses:

| Angle | Key Questions |
|-------|---------------|
| **Correctness** | Does it actually solve the problem? Are there edge cases? |
| **Security** | Any injection risks, auth issues, data exposure, OWASP concerns? |
| **Complexity** | Is this overly complex? Could it be simpler? |
| **Clarity** | Is the code readable? Would a new dev understand it? |
| **Proper Fix vs Hack** | Is this a real solution or a band-aid? Technical debt? |
| **DRY** | Is there duplication? Should something be abstracted? |
| **Performance** | Any obvious N+1 queries, memory leaks, inefficiencies? |
| **Testing** | Is it testable? Are tests included? |

## Review Output Format

Write to `REVIEW.md` with this structure:

```markdown
# Code Review: [PR Title or Brief Description]

## Overview
**Scope:** [What this PR/change does - 2-3 sentences]
**Why:** [The problem being solved or feature being added]
**Risk Level:** [Low/Medium/High] - [Brief justification]

## Change Summary
[Walk through the key changes, explaining what each file/component does]

| File | Change Type | Purpose |
|------|-------------|---------|
| `path/file.ts` | Modified | [What and why] |

## Findings

### Critical Issues 🔴
[Issues that MUST be fixed before merge]

#### Finding #1: [Brief title]
📍 **Location:** `path/to/file.ts:XX-YY`
📊 **Status:** ⚠️ Open

**What's happening:** [Explain the code]
**Problem:** [What's wrong]
**Impact:** [Why this matters - security, bugs, perf, etc.]
**Suggested Fix:** [How to fix it]
```suggestion
// Code suggestion if applicable
```

### Important Issues 🟠
[Should be fixed, but not blockers]

### Suggestions 🟡
[Nice-to-haves, improvements]

### Positive Notes ✅
[What was done well - acknowledge good patterns]

## Security Review
- [ ] No hardcoded secrets or credentials
- [ ] Input validation present where needed
- [ ] No SQL/XSS/injection vulnerabilities
- [ ] Auth/authz properly enforced
- [Additional observations]

## Code Quality Assessment
- **Complexity:** [Simple/Moderate/Complex] - [Notes]
- **Readability:** [Good/Fair/Poor] - [Notes]
- **DRY Compliance:** [Notes on duplication]
- **Proper Solution:** [Is this the right fix or a hack?]

## Verdict

**Recommendation:** [✅ APPROVE | ⚠️ REQUEST CHANGES | 💬 NEEDS DISCUSSION]

**Rationale:** [Why this verdict - summarize key factors]

## Review History
| Version | Date | Commit | Action |
|---------|------|--------|--------|
| v1 | [date] | [sha] | Initial review |
```

## Important Guidelines

0. **Check for project skill FIRST** - Check if `/APFM:apfm-review` is available. If yes, run it and follow its output — skip everything below. If not available, proceed.
1. **⛔ SCOPE GATE** - Review ONLY files in this PR's diff. Before writing ANY finding, verify the file is in the changed files list. If not → delete the finding. No exceptions. Self-check before submitting.
2. **Be thorough** - Don't just skim. Understand every change.
3. **Be specific** - Always include `file:line` references
4. **Explain the "why"** - Don't just say "this is wrong", explain the impact
5. **Suggest solutions** - Every problem should have a suggested fix
6. **Acknowledge good work** - Note positive patterns, not just issues
7. **Think like an attacker** - What could go wrong? What could be exploited?
8. **Think like a maintainer** - Will this be easy to maintain in 6 months?

## Available Context

- **session-info.txt** - PR metadata, Jira ticket details
- **PR_DISCUSSION.md** - Existing PR comments, reviews, and discussions (READ THIS FIRST!)
- **ACR_REVIEW.md** - Automated review results (if present - USE AS INPUT, but do your own analysis)
- **FINDINGS.md** - Investigation results (if investigated first)

> ⚠️ **IMPORTANT**: Read PR_DISCUSSION.md first to understand what feedback has already been given.
> Don't duplicate existing comments. Note if issues were already discussed or marked as "by design".
> If ACR_REVIEW.md exists, use it as context but perform your OWN comprehensive review.

**BEGIN YOUR COMPREHENSIVE REVIEW NOW.**
REVIEW_MODE

    # Re-append Jira context if it existed
    if [ -n "$jira_context" ]; then
        echo "" >> "$claude_file"
        echo "$jira_context" >> "$claude_file"
    fi

    # Update session.json mode if v2 session
    if [ -f "$SESSION_DIR/session.json" ]; then
        update_session_field "$SESSION_DIR" "mode" "review"
        add_session_history "$SESSION_DIR" "mode_switch" '{"to": "review"}'
    fi

    success "Switched to Review Mode"
    dim "Claude will now focus on writing REVIEW.md"
    sleep 1
}

