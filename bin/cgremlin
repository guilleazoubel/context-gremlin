(List of commits made during this session)
DEVLOG
            ;;

        investigation)
            cat > "$claude_md" << 'INV_TEMPLATE'
# Investigation Session

## Project Skill (CHECK FIRST)
Check if `/APFM:apfm-review` skill is available. If yes, run it first for project context before investigating. Then proceed below.

## Focus Area
{CONTEXT}

## Your Task
You are investigating a specific area of the codebase. Your goal is to:
- Understand how the relevant code works
- Identify potential issues or improvements
- Document your findings clearly

## Guidelines
- Be thorough but focused
- Trace code paths to understand flow
- Look for edge cases and error handling
- Consider security and performance

## Output
Write your findings to `FINDINGS.md` in this directory. Structure it as:
1. Summary of investigation
2. Code flow analysis
3. Issues found
4. Recommendations
INV_TEMPLATE
            sed -i '' "s|{CONTEXT}|$context|g" "$claude_md" 2>/dev/null || \
            sed -i "s|{CONTEXT}|$context|g" "$claude_md"
            ;;
    esac
}

# ============================================================================
# DEPENDENCY CHECK
# ============================================================================

check_dependencies() {
    local missing=()

    command -v gum >/dev/null 2>&1 || missing+=("gum")
    command -v fzf >/dev/null 2>&1 || missing+=("fzf")
    command -v gh >/dev/null 2>&1 || missing+=("gh")
    command -v jq >/dev/null 2>&1 || missing+=("jq")
    command -v git >/dev/null 2>&1 || missing+=("git")
    command -v claude >/dev/null 2>&1 || missing+=("claude")

    if [ ${#missing[@]} -gt 0 ]; then
        echo "Missing dependencies: ${missing[*]}"
        echo ""
        echo "Install with:"
        for dep in "${missing[@]}"; do
            case "$dep" in
                gum) echo "  brew install gum" ;;
                fzf) echo "  brew install fzf" ;;
                gh) echo "  brew install gh" ;;
                jq) echo "  brew install jq" ;;
                git) echo "  brew install git" ;;
                claude) echo "  npm install -g @anthropic-ai/claude-code" ;;
            esac
        done
        exit 1
    fi

    # Check for optional dependencies
    HAS_ACR=false
    if command -v acr >/dev/null 2>&1; then
        HAS_ACR=true
    fi
}

check_dependencies

