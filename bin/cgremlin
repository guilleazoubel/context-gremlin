sessions_menu() {
    while true; do
        header
        gum style --foreground 212 --bold "Sessions"
        echo ""

        local choice=$(printf '%s\n' \
            "📋 List all sessions" \
            "🔎 Search sessions" \
            "🧹 Cleanup old sessions" \
            "← Back" | fzf \
            --height=~35% \
            --layout=reverse \
            --border=rounded \
            --no-info \
            --prompt="" \
            --header="Manage existing sessions" \
            --header-first)

        case "$choice" in
            *"List"*)
                list_sessions_menu
                ;;
            *"Search"*)
                search_sessions
                ;;
            *"Cleanup"*)
                cleanup_sessions
                ;;
            *"Back"*|"")
                return 0
                ;;
        esac
    done
}

# ============================================================================
# MAIN MENU
# ============================================================================

main_menu() {
    while true; do
        header

        # Show dashboard status indicator
        local dashboard_status=""
        if is_dashboard_running; then
            dashboard_status="  $(gum style --foreground 82 '● Dashboard running')"
        fi
        [ -n "$dashboard_status" ] && echo "$dashboard_status" && echo ""

        local choice=$(printf '%s\n' \
            "📝 Review      - Review a PR with AI assistance" \
            "🔍 Investigate - Explore codebase for bugs/issues" \
            "🛠️  Develop     - Start new feature from Jira ticket" \
            "─────────────────────────────────────────────────" \
            "⚙️  Settings    - Configure model, dashboard, etc." \
            "📋 Sessions    - View/manage existing sessions" \
            "🌐 Dashboard   - Open live dashboard" \
            "🎛️  Mission Control - Zellij orchestrator cockpit" \
            "👋 Quit" | fzf \
            --height=~50% \
            --layout=reverse \
            --border=rounded \
            --no-info \
            --prompt="" \
            --header="Choose mode:" \
            --header-first)

        case "$choice" in
            *"Review"*)
                if create_pr_session; then
                    run_claude_session "$CURRENT_SESSION"
                fi
                ;;
            *"Investigate"*)
                if create_investigation_session; then
                    run_claude_session "$CURRENT_SESSION"
                fi
                ;;
            *"Develop"*)
                if create_development_session; then
                    run_claude_session "$CURRENT_SESSION"
                fi
                ;;
            *"Settings"*)
                settings_menu
                ;;
            *"Sessions"*)
                sessions_menu
                ;;
            *"Dashboard"*)
                launch_live_dashboard
                ;;
            *"Mission Control"*)
                launch_mission_control
                ;;
            *"Quit"*)
                stop_dashboard_server 2>/dev/null
                clear
                exit 0
                ;;
            *"────"*|"")
                # Separator or ESC pressed - do nothing
                ;;
        esac
    done
}

watch_daemon_loop() {
    local _src="${BASH_SOURCE[0]:-$0}" _d
    while [ -L "$_src" ]; do _d="$(cd -P "$(dirname "$_src")" && pwd)"; _src="$(readlink "$_src")"; [[ "$_src" != /* ]] && _src="$_d/$_src"; done
    local _cg; _cg="$(cd -P "$(dirname "$_src")" && pwd)/$(basename "$_src")"
    local LOG="$SESSIONS_DIR/.watch-daemon.log"
    # Give Zellij time to finish creating the mission-control session before
    # the first cockpit-alive check (the launcher starts this daemon and then
    # exec's Zellij, so the session doesn't exist yet on the first iteration).
    sleep 15
    while true; do
        # Self-terminate if the cockpit session is gone (no orphans).
        zellij list-sessions 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | grep -qE '^mission-control[[:space:]]' || { echo "cockpit gone, exiting $(date)" >> "$LOG"; exit 0; }

        # --- Poll for new PRs from watched authors ---
        # gh emits one tab-separated row per PR (number, url, author) — robust,
        # no JSON-per-line parsing. Drafts are skipped (reviewed once marked ready).
        local watch_repos watch_authors
        watch_repos="${WATCH_REPOS:-}"
        watch_authors="${WATCH_AUTHORS:-}"
        if [ -n "$watch_repos" ] && [ -n "$watch_authors" ]; then
            local wrepo
            for wrepo in $watch_repos; do
                local pr_rows pr_num pr_url pr_author pr_isdraft wauthor matched already_tracked ex me_l
                # Include drafts (the isDraft column decides below); skip approved.
                pr_rows=$(timeout 20 gh pr list --repo "$wrepo" --state open --limit 50 \
                    --json number,url,author,isDraft,reviewDecision \
                    --jq '.[] | select(.reviewDecision != "APPROVED") | [(.number|tostring), .url, .author.login, (.isDraft|tostring)] | @tsv' 2>/dev/null)
                [ -z "$pr_rows" ] && continue
                me_l=$(printf '%s' "${GITHUB_ME:-}" | tr '[:upper:]' '[:lower:]')
                while IFS=$'\t' read -r pr_num pr_url pr_author pr_isdraft; do
                    [ -z "$pr_num" ] || [ -z "$pr_url" ] || [ -z "$pr_author" ] && continue
                    # Author in the watch list? (case-insensitive)
                    matched=false
                    for wauthor in $watch_authors; do
                        [ "$(printf '%s' "$pr_author" | tr '[:upper:]' '[:lower:]')" = "$(printf '%s' "$wauthor" | tr '[:upper:]' '[:lower:]')" ] && { matched=true; break; }
                    done
                    [ "$matched" = false ] && continue
                    local is_me=false
                    [ -n "$me_l" ] && [ "$(printf '%s' "$pr_author" | tr '[:upper:]' '[:lower:]')" = "$me_l" ] && is_me=true
                    # Others' drafts aren't ready to review → skip. My drafts ARE tracked (for reference).
                    [ "$pr_isdraft" = "true" ] && [ "$is_me" = false ] && continue
                    # Skip if a session already exists for this PR number
                    already_tracked=false
                    for ex in "$SESSIONS_DIR"/pr-*-"${pr_num}"-*; do
                        [ -d "$ex" ] && { already_tracked=true; break; }
                    done
                    [ "$already_tracked" = true ] && continue
                    if [ "$is_me" = true ]; then
                        echo "track my PR #${pr_num} @${pr_author} (draft=$pr_isdraft) in ${wrepo} $(date)" >> "$LOG"
                        "$_cg" --track-my-pr "$pr_url" >> "$LOG" 2>&1 &
                    else
                        echo "auto-pickup PR #${pr_num} @${pr_author} in ${wrepo} $(date)" >> "$LOG"
                        "$_cg" --review-pr "$pr_url" >> "$LOG" 2>&1 &
                    fi
                done <<< "$pr_rows"
            done
        fi

        # --- Manage existing PR sessions ---
        for d in "$SESSIONS_DIR"/pr-*; do
            [ -d "$d/repo" ] || continue
            local num repo state review_decision meta lc head
            num=$(read_session_field "$d" "pr.number"); repo=$(_pr_repo "$d")
            [ -z "$num" ] || [ -z "$repo" ] && continue
            # Fetch state + review decision + draft flag together (one API call).
            local meta_rest pr_isdraft
            meta=$(timeout 15 gh pr view "$num" --repo "$repo" --json state,reviewDecision,isDraft -q '.state + "\t" + (.reviewDecision // "") + "\t" + (.isDraft|tostring)' 2>/dev/null)
            state="${meta%%$'\t'*}"; meta_rest="${meta#*$'\t'}"
            review_decision="${meta_rest%%$'\t'*}"; pr_isdraft="${meta_rest##*$'\t'}"
            # Merged/closed → done; delete the session.
            if [ "$state" = "MERGED" ] || [ "$state" = "CLOSED" ]; then
                case "$d" in "$SESSIONS_DIR"/pr-*)
                    echo "delete merged/closed $d $(date)" >> "$LOG"
                    local _apid; _apid=$(cat "$d/agent_pid" 2>/dev/null)
                    [ -n "$_apid" ] && kill "$_apid" 2>/dev/null || true
                    rm -rf "$d"
                    ;;
                esac
                continue
            fi
            # Approved on GitHub (by anyone) → move to the Approved group; the
            # review job is done, so retire its agent pane but KEEP the session
            # visible with a ✅ until it merges.
            if [ "$review_decision" = "APPROVED" ] && [ "$(read_lifecycle "$d")" != "approved" ]; then
                echo "mark approved $d $(date)" >> "$LOG"
                local _apid; _apid=$(cat "$d/agent_pid" 2>/dev/null)
                [ -n "$_apid" ] && kill "$_apid" 2>/dev/null && rm -f "$d/agent_pid"
                update_lifecycle "$d" "approved"
                continue
            fi
            # My own PRs: no rereview. Detect NEW reviewer comments → triage.
            if pr_is_mine "$d"; then
                # Keep the draft flag fresh so the status pane label flips when
                # the PR moves between draft and ready-for-review.
                [ -n "$pr_isdraft" ] && update_session_field "$d" "is_draft" "$pr_isdraft"
                [ "$(read_lifecycle "$d")" = "approved" ] && continue
                [ "$(read_mine_stage "$d")" = "triaging" ] && continue
                local m_owner="${repo%%/*}" m_name="${repo##*/}" seen new_ids
                # Normalize to compact JSON — read_session_field pretty-prints
                # arrays (multi-line), which breaks --argjson below. Fall back to
                # [] on empty/invalid so the set-difference never crashes.
                seen=$(read_session_field "$d" "triaged_threads" 2>/dev/null | jq -c . 2>/dev/null); [ -z "$seen" ] && seen="[]"
                new_ids=$(timeout 30 gh api graphql -f query='query($o:String!,$r:String!,$n:Int!){repository(owner:$o,name:$r){pullRequest(number:$n){reviewThreads(first:100){nodes{id isResolved comments(first:1){nodes{author{login}}}}}}}}' \
                    -F o="$m_owner" -F r="$m_name" -F n="$num" 2>/dev/null \
                    | jq -c --arg me "$GITHUB_ME" --argjson seen "$seen" '[.data.repository.pullRequest.reviewThreads.nodes[] | select(.isResolved==false) | select(((.comments.nodes[0].author.login // "")|ascii_downcase) != ($me|ascii_downcase)) | .id] - $seen' 2>/dev/null)
                if [ -n "$new_ids" ] && [ "$new_ids" != "[]" ]; then
                    echo "new reviewer comments on my PR $num → triage $(date)" >> "$LOG"
                    "$_cg" --triage-comments "$(basename "$d")" >> "$LOG" 2>&1 &
                fi
                continue
            fi
            lc=$(read_lifecycle "$d")
            if [ "$lc" = "commented" ] || [ "$lc" = "changes-requested" ]; then
                if [ "$(read_rereview_pending "$d")" != "true" ]; then
                    head=$(timeout 15 gh pr view "$num" --repo "$repo" --json headRefOid -q .headRefOid 2>/dev/null)
                    if [ -n "$head" ] && [ "$head" != "$(read_reviewed_sha "$d")" ]; then
                        echo "new commits on $num → auto re-review $(date)" >> "$LOG"
                        set_rereview_pending "$d"
                        "$_cg" --rereview-pr "$(basename "$d")" >> "$LOG" 2>&1
                    fi
                fi
            fi
        done
        sleep 60
    done
}

launch_mission_control() {
    local _fresh="$1"   # non-empty → force a brand-new session (delete existing first)
    # Mission Control is always Zellij, regardless of USE_ZELLIJ flag.
    command -v zellij >/dev/null 2>&1 || { error "Zellij not installed. Install it at https://zellij.dev"; sleep 2; return 1; }

    # Resolve this script's real directory, following symlinks. cgremlin is not
    # necessarily on PATH, so the cockpit session adds this dir to PATH below —
    # that's what lets the layout panes and the orchestrator invoke `cgremlin`.
    local _src="${BASH_SOURCE[0]:-$0}" _d
    while [ -L "$_src" ]; do
        _d="$(cd -P "$(dirname "$_src")" && pwd)"; _src="$(readlink "$_src")"
        [[ "$_src" != /* ]] && _src="$_d/$_src"
    done
    local _cgdir; _cgdir="$(cd -P "$(dirname "$_src")" && pwd)"

    # Generate the layout inline (no dependency on a repo file path). Panes invoke
    # `cgremlin`, resolved via the PATH the launcher exports.
    mkdir -p ~/.config/zellij/layouts
    cat > ~/.config/zellij/layouts/mission-control.kdl <<'KDL'
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
    }
    tab name="MISSION CONTROL" focus=true {
        pane split_direction="vertical" {
            pane name="orchestrator" {
                command "cgremlin"
                args "--orchestrator"
            }
            pane name="status" size="45%" {
                command "cgremlin"
                args "--status-pane"
            }
        }
    }
}
KDL

    # Launcher: runs at exec time so session state is checked fresh.
    # Attaches to a RUNNING session; deletes dead/EXITED sessions and creates fresh
    # (attaching to a dead session resurrects old panes with stale layout).
    local _sessions_dir="$SESSIONS_DIR"
    local _launcher; _launcher=$(mktemp /tmp/cgremlin-mc-XXXXXX)
    cat > "$_launcher" <<LAUNCH
#!/bin/bash
export PATH="$_cgdir:\$PATH"
pgrep -f "cgremlin --watch-daemon" >/dev/null 2>&1 || ( "$_cgdir/cgremlin" --watch-daemon >/dev/null 2>&1 & )
_s=\$(zellij list-sessions 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g')
if [ -z "$_fresh" ] && printf '%s' "\$_s" | grep -qE '^mission-control[[:space:]]' && \
   ! printf '%s' "\$_s" | grep -qiE '^mission-control.*(EXITED|dead)'; then
    exec zellij attach mission-control
else
    # --fresh, or a dead/EXITED session: delete and create clean (attaching a
    # dead session resurrects stale panes/layout from an older cgremlin).
    zellij delete-session -f mission-control 2>/dev/null || true
    rm -f "$_sessions_dir/.tab2_open"
    exec zellij --session mission-control --new-session-with-layout mission-control
fi
LAUNCH
    chmod +x "$_launcher"

    # Open a new iTerm2 tab running the launcher; fall back to running directly.
    if [ -d "/Applications/iTerm.app" ]; then
        osascript <<MC_SCRIPT
tell application "iTerm"
    activate
    if (count of windows) = 0 then
        create window with default profile
    end if
    tell current window
        create tab with default profile
        tell current session
            set name to "🎛️ Mission Control"
            write text "bash '$_launcher'"
        end tell
    end tell
end tell
MC_SCRIPT
    else
        exec "$_launcher"
    fi
}

launch_live_dashboard() {
    if is_dashboard_running; then
        local action=$(printf '%s\n' \
            "🌐 Open in browser" \
            "🔄 Restart server (reload code changes)" \
            "🛑 Stop server" \
            "← Back" | fzf \
            --height=~30% \
            --layout=reverse \
            --border=rounded \
            --no-info \
            --prompt="" \
            --header="Dashboard is running at http://127.0.0.1:$DASHBOARD_PORT" \
            --header-first)

        case "$action" in
            *"Open"*)
                open "http://127.0.0.1:$DASHBOARD_PORT" 2>/dev/null || \
                xdg-open "http://127.0.0.1:$DASHBOARD_PORT" 2>/dev/null || \
                gum style --foreground 87 "Open http://127.0.0.1:$DASHBOARD_PORT in your browser"
                sleep 1
                ;;
            *"Restart"*)
                dim "Stopping dashboard..."
                cleanup_dashboard_server
                sleep 0.5
                dim "Starting dashboard..."
                if start_dashboard_server; then
                    success "Dashboard restarted"
                    sleep 0.5
                    open "http://127.0.0.1:$DASHBOARD_PORT" 2>/dev/null
                else
                    error "Failed to restart dashboard"
                fi
                sleep 1
                ;;
            *"Stop"*)
                cleanup_dashboard_server
                success "Dashboard stopped"
                sleep 1
                ;;
        esac
    else
        gum spin --spinner dot --title "Starting dashboard..." -- sleep 0.5
        if start_dashboard_server; then
            success "Dashboard running at http://127.0.0.1:$DASHBOARD_PORT"
            open "http://127.0.0.1:$DASHBOARD_PORT" 2>/dev/null || \
            xdg-open "http://127.0.0.1:$DASHBOARD_PORT" 2>/dev/null || \
            gum style --foreground 87 "Open http://127.0.0.1:$DASHBOARD_PORT in your browser"

            gum style \
                --border rounded \
                --border-foreground 214 \
                --padding "1 2" \
                "Dashboard is running in the background." \
                "Select 'Live Dashboard' again to manage or stop it."
            sleep 2
        else
            error "Failed to start dashboard. Check $SESSIONS_DIR/.dashboard.log for details."
            sleep 2
        fi
    fi
}

# ============================================================================
# ENTRY
# ============================================================================

# Handle --dismiss-pr argument (marks a session's triage_state as done)
if [ "$1" = "--dismiss-pr" ]; then
    [ -z "$2" ] && { echo "Usage: cgremlin --dismiss-pr <session-name>" >&2; exit 1; }
    update_triage_state "$SESSIONS_DIR/$2" "done"
    echo "dismissed $2"
    exit 0
fi

# Handle --approve-pr / --comment-pr / --request-changes-pr (discussion-agent posting helpers)
if [ "$1" = "--approve-pr" ];          then [ -z "$2" ] && { echo "Usage: cgremlin --approve-pr <session> [--force]" >&2; exit 1; }; approve_pr "$2" "$3"; exit $?; fi
if [ "$1" = "--comment-pr" ];          then [ -z "$2" ] && { echo "Usage: cgremlin --comment-pr <session>" >&2; exit 1; }; comment_pr "$2"; exit $?; fi
if [ "$1" = "--request-changes-pr" ];  then [ -z "$2" ] && { echo "Usage: cgremlin --request-changes-pr <session>" >&2; exit 1; }; request_changes_pr "$2"; exit $?; fi
if [ "$1" = "--reply-comment" ]; then [ -z "$3" ] && { echo "Usage: cgremlin --reply-comment <session> <thread-id>" >&2; exit 1; }; reply_comment "$2" "$3"; exit $?; fi
if [ "$1" = "--pr-ready" ];        then [ -z "$2" ] && { echo "Usage: cgremlin --pr-ready <session>" >&2; exit 1; }; pr_ready "$2"; exit $?; fi
if [ "$1" = "--resolve-comment" ]; then [ -z "$3" ] && { echo "Usage: cgremlin --resolve-comment <session> <thread-id>" >&2; exit 1; }; resolve_comment "$2" "$3"; exit $?; fi
if [ "$1" = "--pr-threads" ];      then [ -z "$2" ] && { echo "Usage: cgremlin --pr-threads <session>" >&2; exit 1; }; pr_threads "$2"; exit $?; fi
if [ "$1" = "--stop-local" ]; then stop_local "$2"; exit $?; fi
if [ "$1" = "--run-local" ]; then [ -z "$2" ] && { echo "Usage: cgremlin --run-local <session> [--fresh]" >&2; exit 1; }; run_local "$2" "$3"; exit $?; fi
if [ "$1" = "--commit-fix" ];   then [ -z "$2" ] && { echo "Usage: cgremlin --commit-fix <session> [msg]" >&2; exit 1; }; s="$2"; shift 2; commit_fix "$s" "$@"; exit $?; fi
if [ "$1" = "--push-fix" ];     then [ -z "$2" ] && { echo "Usage: cgremlin --push-fix <session>" >&2; exit 1; }; push_fix "$2"; exit $?; fi
if [ "$1" = "--triage-done" ]; then [ -z "$2" ] && { echo "Usage: cgremlin --triage-done <session>" >&2; exit 1; }; triage_done "$2"; exit $?; fi

# Handle --review-list-grouped argument (emit grouped open reviews for picker)
if [ "$1" = "--review-list-grouped" ]; then
    review_list_grouped
    exit 0
fi

# Skip dashboard lifecycle when called as a subprocess (e.g. --create-session, --review-pr, --lib-only)
if [ "$1" != "--create-session" ] && [ "$1" != "--review-pr" ] && [ "$1" != "--rereview-pr" ] && [ "$1" != "--track-my-pr" ] && [ "$1" != "--lib-only" ] && [ "$1" != "--status-pane" ] && [ "$1" != "--open-pr" ] && [ "$1" != "--orchestrator" ] && [ "$1" != "--dismiss-pr" ] && [ "$1" != "--mission-control" ] && [ "$1" != "--review-list-grouped" ] && [ "$1" != "--approve-pr" ] && [ "$1" != "--comment-pr" ] && [ "$1" != "--request-changes-pr" ] && [ "$1" != "--watch-daemon" ] && [ "$1" != "--triage-comments" ] && [ "$1" != "--investigate" ] && [ "$1" != "--pr-ready" ] && [ "$1" != "--resolve-comment" ] && [ "$1" != "--develop" ] && [ "$1" != "--pr-threads" ] && [ "$1" != "--stop-local" ] && [ "$1" != "--run-local" ]; then
    cleanup_on_exit() {
        stop_dashboard_server 2>/dev/null
    }
    trap cleanup_on_exit EXIT INT TERM

    if ! is_dashboard_running; then
        start_dashboard_server >/dev/null 2>&1 &
    fi
fi

# ============================================================================
# NON-INTERACTIVE SESSION CREATION (for web UI)
# ============================================================================

create_pr_session_noninteractive() {
    local PR_URL="$1"
    local JIRA_TICKET="$2"

    # Parse PR URL
    if [[ "$PR_URL" =~ github\.com/([^/]+)/([^/]+)/pull/([0-9]+) ]]; then
        local OWNER="${BASH_REMATCH[1]}"
        local REPO="${BASH_REMATCH[2]}"
        local PR_NUMBER="${BASH_REMATCH[3]}"
    else
        echo "ERROR: Invalid PR URL" >&2
        exit 1
    fi

    local REPO_URL="https://github.com/$OWNER/$REPO.git"
    local SESSION_NAME="pr-${REPO}-${PR_NUMBER}-$(date +%Y%m%d-%H%M%S)"
    local SESSION_DIR="$SESSIONS_DIR/$SESSION_NAME"

    mkdir -p "$SESSION_DIR"
    cd "$SESSION_DIR"

    # Get PR metadata FIRST (fast, no clone) so the session row can appear
    # immediately with the PR number/author and a "queued" state — before the
    # slow clone. This is what gives instant visibility in the status pane.
    local PR_JSON=$(gh pr view "$PR_NUMBER" --repo "$OWNER/$REPO" --json title,headRefName,baseRefName,author,additions,deletions,changedFiles,url 2>/dev/null)

    local PR_TITLE=$(echo "$PR_JSON" | jq -r '.title // "PR #'"$PR_NUMBER"'"')
    local PR_HEAD=$(echo "$PR_JSON" | jq -r '.headRefName // "unknown"')
    local PR_BASE=$(echo "$PR_JSON" | jq -r '.baseRefName // "main"')
    local PR_AUTHOR=$(echo "$PR_JSON" | jq -r '.author.login // "unknown"')

    # Auto-detect Jira from branch name if not provided
    if [ -z "$JIRA_TICKET" ] && [ -n "$PR_HEAD" ]; then
        # Extract Jira ticket pattern from branch (e.g., HB-404-fix-login -> HB-404)
        local detected=$(echo "$PR_HEAD" | grep -oE '^[A-Za-z]+-[0-9]+' | head -1 | tr '[:lower:]' '[:upper:]')
        if [ -z "$detected" ]; then
            detected=$(echo "$PR_HEAD" | grep -oE '[A-Za-z]+-[0-9]+' | head -1 | tr '[:lower:]' '[:upper:]')
        fi
        [ -n "$detected" ] && JIRA_TICKET="$detected"
    fi

    # Create session.json
    # Build with jq so titles containing quotes/backslashes/newlines are escaped
    # (a hand-rolled heredoc broke create_session_json's --argjson on such titles).
    local extra_json
    extra_json=$(jq -n \
        --arg number "$PR_NUMBER" \
        --arg title "$PR_TITLE" \
        --arg url "https://github.com/$OWNER/$REPO/pull/$PR_NUMBER" \
        --arg head "$PR_HEAD" \
        --arg base "$PR_BASE" \
        --arg author "$PR_AUTHOR" \
        '{pr: {number:$number, title:$title, url:$url, head:$head, base:$base, author:$author}}')
    [ -n "$JIRA_TICKET" ] && extra_json=$(printf '%s' "$extra_json" | jq --arg t "$JIRA_TICKET" '. + {jira: {ticket:$t}}')

    create_session_json "$SESSION_DIR" "review" "https://github.com/$OWNER/$REPO" "$extra_json"

    # Fallback: if session.json is empty/invalid, create minimal one
    if ! jq -e type "$SESSION_DIR/session.json" >/dev/null 2>&1; then
        cat > "$SESSION_DIR/session.json" <<FALLBACK
{
  "id": "$SESSION_NAME",
  "mode": "review",
  "project": "https://github.com/$OWNER/$REPO",
  "created": "$(date -Iseconds)",
  "status": "active",
  "pr": {"number": "$PR_NUMBER", "title": "$PR_TITLE", "url": "https://github.com/$OWNER/$REPO/pull/$PR_NUMBER", "head": "$PR_HEAD", "base": "$PR_BASE", "author": "$PR_AUTHOR"},
  "history": []
}
FALLBACK
    fi

    # Always create session-info.txt as dashboard fallback
    cat > "$SESSION_DIR/session-info.txt" <<INFO_EOF
================================================================================
SESSION INFO
================================================================================
Type:       PR Review
Created:    $(date '+%Y-%m-%d %H:%M:%S')
Session:    $SESSION_NAME

PR #$PR_NUMBER: $PR_TITLE
URL:        https://github.com/$OWNER/$REPO/pull/$PR_NUMBER
Author:     $PR_AUTHOR
Branch:     $PR_HEAD → $PR_BASE

Repository: $OWNER/$REPO
$([ -n "$JIRA_TICKET" ] && echo "Jira:       $JIRA_TICKET")
================================================================================
INFO_EOF

    # Mark queued and create an empty repo/ NOW so the status pane shows the row
    # immediately ("PR #N @author … queued") while the clone runs below.
    mkdir -p "$SESSION_DIR/repo"
    update_review_state "$SESSION_DIR" "queued"

    # Clone and checkout the PR (the slow part — the row is already visible).
    cd "$SESSION_DIR"
    git clone --depth=1 --single-branch "$REPO_URL" repo 2>/dev/null
    cd repo
    git fetch --depth=1 origin "pull/$PR_NUMBER/head:pr-$PR_NUMBER" 2>/dev/null
    git checkout "pr-$PR_NUMBER" 2>/dev/null

    # Create CLAUDE.md for review mode
    generate_claude_md "$SESSION_DIR" "review" "PR #$PR_NUMBER: $PR_TITLE by @$PR_AUTHOR"

    # Fetch PR discussion and comments for context
    fetch_pr_comments "$SESSION_DIR" "$OWNER" "$REPO" "$PR_NUMBER"

    # Output session name for the API
    echo "$SESSION_NAME"
}

create_investigation_session_noninteractive() {
    local REPO_URL="$1"
    local FOCUS="$2"
    local JIRA_TICKET="$3"

    # Parse repo URL
    local REPO_NAME=$(basename "$REPO_URL" .git)
    local SESSION_NAME="inv-${REPO_NAME}-$(date +%Y%m%d-%H%M%S)"
    local SESSION_DIR="$SESSIONS_DIR/$SESSION_NAME"

    mkdir -p "$SESSION_DIR"
    cd "$SESSION_DIR"

    # Clone repo
    git clone --depth=1 --single-branch "$REPO_URL" repo 2>/dev/null

    # Create session.json
    local extra_json=$(cat <<EOF
{
    "focus": "$FOCUS"
}
EOF
)
    [ -n "$JIRA_TICKET" ] && extra_json=$(echo "$extra_json" | jq ". + {jira: {ticket: \"$JIRA_TICKET\"}}")

    create_session_json "$SESSION_DIR" "investigation" "$REPO_URL" "$extra_json"

    # Create CLAUDE.md for investigation mode
    generate_claude_md "$SESSION_DIR" "investigation" "$FOCUS"

    echo "$SESSION_NAME"
}

# Write the investigate-mode autonomous brief as the agent's cwd CLAUDE.md.
# Usage: write_investigate_brief SESSION_DIR
write_investigate_brief() {
    local SDIR="$1" key
    key=$(read_session_field "$SDIR" "jira.ticket")
    cat > "$SDIR/CLAUDE.md" <<INV
# INVESTIGATION — ${key:-(no ticket)}

You are running in the session directory. The PR/repo code is in \`./repo/\`.
Work autonomously. Your deliverable is a complete, self-contained \`FINDINGS.md\`
in this directory — no code changes.

## Source of truth: the Jira ticket
${key:+The ticket is ${key}. Fetch it now via the Atlassian MCP (getJiraIssue) to read the summary, description, and acceptance criteria.} If the ticket is unavailable or absent, use whatever task description you were given. The ticket defines scope — investigate ONLY what it asks about.

## What to do (autonomously — do not ask me for routine steps)
1. Understand the request from the ticket.
2. Explore \`./repo/\`: trace the relevant code paths, reproduce/understand the issue, find the ROOT CAUSE.
   For live web evals, run \`cgremlin --run-local $(basename "$SDIR")\` and wait for the URL, then drive the browser (chrome-devtools MCP) against https://local.findcare.dev.aplaceformom.com/ . Watch logs/dev-server.log and tell me if it fails. When done, \`cgremlin --stop-local $(basename "$SDIR")\`.
3. Write \`FINDINGS.md\` as a COMPLETE HANDOFF a fresh developer could execute from alone:
   - **What's happening** (the observed problem/behavior)
   - **Root cause** (the specific code and why)
   - **Affected files/paths**
   - **Risks / splash zone** (what a fix could plausibly affect)
   - **Direction / plan** to fix the ticket (concrete steps, scoped to the ticket)
4. Do NOT change code. Investigation produces understanding + plan only.

## Scope discipline
Cover ONLY what the ticket asks. If you find necessary out-of-scope work, note it under a "Tech debt (proposed)" section in FINDINGS.md and TELL ME — do not act on it. I decide whether to open a tech-debt Jira.

## When to pause
Proceed on your own for all routine investigation. Pause and ask ME only when there's a genuine approach/design decision with real trade-offs to discuss.

## Handing off to development
When FINDINGS.md is ready, present a short summary and offer to build it. If I say to build it (e.g. "build it" / "let's develop this"), run:
  cgremlin --develop $(basename "$SDIR")
That opens a fresh develop session seeded with FINDINGS.md + the ticket, and closes this pane.

BEGIN NOW: fetch the ticket, investigate, and write FINDINGS.md.
INV
    mkdir -p "$SDIR/.claude"
    printf '{"permissions":{"allow":["Bash(cgremlin --develop *)","Bash(cgremlin --run-local *)","Bash(cgremlin --stop-local *)"]}}\n' > "$SDIR/.claude/settings.local.json"
}

# Create an investigation session and launch its agent in the WORK tab.
# Usage: investigate_start <repo-git-url> <jira-key>
investigate_start() {
    local repo_url="$1" jira="$2"
    local session_name
    session_name=$(create_investigation_session_noninteractive "$repo_url" "" "$jira" | tail -1)
    [ -z "$session_name" ] && { echo "ERROR: investigation session creation failed" >&2; return 1; }
    local SDIR="$SESSIONS_DIR/$session_name"
    # Ensure the ticket is recorded even if the creator didn't set it.
    [ -n "$jira" ] && update_session_field "$SDIR" "jira.ticket" "$jira"
    write_investigate_brief "$SDIR"     # overwrite the generic investigation CLAUDE.md with the autonomous brief
    create_work_agent_pane "$SDIR"
    echo "$session_name"
}

create_development_session_noninteractive() {
    local REPO_URL="$1"
    local JIRA_TICKET="$2"

    # Parse repo URL
    local REPO_NAME=$(basename "$REPO_URL" .git)
    local BRANCH_NAME="feature/${JIRA_TICKET}"
    local SESSION_NAME="dev-${REPO_NAME}-${JIRA_TICKET}-$(date +%Y%m%d-%H%M%S)"
    local SESSION_DIR="$SESSIONS_DIR/$SESSION_NAME"

    mkdir -p "$SESSION_DIR"
    cd "$SESSION_DIR"

    # Clone repo and create branch
    git clone --depth=1 --single-branch "$REPO_URL" repo 2>/dev/null
    cd repo
    git checkout -b "$BRANCH_NAME" 2>/dev/null

    # Create session.json
    local extra_json=$(cat <<EOF
{
    "jira": {
        "ticket": "$JIRA_TICKET"
    },
    "branch": "$BRANCH_NAME"
}
EOF
)

    create_session_json "$SESSION_DIR" "development" "$REPO_URL" "$extra_json"

    # Create CLAUDE.md for development mode
    generate_claude_md "$SESSION_DIR" "development" "Jira: $JIRA_TICKET"

    echo "$SESSION_NAME"
}

# Write the develop-mode autonomous brief as the agent's cwd CLAUDE.md.
# Usage: write_develop_brief SESSION_DIR
write_develop_brief() {
    local SDIR="$1" key sn; key=$(read_session_field "$SDIR" "jira.ticket"); sn=$(basename "$SDIR")
    cat > "$SDIR/CLAUDE.md" <<DEV
# DEVELOP — ${key:-(no ticket)}

You are running in the session directory. The code is in \`./repo/\`. \`FINDINGS.md\`
here is your seeded investigation (root cause + direction). The Jira ticket
${key:+(${key}) — fetch via Atlassian MCP getJiraIssue} is the source of truth.
Cover ONLY what the ticket asks.

## Flow (autonomous except at the gates below)
1. **Read FINDINGS.md + the ticket.** Refine into a concrete implementation plan (root cause is already known).
2. **PLAN GATE — pause.** Present the plan to me, explain it, and adjust it with me. Do NOT implement until I explicitly say to proceed.
3. **Implement with TDD.** For each unit: write the failing test, run it (confirm it fails), write minimal code, run to green, commit. Stay strictly in ticket scope.
4. **Open a draft PR** on the pushed branch: \`gh pr create --draft\`, body summarizing the change and linking ${key:-the ticket}.
5. **Verify on preview.** Find the draft PR's Vercel preview URL (from \`gh pr view <n> --json statusCheckRollup\` — the grace-frontend-dev deployment). Run a FOCUSED live web test set against it with Playwright: prove the ticket's issue is fixed, plus a smoke pass of the feature and its likely splash-zone regressions. NOT the full e2e suite. Iterate to green.
   For live web evals, run \`cgremlin --run-local $sn\` and wait for the URL, then drive the browser (chrome-devtools MCP) against https://local.findcare.dev.aplaceformom.com/ . Watch logs/dev-server.log and tell me if it fails. When done, \`cgremlin --stop-local $sn\`.
6. **Assess bot comments.** Get the LIVE thread list with \`cgremlin --pr-threads $sn\`
   (READ-ONLY: threadId, resolved, author, path:line, last replier, snippet). Re-run it
   whenever I say I changed something. For each UNRESOLVED thread (skip ones already
   \`resolved\` or already replied by me/someone):
   - false positive → reply "false positive: <reason>" then resolve it:
       cgremlin --reply-comment $sn <thread-id>   (write the reply to ${SDIR}/.reply_body.md first)
       cgremlin --resolve-comment $sn <thread-id>
   - clearly valid → fix it (TDD for code changes).
   - unsure → STOP and show it to me to discuss.
7. **Notify me** it's tested and comment-clean so I can watch it run against preview and ask questions.
8. **READY GATE.** Only when I say I'm satisfied, mark the PR ready:
       cgremlin --pr-ready $sn

## Scope + tech debt
Out-of-scope-but-needed work → propose a tech-debt Jira (Atlassian createJiraIssue) and create it ONLY with my explicit OK. Never expand scope silently.

## Hard rules
- Never mark the PR ready (\`--pr-ready\`) or create a Jira without my explicit go-ahead.
- Never skip the PLAN GATE.
- Post to GitHub only via the cgremlin helpers above (never raw gh for review/comment mutations); \`gh pr create --draft\`, \`gh pr view\`, git push are fine.

BEGIN NOW: read FINDINGS.md + the ticket and prepare the plan for the PLAN GATE.
DEV
    mkdir -p "$SDIR/.claude"
    printf '{"permissions":{"allow":["Bash(cgremlin --reply-comment *)","Bash(cgremlin --resolve-comment *)","Bash(cgremlin --pr-ready *)","Bash(cgremlin --commit-fix *)","Bash(cgremlin --push-fix *)","Bash(cgremlin --pr-threads *)","Bash(cgremlin --run-local *)","Bash(cgremlin --stop-local *)"]}}\n' > "$SDIR/.claude/settings.local.json"
}

# Promote an investigation into a fresh develop session (seeded with FINDINGS.md),
# launch it in the WORK tab, and close the investigation pane.
# Usage: develop_start <investigation-session-name>
develop_start() {
    local inv="$1" INV_DIR="$SESSIONS_DIR/$inv"
    [ -d "$INV_DIR/repo" ] || { echo "ERROR: investigation session $inv not found" >&2; return 1; }
    local jira repo_url
    jira=$(read_session_field "$INV_DIR" "jira.ticket")
    repo_url=$(read_session_field "$INV_DIR" "project"); [ -z "$repo_url" ] && repo_url="https://github.com/$(_pr_repo "$INV_DIR")"
    local session_name
    session_name=$(create_development_session_noninteractive "$repo_url" "$jira" | tail -1)
    [ -z "$session_name" ] && { echo "ERROR: develop session creation failed" >&2; return 1; }
    local SDIR="$SESSIONS_DIR/$session_name"
    [ -n "$jira" ] && update_session_field "$SDIR" "jira.ticket" "$jira"
    # Seed the findings (self-contained handoff).
    [ -f "$INV_DIR/FINDINGS.md" ] && cp "$INV_DIR/FINDINGS.md" "$SDIR/FINDINGS.md"
    write_develop_brief "$SDIR"
    create_work_agent_pane "$SDIR"
    # The investigation agent's job is done — close its pane.
    local ipid; ipid=$(cat "$INV_DIR/agent_pid" 2>/dev/null)
    [ -n "$ipid" ] && kill "$ipid" 2>/dev/null; rm -f "$INV_DIR/agent_pid"
    echo "$session_name"
}

# ============================================================================
# HEADLESS REVIEW WORKER (for --review-pr)
# ============================================================================

# Write a settings.local.json that lets an autonomous (headless) reviewer run
# freely EXCEPT for commands that mutate GitHub or the remote. Deny rules take
# precedence over any permission mode, so even bypassPermissions can't post.
# Usage: write_review_guard REPO_DIR
write_review_guard() {
    local repo_dir="$1"
    mkdir -p "$repo_dir/.claude"
    local sf="$repo_dir/.claude/settings.local.json"
    local deny='["Bash(gh pr review:*)","Bash(gh pr comment:*)","Bash(gh pr merge:*)","Bash(gh pr close:*)","Bash(gh pr edit:*)","Bash(gh pr create:*)","Bash(gh api:*--method*)","Bash(git push:*)","Bash(git commit:*)"]'
    if [ -f "$sf" ] && jq -e . "$sf" >/dev/null 2>&1; then
        jq --argjson deny "$deny" '.permissions.deny = ((.permissions.deny // []) + $deny | unique)' "$sf" > "$sf.tmp" && mv "$sf.tmp" "$sf"
    else
        printf '{"permissions":{"deny":%s}}\n' "$deny" > "$sf"
    fi
}

launch_headless_review() {
    local SESSION_DIR="$1"
    local REPO_DIR="$SESSION_DIR/repo"
    local log_file="$SESSION_DIR/logs/terminal-$(date +%Y%m%d-%H%M%S).log"
    mkdir -p "$SESSION_DIR/logs"

    # Resolve the cgremlin script path so the wrapper can source it
    local _p
    _p="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    local _cgremlin_path="${CGREMLIN_SCRIPT_PATH:-$_p}"

    # Let the headless reviewer run read-only gh/git/analysis freely; posting
    # and pushing are hard-denied by the guard so it can work autonomously.
    write_review_guard "$REPO_DIR"

    local wrapper
    wrapper=$(mktemp /tmp/cgremlin-review-XXXXXX)
    cat > "$wrapper" <<WRAPPER_EOF
#!/bin/bash
source "$_cgremlin_path" --lib-only
update_review_state "$SESSION_DIR" reviewing
cd "$REPO_DIR" && script -q "$log_file" \
  claude -p "Run /APFM:apfm-review and write the findings to REVIEW.md following CLAUDE.md. Proceed autonomously; do NOT ask for confirmation or a verdict. Read the PR with git (the branch is checked out) or gh pr view/diff as needed. If Jira/Atlassian MCP is unavailable, skip Jira context and proceed with the diff alone. Do NOT post to GitHub. Write the output to $SESSION_DIR/REVIEW.md." \
  --permission-mode bypassPermissions --add-dir "$SESSION_DIR" < /dev/null
rc=\$?
if [ \$rc -eq 0 ] && [ -s "$SESSION_DIR/REVIEW.md" ]; then
    update_review_state "$SESSION_DIR" ready
else
    update_review_state "$SESSION_DIR" failed
fi
# Clear agent-state so the worker's own Stop hook doesn't leave a stale "waiting"
# flag; .cg_agent_state should only reflect an actually-open discussion agent.
rm -f "$SESSION_DIR/.cg_agent_state"
rm -f "$wrapper"
WRAPPER_EOF
    chmod +x "$wrapper"
    nohup bash "$wrapper" >> "$SESSION_DIR/logs/worker.log" 2>&1 &
    update_session_field "$SESSION_DIR" "review_worker_pid" "$!"
}

review_pr_noninteractive() {
    local pr_input="$1"
    local session_name
    session_name=$(create_pr_session_noninteractive "$pr_input" "" | tail -1)
    [ -z "$session_name" ] && { echo "ERROR: session creation failed" >&2; return 1; }
    local session_dir="$SESSIONS_DIR/$session_name"
    update_review_state "$session_dir" queued
    launch_headless_review "$session_dir"
    echo "$session_name"
}

track_my_pr() {
    # My own PR: create a tracked session (shallow clone so we can fix later),
    # but do NOT run a code review. Just mark it mine_stage=tracking.
    local pr_input="$1"
    local session_name
    session_name=$(create_pr_session_noninteractive "$pr_input" "" | tail -1)
    [ -z "$session_name" ] && { echo "ERROR: session creation failed" >&2; return 1; }
    local session_dir="$SESSIONS_DIR/$session_name"
    update_mine_stage "$session_dir" "tracking"
    # create_pr_session_noninteractive wrote a REVIEW-mode CLAUDE.md (auto-start
    # review). This is MY PR — replace it so no review agent ever auto-starts;
    # the triage pane drives everything via AGENT_CONTEXT.md / COMMENTS.md.
    cat > "$session_dir/CLAUDE.md" <<'MYPR'
# My Pull Request (tracked, not auto-reviewed)

This is your own PR. It is not code-reviewed by the tool. When reviewers leave
comments they are triaged into COMMENTS.md, and AGENT_CONTEXT.md drives the
guided reply/fix flow. Do not start a code review here.
MYPR
    echo "$session_name"
}

rereview_pr() {
    local session_name="$1"
    local SESSION_DIR="$SESSIONS_DIR/$session_name"
    local REPO_DIR="$SESSION_DIR/repo"
    [ -d "$REPO_DIR" ] || { echo "ERROR: repo missing for $session_name (archived?)" >&2; return 1; }
    rm -f "$SESSION_DIR/rereview_summary"
    # New round of findings coming → retire any stale agent tab so the next open
    # starts fresh on the updated REVIEW.md. Killing the agent closes its tab
    # (close_on_exit) with no focus-steal.
    local _apid; _apid=$(cat "$SESSION_DIR/agent_pid" 2>/dev/null)
    [ -n "$_apid" ] && kill "$_apid" 2>/dev/null; rm -f "$SESSION_DIR/agent_pid"

    local pr_num; pr_num=$(read_session_field "$SESSION_DIR" "pr.number")
    update_lifecycle "$SESSION_DIR" "none"
    update_review_state "$SESSION_DIR" "reviewing"

    mkdir -p "$SESSION_DIR/logs"
    local _src="${BASH_SOURCE[0]:-$0}" _d
    while [ -L "$_src" ]; do _d="$(cd -P "$(dirname "$_src")" && pwd)"; _src="$(readlink "$_src")"; [[ "$_src" != /* ]] && _src="$_d/$_src"; done
    local _cg="$(cd -P "$(dirname "$_src")" && pwd)/$(basename "$_src")"

    local wrapper; wrapper=$(mktemp /tmp/cgremlin-rereview-XXXXXX)
    # Outer vars ($SESSION_DIR, $REPO_DIR, $pr_num, $_cg) expand now.
    # Runtime vars use \$ to defer expansion to wrapper execution time.
    cat > "$wrapper" <<WRAPPER_EOF
#!/bin/bash
source "$_cg" --lib-only
write_review_guard "$REPO_DIR"

# --- Step 1: Fetch latest PR head and compute diff ---
old_commit=\$(cd "$REPO_DIR" && git rev-parse HEAD 2>/dev/null)
cd "$REPO_DIR" && git fetch origin "pull/${pr_num}/head" 2>/dev/null || { echo "fetch failed" >&2; update_review_state "$SESSION_DIR" failed; exit 1; }
new_commit=\$(cd "$REPO_DIR" && git rev-parse FETCH_HEAD 2>/dev/null)
cd "$REPO_DIR" && git reset --hard FETCH_HEAD 2>/dev/null

new_commits_text=\$(cd "$REPO_DIR" && git log --oneline "\${old_commit}..\${new_commit}" 2>/dev/null)
commit_count=\$(printf '%s' "\${new_commits_text}" | grep -c . 2>/dev/null || echo 0)
changes_since=\$(cd "$REPO_DIR" && git diff --stat "\${old_commit}...HEAD" 2>/dev/null)
old_short="\${old_commit:0:8}"
new_short="\${new_commit:0:8}"

# --- Step 2: Archive REVIEW.md ---
version=1
while [ -f "$SESSION_DIR/REVIEW-v\${version}.md" ]; do version=\$((version+1)); done
[ -f "$SESSION_DIR/REVIEW.md" ] && [ -s "$SESSION_DIR/REVIEW.md" ] && cp "$SESSION_DIR/REVIEW.md" "$SESSION_DIR/REVIEW-v\${version}.md"
next_version=\$((version+1))
today=\$(date +%Y-%m-%d)

# --- Step 3: Write RE-REVIEW.md ---
{
printf '# Re-Review: v%s\n\n## What Changed\n\n' "\$next_version"
printf '| Info | Value |\n|------|-------|\n'
printf '| **Previous** | v%s (commit `%s`) |\n' "\$version" "\$old_short"
printf '| **Current** | v%s (commit `%s`) |\n' "\$next_version" "\$new_short"
printf '| **New Commits** | %s |\n\n' "\$commit_count"
printf '### New Commits\n\`\`\`\n%s\n\`\`\`\n\n' "\${new_commits_text:-(none)}"
printf '### Files Changed Since Last Review\n\`\`\`\n%s\n\`\`\`\n\n---\n\n' "\${changes_since:-(none)}"
printf '## Re-Review Instructions\n\n**Update REVIEW.md IN PLACE. Same schema as the initial review. Do NOT rewrite from scratch.**\n\n'
printf '### 1. VERIFY each prior finding was properly addressed (do this FIRST)\n'
printf 'The point of a re-review is confirming old concerns were actually fixed, not just finding new ones. For every finding in the "What I found" table EXCEPT 🔇 dismissed:\n'
printf -- '- Re-open the code at its **Where** location and re-check the problem it describes: does the situation in its "What'"'"'s wrong" still happen? For maintainability, are the mixed concerns actually separated now?\n'
printf -- '- Classify with evidence (cite the changed lines): ✅ **resolved** (set Status `resolved`) · ⚠️ **partial** (keep OPEN, update "What'"'"'s wrong" with what still breaks) · ❌ **still open** (leave as-is) · 🔁 **regressed** (keep original + add a new finding for the regression).\n'
printf -- '- A fix you cannot confirm actually closes it is NOT resolved — treat as ⚠️ partial.\n'
printf -- '- **🔇 dismissed?** → SKIP entirely. Do not re-flag, edit, or remove.\n\n'
printf '### 2. Look for NEW findings — same evidence bar as the initial review\n'
printf 'Review the full current PR diff. Add a finding ONLY if it passes the evidence bar in your head (a bug: when it happens / what it does / what it should do; maintainability: what'"'"'s mixed / the concrete cost / how to separate). If you cannot answer concretely, drop it.\n'
printf 'Only Correctness, Security, Regression, provable Performance, and concrete separation-of-concerns. No cosmetic style, docs, or "nice to have". Also re-check intent: does the PR still satisfy the Jira ticket?\n'
printf 'Write each new finding in the SAME plain format as the file (What'"'"'s wrong / Why it matters / Suggested fix), with a `<a id="fN"></a>` anchor and a linked table row. Number continuing from the last ID; set Status to `open`.\n\n'
printf '### 3. Severity — exactly four\n🔴 Critical (blocks) · 🟠 High (should fix) · 🟡 Perf (provable, non-blocking) · 🔧 Maintainability (concrete SoC/coupling, non-blocking).\n\n'
printf '### 4. Update Review History\nADD a new row — never remove existing rows:\n'
printf '\`\`\`\n| v%s | %s | %s | Re-review: X resolved, Y partial, Z new |\n\`\`\`\n\n' "\$next_version" "\$today" "\$new_short"
printf '### 5. Update the Verdict\nRe-evaluate across ALL findings. Only OPEN 🔴/🟠 findings block approval.\n\n---\n\n'
printf '**Scope gate:** every finding'"'"'s file must be in the current diff. **Do NOT touch 🔇 findings. Do NOT post to GitHub.**\n\n'
printf '**BEGIN: read REVIEW.md, VERIFY each prior finding against the new code, then apply the evidence bar to new ones, update in-place.**\n'
} > "$SESSION_DIR/RE-REVIEW.md"

rm -f "$REPO_DIR/RE-REVIEW.md"
ln -s "../RE-REVIEW.md" "$REPO_DIR/RE-REVIEW.md"

# --- Step 4: Update CLAUDE.md with re-review notice ---
if [ -f "$REPO_DIR/CLAUDE.md" ]; then
    tmpf=\$(mktemp)
    awk '/^# ⚠️ RE-REVIEW MODE/{skip=1} skip && /^---$/{skip=0; next} !skip' "$REPO_DIR/CLAUDE.md" > "\$tmpf"
    {
        printf '# ⚠️ RE-REVIEW MODE (v%s)\n\n' "\$next_version"
        printf '**PR updated: %s new commit(s) since last review.**\n\n' "\$commit_count"
        printf '## What to do:\n1. Read \`RE-REVIEW.md\` for what changed\n'
        printf '2. Update \`REVIEW.md\` **in-place** (do not append sections)\n'
        printf '3. Move fixed items to "Resolved Findings" section\n'
        printf '4. Add any new issues found in the new commits\n'
        printf '5. Add a new row to the Review History table for v%s\n\n---\n\n' "\$next_version"
        cat "\$tmpf"
    } > "$REPO_DIR/CLAUDE.md"
    rm -f "\$tmpf"
fi

# --- Step 5: Update reviewed_sha ---
update_session_field "$SESSION_DIR" "reviewed_sha" "\$new_commit"

# --- Step 6: Run headless re-review with skill-aware prompt ---
prompt="STEP 1: Check if /APFM:apfm-review skill is available. If yes, run it for re-review and follow its output — skip everything else. STEP 2 (only if skill unavailable): RE-REVIEW MODE — PR updated with \${commit_count} new commit(s). Read RE-REVIEW.md and follow it. Update REVIEW.md in-place. FIRST verify each prior finding was properly addressed: re-check whether the problem it describes still happens in the new code and classify ✅ resolved / ⚠️ partial (keep open) / ❌ still open / 🔁 regressed, with evidence — 🔇 dismissed stay untouched. THEN add NEW findings only if they pass the evidence bar in CLAUDE.md, written in the file's plain format (What's wrong / Why it matters / Suggested fix), and re-check the PR still satisfies its Jira ticket. Severity is 🔴 Critical / 🟠 High / 🟡 Perf / 🔧 Maintainability. Scope: ONLY files in the PR diff. Add a new row to Review History. Self-check: verify every finding references a changed file. As the very last action, write a single line to the file $SESSION_DIR/rereview_summary. Format: '✅ N/N resolved' if all prior findings are resolved, or '⚠️ K/N resolved, M new' otherwise. Write only that line — no other content."

cd "$REPO_DIR" && claude -p "\$prompt" --permission-mode bypassPermissions --add-dir "$SESSION_DIR" < /dev/null
rc=\$?
if [ \$rc -eq 0 ] && [ -s "$SESSION_DIR/REVIEW.md" ]; then update_review_state "$SESSION_DIR" ready; else update_review_state "$SESSION_DIR" failed; fi
rm -f "$SESSION_DIR/.cg_agent_state"
rm -f "$wrapper"
WRAPPER_EOF
    chmod +x "$wrapper"
    nohup bash "$wrapper" >> "$SESSION_DIR/logs/worker.log" 2>&1 &
    update_session_field "$SESSION_DIR" "review_worker_pid" "$!"
    echo "re-reviewing $session_name"
}

triage_comments() {
    local session_name="$1"
    local SESSION_DIR="$SESSIONS_DIR/$session_name"
    local REPO_DIR="$SESSION_DIR/repo"
    [ -d "$REPO_DIR" ] || { echo "ERROR: repo missing for $session_name" >&2; return 1; }

    local pr_num repo
    pr_num=$(read_session_field "$SESSION_DIR" "pr.number")
    repo=$(_pr_repo "$SESSION_DIR")
    [ -z "$pr_num" ] || [ -z "$repo" ] && { echo "ERROR: missing pr.number/repo" >&2; return 1; }
    local owner="${repo%%/*}" name="${repo##*/}"

    update_mine_stage "$SESSION_DIR" "triaging"
    mkdir -p "$SESSION_DIR/logs"
    # A mine PR is never code-reviewed. Remove any stale REVIEW.md (from a
    # legacy review session that got reclassified as mine) so the triage pane
    # can't be misled by an old "nothing to flag" verdict — COMMENTS.md rules.
    rm -f "$SESSION_DIR/REVIEW.md" "$SESSION_DIR/repo/REVIEW.md"
    write_review_guard "$REPO_DIR"
    # Mine sessions are never apfm-reviewed, so also deny GraphQL here — the
    # triage worker must post NOTHING. (Replies go through --reply-comment, a
    # separate cgremlin process not under this guard.)
    local _gsf="$REPO_DIR/.claude/settings.local.json"
    if [ -f "$_gsf" ] && jq -e . "$_gsf" >/dev/null 2>&1; then
        jq '.permissions.deny = ((.permissions.deny // []) + ["Bash(gh api graphql:*)"] | unique)' "$_gsf" > "$_gsf.tmp" && mv "$_gsf.tmp" "$_gsf"
    fi

    # Snapshot the unresolved review threads from OTHERS (path, line, author,
    # body, thread id) into a context file the agent classifies. Also stamp
    # triaged_threads so the daemon won't relaunch for the same threads.
    local threads_json
    threads_json=$(timeout 30 gh api graphql -f query='query($o:String!,$r:String!,$n:Int!){repository(owner:$o,name:$r){pullRequest(number:$n){reviewThreads(first:100){nodes{id isResolved comments(first:1){nodes{author{login} path line body}}}}}}}' \
        -F o="$owner" -F r="$name" -F n="$pr_num" 2>/dev/null \
        | jq --arg me "$GITHUB_ME" '[.data.repository.pullRequest.reviewThreads.nodes[]
             | select(.isResolved==false)
             | {id, author:(.comments.nodes[0].author.login // ""), path:.comments.nodes[0].path, line:.comments.nodes[0].line, body:.comments.nodes[0].body}
             | select((.author|ascii_downcase) != ($me|ascii_downcase))]' 2>/dev/null)
    [ -z "$threads_json" ] && threads_json="[]"
    printf '%s\n' "$threads_json" > "$SESSION_DIR/.threads.json"
    # NOTE: triaged_threads is recorded only on SUCCESS (in the wrapper below),
    # so a failed triage leaves the threads un-triaged and the daemon retries.

    local _src="${BASH_SOURCE[0]:-$0}" _d
    while [ -L "$_src" ]; do _d="$(cd -P "$(dirname "$_src")" && pwd)"; _src="$(readlink "$_src")"; [[ "$_src" != /* ]] && _src="$_d/$_src"; done
    local _cg="$(cd -P "$(dirname "$_src")" && pwd)/$(basename "$_src")"

    local wrapper; wrapper=$(mktemp /tmp/cgremlin-triage-XXXXXX)
    cat > "$wrapper" <<WRAPPER_EOF
#!/bin/bash
source "$_cg" --lib-only
write_review_guard "$REPO_DIR"
cd "$REPO_DIR" && claude -p "You are helping the PR AUTHOR triage reviewer comments on their own PR. The unresolved reviewer comments (from others) are in ${SESSION_DIR}/.threads.json as a JSON array (fields: id, author, path, line, body). The PR branch is checked out here. For EACH comment, read the referenced code and decide whether it is ✅ valid (a real issue the author should fix) or 🟡 false-positive (does not apply / already handled / mistaken), with a one- or two-sentence plain-language reason. Write ${SESSION_DIR}/COMMENTS.md with one entry per comment in EXACTLY this format:

### <n>. <short title>
- **Thread:** <id from .threads.json>
- **From:** @<author>   **Where:** \\\`<path>:<line>\\\`
- **Comment:** <quote the reviewer's text>
- **Verdict:** ✅ valid   (or)   🟡 false-positive
- **Reasoning:** <plain sentences>
- **Proposed reply:** <what to reply, for false-positive only>
- **Proposed fix:** <how to fix, for valid only>
- **Status:** open

Do NOT reply on GitHub, do NOT edit code, do NOT commit — only write COMMENTS.md. Proceed autonomously; no confirmation." \
  --permission-mode bypassPermissions --add-dir "$SESSION_DIR" < /dev/null
rc=\$?
if [ \$rc -eq 0 ] && [ -s "$SESSION_DIR/COMMENTS.md" ]; then
    # Success: mark these threads triaged so the daemon won't relaunch for them.
    update_session_field "$SESSION_DIR" "triaged_threads" "\$(jq -c '[.[].id]' "$SESSION_DIR/.threads.json")"
    # Fresh COMMENTS.md → retire any stale agent tab so the next open reads it
    # fresh (killing the agent closes its tab via close_on_exit, no focus-steal).
    _apid=\$(cat "$SESSION_DIR/agent_pid" 2>/dev/null); [ -n "\$_apid" ] && kill "\$_apid" 2>/dev/null; rm -f "$SESSION_DIR/agent_pid"
    update_mine_stage "$SESSION_DIR" ready
else
    update_mine_stage "$SESSION_DIR" tracking
fi
rm -f "$SESSION_DIR/.cg_agent_state" "$wrapper"
WRAPPER_EOF
    chmod +x "$wrapper"
    nohup bash "$wrapper" >> "$SESSION_DIR/logs/worker.log" 2>&1 &
    update_session_field "$SESSION_DIR" "review_worker_pid" "$!"
    echo "triaging comments for $session_name"
}

# When sourced with --lib-only: define functions + load config, then stop (no menu/dashboard).
[ "$1" = "--lib-only" ] && return 0 2>/dev/null

# Handle --review-pr argument (called from orchestrator)
if [ "$1" = "--review-pr" ]; then
    review_pr_noninteractive "$2" "$3"
    exit $?
fi

if [ "$1" = "--investigate" ]; then
    [ -z "$2" ] && { echo "Usage: cgremlin --investigate <repo-url> <jira-key>" >&2; exit 1; }
    investigate_start "$2" "$3"; exit $?
fi

if [ "$1" = "--develop" ]; then
    [ -z "$2" ] && { echo "Usage: cgremlin --develop <investigation-session>" >&2; exit 1; }
    develop_start "$2"; exit $?
fi

if [ "$1" = "--track-my-pr" ]; then
    [ -z "$2" ] && { echo "Usage: cgremlin --track-my-pr <pr-url>" >&2; exit 1; }
    track_my_pr "$2"; exit $?
fi

# Handle --rereview-pr argument (incremental re-review of an existing session)
if [ "$1" = "--rereview-pr" ]; then
    [ -z "$2" ] && { echo "Usage: cgremlin --rereview-pr <session-name>" >&2; exit 1; }
    rereview_pr "$2"; exit $?
fi

if [ "$1" = "--triage-comments" ]; then
    [ -z "$2" ] && { echo "Usage: cgremlin --triage-comments <session>" >&2; exit 1; }
    triage_comments "$2"; exit $?
fi

# Handle --watch-daemon argument (background loop: delete merged sessions, auto-rereview on new commits)
if [ "$1" = "--watch-daemon" ]; then
    watch_daemon_loop
    exit 0
fi

# Handle --create-session argument (called from web UI)
if [ "$1" = "--create-session" ]; then
    case "$CGREMLIN_MODE" in
        review)
            create_pr_session_noninteractive "$CGREMLIN_URL" "$CGREMLIN_JIRA"
            ;;
        investigation)
            create_investigation_session_noninteractive "$CGREMLIN_URL" "$CGREMLIN_FOCUS" "$CGREMLIN_JIRA"
            ;;
        development)
            create_development_session_noninteractive "$CGREMLIN_URL" "$CGREMLIN_JIRA"
            ;;
        *)
            echo "ERROR: Unknown mode $CGREMLIN_MODE" >&2
            exit 1
            ;;
    esac
    exit 0
fi

# Handle --open-pr argument (shows floating agent pane for a PR session)
if [ "$1" = "--open-pr" ]; then
    if [ -z "$2" ]; then
        echo "Usage: cgremlin --open-pr <session-name>" >&2
        exit 1
    fi
    open_pr_row "$2"
    exit $?
fi

# Handle --status-pane argument (runs in Mission Control status pane)
if [ "$1" = "--status-pane" ]; then
    status_pane_loop
    exit 0
fi

# Handle --orchestrator argument (runs interactive Claude in the Mission Control orchestrator pane)
launch_orchestrator() {
  local odir="$SESSIONS_DIR/.orchestrator"; mkdir -p "$odir/.claude"
  # DEFAULT_PROJECT (e.g. https://github.com/aplaceformom/grace-frontend) lets the orchestrator
  # expand a bare PR number to a full URL, since --review-pr requires a full PR URL.
  cat > "$odir/CLAUDE.md" <<MD
# PR Review Orchestrator
You coordinate PR reviews. Default repo for bare PR numbers: ${DEFAULT_PROJECT:-(unset — require full URLs)}.
When the user gives PR numbers or links:
- Expand a bare number N to "\${DEFAULT_PROJECT}/pull/N" (strip any trailing .git). If DEFAULT_PROJECT is unset, ask for a full URL.
- For each PR, run: \`cgremlin --review-pr <full-pr-url>\` (creates the session + launches a headless review). Report "#<n> queued".
- Do NOT run reviews yourself. Do NOT post GitHub comments.
- Finished reviews appear in the status PICKER; the user clicks one to open a floating agent pane. If the user asks YOU to open PR N: find its session with \`ls "\$HOME/.cgremlin/sessions"/pr-*-N-* | tail -1\` (newest), then run \`cgremlin --open-pr <session-name>\`.
- When asked about a specific PR, summarize from its REVIEW.md. To dismiss one: \`cgremlin --dismiss-pr <session-name>\`.
- Follow PRINCIPLES.md.

## Starting work on a ticket
When I tell you I'm picking up a ticket (e.g. "I'm on HB-1051", or paste a Jira key/URL),
run:  cgremlin --investigate <REPO_URL> <JIRA-KEY>
where <REPO_URL> is the DEFAULT_PROJECT repo (expand a bare key against it, same as you
do for PR numbers). That opens an investigation agent in the 🔨 WORK tab. Tell me it started.
Do not investigate yourself — the WORK-tab agent does the work.
MD
  # pre-approve only the commands it needs
  cat > "$odir/.claude/settings.local.json" <<JSON
{ "permissions": { "allow": ["Bash(cgremlin --review-pr *)", "Bash(cgremlin --open-pr *)", "Bash(cgremlin --dismiss-pr *)", "Bash(cgremlin --investigate *)", "Bash(ls *)", "Read(*)"] } }
JSON
  cd "$odir" && claude --model "$MODEL" --add-dir "$SESSIONS_DIR"
}

if [ "$1" = "--orchestrator" ]; then
    launch_orchestrator
    exit $?
fi

if [ "$1" = "--mission-control" ]; then
    # --fresh forces a brand-new session (delete any existing one first) so
    # code/layout changes take effect without manually deleting the session.
    _mc_fresh=""; [ "$2" = "--fresh" ] && _mc_fresh="1"
    launch_mission_control "$_mc_fresh"
    exit $?
fi

main_menu
