    # Add the markdown content as a JavaScript variable
    echo "const markdown = \`" >> "$html_file"
    # Escape for JS template literal: backslashes, backticks, and ${
    # Then convert emoji codes
    cat "$file" | \
        sed 's/\\/\\\\/g' | \
        sed 's/`/\\`/g' | \
        sed 's/\${/\\${/g' | \
        sed 's/:red_circle:/🔴/g' | \
        sed 's/:orange_circle:/🟠/g' | \
        sed 's/:yellow_circle:/🟡/g' | \
        sed 's/:blue_circle:/🔵/g' | \
        sed 's/:white_check_mark:/✅/g' | \
        sed 's/:heavy_check_mark:/✅/g' | \
        sed 's/:x:/❌/g' | \
        sed 's/:warning:/⚠️/g' | \
        sed 's/:bulb:/💡/g' | \
        sed 's/:memo:/📝/g' | \
        sed 's/:rocket:/🚀/g' | \
        sed 's/:bug:/🐛/g' | \
        sed 's/:lock:/🔒/g' | \
        sed 's/:zap:/⚡/g' | \
        sed 's/:recycle:/♻️/g' | \
        sed 's/:fire:/🔥/g' | \
        sed 's/:star:/⭐/g' | \
        sed 's/:thumbsup:/👍/g' | \
        sed 's/:thumbsdown:/👎/g' | \
        sed 's/:question:/❓/g' | \
        sed 's/:exclamation:/❗/g' >> "$html_file"

    cat >> "$html_file" << 'HTMLEOF'
`;

        // Custom renderer for marked
        const renderer = new marked.Renderer();

        // Process the markdown
        let html = marked.parse(markdown);

        // Enhance findings sections with colored cards
        html = html.replace(/<h3>([^<]*Critical[^<]*)<\/h3>/gi, '<h3 class="finding-header critical">$1</h3>');
        html = html.replace(/<h3>([^<]*High[^<]*)<\/h3>/gi, '<h3 class="finding-header high">$1</h3>');
        html = html.replace(/<h3>([^<]*Medium[^<]*)<\/h3>/gi, '<h3 class="finding-header medium">$1</h3>');
        html = html.replace(/<h3>([^<]*Suggestion[^<]*)<\/h3>/gi, '<h3 class="finding-header suggestion">$1</h3>');
        html = html.replace(/<h3>([^<]*Positive[^<]*)<\/h3>/gi, '<h3 class="finding-header positive">$1</h3>');

        // Wrap file:line references in styled spans
        html = html.replace(/\[([^\]]+\.(ts|tsx|js|jsx|py|go|rs|java|rb|css|scss|html|json|yml|yaml|md):\d+[^\]]*)\]/g,
            '<span class="finding-location">📍 $1</span>');
        html = html.replace(/\[([^\]]+\.(ts|tsx|js|jsx|py|go|rs|java|rb|css|scss|html|json|yml|yaml|md)[^\]]*)\]/g,
            '<span class="finding-location">📄 $1</span>');

        // Wrap in sections
        html = html.replace(/<h2>/g, '</div><div class="section"><h2>');
        html = '<div class="section">' + html + '</div>';
        html = html.replace(/<div class="section"><\/div>/g, '');

        // Style the first section as header
        html = html.replace(/<div class="section">/, '<div class="review-header">');

        // Add verdict styling
        if (html.includes('Approve')) {
            html = html.replace(/(<li[^>]*>.*✅.*Approve[^<]*<\/li>)/i,
                '<li class="verdict-item approve">$1</li>');
        }

        document.getElementById('content').innerHTML = DOMPurify.sanitize(html);

        // Post-process: style finding items
        document.querySelectorAll('ul li, p').forEach(el => {
            const text = el.textContent;
            if (text.includes('📍') || el.querySelector('.finding-location')) {
                const parent = el.closest('.section');
                if (parent) {
                    const headerText = parent.querySelector('h2, h3')?.textContent || '';
                    let cls = 'finding';
                    if (headerText.match(/critical/i)) cls += ' finding-critical';
                    else if (headerText.match(/high/i)) cls += ' finding-high';
                    else if (headerText.match(/medium/i)) cls += ' finding-medium';
                    else if (headerText.match(/suggestion|low/i)) cls += ' finding-suggestion';
                    else if (headerText.match(/positive|good|well/i)) cls += ' finding-positive';
                    el.classList.add(...cls.split(' '));
                }
            }
        });
    </script>
</body>
</html>
HTMLEOF

    open "$html_file" 2>/dev/null || xdg-open "$html_file" 2>/dev/null || true
    success "Opened review in browser"
    sleep 1
}

archive_session() {
    local SESSION_DIR="$1"
    local SESSION_NAME=$(basename "$SESSION_DIR")

    # REVIEW.md and FINDINGS.md are already in session root (repo has symlinks)
    # Just save CLAUDE.md if it exists and isn't a symlink
    if [ -f "$SESSION_DIR/repo/CLAUDE.md" ] && [ ! -L "$SESSION_DIR/repo/CLAUDE.md" ]; then
        cp "$SESSION_DIR/repo/CLAUDE.md" "$SESSION_DIR/"
    fi

    # Delete repo folder (symlinks will be deleted with it, actual files stay in session root)
    rm -rf "$SESSION_DIR/repo"

    # Mark as archived
    echo "ARCHIVED: $(date '+%Y-%m-%d %H:%M:%S')" >> "$SESSION_DIR/session-info.txt"

    success "Session archived (repo deleted, review/findings kept)"
}

is_archived() {
    local SESSION_DIR="$1"
    [ ! -d "$SESSION_DIR/repo" ] && [ -f "$SESSION_DIR/session-info.txt" ]
}

refresh_pr_session() {
    local SESSION_DIR="$1"
    local INFO_FILE="$SESSION_DIR/session-info.txt"

    if ! grep -q "^Type:.*PR" "$INFO_FILE" 2>/dev/null; then
        error "This is not a PR session"
        sleep 2
        return 1
    fi

    local PR_NUMBER=$(grep "^PR #" "$INFO_FILE" 2>/dev/null | head -1 | sed 's/PR #\([0-9]*\).*/\1/')
    local REPO=$(grep "^Repository:" "$INFO_FILE" 2>/dev/null | head -1 | cut -d: -f2 | xargs)
    local PR_BASE=$(grep "^Branch:" "$INFO_FILE" 2>/dev/null | head -1 | sed 's/.*→ //' | xargs)

    if [ -z "$PR_NUMBER" ] || [ -z "$REPO" ]; then
        error "Could not find PR info in session"
        sleep 2
        return 1
    fi

    cd "$SESSION_DIR/repo" || return 1

    # Get current commit before refresh
    local OLD_COMMIT=$(git rev-parse HEAD 2>/dev/null)

    echo ""
    gum spin --spinner dot --title "Fetching latest PR changes..." -- \
        bash -c "git fetch origin 'pull/$PR_NUMBER/head' 2>&1"

    local NEW_COMMIT=$(git rev-parse "FETCH_HEAD" 2>/dev/null)

    if [ "$OLD_COMMIT" = "$NEW_COMMIT" ]; then
        success "PR is already up to date (no new commits)"
        sleep 2
        return 0
    fi

    # Show what changed
    local NEW_COMMITS=$(git log --oneline "$OLD_COMMIT".."$NEW_COMMIT" 2>/dev/null)
    local COMMIT_COUNT=$(echo "$NEW_COMMITS" | grep -c . || echo "0")

    echo ""
    gum style --foreground 82 --bold "Found $COMMIT_COUNT new commit(s):"
    echo ""
    echo "$NEW_COMMITS" | head -10
    [ "$COMMIT_COUNT" -gt 10 ] && dim "... and $((COMMIT_COUNT - 10)) more"
    echo ""

    if ! gum confirm "Update to latest and prepare re-review?"; then
        return 0
    fi

    # Reset to latest PR code
    git reset --hard FETCH_HEAD 2>/dev/null
    if [ $? -ne 0 ]; then
        error "Git reset failed"
        return 1
    fi
    # Re-create session file symlinks after reset
    setup_output_files "$SESSION_DIR"

    # Get new diff stats
    local NEW_DIFF_STAT=$(git diff --stat "$PR_BASE"...HEAD 2>/dev/null || echo "")
    local NEW_CHANGED_FILES=$(git diff --name-only "$PR_BASE"...HEAD 2>/dev/null || echo "")
    local CHANGES_SINCE=$(git diff --stat "$OLD_COMMIT"...HEAD 2>/dev/null || echo "")

    # Update session info with refresh timestamp
    echo "" >> "$INFO_FILE"
    echo "REFRESHED: $(date '+%Y-%m-%d %H:%M:%S')" >> "$INFO_FILE"
    echo "Previous commit: $OLD_COMMIT" >> "$INFO_FILE"
    echo "New commit: $NEW_COMMIT" >> "$INFO_FILE"
    echo "New commits: $COMMIT_COUNT" >> "$INFO_FILE"

    # Archive old REVIEW.md if it exists (files are in session root)
    local version=1
    while [ -f "$SESSION_DIR/REVIEW-v${version}.md" ]; do
        ((version++))
    done

    if [ -f "$SESSION_DIR/REVIEW.md" ] && [ -s "$SESSION_DIR/REVIEW.md" ]; then
        cp "$SESSION_DIR/REVIEW.md" "$SESSION_DIR/REVIEW-v${version}.md"
        success "Archived previous review as REVIEW-v${version}.md"
    fi

    local next_version=$((version + 1))

    # Create RE-REVIEW.md in session root, symlink into repo
    cat > "$SESSION_DIR/RE-REVIEW.md" << REREVIEW_EOF
# Re-Review: v${next_version}

## What Changed

| Info | Value |
|------|-------|
| **Previous** | v${version} (commit \`${OLD_COMMIT:0:8}\`) |
| **Current** | v${next_version} (commit \`${NEW_COMMIT:0:8}\`) |
| **New Commits** | ${COMMIT_COUNT} |

### New Commits
\`\`\`
$NEW_COMMITS
\`\`\`

### Files Changed Since Last Review
\`\`\`
$CHANGES_SINCE
\`\`\`

---

## Re-Review Instructions

**Update REVIEW.md IN PLACE. Same schema as the initial review. Do NOT rewrite from scratch.**

### 1. VERIFY each prior finding was properly addressed (do this FIRST)
This is the point of a re-review — not just finding new issues, but confirming the old concerns were actually fixed. For every finding in the "What I found" table EXCEPT 🔇 dismissed ones:
- Re-open the code at its **Where** location and re-check the problem the finding describes: does the situation in its "What's wrong" still happen in the new code? For a maintainability finding, are the mixed concerns actually separated now?
- Classify with evidence (cite the lines that changed it):
  - ✅ **resolved** — the fix genuinely closes it. Set Status \`resolved\`.
  - ⚠️ **partial** — attempted but it still misbehaves in some case. Keep it OPEN; update "What's wrong" to describe what still breaks.
  - ❌ **still open** — not addressed. Leave as-is.
  - 🔁 **regressed** — the fix introduced a NEW problem. Keep the original open if unfixed, AND add a new finding for the regression.
- A fix you cannot confirm actually closes it is NOT resolved — treat it as ⚠️ partial.
- **🔇 dismissed?** → SKIP entirely. Do not re-flag, edit, or remove. The reviewer dismissed it on purpose.

### 2. Look for NEW findings — same evidence bar as the initial review
Review the full current PR diff. Add a finding ONLY if it passes the evidence bar in your head (a bug: when it happens / what it does / what it should do; a maintainability issue: what's mixed / the concrete cost / how to separate). If you cannot answer concretely, drop it. Only Correctness, Security, Regression, provable Performance, and concrete separation-of-concerns — no cosmetic style, docs, or "nice to have". Also re-check intent: does the PR still satisfy the Jira ticket? Write each new finding in the SAME plain format as the file (What's wrong / Why it matters / Suggested fix), with a \`<a id="fN"></a>\` anchor and a linked table row. Number continuing from the last ID; Status \`open\`.

### 3. Severity — exactly four
🔴 Critical (blocks) · 🟠 High (should fix) · 🟡 Perf (provable, non-blocking) · 🔧 Maintainability (concrete SoC/coupling, non-blocking).

### 4. Update the Review History table
ADD a new row (never remove existing rows):
\`\`\`markdown
| v${next_version} | $(date '+%Y-%m-%d') | ${NEW_COMMIT:0:8} | Re-review: X resolved, Y partial, Z new |
\`\`\`

### 5. Update the Verdict
Re-evaluate across ALL findings. Only OPEN 🔴/🟠 findings block approval.

---

**Scope gate:** every finding's file must be in the current diff. **Do NOT touch 🔇 findings.** **Do NOT post to GitHub.**

**BEGIN: read REVIEW.md, VERIFY each prior finding against the new code, then apply the evidence bar to new ones, update in-place.**
REREVIEW_EOF
    rm -f "$SESSION_DIR/repo/RE-REVIEW.md"
    ln -sf "../RE-REVIEW.md" "$SESSION_DIR/repo/RE-REVIEW.md"

    success "PR refreshed! RE-REVIEW.md created with instructions"
    sleep 1

    # Update CLAUDE.md to reference RE-REVIEW.md
    if [ -f "$SESSION_DIR/repo/CLAUDE.md" ]; then
        # Remove any previous re-review notice
        sed -i '' '/^# ⚠️ RE-REVIEW MODE/,/^---$/d' "$SESSION_DIR/repo/CLAUDE.md" 2>/dev/null || true

        # Prepend new re-review notice
        local temp_file=$(mktemp)
        cat > "$temp_file" << NOTICE_EOF
# ⚠️ RE-REVIEW MODE (v${next_version})

**PR updated: ${COMMIT_COUNT} new commit(s) since last review.**

## What to do:
1. Read \`RE-REVIEW.md\` for what changed
2. Update \`REVIEW.md\` **in-place** (don't append sections)
3. Move fixed items to "Resolved Findings" section
4. Add any new issues found in the new commits
5. **IMPORTANT**: Add a new row to the Review History table for v${next_version}

## Review History Must Show:
- v1: Initial review
- v${next_version}: This re-review (add this row!)

---

NOTICE_EOF
        cat "$SESSION_DIR/repo/CLAUDE.md" >> "$temp_file"
        mv "$temp_file" "$SESSION_DIR/repo/CLAUDE.md"
    fi

    # Refresh PR comments/discussions
    local OWNER=""
    local REPO_NAME=""
    if [[ "$REPO" =~ ^([^/]+)/([^/]+)$ ]]; then
        OWNER="${BASH_REMATCH[1]}"
        REPO_NAME="${BASH_REMATCH[2]}"
        fetch_pr_comments "$SESSION_DIR" "$OWNER" "$REPO_NAME" "$PR_NUMBER"
    fi

    # Ask if user wants to start Claude immediately for re-review
    echo ""
    local rereview_action=$(printf '%s\n' \
        "▶ Start Claude re-review now" \
        "🤖 Run ACR first, then Claude" \
        "📋 Return to menu (start later)" | fzf \
        --height=~30% \
        --layout=reverse \
        --border=rounded \
        --no-info \
        --prompt="" \
        --header="Ready to re-review. What would you like to do?" \
        --header-first)

    case "$rereview_action" in
        *"Start Claude"*)
            tput reset 2>/dev/null || clear
            cd "$SESSION_DIR/repo"
            claude "STEP 1: Check if /APFM:apfm-review skill is available. If yes, run it for re-review and follow its output — skip everything else. STEP 2 (only if skill unavailable): RE-REVIEW MODE — PR updated with $COMMIT_COUNT new commit(s). Read RE-REVIEW.md and follow it. Update REVIEW.md in-place. FIRST verify each prior finding was properly addressed: re-check whether the problem it describes still happens in the new code and classify ✅ resolved / ⚠️ partial (keep open) / ❌ still open / 🔁 regressed, with evidence — 🔇 dismissed stay untouched. THEN add NEW findings only if they pass the evidence bar in CLAUDE.md, written in the file's plain format (What's wrong / Why it matters / Suggested fix), and re-check the PR still satisfies its Jira ticket. Severity is 🔴 Critical / 🟠 High / 🟡 Perf / 🔧 Maintainability. Scope: ONLY files in the PR diff. Add a new row to Review History. Self-check: verify every finding references a changed file."
            return 2  # Signal that Claude was run
            ;;
        *"ACR"*)
            run_acr_quick "$SESSION_DIR" "$PR_BASE"
            tput reset 2>/dev/null || clear
            cd "$SESSION_DIR/repo"
            claude "STEP 1: Check if /APFM:apfm-review skill is available. If yes, run it for re-review (ACR_REVIEW.md has context) and follow its output — skip everything else. STEP 2 (only if skill unavailable): RE-REVIEW MODE — PR updated. Read RE-REVIEW.md and ACR_REVIEW.md, and follow RE-REVIEW.md. Update REVIEW.md in-place. FIRST verify each prior finding was properly addressed: re-check whether the problem it describes still happens in the new code and classify ✅ resolved / ⚠️ partial (keep open) / ❌ still open / 🔁 regressed, with evidence — 🔇 dismissed stay untouched. THEN add NEW findings only if they pass the evidence bar in CLAUDE.md, written in the file's plain format (What's wrong / Why it matters / Suggested fix), and re-check the PR still satisfies its Jira ticket. Severity is 🔴 Critical / 🟠 High / 🟡 Perf / 🔧 Maintainability. Scope: ONLY files in the PR diff. Add a new row to Review History. Self-check: verify every finding references a changed file."
            return 2  # Signal that Claude was run
            ;;
        *)
            return 0
            ;;
    esac
}

restart_session() {
    local SESSION_DIR="$1"
    local INFO_FILE="$SESSION_DIR/session-info.txt"

    # Extract repo URL and branch info
    local REPO_URL=$(grep "^URL:" "$INFO_FILE" 2>/dev/null | head -1 | cut -d' ' -f2-)

    if [ -z "$REPO_URL" ]; then
        error "Could not find repository URL in session info"
        sleep 2
        return 1
    fi

    # Check if it's a PR session
    if grep -q "^Type:.*PR" "$INFO_FILE" 2>/dev/null; then
        local PR_NUMBER=$(grep "^PR #" "$INFO_FILE" 2>/dev/null | head -1 | sed 's/PR #\([0-9]*\).*/\1/')
        local PR_BASE=$(grep "^Branch:" "$INFO_FILE" 2>/dev/null | head -1 | sed 's/.*→ //' | xargs)

        gum spin --spinner dot --title "Re-cloning repository..." -- \
            git clone --depth=50 "https://github.com/${REPO_URL}.git" "$SESSION_DIR/repo" 2>&1 || \
            git clone --depth=50 "$REPO_URL" "$SESSION_DIR/repo" 2>&1

        if [ ! -d "$SESSION_DIR/repo" ]; then
            error "Failed to clone repository"
            sleep 2
            return 1
        fi

        cd "$SESSION_DIR/repo"
        gum spin --spinner dot --title "Checking out PR branch..." -- \
            bash -c "git fetch origin 'pull/$PR_NUMBER/head:pr-$PR_NUMBER' 2>&1 && git checkout 'pr-$PR_NUMBER' 2>&1"
    else
        # Investigation session
        local BRANCH=$(grep "^Branch:" "$INFO_FILE" 2>/dev/null | head -1 | cut -d: -f2 | xargs | sed 's/ (default)//')

        # Clone with branch directly if specified (avoids fetch issues with shallow clone)
        local clone_cmd="git clone --depth=100"
        [ -n "$BRANCH" ] && clone_cmd="$clone_cmd --branch '$BRANCH'"
        clone_cmd="$clone_cmd '$REPO_URL' '$SESSION_DIR/repo'"

        gum spin --spinner dot --title "Re-cloning repository..." -- \
            bash -c "$clone_cmd 2>&1"

        if [ ! -d "$SESSION_DIR/repo" ]; then
            error "Failed to clone repository"
            sleep 2
            return 1
        fi
    fi

    # Restore CLAUDE.md to repo if it exists in session root
    [ -f "$SESSION_DIR/CLAUDE.md" ] && cp "$SESSION_DIR/CLAUDE.md" "$SESSION_DIR/repo/"

    # Setup output files with symlinks (files are in session root, symlinked to repo)
    setup_output_files "$SESSION_DIR"

    # Remove archived marker
    sed -i '' '/^ARCHIVED:/d' "$SESSION_DIR/session-info.txt" 2>/dev/null || true

    success "Session restored!"
    sleep 1
    return 0
}

# Generic tool picker for review/investigation/development
# Usage: pick_tool "review|investigation|development" "$PR_URL"
pick_tool() {
    local action_type="$1"  # review, investigation, or development
    local PR_URL="$2"

    local options=()
    local header=""

    case "$action_type" in
        review)
            header="Select review tool:"
            options+=("🤖 Claude - Deep review with explanations")
            # Add Codex if available
            if command -v codex >/dev/null 2>&1 && [ -n "$PR_URL" ]; then
                options+=("⚡ Codex - Fast parallel review")
            fi
            # Add ACR options if available
            if [ "$HAS_ACR" = "true" ] && [ -n "$PR_URL" ]; then
                options+=("🔀 ACR → Claude - Quick scan, then deep dive")
                options+=("📋 ACR only - Parallel AI scan")
            fi
            ;;
        investigation)
            header="Select investigation tool:"
            options+=("🤖 Claude - Interactive exploration")
            if command -v codex >/dev/null 2>&1; then
                options+=("⚡ Codex - Fast analysis")
            fi
            ;;
        development)
            header="Select development tool:"
            options+=("🤖 Claude - Interactive development")
            if command -v codex >/dev/null 2>&1; then
                options+=("⚡ Codex - Fast assistance")
            fi
            ;;
    esac

    options+=("← Back")

    local choice=$(printf '%s\n' "${options[@]}" | fzf \
        --height=~30% \
        --layout=reverse \
        --border=rounded \
        --no-info \
        --prompt="" \
        --header="$header" \
        --header-first \
        --ansi)

    echo "$choice"
}

pre_session_menu() {
    local SESSION_DIR="$1"
    local SESSION_NAME=$(basename "$SESSION_DIR")

    # Get PR URL if it's a PR session
    local PR_URL=""
    if [ -f "$SESSION_DIR/session-info.txt" ]; then
        PR_URL=$(grep "^URL:" "$SESSION_DIR/session-info.txt" 2>/dev/null | head -1 | cut -d: -f2- | xargs)
    fi

    # Get PR base branch for ACR
    local PR_BASE=""
    if [ -f "$SESSION_DIR/session-info.txt" ]; then
        PR_BASE=$(grep "^Branch:" "$SESSION_DIR/session-info.txt" 2>/dev/null | head -1 | sed 's/.*→ //' | xargs)
    fi
    [ -z "$PR_BASE" ] && PR_BASE="main"

    while true; do
        header
        gum style \
            --border rounded \
            --border-foreground 82 \
            --padding "1 2" \
            --align center \
            "Session ready: $SESSION_NAME"

        echo ""
        dim "Choose an action:"
        echo ""

        # UNIFIED options - same for ALL session types
        local options=()

        # Primary actions - ALL available regardless of session type
        options+=("▶ Review")
        options+=("🔬 Investigate")
        options+=("🛠 Develop")

        # Utility options
        options+=("💻 Open in editor")
        options+=("📊 View diff")

        if [ -n "$PR_URL" ]; then
            options+=("🌐 Open PR in browser")
            options+=("🔄 Refresh PR")
            options+=("💬 Refresh Discussion")
        fi

        options+=("📄 Session info")
        options+=("🗑 Delete session")
        options+=("← Back")

        local choice=$(printf '%s\n' "${options[@]}" | fzf \
            --height=~40% \
            --layout=reverse \
            --border=rounded \
            --no-info \
            --prompt="" \
            --header="What would you like to do?" \
            --header-first \
            --ansi)

        case "$choice" in
            *"Review"*)
                local tool=$(pick_tool "review" "$PR_URL")
                case "$tool" in
                    *"ACR"*"Claude"*)
                        # ACR first, then Claude - must come before *"Claude"*
                        run_acr_quick "$SESSION_DIR" "$PR_BASE"
                        switch_to_review_mode "$SESSION_DIR"
                        echo ""
                        dim "Type /exit when done to return here."
                        sleep 1
                        tput reset 2>/dev/null || clear
                        cd "$SESSION_DIR/repo" && claude --model $MODEL --add-dir "$SESSION_DIR" -- "STEP 1: Check if /APFM:apfm-review skill is available. If yes, run it (ACR_REVIEW.md has prior automated findings as context) and follow its output — skip everything else. STEP 2 (only if skill unavailable): ACR_REVIEW.md contains automated findings — use as input but verify independently. You are a senior engineer. Review ONLY files listed in Changed Files in CLAUDE.md. ANY finding whose file is not in that list is INVALID — delete it. Follow CLAUDE.md review guidelines. Write REVIEW.md with findings by severity. For each: file:line, what the code does, the problem, why it matters, and a concrete fix. Self-check: before finishing, verify every finding references a changed file."
                        post_session_menu "$SESSION_DIR"
                        return 0
                        ;;
                    *"ACR only"*)
                        run_acr_review "$SESSION_DIR" "$PR_BASE"
                        ;;
                    *"Codex"*)
                        run_codex_review "$SESSION_DIR" "$PR_BASE" "false"
                        post_session_menu "$SESSION_DIR"
                        return 0
                        ;;
                    *"Claude"*)
                        # Plain Claude - must come after ACR patterns
                        switch_to_review_mode "$SESSION_DIR"
                        echo ""
                        dim "Type /exit when done to return here."
                        sleep 1
                        tput reset 2>/dev/null || clear
                        cd "$SESSION_DIR/repo" && claude --model $MODEL --add-dir "$SESSION_DIR" -- "STEP 1: Check if /APFM:apfm-review skill is available. If yes, run it and follow its output — skip everything else. STEP 2 (only if skill unavailable): You are a senior engineer. Review ONLY files listed in Changed Files in CLAUDE.md. ANY finding whose file is not in that list is INVALID — delete it. Follow CLAUDE.md review guidelines — it defines the confidence gate and the REVIEW.md format. First check intent: does the PR satisfy its Jira ticket (source of truth)? If it diverges, that is a 🔴 finding. Then write ONLY high-confidence findings that pass the evidence bar in CLAUDE.md (a bug: when it happens / what it does / what it should do; maintainability: what's mixed / the concrete cost / how to separate), otherwise drop it. Write findings in CLAUDE.md's plain format (What's wrong / Why it matters / Suggested fix) — clear language, no jargon. Severity is 🔴 Critical / 🟠 High / 🟡 Perf / 🔧 Maintainability. Cover Correctness, Security, Regression, provable Performance, and concrete separation-of-concerns — no cosmetic style, docs, or suggestions. Self-check: before finishing, verify every finding references a changed file and passes the bar."
                        post_session_menu "$SESSION_DIR"
                        return 0
                        ;;
                    *) ;; # Back - continue loop
                esac
                ;;
            *"Investigate"*)
                local tool=$(pick_tool "investigation" "$PR_URL")
                case "$tool" in
                    *"Claude"*)
                        switch_to_investigation_mode "$SESSION_DIR"
                        echo ""
                        dim "Type /exit when done to return here."
                        sleep 1
                        tput reset 2>/dev/null || clear
                        cd "$SESSION_DIR/repo" && claude --model $MODEL --add-dir "$SESSION_DIR" -- "STEP 1: Check if /APFM:apfm-review skill is available. If yes, run it for project context before investigating. STEP 2: Follow CLAUDE.md investigation guidelines. Explore the codebase, trace execution paths relevant to the focus area, and document all findings in FINDINGS.md."
                        post_session_menu "$SESSION_DIR"
                        return 0
                        ;;
                    *"Codex"*)
                        info "Codex investigation not yet implemented"
                        sleep 1
                        ;;
                    *) ;; # Back
                esac
                ;;
            *"Develop"*)
                local tool=$(pick_tool "development" "$PR_URL")
                case "$tool" in
                    *"Claude"*)
                        switch_to_development_mode "$SESSION_DIR"
                        echo ""
                        dim "Type /exit when done to return here."
                        sleep 1
                        tput reset 2>/dev/null || clear
                        cd "$SESSION_DIR/repo" && claude --model $MODEL --add-dir "$SESSION_DIR" -- "STEP 1: Check if /APFM:apfm-review skill is available. If yes, run it for project context before developing. STEP 2: Follow CLAUDE.md development guidelines. Read existing context files (FINDINGS.md, REVIEW.md) before writing any code. Track progress in DEVLOG.md."
                        post_session_menu "$SESSION_DIR"
                        return 0
                        ;;
                    *"Codex"*)
                        info "Codex development not yet implemented"
                        sleep 1
                        ;;
                    *) ;; # Back
                esac
                ;;
            *"editor"*)
                open_in_editor "$SESSION_DIR/repo"
                ;;
            *"diff"*|*"Diff"*)
                view_diff "$SESSION_DIR"
                ;;
            *"PR"*"browser"*|*"Open PR"*)
                [ -n "$PR_URL" ] && open "${PR_URL}/files"
                sleep 1
                ;;
            *"Refresh"*)
                refresh_pr_session "$SESSION_DIR"
                ;;
            *"info"*|*"Info"*)
                gum pager < "$SESSION_DIR/session-info.txt"
                ;;
            *"Delete"*)
                gum confirm --default=false "Delete session?" && rm -rf "$SESSION_DIR" && return 1
                ;;
            *"Back"*|*)
                return 1
                ;;
        esac
    done
}

post_session_menu() {
    local SESSION_DIR="$1"
    local SESSION_NAME=$(basename "$SESSION_DIR")

    # Get PR URL if it's a PR session
    local PR_URL=""
    if [ -f "$SESSION_DIR/session-info.txt" ]; then
        PR_URL=$(grep "^URL:" "$SESSION_DIR/session-info.txt" 2>/dev/null | head -1 | cut -d: -f2- | xargs)
    fi

    # Find review/findings files (stored in session root, symlinked to repo)
    local review_file=""
    local findings_file=""
    [ -f "$SESSION_DIR/REVIEW.md" ] && [ -s "$SESSION_DIR/REVIEW.md" ] && review_file="$SESSION_DIR/REVIEW.md"
    [ -f "$SESSION_DIR/FINDINGS.md" ] && [ -s "$SESSION_DIR/FINDINGS.md" ] && findings_file="$SESSION_DIR/FINDINGS.md"

    while true; do
        header
        gum style \
            --border rounded \
            --border-foreground 240 \
            --padding "1 2" \
            --align center \
            "Session: $SESSION_NAME"

        echo ""

        # Show what output files exist
        local has_output=false
        if [ -n "$review_file" ] || [ -n "$findings_file" ]; then
            has_output=true
            local output_info=""
            [ -n "$review_file" ] && output_info="Review"
            [ -n "$findings_file" ] && output_info="${output_info:+$output_info + }Findings"
            gum style --foreground 82 "📝 $output_info available"
            echo ""
        fi

        local options=(
            "↩ Resume Claude"
            "🚀 Start Claude in new terminal (with logging)"
            "💻 Open in editor"
            "🖥️  Open Terminal in repo"
            "🎯 Focus session terminal"
            "📊 View diff"
        )

        # Add PR-specific options
        if [ -n "$PR_URL" ]; then
            options+=("🌐 Open PR in browser")
            options+=("🔄 Refresh PR (check for updates)")
        fi

        # Add output file options if they exist
        if [ "$has_output" = "true" ]; then
            options+=("📖 View output (nice)")
            options+=("👁 Open live preview (auto-refresh)")
            options+=("📋 Copy to clipboard")
        fi

        options+=(
            "🔄 Switch mode (Review ↔ Investigation)"
            "📄 View session info"
            "───────────────"
            "📁 Keep session"
            "📦 Archive (keep review, delete repo)"
            "🗑 Delete everything"
            "← Back to main menu"
        )

        local choice=$(printf '%s\n' "${options[@]}" | fzf \
            --height=~50% \
            --layout=reverse \
            --border=rounded \
            --no-info \
            --prompt="" \
            --header="What next?" \
            --header-first)

        case "$choice" in
            *"Resume Claude"*)
                tput reset 2>/dev/null || clear
                cd "$SESSION_DIR/repo"

                # Determine current mode and appropriate file
                local mode=$(get_current_mode "$SESSION_DIR")
                local output_file=""
                local prompt=""

                if [ "$mode" = "development" ]; then
                    [ -f "$SESSION_DIR/repo/DEVLOG.md" ] && [ -s "$SESSION_DIR/repo/DEVLOG.md" ] && output_file="DEVLOG.md"
                    prompt="Read DEVLOG.md and give me a brief summary of the progress so far (bullet points). Then let me know you're ready to continue development."
                elif [ "$mode" = "investigation" ]; then
                    [ -f "$SESSION_DIR/repo/FINDINGS.md" ] && [ -s "$SESSION_DIR/repo/FINDINGS.md" ] && output_file="FINDINGS.md"
                    prompt="Read FINDINGS.md and give me a brief summary of the key discoveries (bullet points, max 5-7 items). Then let me know you're ready to continue the investigation or discuss the findings."
                else
                    [ -f "$SESSION_DIR/repo/REVIEW.md" ] && [ -s "$SESSION_DIR/repo/REVIEW.md" ] && output_file="REVIEW.md"
                    prompt="Read REVIEW.md and give me a brief summary of the key findings (bullet points, max 5-7 items). Highlight any critical or high-severity issues. Then let me know you're ready to discuss, refine, or update the review."
                fi

                if [ -n "$output_file" ]; then
                    claude "$prompt"
                else
                    claude -c
                fi
                ;;
            *"Start Claude in new terminal"*)
                start_claude_terminal "$SESSION_DIR"
                success "Claude started in new terminal with logging"
                sleep 1
                ;;
            *"editor"*)
                open_in_editor "$SESSION_DIR/repo"
                ;;
            *"Terminal"*)
                open_terminal_in_repo "$SESSION_DIR"
                ;;
            *"Focus session terminal"*)
                if ! focus_session_terminal "$SESSION_DIR"; then
                    dim "No terminal found for this session"
                    sleep 1
                fi
                ;;
            *"View diff"*)
                view_diff "$SESSION_DIR"
                ;;
            *"Open PR in browser"*)
                if [ -n "$PR_URL" ]; then
                    open "${PR_URL}/files" 2>/dev/null || xdg-open "${PR_URL}/files" 2>/dev/null || true
                fi
                ;;
            *"Refresh PR"*)
                if refresh_pr_session "$SESSION_DIR"; then
                    # Re-check files after refresh
                    review_file=""
                    findings_file=""
                    [ -f "$SESSION_DIR/REVIEW.md" ] && [ -s "$SESSION_DIR/REVIEW.md" ] && review_file="$SESSION_DIR/REVIEW.md"
                    [ -f "$SESSION_DIR/FINDINGS.md" ] && [ -s "$SESSION_DIR/FINDINGS.md" ] && findings_file="$SESSION_DIR/FINDINGS.md"
                fi
                ;;
            *"Refresh Discussion"*)
                # Refresh PR comments and discussions
                local PR_NUMBER=$(grep "^PR #" "$SESSION_DIR/session-info.txt" 2>/dev/null | head -1 | sed 's/PR #\([0-9]*\).*/\1/')
                local REPO=$(grep "^Repository:" "$SESSION_DIR/session-info.txt" 2>/dev/null | head -1 | cut -d: -f2 | xargs)
                if [ -n "$PR_NUMBER" ] && [ -n "$REPO" ]; then
                    local OWNER="${REPO%/*}"
                    local REPO_NAME="${REPO#*/}"
                    fetch_pr_comments "$SESSION_DIR" "$OWNER" "$REPO_NAME" "$PR_NUMBER"

                    # Show summary of what was fetched
                    if [ -f "$SESSION_DIR/PR_DISCUSSION.md" ]; then
                        local total=$(tail -1 "$SESSION_DIR/PR_DISCUSSION.md" | grep -oE '[0-9]+' | paste -sd+ - | bc 2>/dev/null || echo "0")
                        success "PR discussion refreshed ($total total comments)"

                        # Offer to view the discussion
                        if gum confirm "View PR discussion?"; then
                            view_markdown_nice "$SESSION_DIR/PR_DISCUSSION.md"
                        fi
                    fi
                else
                    error "Could not find PR info in session"
                fi
                sleep 1
                ;;
            *"View output"*)
                # Let user choose which file to view
                local view_choice=""
                if [ -n "$review_file" ] && [ -n "$findings_file" ]; then
                    view_choice=$(printf '%s\n' "REVIEW.md" "FINDINGS.md" "Both" | fzf \
                        --height=~20% \
                        --layout=reverse \
                        --border=rounded \
                        --no-info \
                        --prompt="" \
                        --header="Which file?" \
                        --header-first)
                elif [ -n "$review_file" ]; then
                    view_choice="REVIEW.md"
                else
                    view_choice="FINDINGS.md"
                fi

                case "$view_choice" in
                    "REVIEW.md") view_markdown_nice "$SESSION_DIR/REVIEW.md" ;;
                    "FINDINGS.md") view_markdown_nice "$SESSION_DIR/FINDINGS.md" ;;
                    "Both")
                        view_markdown_nice "$SESSION_DIR/REVIEW.md"
                        view_markdown_nice "$SESSION_DIR/FINDINGS.md"
                        ;;
                esac
                ;;
            *"live preview"*)
                # Choose preview mode
                local preview_mode=$(printf '%s\n' \
                    "🔄 Open Dashboard (all sessions)" \
                    "📄 Static HTML (this session only)" \
                    "🛑 Stop dashboard server" \
                    "← Cancel" | fzf \
                    --height=~30% \
                    --layout=reverse \
                    --border=rounded \
                    --no-info \
                    --prompt="" \
                    --header="Preview mode" \
                    --header-first)

                case "$preview_mode" in
                    *"Dashboard"*)
                        start_dashboard_server
                        sleep 1
                        ;;
                    *"Static HTML"*)
                        local static_file="$SESSION_DIR/preview.html"
                        create_static_preview "$SESSION_DIR" "$static_file"
                        open "$static_file" 2>/dev/null
                        success "Opened static preview - refresh browser to see updates"
                        sleep 1
                        ;;
                    *"Stop"*)
                        stop_dashboard_server
                        sleep 1
                        ;;
                esac
                ;;
            *"Copy"*"clipboard"*)
                # Let user choose which file to copy
                local copy_choice=""
                if [ -n "$review_file" ] && [ -n "$findings_file" ]; then
                    copy_choice=$(printf '%s\n' "REVIEW.md" "FINDINGS.md" "Both" | fzf \
                        --height=~20% \
                        --layout=reverse \
                        --border=rounded \
                        --no-info \
                        --prompt="" \
                        --header="Which file?" \
                        --header-first)
                elif [ -n "$review_file" ]; then
                    copy_choice="REVIEW.md"
                elif [ -n "$findings_file" ]; then
                    copy_choice="FINDINGS.md"
                fi

                case "$copy_choice" in
                    "REVIEW.md")
                        cat "$SESSION_DIR/REVIEW.md" | pbcopy 2>/dev/null && success "Review copied to clipboard"
                        ;;
                    "FINDINGS.md")
                        cat "$SESSION_DIR/FINDINGS.md" | pbcopy 2>/dev/null && success "Findings copied to clipboard"
                        ;;
                    "Both")
                        { echo "# REVIEW"; cat "$SESSION_DIR/REVIEW.md"; echo -e "\n\n# FINDINGS"; cat "$SESSION_DIR/FINDINGS.md"; } | pbcopy 2>/dev/null
                        success "Both files copied to clipboard"
                        ;;
                esac
                sleep 1
                ;;
            *"Switch mode"*)
                prompt_mode_switch "$SESSION_DIR"
                ;;
            *"session info"*)
                if [ -f "$SESSION_DIR/session-info.txt" ]; then
                    gum pager < "$SESSION_DIR/session-info.txt"
                fi
                ;;
            *"Keep session"*)
                info "Session kept at: $SESSION_DIR"
                sleep 1
                return 0
                ;;
            *"Archive"*)
                if gum confirm "Archive session? (Keeps review & metadata, deletes repo)"; then
                    archive_session "$SESSION_DIR"
                    sleep 1
                fi
                return 0
                ;;
            *"Delete everything"*)
                if gum confirm --default=false "Delete this session completely?"; then
                    rm -rf "$SESSION_DIR"
                    success "Session deleted"
                    sleep 1
                fi
                return 0
                ;;
            *"───"*)
                # Separator, do nothing
                ;;
            *"Back to main"*)
                return 0
                ;;
            *)
                # ESC pressed or empty selection - go back
                return 0
                ;;
        esac
    done
}

view_diff() {
    local SESSION_DIR="$1"
    local INFO_FILE="$SESSION_DIR/session-info.txt"

    cd "$SESSION_DIR/repo"

    # Get base branch from session info
    local BASE_BRANCH=$(grep "^Branch:" "$INFO_FILE" 2>/dev/null | head -1 | sed 's/.*→ //' | xargs)

    if [ -z "$BASE_BRANCH" ]; then
        BASE_BRANCH="main"
    fi

    local choice=$(gum choose \
        "📊 Summary (stat)" \
        "📝 Full diff in pager" \
        "💻 Open diff in VS Code" \
        "← Back")

    case "$choice" in
        *"Summary"*)
            clear
            echo ""
            gum style --foreground 75 --bold "Diff Summary"
            echo ""
            git diff --stat "$BASE_BRANCH"...HEAD 2>/dev/null || git diff --stat HEAD~5
            echo ""
            read -p "Press Enter to continue..."
            ;;
        *"Full diff"*)
            # Use delta if available, otherwise git diff with color
            if command -v delta >/dev/null 2>&1; then
                git diff "$BASE_BRANCH"...HEAD 2>/dev/null | delta --paging=always
            else
                git diff "$BASE_BRANCH"...HEAD --color=always 2>/dev/null | gum pager
            fi
            ;;
        *"VS Code"*)
            # Open VS Code with git diff
            code --diff "$SESSION_DIR/repo" 2>/dev/null || {
                error "Could not open VS Code"
                sleep 2
            }
            ;;
    esac
}

# ============================================================================
# SEARCH
# ============================================================================

search_sessions() {
    header
    gum style --foreground 214 --bold "Search Sessions"
    echo ""

    printf "Search: "
    read -r query
    [ -z "$query" ] && return 0

    local results=$(grep -ril "$query" "$SESSIONS_DIR"/*/session-info.txt 2>/dev/null || true)

    if [ -z "$results" ]; then
        echo ""
        dim "No sessions found matching '$query'"
        sleep 2
        return 0
    fi

    # Build formatted options
    local sessions=()
    local options=()

    while IFS= read -r info_file; do
        [ -z "$info_file" ] && continue
        local session=$(dirname "$info_file")
        sessions+=("$session")

        local name=$(basename "$session")
        local archived=""
        grep -q "^ARCHIVED:" "$info_file" 2>/dev/null && archived="📦 "

        local has_review=""
        [ -f "$session/REVIEW.md" ] || [ -f "$session/repo/REVIEW.md" ] && has_review=" 📝"
        [ -f "$session/FINDINGS.md" ] || [ -f "$session/repo/FINDINGS.md" ] && has_review=" 📝"

        local created=$(grep "^Created:" "$info_file" 2>/dev/null | cut -d: -f2- | xargs | cut -d' ' -f1-2)

        if [[ "$name" == pr-* ]]; then
            local title=$(grep "^PR #" "$info_file" 2>/dev/null | head -1)
            options+=("${archived}🔍 ${title}${has_review} • ${created}")
        else
            local title=$(sed -n '/Investigation Focus:/,/====/p' "$info_file" 2>/dev/null | grep -v "Investigation Focus:" | grep -v "===" | grep -v "^-" | head -1 | xargs)
            options+=("${archived}🔬 ${title:0:40}${has_review} • ${created}")
        fi
    done <<< "$results"

    echo ""
    # Add back option
    local all_options=("← Back" "${options[@]}")
    local selected=$(printf '%s\n' "${all_options[@]}" | fzf \
        --height=~50% \
        --layout=reverse \
        --border=rounded \
        --no-info \
        --prompt="" \
        --header="Found ${#options[@]} match(es) for '$query'" \
        --header-first)

    if [ -z "$selected" ] || [[ "$selected" == "← Back"* ]]; then
        return 0
    fi

    # Find matching session by index
    for i in "${!options[@]}"; do
        if [ "${options[$i]}" = "$selected" ]; then
            pre_session_menu "${sessions[$i]}"
            return 0
        fi
    done
}

# ============================================================================
# CLEANUP
# ============================================================================

cleanup_sessions() {
    header
    gum style --foreground 196 --bold "Cleanup Sessions"
    echo ""

    local sessions=$(get_sessions)

    if [ -z "$sessions" ]; then
        dim "No sessions to clean up"
        sleep 2
        return 0
    fi

    # Display all sessions
    display_sessions

    # Build options for multi-select
    local session_array=()
    local options=()
    while IFS= read -r session; do
        [ -z "$session" ] && continue
        session_array+=("$session")
        local name=$(basename "$session")
        local info_file="$session/session-info.txt"

        if [ -f "$info_file" ]; then
            if [[ "$name" == pr-* ]]; then
                local title=$(grep "^PR #" "$info_file" 2>/dev/null | head -1)
                options+=("$title")
            else
                local title=$(sed -n '/Investigation Focus:/,/====/p' "$info_file" 2>/dev/null | grep -v "Investigation Focus:" | grep -v "===" | grep -v "^-" | head -1 | xargs)
                options+=("${title:0:50}")
            fi
        else
            options+=("$name")
        fi
    done <<< "$sessions"

    echo ""
    dim "Press TAB to select, Enter to confirm, ESC to cancel"
    echo ""
    local selected=$(printf '%s\n' "${options[@]}" | fzf \
        --multi \
        --height=~50% \
        --layout=reverse \
        --border=rounded \
        --no-info \
        --prompt="" \
        --header="Select sessions to delete (TAB to select)" \
        --header-first)

    if [ -z "$selected" ]; then
        return 0
    fi

    # Find and delete matching sessions
    local to_delete=()
    while IFS= read -r sel; do
        [ -z "$sel" ] && continue
        for i in "${!options[@]}"; do
            if [ "${options[$i]}" = "$sel" ]; then
                to_delete+=("${session_array[$i]}")
                break
            fi
        done
    done <<< "$selected"

    if [ ${#to_delete[@]} -eq 0 ]; then
        return 0
    fi

    echo ""
    gum style --foreground 196 "Will delete ${#to_delete[@]} session(s)"
    echo ""

    if gum confirm --default=false "Delete these sessions?"; then
        for session in "${to_delete[@]}"; do
            rm -rf "$session"
            success "Deleted: $(basename "$session")"
        done
        sleep 1
    fi
}

# ============================================================================
# LIST / RESUME
# ============================================================================

list_sessions_menu() {
    header

    local sessions=$(get_sessions)

    if [ -z "$sessions" ]; then
        dim "No sessions found"
        sleep 2
        return 0
    fi

    local session=$(select_session_simple)

    if [ -n "$session" ] && [ -d "$session" ]; then
        # Check if archived
        local archived=$(is_archived "$session" && echo "yes" || echo "no")

        # Find review/findings files (prefer session root, fallback to repo for old sessions)
        local review_file=""
        local findings_file=""
        [ -f "$session/REVIEW.md" ] && [ -s "$session/REVIEW.md" ] && review_file="$session/REVIEW.md"
        [ -f "$session/FINDINGS.md" ] && [ -s "$session/FINDINGS.md" ] && findings_file="$session/FINDINGS.md"

        # Get PR URL for PR-specific options
        local PR_URL=""
        if [ -f "$session/session-info.txt" ]; then
            PR_URL=$(grep "^URL:" "$session/session-info.txt" 2>/dev/null | head -1 | cut -d: -f2- | xargs)
        fi

        local options=()

        if [ "$archived" = "yes" ]; then
            options+=("🔄 Restart session (re-clone repo)")
        else
            options+=("▶ Resume session")
            options+=("💻 Open in editor")
            options+=("📊 View diff")
        fi

        if [ -n "$PR_URL" ]; then
            options+=("🌐 Open PR in browser")
            [ "$archived" != "yes" ] && options+=("🔄 Refresh PR (fetch updates)")
        fi

        if [ -n "$review_file" ]; then
            options+=("📖 View review (nice)")
        fi

        options+=("ℹ View session info")
        options+=("🗑 Delete session")
        options+=("← Back")

        local header_text="Active Session"
        [ "$archived" = "yes" ] && header_text="📦 Archived Session"
        local choice=$(printf '%s\n' "${options[@]}" | fzf \
            --height=~50% \
            --layout=reverse \
            --border=rounded \
            --no-info \
            --prompt="" \
            --header="$header_text" \
            --header-first)

        case "$choice" in
            *"Restart"*)
                if restart_session "$session"; then
                    pre_session_menu "$session"
                fi
                ;;
            *"Resume"*)
                tput reset 2>/dev/null || clear
                pre_session_menu "$session"
                ;;
            *"editor"*)
                open_in_editor "$session/repo"
                ;;
            *"View diff"*)
                view_diff "$session"
                ;;
            *"Open PR in browser"*)
                if [ -n "$PR_URL" ]; then
                    open "${PR_URL}/files" 2>/dev/null || xdg-open "${PR_URL}/files" 2>/dev/null || true
                fi
                ;;
            *"Refresh PR"*)
                refresh_pr_session "$session"
                ;;
            *"View review"*)
                if [ -n "$review_file" ]; then
                    view_markdown_nice "$review_file"
                fi
                ;;
            *"session info"*)
                if [ -f "$session/session-info.txt" ]; then
                    gum pager < "$session/session-info.txt"
                fi
                ;;
            *"Delete"*)
                if gum confirm --default=false "Delete this session?"; then
                    rm -rf "$session"
                    success "Session deleted"
                    sleep 1
                fi
                ;;
        esac
    fi
}

# ============================================================================
# SETTINGS MENU
# ============================================================================

settings_menu() {
    while true; do
        header
        gum style --foreground 212 --bold "Settings"
        echo ""

        # Show current settings
        gum style --foreground 240 "Current configuration:"
        echo "  Model: $(gum style --foreground 82 "$MODEL")"
        echo "  Dashboard auto-start: $(gum style --foreground 82 "$DASHBOARD_AUTO_START")"
        echo "  Use Zellij: $(gum style --foreground 82 "$USE_ZELLIJ")"
        [ -n "$DEFAULT_PROJECT" ] && echo "  Default project: $(gum style --foreground 82 "$DEFAULT_PROJECT")"
        echo ""

        local choice=$(printf '%s\n' \
            "🤖 Switch Claude model ($MODEL)" \
            "🌐 Toggle dashboard auto-start ($DASHBOARD_AUTO_START)" \
            "🪟 Toggle Zellij panes ($USE_ZELLIJ)" \
            "📁 Set default project" \
            "🔄 Migrate sessions to v2 format" \
            "🗑️  Clear configuration" \
            "📄 View config file" \
            "← Back" | fzf \
            --height=~40% \
            --layout=reverse \
            --border=rounded \
            --no-info \
            --prompt="" \
            --header="Configure cgremlin settings" \
            --header-first)

        case "$choice" in
            *"Switch Claude model"*)
                local new_model=$(printf '%s\n' \
                    "sonnet (Recommended - fast & capable)" \
                    "opus (Most capable - slower)" \
                    "haiku (Fastest - simpler tasks)" | fzf \
                    --height=~25% \
                    --layout=reverse \
                    --border=rounded \
                    --no-info \
                    --prompt="" \
                    --header="Select Claude model" \
                    --header-first)

                case "$new_model" in
                    *"sonnet"*) MODEL="sonnet" ;;
                    *"opus"*) MODEL="opus" ;;
                    *"haiku"*) MODEL="haiku" ;;
                esac

                if [ -n "$new_model" ]; then
                    save_config
                    success "Model set to: $MODEL"
                    sleep 1
                fi
                ;;
            *"Toggle dashboard"*)
                if [ "$DASHBOARD_AUTO_START" = "true" ]; then
                    DASHBOARD_AUTO_START="false"
                else
                    DASHBOARD_AUTO_START="true"
                fi
                save_config
                success "Dashboard auto-start: $DASHBOARD_AUTO_START"
                sleep 1
                ;;
            *"Toggle Zellij"*)
                if [ "$USE_ZELLIJ" = "true" ]; then
                    USE_ZELLIJ="false"
                else
                    USE_ZELLIJ="true"
                fi
                save_config
                success "Use Zellij: $USE_ZELLIJ"
                sleep 1
                ;;
            *"Set default project"*)
                local project_path=$(gum input \
                    --placeholder "e.g., https://github.com/org/repo" \
                    --value "$DEFAULT_PROJECT" \
                    --header "Default project URL or path:")

                if [ -n "$project_path" ]; then
                    DEFAULT_PROJECT="$project_path"
                    save_config
                    success "Default project set"
                    sleep 1
                fi
                ;;
            *"Migrate sessions"*)
                echo ""
                dim "Scanning for v1 sessions..."
                local migrated=0
                local failed=0

                for session in $(get_sessions); do
                    if [ ! -f "$session/session.json" ] && [ -f "$session/session-info.txt" ]; then
                        local name=$(basename "$session")
                        dim "  Migrating $name..."
                        if migrate_session_to_v2 "$session"; then
                            ((migrated++))
                        else
                            ((failed++))
                        fi
                    fi
                done

                echo ""
                if [ $migrated -gt 0 ]; then
                    success "Migrated $migrated session(s) to v2 format"
                fi
                if [ $failed -gt 0 ]; then
                    error "Failed to migrate $failed session(s)"
                fi
                if [ $migrated -eq 0 ] && [ $failed -eq 0 ]; then
                    dim "No v1 sessions found to migrate"
                fi
                sleep 2
                ;;
            *"Clear configuration"*)
                if gum confirm "Clear all configuration?"; then
                    MODEL="$DEFAULT_MODEL"
                    DASHBOARD_AUTO_START="$DEFAULT_DASHBOARD_AUTO_START"
                    DEFAULT_PROJECT=""
                    USE_ZELLIJ="$DEFAULT_USE_ZELLIJ"
                    rm -f "$CONFIG_FILE"
                    success "Configuration cleared"
                    sleep 1
                fi
                ;;
            *"View config"*)
                if [ -f "$CONFIG_FILE" ]; then
                    gum pager < "$CONFIG_FILE"
                else
                    dim "No config file exists yet"
                    sleep 1
                fi
                ;;
            *"Back"*|"")
                return 0
                ;;
        esac
    done
}

