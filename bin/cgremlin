switch_to_development_mode() {
    local SESSION_DIR="$1"
    local claude_file="$SESSION_DIR/repo/CLAUDE.md"

    # Preserve existing Jira context before overwriting
    local jira_context=$(extract_jira_context "$claude_file")

    cat > "$claude_file" << 'DEV_MODE'
# Development Mode — Senior Engineer

> You are a senior software engineer. Read and understand the codebase's patterns, conventions, and architecture BEFORE writing any code.

## Project Skill (CHECK FIRST)

Check if `/APFM:apfm-review` skill is available. If yes, run it first for project context before developing. Then proceed with development below.

## Task Context

[Task details will be appended below from Jira ticket and/or custom instructions]

## Engineering Principles

- **DRY** — Don't repeat yourself; extract shared logic into reusable functions
- **Low complexity** — Simple, readable solutions over clever ones
- **No hacks** — Every solution must be the "right" way, not a workaround or shortcut
- **Maintainability** — Code should be easy for the next developer to understand and modify
- **Follow existing patterns** — Match the codebase's naming conventions, file structure, and coding style
- **Small, focused changes** — One concern per commit; don't mix refactoring with features

## Before Writing Code

1. **Explore the codebase** — Understand existing architecture, patterns, and conventions
2. **Read context files** — Check FINDINGS.md, REVIEW.md, DEVLOG.md for prior work and open issues
3. **Understand the "why"** — Know the goal behind the task, not just the surface request
4. **Plan your approach** — Think through the design before typing code

## Development Process

1. Implement changes following the codebase's conventions
2. Write or update tests for your changes
3. Run tests after every meaningful change
4. Make incremental, logical commits with clear messages
5. Document progress and decisions in **DEVLOG.md**

## What NOT to Do

- Don't introduce new patterns that conflict with existing ones
- Don't add unnecessary abstractions or over-engineer
- Don't leave TODO/FIXME comments as solutions
- Don't bypass existing safety checks, validations, or linting rules
- Don't commit broken or untested code
- Don't write hacks, workarounds, or "temporary" fixes that become permanent

## Available Context Files

- **session-info.txt** — Task/ticket details and requirements
- **FINDINGS.md** — Investigation notes (read if exists!)
- **REVIEW.md** — Code review findings (fix issues found here!)
- **DEVLOG.md** — Your development log (write progress here)

## DEVLOG Format

Write your progress to `DEVLOG.md`:

```markdown
# Development Log

## Task
[Brief description of what you're implementing]

## Progress

### [Timestamp or Step]
- What was done
- Files modified
- Issues encountered

## Changes Made
- `path/to/file.ts` - [what changed]

## Testing
- [ ] Unit tests pass
- [ ] Manual testing done
```

**BEGIN DEVELOPMENT NOW.**
DEV_MODE

    # Re-append Jira context if it existed
    if [ -n "$jira_context" ]; then
        echo "" >> "$claude_file"
        echo "$jira_context" >> "$claude_file"
    fi

    # Update session.json mode if v2 session
    if [ -f "$SESSION_DIR/session.json" ]; then
        update_session_field "$SESSION_DIR" "mode" "development"
        add_session_history "$SESSION_DIR" "mode_switch" '{"to": "development"}'
    fi

    success "Switched to Development Mode"
    dim "Claude will focus on implementation and DEVLOG.md"
    sleep 1
}

prompt_mode_switch() {
    local SESSION_DIR="$1"
    local current_mode=$(get_current_mode "$SESSION_DIR")

    header
    gum style --foreground 214 --bold "Switch Mode"
    echo ""

    case "$current_mode" in
        review)
            dim "Current mode: Review (REVIEW.md)"
            ;;
        investigation)
            dim "Current mode: Investigation (FINDINGS.md)"
            ;;
        development)
            dim "Current mode: Development (DEVLOG.md)"
            ;;
        *)
            dim "Current mode: Unknown"
            ;;
    esac
    echo ""

    local choice=$(gum choose \
        --header "Select mode:" \
        "📝 Review Mode (focus on REVIEW.md)" \
        "🔬 Investigation Mode (focus on FINDINGS.md)" \
        "🛠 Development Mode (focus on DEVLOG.md)" \
        "← Cancel")

    case "$choice" in
        *"Review Mode"*)
            switch_to_review_mode "$SESSION_DIR"
            return 0
            ;;
        *"Investigation Mode"*)
            switch_to_investigation_mode "$SESSION_DIR"
            return 0
            ;;
        *"Development Mode"*)
            switch_to_development_mode "$SESSION_DIR"
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

# ============================================================================
# ACR (AGENTIC CODE REVIEWER)
# ============================================================================

# Quick ACR run without post-menu (for ACR → Claude flow)
run_acr_quick() {
    local SESSION_DIR="$1"
    local PR_BASE="${2:-main}"

    if [ "$HAS_ACR" != "true" ]; then
        error "ACR not installed. Install with: brew install richhaase/tap/acr"
        sleep 2
        return 1
    fi

    cd "$SESSION_DIR/repo" || return 1

    header
    gum style --foreground 214 --bold "ACR - Quick Review (5 reviewers, claude)"
    echo ""

    local acr_output="$SESSION_DIR/ACR_REVIEW.md"

    # Create header
    {
        echo "# ACR Review Results"
        echo ""
        echo "- **Reviewers**: 5"
        echo "- **Agents**: claude"
        echo "- **Base**: $PR_BASE"
        echo "- **Date**: $(date '+%Y-%m-%d %H:%M:%S')"
        echo ""
        echo "---"
        echo ""
    } > "$acr_output"

    # Run ACR with defaults
    gum spin --spinner dot --title "Running ACR..." -- bash -c "acr -r 5 -a claude -b '$PR_BASE' -t 10m --local 2>&1 | tee -a '$acr_output'"

    echo "---" >> "$acr_output"
    echo "" >> "$acr_output"
    echo "*Generated by ACR (Agentic Code Reviewer)*" >> "$acr_output"

    success "ACR results saved to ACR_REVIEW.md"
    sleep 1
    return 0
}

run_acr_review() {
    local SESSION_DIR="$1"
    local PR_BASE="${2:-main}"

    if [ "$HAS_ACR" != "true" ]; then
        error "ACR not installed. Install with: brew install richhaase/tap/acr"
        sleep 2
        return 1
    fi

    cd "$SESSION_DIR/repo" || return 1

    header
    gum style --foreground 214 --bold "ACR - Agentic Code Reviewer"
    echo ""

    # ACR configuration
    local reviewers=5
    local agents="claude"
    local timeout="10m"
    local verbose=""

    # Let user configure
    local config_choice=$(gum choose \
        "🚀 Quick review (5 reviewers, claude)" \
        "⚙️  Custom configuration" \
        "← Back")

    case "$config_choice" in
        *"Quick"*)
            # Use defaults
            ;;
        *"Custom"*)
            echo ""
            reviewers=$(gum input --placeholder "Number of reviewers (1-10)" --value "5")
            [[ ! "$reviewers" =~ ^[0-9]+$ ]] && reviewers=5
            [ "$reviewers" -gt 10 ] && reviewers=10
            [ "$reviewers" -lt 1 ] && reviewers=1

            agents=$(gum choose --header "Select agent(s):" \
                "claude" \
                "codex" \
                "gemini" \
                "claude,codex" \
                "claude,gemini" \
                "codex,gemini" \
                "claude,codex,gemini")

            if gum confirm "Enable verbose output?"; then
                verbose="-v"
            fi
            ;;
        *)
            return 1
            ;;
    esac

    echo ""
    gum style --foreground 240 "Running ACR with $reviewers reviewers using $agents..."
    echo ""

    # Run ACR (--local to not post to GitHub, capture output)
    local acr_output="$SESSION_DIR/ACR_REVIEW.md"

    # Create a wrapper to capture output nicely
    {
        echo "# ACR Review Results"
        echo ""
        echo "- **Reviewers**: $reviewers"
        echo "- **Agents**: $agents"
        echo "- **Base**: $PR_BASE"
        echo "- **Date**: $(date '+%Y-%m-%d %H:%M:%S')"
        echo ""
        echo "---"
        echo ""
    } > "$acr_output"

    # Run ACR and capture output
    if acr -r "$reviewers" -a "$agents" -b "$PR_BASE" -t "$timeout" --local $verbose 2>&1 | tee -a "$acr_output"; then
        success "ACR review complete"
    else
        error "ACR review failed or found issues (exit code indicates findings)"
    fi

    echo ""
    echo "---" >> "$acr_output"
    echo "" >> "$acr_output"
    echo "*Generated by ACR (Agentic Code Reviewer)*" >> "$acr_output"

    success "Results saved to ACR_REVIEW.md"
    sleep 1

    # Offer next steps in a loop until user chooses to go back
    while true; do
        local next=$(gum choose \
            "📖 View ACR results" \
            "🤖 Feed results to Claude for deeper analysis" \
            "⚡ Feed results to Codex for deeper analysis" \
            "✅ Done, return to session menu")

        case "$next" in
            *"View ACR"*)
                if command -v glow >/dev/null 2>&1; then
                    glow -p "$acr_output"
                else
                    gum pager < "$acr_output"
                fi
                ;;
            *"Claude"*)
                feed_acr_to_claude "$SESSION_DIR" "$acr_output"
                return 0
                ;;
            *"Codex"*)
                if command -v codex >/dev/null 2>&1; then
                    # Copy ACR results to REVIEW.md as context (in session root)
                    cat > "$SESSION_DIR/REVIEW.md" << ACRCTX
# Code Review

## ACR Pre-Analysis

\`\`\`
$(cat "$acr_output")
\`\`\`

---

## Detailed Analysis

ACRCTX
                    run_codex_review "$SESSION_DIR" "$PR_BASE" "false"
                else
                    error "Codex not installed"
                    sleep 1
                fi
                return 0
                ;;
            *"Done"*|*)
                return 0
                ;;
        esac
    done
}

feed_acr_to_claude() {
    local SESSION_DIR="$1"
    local ACR_OUTPUT="$2"

    # Append ACR context to CLAUDE.md
    local claude_md="$SESSION_DIR/repo/CLAUDE.md"

    if [ -f "$claude_md" ]; then
        # Add ACR results section
        cat >> "$claude_md" << ACR_CONTEXT

---

# ACR Review Results (Pre-Analysis)

The following findings were generated by ACR (Agentic Code Reviewer) using parallel AI reviewers.
Your task is to:

1. **Validate** - Check if each finding is accurate
2. **Prioritize** - Rank by actual impact and severity
3. **Expand** - Look deeper into critical issues
4. **Add** - Find anything ACR might have missed
5. **Consolidate** - Merge with your own analysis in REVIEW.md

## ACR Findings:

\`\`\`markdown
$(cat "$ACR_OUTPUT")
\`\`\`

---

**Analyze these findings and incorporate them into your REVIEW.md with your own assessment.**
ACR_CONTEXT
    fi

    echo ""
    dim "ACR results added to Claude context."
    dim "Starting Claude to analyze and expand on findings..."
    sleep 2

    tput reset 2>/dev/null || clear
    cd "$SESSION_DIR/repo"
    claude "I've received ACR review results. Please analyze them, validate the findings, and incorporate them into a comprehensive REVIEW.md with your own deeper analysis."
}

# ============================================================================
# CLAUDE SESSION
# ============================================================================

run_claude_session() {
    local SESSION_DIR="$1"
    local SESSION_NAME=$(basename "$SESSION_DIR")

    # Verify session exists
    if [ ! -d "$SESSION_DIR/repo" ]; then
        error "Session directory not found: $SESSION_DIR/repo"
        error "The session may have been deleted or failed to create."

        # Clean up orphaned session if it exists
        if [ -d "$SESSION_DIR" ]; then
            if gum confirm --default=false "Delete orphaned session directory?"; then
                rm -rf "$SESSION_DIR"
                success "Cleaned up orphaned session"
            fi
        fi
        sleep 2
        return 1
    fi

    pre_session_menu "$SESSION_DIR"
}

open_in_editor() {
    local dir="$1"

    # Try VS Code, then Cursor, then fallback
    if command -v code >/dev/null 2>&1; then
        code "$dir"
    elif command -v cursor >/dev/null 2>&1; then
        cursor "$dir"
    elif [ -d "/Applications/Visual Studio Code.app" ]; then
        open -a "Visual Studio Code" "$dir"
    elif [ -d "/Applications/Cursor.app" ]; then
        open -a "Cursor" "$dir"
    else
        error "No editor found. Install VS Code and run:"
        dim "  Cmd+Shift+P → 'Shell Command: Install code command in PATH'"
        sleep 3
        return 1
    fi
    return 0
}

# Open a new terminal window/tab in the session's repo folder
# Start a Claude session in a new terminal with logging
start_claude_terminal() {
    local SESSION_DIR="$1"
    local REPO_DIR="$SESSION_DIR/repo"
    local SESSION_NAME=$(basename "$SESSION_DIR")

    if [ ! -d "$REPO_DIR" ]; then
        error "Repository folder not found: $REPO_DIR"
        return 1
    fi

    # Create terminal log directory
    local log_dir="$SESSION_DIR/logs"
    mkdir -p "$log_dir"
    local log_file="$log_dir/terminal-$(date +%Y%m%d-%H%M%S).log"

    # Determine mode for proper claude startup
    local mode=$(get_current_mode "$SESSION_DIR")
    local mode_short="${mode:0:3}"

    # Build the claude command based on mode
    # Use --add-dir to allow Claude to write to session folder without permission prompts
    local claude_cmd="cd '$REPO_DIR' && claude --model $MODEL --add-dir '$SESSION_DIR'"

    # Try Zellij if configured and available
    if [ "$USE_ZELLIJ" = "true" ] && command -v zellij &>/dev/null; then
        local tmp_script=$(mktemp /tmp/cgremlin-XXXXXX)
        echo "script -q '$log_file' $claude_cmd" > "$tmp_script"
        chmod +x "$tmp_script"
        zellij run --name "🧪 $SESSION_NAME" -- bash "$tmp_script"
        if [ -f "$SESSION_DIR/session.json" ]; then
            local terminal_info=$(jq -n \
                --arg log "$log_file" \
                --arg name "$SESSION_NAME" \
                '{log_file: $log, tab_name: $name, started: (now | strftime("%Y-%m-%dT%H:%M:%S"))}')
            update_session_field "$SESSION_DIR" "terminal" "$terminal_info"
            add_session_history "$SESSION_DIR" "terminal_started" '{"app": "Zellij"}'
        fi
        return 0
    fi

    # Try iTerm2 first (macOS)
    if [ -d "/Applications/iTerm.app" ]; then
        # Compute session color for iTerm2 tab
        local color_idx=$(echo -n "$SESSION_NAME" | cksum | awk '{print $1 % 15}')
        local colors=("#ef4444" "#f97316" "#eab308" "#84cc16" "#22c55e" "#14b8a6" "#06b6d4" "#0ea5e9" "#3b82f6" "#6366f1" "#8b5cf6" "#a855f7" "#d946ef" "#ec4899" "#f43f5e")
        local hex="${colors[$color_idx]}"
        local r=$((16#${hex:1:2})) g=$((16#${hex:3:2})) b=$((16#${hex:5:2}))
        local color_cmd="printf '\\\\033]6;1;bg;red;brightness;${r}\\\\a\\\\033]6;1;bg;green;brightness;${g}\\\\a\\\\033]6;1;bg;blue;brightness;${b}\\\\a'"
        osascript << ITERM_SCRIPT
tell application "iTerm"
    activate
    tell current window
        create tab with default profile
        tell current session
            set name to "🧪 $SESSION_NAME"
            write text "printf '\\033]1;🧪 $SESSION_NAME\\a'"
            write text "$color_cmd"
            write text "script -q '$log_file' $claude_cmd"
        end tell
    end tell
end tell
ITERM_SCRIPT
        # Update session.json with terminal info
        if [ -f "$SESSION_DIR/session.json" ]; then
            local terminal_info=$(jq -n \
                --arg log "$log_file" \
                --arg name "$SESSION_NAME" \
                '{log_file: $log, tab_name: $name, started: (now | strftime("%Y-%m-%dT%H:%M:%S"))}')
            update_session_field "$SESSION_DIR" "terminal" "$terminal_info"
            add_session_history "$SESSION_DIR" "terminal_started" '{"app": "iTerm2"}'
        fi
        return 0
    fi

    # Try Terminal.app (macOS)
    if [ -d "/Applications/Utilities/Terminal.app" ]; then
        osascript << TERM_SCRIPT
tell application "Terminal"
    activate
    do script "script -q '$log_file' $claude_cmd"
end tell
TERM_SCRIPT
        if [ -f "$SESSION_DIR/session.json" ]; then
            local terminal_info=$(jq -n \
                --arg log "$log_file" \
                --arg name "$SESSION_NAME" \
                '{log_file: $log, tab_name: $name, started: (now | strftime("%Y-%m-%dT%H:%M:%S"))}')
            update_session_field "$SESSION_DIR" "terminal" "$terminal_info"
            add_session_history "$SESSION_DIR" "terminal_started" '{"app": "Terminal.app"}'
        fi
        return 0
    fi

    # Fallback: print instructions
    echo ""
    info "To start Claude in the repo, run:"
    echo ""
    gum style --foreground 82 "  cd $REPO_DIR && claude"
    echo ""
    sleep 2
    return 0
}

# Open terminal in repo without starting claude
open_terminal_in_repo() {
    local SESSION_DIR="$1"
    local REPO_DIR="$SESSION_DIR/repo"
    local SESSION_NAME=$(basename "$SESSION_DIR")

    if [ ! -d "$REPO_DIR" ]; then
        error "Repository folder not found: $REPO_DIR"
        sleep 1
        return 1
    fi

    # Try Zellij if configured and available
    if [ "$USE_ZELLIJ" = "true" ] && command -v zellij &>/dev/null; then
        local tmp_script=$(mktemp /tmp/cgremlin-XXXXXX)
        printf '%s\n' "cd '$REPO_DIR' && clear && pwd && git status && exec bash" > "$tmp_script"
        chmod +x "$tmp_script"
        zellij run --name "🧪 $SESSION_NAME" -- bash "$tmp_script"
        success "Opened new Zellij pane"
        return 0
    fi

    # Try iTerm2 first (macOS)
    if [ -d "/Applications/iTerm.app" ]; then
        osascript << ITERM_SCRIPT
tell application "iTerm"
    activate
    tell current window
        create tab with default profile
        tell current session
            set name to "🧪 $SESSION_NAME"
            write text "printf '\\033]1;🧪 $SESSION_NAME\\a'"
            write text "cd '$REPO_DIR' && clear && pwd && git status"
        end tell
    end tell
end tell
ITERM_SCRIPT
        success "Opened new iTerm2 tab"
        return 0
    fi

    # Try Terminal.app (macOS)
    if [ -d "/Applications/Utilities/Terminal.app" ]; then
        osascript << TERM_SCRIPT
tell application "Terminal"
    activate
    do script "cd '$REPO_DIR' && clear && pwd && git status"
end tell
TERM_SCRIPT
        success "Opened new Terminal window"
        return 0
    fi

    # Fallback: print instructions
    echo ""
    info "To open a terminal in the repo, run:"
    echo ""
    gum style --foreground 82 "  cd $REPO_DIR"
    echo ""
    sleep 2
    return 0
}

# Focus an existing terminal window/tab for a session
focus_session_terminal() {
    local SESSION_DIR="$1"
    local SESSION_NAME=$(basename "$SESSION_DIR")

    # Try iTerm2 first
    if [ -d "/Applications/iTerm.app" ]; then
        osascript << FOCUS_SCRIPT
tell application "iTerm"
    activate
    set foundTab to false
    repeat with aWindow in windows
        repeat with aTab in tabs of aWindow
            repeat with aSession in sessions of aTab
                if name of aSession contains "$SESSION_NAME" then
                    select aTab
                    set foundTab to true
                    exit repeat
                end if
            end repeat
            if foundTab then exit repeat
        end repeat
        if foundTab then exit repeat
    end repeat
    return foundTab
end tell
FOCUS_SCRIPT
        return $?
    fi

    # Terminal.app doesn't support easy tab finding
    dim "Could not auto-focus terminal. Look for tab: $SESSION_NAME"
    return 1
}

# Get terminal output (last N lines from log)
get_terminal_output() {
    local SESSION_DIR="$1"
    local lines="${2:-50}"

    if [ -f "$SESSION_DIR/session.json" ]; then
        local log_file=$(jq -r '.terminal.log_file // empty' "$SESSION_DIR/session.json")
        if [ -n "$log_file" ] && [ -f "$log_file" ]; then
            # Strip ANSI codes and get last N lines
            tail -n "$lines" "$log_file" 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g'
            return 0
        fi
    fi

    # Fallback: look for any log file
    local latest_log=$(ls -t "$SESSION_DIR/logs"/*.log 2>/dev/null | head -1)
    if [ -n "$latest_log" ]; then
        tail -n "$lines" "$latest_log" 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g'
        return 0
    fi

    echo "No terminal log found"
    return 1
}

